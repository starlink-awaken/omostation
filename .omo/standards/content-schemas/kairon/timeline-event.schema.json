{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/timeline-event.schema.json",
  "title": "TimelineEvent",
  "type": "object",
  "required": [
    "event_id",
    "occurred_at",
    "type",
    "actor",
    "summary",
    "risk_level",
    "work_packet",
    "artifacts"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt-[0-9]{8}-[0-9]{3,}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": [
        "workspace_created",
        "agent_team_bootstrap",
        "agent_review_completed",
        "planning_package_created",
        "coordination_space_created",
        "hot_start_workflow_skills_created",
        "readiness_validation_created",
        "readiness_validation_passed",
        "execution_taxonomy_created",
        "execution_taxonomy_validated",
        "agent_handoff_plan_management_created",
        "agent_handoff_plan_management_validated",
        "global_implementation_plan_created",
        "global_implementation_plan_validated",
        "r3_engineering_contracts_created",
        "r3_engineering_ready_validated",
        "daily_brief_retrospective_system_created",
        "daily_brief_retrospective_system_validated",
        "project_panorama_status_added",
        "hierarchical_id_system_created",
        "hierarchical_id_system_validated",
        "w3_work_packets_created",
        "external_agent_readonly_trial_completed",
        "project_asset_readonly_probe_completed",
        "runtime_api_review_completed",
        "phase0_freeze_review_completed",
        "external_agent_evidence_hardening_completed",
        "readonly_probe_boundary_verification_completed",
        "agentrun_schema_enforcement_completed",
        "phase1_object_schemas_completed",
        "ledger_machine_contract_hardened",
        "phase1_entry_gate_completed",
        "gemini_critic_review_completed",
        "droid_preflight_completed",
        "crush_auth_blocked",
        "crush_quality_review_completed",
        "mmx_quality_review_completed",
        "claude_final_preflight_completed",
        "model_resource_pool_created",
        "opencode_kilocode_capability_probe_completed",
        "local_model_pool_integrated",
        "agent_heartbeat_protocol_created",
        "shared_agent_dashboard_created",
        "work_packet_created",
        "agent_dispatched",
        "agent_completed",
        "artifact_collected",
        "integration_reviewed",
        "canonical_doc_updated",
        "approval_requested",
        "approval_recorded",
        "tool_called",
        "failure_recorded",
        "reflection_recorded",
        "event_correction"
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "actor_role": { "type": "string" },
    "work_packet": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": ["string", "null"] },
    "parent_event_id": { "type": ["string", "null"] },
    "corrects_event_id": { "type": ["string", "null"] },
    "correction_reason": { "type": ["string", "null"] },
    "policy_scope": { "type": "array", "items": { "type": "string" }, "default": [] },
    "approval_receipt": { "type": ["string", "null"] },
    "source_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "default": []
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "allOf": [
    {
      "if": { "properties": { "risk_level": { "enum": ["high", "critical"] } } },
      "then": {
        "required": ["correlation_id", "evidence", "policy_scope"],
        "properties": {
          "correlation_id": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "policy_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "event_correction" } } },
      "then": { "required": ["corrects_event_id", "correction_reason"] }
    }
  ],
  "additionalProperties": false
}
