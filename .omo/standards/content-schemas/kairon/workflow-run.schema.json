{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/workflow-run.schema.json",
  "title": "WorkflowRun",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "title",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "visibility",
    "permission",
    "permission_scope",
    "write_authority",
    "audit_trace",
    "workflow_id",
    "workflow_kind",
    "trigger_refs",
    "step_run_refs",
    "checkpoint_refs",
    "recovery_plan_refs",
    "evaluation_refs",
    "reflection_refs",
    "policy_ref",
    "risk_level",
    "external_truth_unavailable"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^wfr_" },
    "type": { "const": "WorkflowRun" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "enum": ["planned", "running", "checkpointed", "recovering", "completed", "failed", "cancelled"] },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
    "permission": {
      "type": "object",
      "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "external_write_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "permission_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "write_authority": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "workflow_kind": { "type": "string", "enum": ["manual", "task_orchestration", "external_wrapper", "recovery", "evaluation"] },
    "trigger_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "step_run_refs": { "type": "array", "items": { "type": "string", "pattern": "^step_" }, "minItems": 1 },
    "current_step_id": { "type": ["string", "null"], "pattern": "^step_" },
    "checkpoint_refs": { "type": "array", "items": { "type": "string" } },
    "recovery_plan_refs": { "type": "array", "items": { "type": "string" } },
    "evaluation_refs": { "type": "array", "items": { "type": "string" } },
    "reflection_refs": { "type": "array", "items": { "type": "string" } },
    "policy_ref": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "external_surface": { "type": ["string", "null"] },
    "external_truth_unavailable": { "type": "boolean" },
    "degraded_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
