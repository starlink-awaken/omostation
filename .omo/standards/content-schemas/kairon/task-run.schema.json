{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/task-run.schema.json",
  "title": "TaskRun",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "title",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "provenance",
    "visibility",
    "permission",
    "permission_scope",
    "write_authority",
    "audit_trace",
    "task_id",
    "work_packet",
    "owner_role",
    "risk_level",
    "operator",
    "policy_ref",
    "allowed_tools",
    "forbidden_actions",
    "write_scope",
    "acceptance_criteria",
    "tool_call_refs",
    "approval_request_id"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^task_" },
    "type": { "const": "TaskRun" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "enum": ["queued", "running", "review", "completed", "blocked", "failed", "rejected", "denied"] },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": ["captured_from", "captured_at", "captured_by", "source_system", "import_method"],
      "properties": {
        "captured_from": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "captured_by": { "type": "string" },
        "source_system": { "type": "string" },
        "import_method": { "type": "string" },
        "lineage_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
    "permission": {
      "type": "object",
      "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "external_write_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "permission_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "write_authority": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "work_packet": { "type": "string", "pattern": "^WP-2026-" },
    "owner_role": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "operator": { "type": "string", "minLength": 1 },
    "policy_ref": { "type": "string", "minLength": 1 },
    "allowed_tools": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "write_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "approval_request_id": { "type": ["string", "null"], "pattern": "^apr_" },
    "approval_receipt_id": { "type": ["string", "null"], "pattern": "^aprv_" },
    "tool_call_refs": { "type": "array", "items": { "type": "string", "pattern": "^tcall_" }, "minItems": 1 },
    "audit_refs": { "type": "array", "items": { "type": "string", "pattern": "^audit-|^evt-" }, "minItems": 1 }
  },
  "additionalProperties": true
}
