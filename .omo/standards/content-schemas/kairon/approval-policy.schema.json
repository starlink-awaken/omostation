{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalPolicy",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "workspace_id",
    "status",
    "eligible_roles",
    "fallback_roles",
    "quorum_by_risk",
    "escalation_enabled",
    "policy_ref"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "ApprovalPolicy" },
    "version": { "type": "integer", "minimum": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "inactive"] },
    "eligible_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["owner", "reviewer", "operator", "observer"] }
    },
    "fallback_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["owner", "reviewer", "operator", "observer"] }
    },
    "quorum_by_risk": {
      "type": "object",
      "required": ["low", "medium", "high", "critical"],
      "properties": {
        "low": { "type": "integer", "minimum": 1 },
        "medium": { "type": "integer", "minimum": 1 },
        "high": { "type": "integer", "minimum": 1 },
        "critical": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "escalation_enabled": { "type": "boolean" },
    "policy_ref": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
