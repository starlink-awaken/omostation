{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/agent-run.schema.json",
  "title": "AgentRun",
  "type": "object",
  "required": [
    "run_id",
    "hierarchy_id",
    "parent_id",
    "work_packet",
    "agent_id",
    "role",
    "evidence_schema_version",
    "mode",
    "risk_level",
    "status",
    "allowed_tools",
    "forbidden_actions",
    "write_scope",
    "artifact_dir",
    "created_at"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "hierarchy_id": { "type": "string" },
    "parent_id": { "type": "string" },
    "work_packet": { "type": "string" },
    "agent_id": { "type": "string" },
    "role": { "type": "string" },
    "evidence_schema_version": { "type": ["string", "null"] },
    "mode": { "type": "string" },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "collected", "evaluated", "integrated", "failed", "rejected"]
    },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "write_scope": { "type": "array", "items": { "type": "string" } },
    "prompt_path": { "type": ["string", "null"] },
    "artifact_dir": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "command": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "cwd": { "type": ["string", "null"] },
    "stdout_path": { "type": ["string", "null"] },
    "stderr_path": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {}
    },
    "redaction_result": {
      "type": ["object", "null"],
      "properties": {
        "applied": { "type": "boolean" },
        "redacted_artifacts": { "type": "array", "items": { "type": "string" } },
        "line_limit": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "evaluation_result": {
      "type": ["object", "null"],
      "properties": {
        "passed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "checked_at": { "type": "string", "format": "date-time" },
        "checks": { "type": "array", "items": { "type": "string" } },
        "missing_evidence": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "validation": { "type": "array", "items": { "type": "string" }, "default": [] },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": true
}
