{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/review.schema.json",
  "title": "Review",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "subject_ref", "target_ref", "reviewer", "review_type", "decision", "rationale", "reviewed_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^rev_" },
    "type": { "const": "Review" },
    "status": { "enum": ["requested", "completed", "rejected", "superseded"] },
    "target_ref": { "type": "string" },
    "subject_ref": { "type": "string" },
    "reviewer": { "type": "string" },
    "review_type": { "type": "string", "enum": ["memory", "claim", "evidence", "research", "schema", "governance"] },
    "decision": { "type": "string", "enum": ["approve", "reject", "revise", "defer"] },
    "rationale": { "type": "string" },
    "findings": { "type": "array", "items": { "type": "string" } },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "conditions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
