{
  "$schema": "handoff-schema/v1",
  "description": "会话交接协议 — 机器可读 handoff 记录",
  "required_fields": ["session_id", "timestamp", "agent", "summary", "changed_files", "verification", "follow_ups"],
  "optional_fields": ["blocked_by", "risks", "artifacts"],
  "example": {
    "session_id": "opencode:ses_xxx",
    "timestamp": "2026-08-23T00:00:00Z",
    "agent": "sisyphus",
    "summary": "one-line what was done",
    "changed_files": ["path/to/file"],
    "verification": {"command": "pytest -q", "result": "pass"},
    "follow_ups": [{"desc": "...", "priority": "medium"}]
  }
}
