#!/bin/bash
# Pre-push gate: lint + smoke test
if [ "${SKIP_GATE:-}" = "true" ]; then exit 0; fi
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
echo "🔍 Pre-push: $(basename $REPO_ROOT)"

# ruff check
if command -v ruff &>/dev/null; then
  ruff check src/omo/ || { echo "❌ ruff check failed"; exit 1; }
  ruff format --check src/omo/ || { echo "❌ format check failed"; exit 1; }
fi

# smoke test: 本地 pre-push 跳过 archive/integration 等慢/旧测试
if [ -d tests ]; then
  uv run pytest tests/ -q --tb=no -x --ignore=tests/archive --ignore=tests/integration 2>/dev/null || echo "⚠️  tests failed (non-blocking in dev)"
fi

echo "✅ Pre-push check passed"
