#!/bin/bash
# pre-merge-commit — 合并前校验.
#
# 机制 22c (2026-09-05): 合并提交前校验 (submodule-guard + conflict-marker + mass-deletion).

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"
if [ -z "$ROOT" ]; then
  exit 0
fi

PY_RUNTIME="$ROOT/bin/gac/managed-python"
run_py() { "$PY_RUNTIME" run --profile stdlib -- "$@"; }

# ── submodule-guard (merge 模式: 跳过祖先检查但校验初始化) ──
if [ -f "$ROOT/bin/gac/submodule-guard.py" ]; then
  if ! run_py "$ROOT/bin/gac/submodule-guard.py" --merge 2>&1; then
    echo "[pre-merge-commit] ❌ submodule-guard 失败" >&2
    exit 1
  fi
fi

# ── conflict-marker ────────────────────────────────────────
if [ -f "$ROOT/bin/ssot/conflict-marker-check.py" ]; then
  if ! run_py "$ROOT/bin/ssot/conflict-marker-check.py" 2>&1; then
    echo "[pre-merge-commit] ❌ 发现未解决冲突标记" >&2
    exit 1
  fi
fi

# ── mass-deletion ──────────────────────────────────────────
if [ -f "$ROOT/bin/gac/mass-deletion-gate.py" ]; then
  if ! run_py "$ROOT/bin/gac/mass-deletion-gate.py" --staged 2>&1; then
    echo "[pre-merge-commit] ❌ 检测到大量删除" >&2
    exit 1
  fi
fi

exit 0
