#!/bin/bash
# pre-commit — GaC + SSOT 本地硬门
#
# commit 前:
#   1. hygiene advisory: 0 字节/大小写冲突提示
#   2. GaC local gate: validate + drift + doc SSOT + snapshot + doc links
#   3. SSOT guardian: task count/current wave/submodule/direct-io 等漂移
#   4. audit-engine: Python AST 静态非原子写审计与拦截
#
# 安装: make install-hooks (从 .githooks/ 复制到 .git/hooks/)
# 新 clone 必跑: make install-hooks

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ── G-CONV.7 / ADR-0220 D3: shared worktree claim-before-commit ──────
# install-hooks path SSOT (.githooks/pre-commit → .git/hooks/pre-commit).
# Fail-closed on shared main/detached: unclaimed staged writes are rejected.
# Isolated work/* | pr/* branches short-circuit inside claim-check.
if [ -f "$ROOT/bin/gac/swarm-discipline-cli.py" ]; then
  _d3_out="$(python3 "$ROOT/bin/gac/swarm-discipline-cli.py" claim-check --staged 2>&1)" || _d3_rc=$?
  _d3_rc="${_d3_rc:-0}"
  printf '%s\n' "$_d3_out" | sed 's/^/[swarm-d3] /' >&2
  if [ "$_d3_rc" -ne 0 ]; then
    cat >&2 <<EOF
[swarm-d3] ❌ D3 shared-worktree claim check failed (ADR-0220 / G-CONV.7)
   共享 main worktree 上的提交必须先:
     bash bin/gac/gac-worktree.sh claim <session>   # 隔离 work/*
     # 或: agent-workflow claim <run-id> --path <file>
EOF
    exit 1
  fi
fi

if [ -x "$ROOT/bin/gac-hygiene-check.py" ]; then
  # advisory: 输出到 stderr, 不阻断 commit (|| true)
  python3 "$ROOT/bin/gac-hygiene-check.py" 2>&1 | sed 's/^/[hygiene] /' >&2 || true
fi

run_py_with_yaml() {
  local script="$1"
  shift
  if command -v uv >/dev/null 2>&1; then
    uv run --with pyyaml python "$script" "$@"
  else
    python3 "$script" "$@"
  fi
}

if [ -f "$ROOT/bin/gac-local-gate.py" ]; then
  run_py_with_yaml "$ROOT/bin/gac-local-gate.py" 2>&1 | sed 's/^/[gac] /' >&2
fi

if [ -f "$ROOT/bin/ssot-guardian.py" ]; then
  run_py_with_yaml "$ROOT/bin/ssot-guardian.py" 2>&1 | sed 's/^/[ssot] /' >&2
fi

if [ -f "$ROOT/bin/gac-audit-engine.py" ]; then
  # 调用中央 audit-engine 进行 atomic_write (debt) 的静态 AST 审计拦截
  python3 "$ROOT/bin/gac-audit-engine.py" --staged 2>&1 | sed 's/^/[audit] /' >&2
fi

# ── PASW: 子模块隔离强制执行 ──────────────────────────────────────
# 高冲突子模块 (gbrain/cockpit/agora) 必须通过 .subtrees/ worktree 修改,
# 不允许在 root 直接 git add projects/<sub> (gitlink 变更).
# 合法流程: cd .subtrees/<sub> && git add . && git commit → bump-pointer
# G3 (P79, 2026-08-04): merge commit 豁免 — merge main 带入的 gitlink 变更不拦
# (PASW guard 对 merge 不友好, #907 实证: merge main 引入多子模块 gitlink →
#  要求每个 .subtrees/<sub> 对齐 → 死循环). merge 的 gitlink 是 base 端合法 commit,
#  CI reachability gate (full checkout) 兜底验证可达.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  echo "[submodule-guard] ℹ️ merge commit (MERGE_HEAD), 跳过 PASW gitlink 变更检查 (G3/P79, CI 兜底)" >&2
else
PASW_ISOLATED="projects/gbrain projects/cockpit projects/agora"
for sub in $PASW_ISOLATED; do
  # 检查是否尝试在 root 直接 stage 子模块 gitlink 变更
  if git diff --cached --name-only | grep -qxF "$sub"; then
    sub_name=$(basename "$sub")
    # 用 $ROOT 绝对路径 (pre-commit 钩子环境相对路径可能解析到主仓 HEAD)
    sub_wt="$ROOT/.subtrees/$sub_name"

    if [ ! -d "$sub_wt" ]; then
      echo "[submodule-guard] ❌ $sub 指针变更被拒绝: 子模块 worktree 不存在" >&2
      echo "   请先: bash bin/gac/gac-worktree.sh claim <session>" >&2
      echo "   然后在子模块 worktree 中 commit: cd $sub_wt && git add . && git commit" >&2
      exit 1
    fi

    # 验证 staged SHA 与 worktree HEAD 一致 (确保改动来自隔离 worktree)
    staged_sha=$(git ls-files --stage -- "$sub" | awk '$1 == "160000" {print $2}')
    # env -u GIT_DIR/GIT_WORK_TREE: git hook 执行时 GIT_DIR 指向主仓, `git -C` 改 cwd
    # 但 GIT_DIR 优先, 读主仓 ref 而非子模块 HEAD (幽灵 SHA, 拦截所有 PASW bump-pointer).
    # 清除环境变量让 git -C .subtrees/<sub> 正确读子模块 worktree HEAD.
    wt_sha=$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$sub_wt" rev-parse HEAD 2>/dev/null || echo "")
    if [ "$staged_sha" != "$wt_sha" ]; then
      echo "[submodule-guard] ❌ $sub 指针变更被拒绝: 与子模块 worktree HEAD 不匹配" >&2
      echo "   staged SHA: ${staged_sha:-none}" >&2
      echo "   worktree HEAD: $wt_sha" >&2
      echo "   请先在子模块 worktree 中 commit: cd $sub_wt && git add . && git commit" >&2
      echo "   然后: bash bin/gac/gac-worktree.sh bump-pointer <session> $sub" >&2
      exit 1
    fi
  fi
done
fi
# 禁止将 .subtrees/ 目录 commit 到 root
if git diff --cached --name-only | grep -q '^\.subtrees/'; then
  echo "[submodule-guard] ❌ 不允许将 .subtrees/ 提交到 root 仓库" >&2
  echo "   .subtrees/ 是 PASW 隔离 worktree 的本地存储, 不属于 root 仓库" >&2
  exit 1
fi

# ── Debt directory deletion guard ──
# 禁止 unstaged 删除 .omo/debt/ 下的文件
if git status --short -- ".omo/debt/" | grep -q "^.D"; then
  echo "[debt-guard] ❌ .omo/debt/ 下有关联删除文件:" >&2
  git status --short -- ".omo/debt/" | grep "^.D" | sed 's/^/[debt-guard]   /' >&2
  echo "[debt-guard] ⛔ 拒绝提交 — 债务文件只能通过 omo debt CLI 管理" >&2
  exit 1
fi


# --- mass-deletion gate (2026-08-08 agora 整仓被清空事故) ---
# 工作树被 rm -rf / 子模块未 init 时, git add -A 会把"文件消失"记成删除,
# commit+push 后远端整仓归零。这里在提交前拦一次量级异常。
GATE="$(git rev-parse --show-toplevel)/bin/gac/mass-deletion-gate.py"
if [ -f "$GATE" ]; then
  python3 "$GATE" --staged || exit 1
fi

exit 0

