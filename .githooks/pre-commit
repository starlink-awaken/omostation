#!/bin/bash
# =============================================================================
# Meta-Model CI Gate — Pre-Commit Hook
# Validates YAML files, checks kei.yaml validity, and verifies protocol
# registry references.
#
# Installed via: git config core.hooksPath .githooks
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
ERRORS=0
WARNINGS=0

# ── Helpers ──────────────────────────────────────────────────────────────────

pass() { echo -e "  ${GREEN}✓${NC} $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $1"; WARNINGS=$((WARNINGS + 1)); }
fail() { echo -e "  ${RED}✗${NC} $1"; ERRORS=$((ERRORS + 1)); }

section() {
    echo ""
    echo -e "${CYAN}═══ $1 ═══${NC}"
}

# ── 1. Validate all staged/committed YAML files ──────────────────────────────

validate_yaml_syntax() {
    section "YAML Syntax Validation"

    # Get staged files (both in index and working tree for pre-commit)
    local yaml_files
    yaml_files=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
    if [[ -z "$yaml_files" ]]; then
        yaml_files=$(git ls-files '*.yaml' '*.yml' 2>/dev/null || true)
    fi

    if [[ -z "$yaml_files" ]]; then
        pass "No YAML files to check"
        return
    fi

    local checked=0
    local invalid=0

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        local full_path="$REPO_ROOT/$file"
        if [[ ! -f "$full_path" ]]; then
            continue
        fi

        checked=$((checked + 1))

        if command -v python3 &>/dev/null; then
            if ! python3 -c "
import yaml, sys
try:
    with open('$full_path') as f:
        yaml.safe_load(f)
    sys.exit(0)
except Exception as e:
    print(f'YAML error in $file: {e}')
    sys.exit(1)
" 2>&1; then
                fail "YAML parse failed: $file"
                invalid=$((invalid + 1))
                continue
            fi
        else
            warn "python3 not found, skipping YAML validation for $file"
            continue
        fi

        pass "Valid YAML: $file"
    done <<< "$yaml_files"

    if [[ $checked -eq 0 ]]; then
        pass "No YAML files to validate"
    else
        echo "  Checked $checked YAML files, $invalid invalid"
    fi
}

# ── 2. Validate kei.yaml ────────────────────────────────────────────────────

validate_kei_yaml() {
    section "KEI YAML Validation"

    local kei_file="$REPO_ROOT/kei.yaml"
    if [[ ! -f "$kei_file" ]]; then
        warn "kei.yaml not found at $kei_file — skipping KEI validation"
        return
    fi

    python3 -c "
import yaml, sys

with open('$kei_file') as f:
    data = yaml.safe_load(f)

errors = []

if not isinstance(data, dict):
    errors.append('kei.yaml root is not a mapping')
else:
    if 'version' not in data:
        errors.append(\"Missing required field: 'version'\")
    if 'permissions' not in data:
        errors.append(\"Missing required field: 'permissions'\")
    else:
        perms = data['permissions']
        if 'network' not in perms:
            errors.append(\"Missing 'permissions.network'\")
        if 'filesystem' not in perms:
            errors.append(\"Missing 'permissions.filesystem'\")
        if 'execution' not in perms:
            errors.append(\"Missing 'permissions.execution'\")

if errors:
    for e in errors:
        print(f'KEI ERROR: {e}')
    sys.exit(1)
else:
    print(f'KEI version: {data.get(\"version\", \"?\")}')
    print(f'KEI schema: valid')
" 2>&1

    if [[ $? -eq 0 ]]; then
        pass "kei.yaml is valid"
    else
        fail "kei.yaml validation failed"
    fi
}

# ── 3. Verify protocol registry references exist ─────────────────────────────

validate_protocol_refs() {
    section "Protocol Registry Reference Validation"

    local registry_file="$REPO_ROOT/protocols/L0-registry.yaml"
    if [[ ! -f "$registry_file" ]]; then
        warn "L0-registry.yaml not found — skipping reference validation"
        return
    fi

    python3 -c "
import yaml, sys, os
from pathlib import Path

repo_root = Path('$REPO_ROOT')

with open('$registry_file') as f:
    data = yaml.safe_load(f)

protocols = data.get('protocols', [])
errors = []
warnings = []

for proto in protocols:
    name = proto.get('name', '?')
    spec_url = proto.get('spec_url', '')

    if not spec_url:
        continue

    if spec_url.startswith(('http://', 'https://', 'mcp:', 'file:')):
        continue

    expanded = spec_url.replace('~/', str(Path.home()) + '/')
    expanded = expanded.replace('\$HOME', str(Path.home()))
    expanded = expanded.replace('\$WORKSPACE_HOME', str(Path.home() / 'Workspace'))

    if '\$RUNTIME_HOME' in expanded:
        continue

    ref_path = Path(expanded)

    if not ref_path.is_absolute():
        ref_path = repo_root / ref_path

    if not ref_path.exists():
        errors.append(f\"spec_url for '{name}' not found: {spec_url} -> {ref_path}\")
        continue

    print(f\"  ✓ '{name}' -> {ref_path}\")

if errors:
    print(f'\\nReference errors:')
    for e in errors:
        print(f'  ✗ {e}')
    sys.exit(1)
else:
    print('  All protocol spec_url references resolve')
" 2>&1

    if [[ $? -eq 0 ]]; then
        pass "All protocol registry references resolve"
    else
        fail "Some protocol registry references are broken"
    fi
}

# ── Main ──────────────────────────────────────────────────────────────────────

echo ""
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}  Meta-Model CI Gate — Pre-Commit Hook${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"

validate_yaml_syntax
validate_kei_yaml
validate_protocol_refs

# ── Result ────────────────────────────────────────────────────────────────────

echo ""
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}  Summary: ${ERRORS} errors, ${WARNINGS} warnings${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════════════${NC}"
echo ""

if [[ $ERRORS -gt 0 ]]; then
    echo -e "${RED}❌ Pre-commit hook FAILED — ${ERRORS} error(s) found. Fix before committing.${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ Pre-commit hook PASSED${NC}"
    echo ""
    exit 0
fi
