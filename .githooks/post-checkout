#!/bin/bash
# 机制 22c: post-checkout 委托给 hook-runner.sh (分支检出后命名合规)
# 触发: git checkout / git switch / git worktree add (flag=1 分支切换)
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# 子模块上下文守卫: 同 pre-commit, 主仓 hook-runner 在子模块不存在则跳过
[ -f "$ROOT/bin/gac/hook-runner.sh" ] || exit 0
# ── remote-hygiene 自愈 (2026-09-13, 实证污染事故) ────────────────────
# 放在最前: 快速幂等 (纯 config 检查), 无网络依赖. 并发会话可能改写共享
# config 的 remote.origin.url (实证: 被改写成 omostation-runtime 后
# fetch/gh pr/验证静默失效). checkout/worktree add 是观测到的污染窗口.
# 失败/绕过由 pre-push blocking remote-hygiene 兜底拦截.
if [ "${GAC_SKIP_POST_CHEKOUT_GUARD:-}" != "1" ] && [ -f "$ROOT/bin/ssot/fix-remotes.py" ]; then
  bash "$ROOT/bin/ssot/fix-remotes.py" >/dev/null 2>&1 || true
fi
# ── BET-Y1Q4-T10-161: gitlink 新鲜度 + remote 完整性守卫 ──────────────
# advisory (恒不阻断 checkout); 覆盖 git worktree add 绕过 gac-worktree.sh
# claim 的路径. GAC_SKIP_POST_CHEKOUT_GUARD=1 可跳过 (测试/特殊流程).
if [ "${GAC_SKIP_POST_CHEKOUT_GUARD:-}" != "1" ] && [ -f "$ROOT/bin/gac/gac-worktree.sh" ]; then
  bash "$ROOT/bin/gac/gac-worktree.sh" guard-submodules --fix >/dev/null 2>&1 || true
fi
# ── WIP 快照兜底 (2026-09-17, 共享工作区改动丢失事故) ────────────────
# 主工作区被多 agent 共享, checkout 可能刚覆盖掉他人的未提交改动.
# 此处在 checkout 后立即快照当前脏态 (仅在主工作区生效; worktree 跳过).
# 纯本地复制, 恒不阻断; 额外快照由 cron 每小时执行.
if [ "${GAC_SKIP_POST_CHEKOUT_GUARD:-}" != "1" ] && [ -f "$ROOT/bin/gac/workspace-wip-guard.py" ]; then
  python3 "$ROOT/bin/gac/workspace-wip-guard.py" snapshot --reason post-checkout --quiet >/dev/null 2>&1 || true
fi
bash "$ROOT/bin/gac/hook-runner.sh" --hook post-checkout
