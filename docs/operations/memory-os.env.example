# Memory OS / Neo4j local defaults (ADR-0372 Phase 6–8)
# Copy to config/memory-os.env (gitignored) or projects/cockpit/.env and adjust.
# Do not commit real secrets. Defaults match brew/minerva/mos compose.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

MOS_TEMPORAL=1
MOS_RBAC=1
MOS_MEM0=0
MOS_GRAPHITI=0
MOS_HTTP_TIMEOUT=60
# Optional: MOS_STORE_PATH= / absolute path for FileStore
# Optional: MOS_RBAC_PATH= .omo/_truth/registry/memory-rbac.yaml
