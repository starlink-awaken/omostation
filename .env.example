# Cockpit environment variables
COCKPIT_DASHBOARD_PORT=8090
COCKPIT_DASHBOARD_TOKEN=
COCKPIT_DASHBOARD_CORS_ORIGIN=http://localhost:8090
COCKPIT_DASHBOARD_RATE_LIMIT=60
COCKPIT_AUTH_REQUIRED=false
COCKPIT_API_KEY=
COCKPIT_KEYS_FILE=config/api_keys.yaml
# 32+ character shared key; configure the same value for Cockpit and OMO.
COCKPIT_ENGINEERING_REVIEW_SIGNING_KEY=
COCKPIT_JWT_TOKEN=
RUNTIME_HOME=~/runtime

# Memory OS / Neo4j (ADR-0372) — also see docs/operations/memory-os.env.example
# Loaded by cockpit.web.memory_env (does not overwrite non-empty process env)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
MOS_TEMPORAL=1
MOS_RBAC=1
MOS_MEM0=0
MOS_GRAPHITI=0
