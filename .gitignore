# .gitignore — agora project root
# BOS 可观测性数据库（自动创建，不含敏感数据，但属于运行时数据）
# 路径由 AGORA_METRICS_DB 环境变量控制，默认 ~/.agora/bos_metrics.db
bos_metrics.db
*.db
*.db-shm
*.db-wal

# Python runtime artifacts
__pycache__/
*.pyc
*.pyo

# Runtime trace logs (not source code)
src/trace_log.jsonl

etc/graphify-out/
.omc/
cache/
*.tmp
.DS_Store
.subtrees/
