# === omostation root .gitignore ===
# 根仓库只追踪元配置、基础设施和文档。
# 项目代码在各子仓库中独立管理。

# ---------------------------------------------------------------------------
# 1. 治理平面运行时产物（OMO / OMC / spaces）
#    这些目录承载的是会话、计划、证据等运行时/治理状态，不是仓库源码。
# ---------------------------------------------------------------------------
.omo/.omo/
.omo/_archive/
.artifacts/
.omo/_delivery/
.omo/_log/
.omo/_knowledge/*.jsonl
# workflow-mesh 运行时事件流 (高频 churn, 非治理 SSOT; governance-history.jsonl 保留入仓)
.omo/_knowledge/workflow-mesh/
# 通用锁文件 (git 不追踪 .lock)
**/*.lock
.omo/_control/evolution/drift-history/*.json.lock
.omo/capabilities/
# debt/ 派生产物 (dashboard/dispatch/action-packet/review-queue/owner-routing/reviews/
# campaign/reporting) 高 churn, write_dashboard 等从 items/ + metrics 派生, 生成器可重建.
# items/ 例外: canonical SSOT (跟 .omo/tasks/ 同类 lifecycle 数据), 入仓 (修正 c82cbd23 误判).
.omo/debt/*
!.omo/debt/items/
# health trend history (compass_radar JSONL append-only 时间序列)
# 高 churn, 由 compass_radar 自动生成, 不入仓 (防 working tree 噪声).
.omo/state/history/
.omo/evidence
.omo/plans/
.omo/run-continuation/
.omo/tests/
.omo/workers/

.omc/

projects/.omc/
# projects/cockpit-ui/ 移出忽略 (BET-Y1Q4-T8-02: PWA 前端入主仓跟踪)
projects/ecos/src/ecos/ssot/mof/m0/snapshot.yaml

spaces/*.db

# ---------------------------------------------------------------------------
# 2. Runtime 运行时残渣（非持久数据）
#    runtime/ 只保留 README 和边界契约 YAML；
#    sandbox 中 debt/tasks/OpenSpec 是已跟踪的治理 artifacts，
#    decayed/pitches 由 c2g 等工具自动生成，只忽略新增文件。
# ---------------------------------------------------------------------------
runtime/**/*.log
runtime/**/*.jsonl
runtime/**/*.pid
runtime/data/
runtime/run-continuation/*.json
runtime/server.log
runtime/wechat-main.png

# BET-Y1Q3-T6-15 R2a: approved runtime output/cache/snapshot artifacts remain
# local-only after repository untracking; contracts and runtime code stay visible.
runtime/bos-neural-mesh-*
runtime/concept-weave-preflight*.json
runtime/consumer-audit-*.json
runtime/control/evidence/documents-weijian-*/
runtime/daily-health-preflight*.json
runtime/heartbeats/weijian-*
runtime/kos-preflight-*.json
runtime/predictor-preflight*.json
runtime/quarantine/documents-bos-neural-mesh-20260828/
# Recoverable physical-migration packages are runtime evidence, not disposable
# untracked output; protect every package from ordinary repository cleanup.
runtime/quarantine/*/
runtime/task-inventory/snapshots/

runtime/sandbox/decayed/
runtime/sandbox/pitches/
runtime/omo/
runtime/agent-sessions/

# OMO volatile self-healing/ingress/evolution runtime mirrors (now live under runtime/omo/)
.omo/_delivery/ingress/
.omo/_control/evolution/drift/
.omo/_control/evolution/drift-history/
.omo/_control/evolution/approval-board/
.omo/_control/evolution/loop/
.omo/_control/evolution/self-evolve/
.omo/_control/evolution/radar-history.json
.omo/change-log/mutations.jsonl
.omo/tasks/registry/done/
.omo/_truth/registry/dependency-baseline.yaml

# ---------------------------------------------------------------------------
# 3. Data 共享数据底座的运行时文件
#    保留：README、访问策略 YAML、驾驶舱 CARDS Markdown。
#    忽略：数据库、备份、索引、捕获等生成/运行时文件。
# ---------------------------------------------------------------------------
data/**/*.db
data/**/*.db-shm
data/**/*.db-wal
data/**/*.sqlite
data/**/*.sqlite3
data/_index/
data/backups/
data/cards/*.db
data/db/
data/kos/
data/sharedbrain/data/
data/驾驶舱/documents.db

# ---------------------------------------------------------------------------
# 4. KOS 运行时目录
#    KOS_HOME 指向根 kos/，其中 manifest + sqlite + captures 是运行时状态。
# 锚定根目录: projects/knowledge/kairon/packages/kos 是源码 (T6-01 内包) 不可 ignore。
# ---------------------------------------------------------------------------
/kos/

# ---------------------------------------------------------------------------
# 5. 生成文档与缓存
# ---------------------------------------------------------------------------
docs/generated/*
# GEN-FORCE (差距治理 S1): 已跟踪生成物是"受保护生成物契约" —
# CI check-docs-drift 依赖它们随 commit 同步提交. 从忽略中排除,
# 使 git add/status 直接可见, 无需 -f 强制提交.
!docs/generated/agent-gac-rules.md
!docs/generated/architecture-deep-analysis.md
!docs/generated/capability-registry.yaml
!docs/generated/kos-ontology-graph.md
!docs/generated/project-layer-index.md
# DOC-GOV Phase 5: 文档治理框架产物 (受跟踪生成物)
!docs/generated/doc-gov-framework.md
!docs/generated/ssot-map.md
!docs/generated/doc-inventory.md
graphify-out/
agent-runtime/
_derivation_logs/
# codebase-memory-mcp local knowledge graph (regenerate via MCP index_repository;
# ~tens of MB compressed; do not commit — see docs/operations/codebase-memory.md)
.codebase-memory/

# ---------------------------------------------------------------------------
# 6. 构建产物与语言缓存
# ---------------------------------------------------------------------------
.env
__pycache__/
*.egg-info/
*.pyc
*.so
dist/
node_modules/

.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.runtime/

# ---------------------------------------------------------------------------
# 7. 本地工具、Agent 与 IDE 配置
#    AI 编码工具目录 (.claude/.crush/.serena/.reasonix/.grok/.hermes/.husky/
#    .antigravitycli/.mimocode/.qoder/.deepeval/.idea) 已由
#    ~/.gitignore_global 统一忽略, 此处为主仓显式兜底（防 global 未配置）。
#    以下仅保留项目特有的忽略规则；本地面一律不入仓。
# ---------------------------------------------------------------------------
.claude/
.mimocode/worktrees/
.mimocode/logs/
.mimocode/sessions/
.mimocode/state/
.mimocode/notepads/
.mimocode/plans/
.omc/notepads/
.omc/logs/
.openclaude/logs/
.metaos/
.codebuddy/
.openclaude/
config/
*.local.json
.cursor/
.vscode/
.idea/

# ---------------------------------------------------------------------------
# 8. 本地开发沙箱与一次性脚本
# ---------------------------------------------------------------------------
/scratch/
**/_tmp_*
**/temp_*

/fix_indent.py
/patch.py
/patch_all.py
/patch_scenario.py
/patch_scenario2.py
/patch_scenario3.py
/patch_scenario4.py
/patch_test.py
/patch_test2.py

# ---------------------------------------------------------------------------
# 9. 历史归档目录与临时数据
#    已跟踪的归档文件保留；新增文件默认不进 git，需 git add -f。
# ---------------------------------------------------------------------------
_archived/

bets.json
tasks.json
/skills/
!.agents/skills/
.mimocode/
!.mimocode/commands/
!.mimocode/skills/

# ---------------------------------------------------------------------------
# 10. 系统文件
# ---------------------------------------------------------------------------
.DS_Store
/.c2g_data/

# governance-dashboard hook transient specs
.omo/autopilot/

# Runtime session continuation (transient)
runtime/run-continuation/
data/cards/

# ADR-0128 Phase 3: runtime projection plane (canonical, generated by `omo state sync`)
# T4 试验 PASS 2026-07-05: fresh clone 跑 omo state sync 重新生成 canonical
# README.md 保留 tracked (导航说明), 其余 generated
.omo/state/runtime/*
!.omo/state/runtime/README.md

# ADR-0404: 运行时状态文件不进git (避免session/branch间永久冲突)
# 根因: signal-poller/alert-handler/agent-tick等进程持续写这些文件
# 两个session同时操作时必然冲突 → git pull永久ABORT
.omo/state/*.jsonl
.omo/state/*.json
.omo/state/agent-beliefs/
.omo/state/agent-cards/
.omo/state/swarm/
.omo/state/system.yaml.bak-*
# 保留tracked的配置/快照类文件
!.omo/state/system.yaml
!.omo/state/system_health.yaml
!.omo/state/health.yaml
!.omo/state/collab-dualtrack.yaml
!.omo/state/provider-plane.yaml
!.omo/state/bos-stdio-migrate-candidates.yaml
!.omo/state/m2-ssot-batch-1.yaml

# ADR-0137 (M4 派生面范式强化): 派生面应跟随 SSOT 源所在子模块,
# 不再在主仓根 .omo/_derived/ 写派生. example:
# projects/ecos/.omo/_derived/ (gitignored in projects/ecos/.gitignore)

# ADR-0144 (M4 cron hook 例外): m4-cron-log.json SSOT 在主仓 .omo/cron/
# 所以派生面也写到主仓根, 这是 ADR-0137 的唯一例外
.omo/_derived/m4-cron-log.json

# ADR-0151 (Round 5f): runtime/.watch-dispatch-stamps.json 是 OMO runtime-stamp-policy
# 守门自动写入的派生面 (每次 bin/omo-state-cleanup.py sync 触发). 主仓 SSOT 跟踪
# metadata (system.yaml, system_health.yaml, health.yaml 等), stamps 本身可重建.
# 治本: 不在主仓 SSOT 中保留. P74 governance boundary 守护.
runtime/.watch-dispatch-stamps.json
.commit-suggestion

# 生成 dashboard 制品 + 临时下载 (2026-07-23 清理)
artifacts-*.html
/archive-*/

# accidental root ecos scaffold (SSOT lives in projects/ecos)
/ecos/

# ---------------------------------------------------------------------------
# 11. PASW (Per-Agent Submodule Worktree) 隔离存储
#    高冲突子模块的独立 worktree 存放目录. 不属于 root 仓库, 禁止 commit.
#    gac-worktree.sh claim 时创建, release/merge 时清理.
# ---------------------------------------------------------------------------
.subtrees/

# ---------------------------------------------------------------------------
# 12. 统一事件面运行时状态 (observability-unified-architecture)
#    事件面 JSONL + 适配器增量指针是运行时产物 (SSOT 在 registry/observability-events.yaml)
# ---------------------------------------------------------------------------
.omo/_delivery/observability/
.omo/state/observability-adapters/

# ---------------------------------------------------------------------------
# 13. 本地-only 独立子仓库 (未在 .gitmodules 注册, 仅部分成员本地 clone)
#    这些是单独 git 仓库, 不在超项目追踪范围. CI 显式跳过 (见 kairon-ci.yml 注释).
# ---------------------------------------------------------------------------
projects/c2g/
projects/gbrain/
projects/kairon/
projects/omo-debt/

# ---------------------------------------------------------------------------
# 14. 运行时派生产物 (evolution proposals + affected-graph receipts)
#     evolution-agent 自动生成 900+ proposal JSON; receipts 由 affected-graph.py 生成.
# ---------------------------------------------------------------------------
.omo/_knowledge/evolution-proposals/
.omo/reports/
.omo/_knowledge/sediment/
.omo/state/attestations/
.kb/
.kb/
projects/cockpit-ui

# tool caches (root-governance allowed)
.benchmarks/
.deepeval/
