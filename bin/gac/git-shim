#!/usr/bin/env bash
# git-shim (BET-Y1Q1-T1-07 + T1-04 加固) — agent PATH 前置 shim: git → swarm-git 强制收口
#
# circuit_breaker: AGENT_ID 空 → 透传 real git (人类终端无此 env, 不受影响)
#                  AGENT_ID 非空 → swarm-git (拦 --no-verify + 高危 clean/reset/stash/rebase)
#
# T1-04 加固: swarm-git 缺失时 fail-closed (不再透传), shim 自身执行关键拦截:
#   - --no-verify: 直接阻断 (无 escape 通道, 需人工处理)
#   - clean -fd / reset --hard / stash -u: 直接阻断
#   - 共享分支 rebase: 直接阻断
#   守 D0 铁律: 交付物不消失. 这些操作删 peer agent 未入库工作.
#
# 关键: 内部 git 调用用 REAL_GIT (非 shim 的 git), 否则 shim→swarm-git→git→shim→… 递归.
#
# 安装 (T1-07): ~/agents/shim/bin/git → symlink 本文件; ~/.claude/settings.json::env
#   前置 PATH + 注入 AGENT_ID. 详见 docs/plans/AGENT-BRIEF.md §3 + AGENTS.md §1.6.

set -euo pipefail

# REAL_GIT = PATH 中第一个非 shim 的 git (防递归)
_shim_dir="${HOME:-}/agents/shim/bin"
REAL_GIT=""
IFS=':' read -ra _dirs <<< "${PATH:-}"
for _d in "${_dirs[@]}"; do
  [ "$_d" = "$_shim_dir" ] && continue
  if [ -x "$_d/git" ]; then REAL_GIT="$_d/git"; break; fi
done

_git_probe() {
  if [ "${#_git_global_args[@]}" -gt 0 ]; then
    "$REAL_GIT" "${_git_global_args[@]}" "$@"
  else
    "$REAL_GIT" "$@"
  fi
}
REAL_GIT="${REAL_GIT:-/usr/bin/git}"

# Normalize Git's global options before evaluating the repository and command.
# The fallback must enforce the same policy for `git -C/-c/--git-dir ...`.
_git_argv=("$@")
_git_global_args=()
GIT_COMMAND=""
GIT_COMMAND_ARGS=()
GIT_INLINE_ALIAS_CONFIG=0
_git_index=0
while [ "$_git_index" -lt "${#_git_argv[@]}" ]; do
  _git_arg="${_git_argv[$_git_index]}"
  case "$_git_arg" in
    -C|--git-dir|--work-tree|--namespace)
      _git_global_args+=("$_git_arg")
      _git_index=$((_git_index + 1))
      if [ "$_git_index" -lt "${#_git_argv[@]}" ]; then
        _git_global_args+=("${_git_argv[$_git_index]}")
      fi
      ;;
    -c|--config-env)
      _git_global_args+=("$_git_arg")
      _git_index=$((_git_index + 1))
      if [ "$_git_index" -lt "${#_git_argv[@]}" ]; then
        _git_config_value="${_git_argv[$_git_index]}"
        _git_global_args+=("$_git_config_value")
        case "$_git_config_value" in
          [Aa][Ll][Ii][Aa][Ss].*) GIT_INLINE_ALIAS_CONFIG=1 ;;
        esac
      fi
      ;;
    --config-env=*)
      _git_global_args+=("$_git_arg")
      case "${_git_arg#--config-env=}" in
        [Aa][Ll][Ii][Aa][Ss].*) GIT_INLINE_ALIAS_CONFIG=1 ;;
      esac
      ;;
    --git-dir=*|--work-tree=*|--namespace=*|--exec-path=*|--bare|--no-pager|--paginate|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks|--no-replace-objects)
      _git_global_args+=("$_git_arg")
      ;;
    --)
      ;;
    -*)
      _git_global_args+=("$_git_arg")
      ;;
    *)
      GIT_COMMAND="$_git_arg"
      GIT_COMMAND_ARGS=("${_git_argv[@]:$((_git_index + 1))}")
      break
      ;;
  esac
  _git_index=$((_git_index + 1))
done

# circuit_breaker: 人类透传
if [ -z "${AGENT_ID:-}" ]; then
  exec "$REAL_GIT" "$@"
fi

# 非 git 仓 → 透传
ROOT="$(_git_probe rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT:-}" ]; then
  exec "$REAL_GIT" "$@"
fi

# agent 通道 → swarm-git
SWARM_GIT="$ROOT/bin/gac/swarm-git"
if [ -x "$SWARM_GIT" ]; then
  exec "$SWARM_GIT" "$@"
fi

# ── T1-04 fail-closed: swarm-git 缺失时 shim 自身执行关键拦截 ──

_danger_block() {
  cat >&2 <<EOF
[git-shim] ❌ $1 (T1-04 fail-closed: swarm-git 缺失, shim 兜底拦截)
   $2
   修复: 确保 bin/gac/swarm-git 存在, 或用人类终端执行此操作.
EOF
  exit 1
}

# --no-verify 拦截
if printf '%s\0' "$@" | grep -qz -- '--no-verify'; then
  _danger_block \
    "--no-verify blocked" \
    "agent 环境禁止跳过 hooks. 如需 escape, 修复 swarm-git 或使用 SWARM_ESCAPE_ID."
fi

# clean -fd / reset --hard / stash -u 拦截
if printf '%s\0' "$@" | grep -qzE '\bclean\b|\breset\b|\bstash\b'; then
  _ARGS="$*"
  if printf '%s' "$_ARGS" | grep -qE 'clean.*-f|clean.*-d|reset.*--hard|stash.*-u'; then
    _danger_block \
      "high-risk op blocked" \
      "clean -fd / reset --hard / stash -u 删 peer agent 未入库工作 (守 D0 铁律)."
  fi
fi

# B2d-1 fail-closed parity: even if swarm-git is unavailable, agent/* remains
# an immutable writer lineage.  Only abort/recovery commands may unwind an
# interrupted merge or rebase.
BRANCH="$(_git_probe rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
IMMUTABLE_WRITER=0
case "$BRANCH" in
  agent/*) IMMUTABLE_WRITER=1 ;;
esac

if [ "$IMMUTABLE_WRITER" -eq 1 ]; then
  if [ "$GIT_INLINE_ALIAS_CONFIG" -eq 1 ]; then
    _danger_block \
      "immutable writer branch '$BRANCH' cannot inject Git aliases" \
      "Use explicit built-in Git commands so lineage policy can inspect them."
  fi
  if [ -n "$GIT_COMMAND" ]; then
    _git_alias="$(_git_probe config --get "alias.$GIT_COMMAND" 2>/dev/null || true)"
    if [ -n "$_git_alias" ]; then
      _danger_block \
        "immutable writer branch '$BRANCH' cannot dispatch configured Git alias '$GIT_COMMAND'" \
        "Use the explicit built-in Git command."
    fi
  fi
  case "$GIT_COMMAND" in
    rebase)
      if [ "${#GIT_COMMAND_ARGS[@]}" -ne 1 ] || [ "${GIT_COMMAND_ARGS[0]:-}" != "--abort" ]; then
        _danger_block \
          "immutable writer branch '$BRANCH' cannot rebase" \
          "Start a fresh delivery attempt instead of rewriting lineage."
      fi
      ;;
    merge)
      if [ "${#GIT_COMMAND_ARGS[@]}" -ne 1 ] || [ "${GIT_COMMAND_ARGS[0]:-}" != "--abort" ]; then
        _danger_block \
          "immutable writer branch '$BRANCH' cannot merge upstream" \
          "Start a fresh delivery attempt instead of mutating lineage."
      fi
      ;;
    pull)
      _danger_block \
        "immutable writer branch '$BRANCH' cannot pull upstream" \
        "Start a fresh delivery attempt instead of mutating lineage."
      ;;
    push)
      # Exact create-if-absent lease: the empty expected remote OID makes a
      # concurrent or reused attempt fail atomically without rewriting history.
      _atomic_create_lease=0
      if [ "${#GIT_COMMAND_ARGS[@]}" -eq 4 ] \
        && [ "${GIT_COMMAND_ARGS[0]}" = "--porcelain" ] \
        && [ "${GIT_COMMAND_ARGS[1]}" = "--force-with-lease=refs/heads/$BRANCH:" ] \
        && [ "${GIT_COMMAND_ARGS[2]}" = "origin" ] \
        && [ "${GIT_COMMAND_ARGS[3]#*:}" = "refs/heads/$BRANCH" ]; then
        _create_source="${GIT_COMMAND_ARGS[3]%%:*}"
        if printf '%s' "$_create_source" | grep -qE '^[0-9a-f]{40}([0-9a-f]{24})?$'; then
          _atomic_create_lease=1
        fi
      fi
      if [ "${#GIT_COMMAND_ARGS[@]}" -gt 0 ]; then
        for _arg in "${GIT_COMMAND_ARGS[@]}"; do
          case "$_arg" in
            -f|--force|--force=*|--force-with-lease|--force-with-lease=*)
              if [ "$_atomic_create_lease" -eq 1 ] \
                && [ "$_arg" = "--force-with-lease=refs/heads/$BRANCH:" ]; then
                continue
              fi
              _danger_block \
                "immutable writer branch '$BRANCH' cannot force-push history" \
                "Publish additive commits only."
              ;;
          esac
        done
      fi
      ;;
  esac
fi

# T1-07 compatibility: legacy shared branches still block ordinary rebase.
if [ "$GIT_COMMAND" = "rebase" ] && { [ "${#GIT_COMMAND_ARGS[@]}" -ne 1 ] || [ "${GIT_COMMAND_ARGS[0]:-}" != "--abort" ]; }; then
  if [ -n "$BRANCH" ] && ! printf '%s' "$BRANCH" | grep -qE '^work/|^pr/'; then
    _danger_block \
      "rebase on shared branch '$BRANCH' blocked" \
      "把工作挪到 work/* 或 pr/* 分支."
  fi
fi

# 非危险操作 → 透传但警告 (swarm-git 缺失, D4 escape 收口降级)
echo "[git-shim] ⚠️ swarm-git 缺失, 非危险操作透传 (T1-04 fail-closed: 危险操作已拦截)" >&2
exec "$REAL_GIT" "$@"
