#!/usr/bin/env bash
# git-shim (BET-Y1Q1-T1-07) — agent PATH 前置 shim: git → swarm-git 强制收口
#
# circuit_breaker: AGENT_ID 空 → 透传 real git (人类终端无此 env, 不受影响)
#                  AGENT_ID 非空 → swarm-git (拦 --no-verify + 高危 clean/reset/stash/rebase)
#
# 安装 (T1-07 阶段5): ~/agents/shim/bin/git → symlink 本文件; ~/.claude/settings.json::env
#   前置 PATH + 注入 AGENT_ID. 详见 docs/plans/AGENT-BRIEF.md §3 + plan BET-Y1Q1-T1-07.
#
# 为什么不直接 alias git=swarm-git: alias 不覆盖脚本/cron/子进程里裸 `git`; PATH shim
# 才能强制收口所有 agent 通道 (G-CONV.7 D4 fail-closed on supported agent path).

set -euo pipefail

# circuit_breaker: 人类透传
if [ -z "${AGENT_ID:-}" ]; then
  exec /usr/bin/git "$@"
fi

# 非 git 仓 (swarm-git 也透传, 但这里早退省一次调用)
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT:-}" ]; then
  exec /usr/bin/git "$@"
fi

# agent 通道 → swarm-git
SWARM_GIT="$ROOT/bin/gac/swarm-git"
if [ -x "$SWARM_GIT" ]; then
  exec "$SWARM_GIT" "$@"
fi

# swarm-git 缺失 (老 checkout / 子集 clone): 透传但警告 (勿静默绕过 D4)
echo "[git-shim] ⚠️ $SWARM_GIT 缺失, 透传 real git (D4 escape 收口失效)" >&2
exec /usr/bin/git "$@"
