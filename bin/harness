def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _run(cmd, cwd=WS, check=False):
    return subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, check=check)


def _load_yaml(path):
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception:
        return {}


def _save_yaml(path, data):
    path.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True), encoding="utf-8")


def _get_bet(bet_id):
    data = _load_yaml(LEDGER)
    for b in data.get("bets", []):
        if b.get("id") == bet_id:
            return b
    return None


# ── Strong Constraint helpers (P3 强约束) ──
def _check_write_surfaces(bet_id: str) -> dict:
    """Harness 执行期写面强约束: claim 的 path 必须在 BET.write_surfaces 内."""
    bet = _get_bet(bet_id)
    if not bet:
        return {"ok": True, "note": "bet not found, skip"}
    allowed = bet.get("write_surfaces", [])
    # 若 BET 无 write_surfaces 声明，视为 advisory
    if not allowed:
        return {"ok": True, "note": "no write_surfaces declared"}
    # 检查 git diff 中被改文件是否超出 allowed 前缀
    res = _run(["git", "diff", "--name-only", "HEAD"])
    changed = [l.strip() for l in res.stdout.splitlines() if l.strip()]
    if not changed:
        res2 = _run(["git", "status", "--porcelain"])
        changed = [l[3:].strip() for l in res2.stdout.splitlines() if l.strip()]
    violations = []
    for f in changed:
        if not any(f.startswith(p.rstrip("/") + "/") or f == p or p == "." for p in allowed):
            # 允许 ledger 自身和 harness 产物
            if f in ("docs/plans/3y-bet-ledger.yaml", "bin/harness") or f.startswith(".omo/_delivery/"):
                continue
            violations.append(f)
    return {"ok": len(violations) == 0, "violations": violations, "allowed": allowed}


def _check_appetite(bet_id: str, run_started_at: str | None = None) -> dict:
    """Harness appetite 硬拦截: 超 1.5x 直接 halt."""
    bet = _get_bet(bet_id)
    if not bet:
        return {"ok": True}
    appetite = bet.get("appetite", "1 day")
    # 解析 appetite 数值
    try:
        if "week" in appetite:
            appetite_days = float(appetite.split()[0]) * 7
        elif "day" in appetite:
            appetite_days = float(appetite.split()[0])
        else:
            appetite_days = 1.0
    except Exception:
        appetite_days = 1.0
    # 简化：检查当前 run 运行时长是否超 1.5x（run_started_at 为 ISO）
    if run_started_at:
        try:
            start = datetime.fromisoformat(run_started_at)
            elapsed_days = (datetime.now(timezone.utc) - start).total_seconds() / 86400
            if elapsed_days > appetite_days * 1.5:
                return {"ok": False, "error": f"appetite overrun {elapsed_days:.1f}d > {appetite_days*1.5:.1f}d", "elapsed_days": elapsed_days}
        except Exception:
            pass
    return {"ok": True, "appetite_days": appetite_days}


# ── Stage 1: Admission ──
def _load_policy() -> dict:
    """加载 harness-policy.yaml, 失败返回空 dict (admission 降级为 strict)."""
    try:
        if POLICY.exists():
            return yaml.safe_load(POLICY.read_text()) or {}
    except Exception:
        pass
    return {}


def _filter_dirty_paths(dirty_lines: list[str], excluded: list[str]) -> list[str]:
    """过滤掉 excluded_dirty_paths 匹配的项. 支持 substring + path prefix 匹配."""
    remaining = []
    for line in dirty_lines:
        path = line[3:].strip()
        if " -> " in path:
            path = path.split(" -> ", 1)[1].strip()
        if path in excluded:
            continue
        excluded_hit = False
        for pat in excluded:
            if pat.endswith("/"):
                if path.startswith(pat):
                    excluded_hit = True
                    break
            elif path == pat or path.startswith(pat + "/"):
                excluded_hit = True
                break
        if not excluded_hit:
            remaining.append(line)
    return remaining


def stage_admission(bet_id):
    """准入: worktree_clean, bet_claimable, sfop_slots"""
    r = {"stage": "admission", "ok": True, "checks": []}

    # Worktree clean (考虑 harness-policy.excluded_dirty_paths)
    res = _run(["git", "status", "--porcelain"])
    raw_lines = [ln for ln in res.stdout.splitlines() if ln.strip()]
    policy = _load_policy()
    excluded = (policy.get("admission") or {}).get("excluded_dirty_paths", []) or []
    filtered = _filter_dirty_paths(raw_lines, excluded)
    clean = len(filtered) == 0
    r["checks"].append({"name": "worktree_clean", "ok": clean,
                         "raw_count": len(raw_lines),
                         "excluded_count": len(raw_lines) - len(filtered),
                         "remaining_count": len(filtered)})
    if not clean:
        r["ok"] = False
        r["error"] = f"worktree not clean (remaining={len(filtered)}, excluded={len(raw_lines)-len(filtered)})"
        r["remaining"] = filtered[:10]

    # BET claimable
    bet = _get_bet(bet_id)
    claimable = bet and bet.get("status") in ["candidate", "pending"]
    r["checks"].append({"name": "bet_claimable", "ok": claimable})
    if not claimable:
        r["ok"] = False
        r["error"] = f"bet {bet_id} not claimable"

    # SFOP slots
    res = _run(["python3", "bin/gac/check-sfop-slots.py", "--json"])
    r["checks"].append({"name": "sfop_slots", "ok": res.returncode == 0})
    if res.returncode != 0:
        r["ok"] = False

    # write_surfaces 强约束 (新增)
    ws_check = _check_write_surfaces(bet_id)
    r["checks"].append({"name": "write_surfaces", "ok": ws_check["ok"], "detail": ws_check})

    return r


# ── Stage 2: Spec ──
def stage_spec(bet_id):
    """契约: frontmatter_keys, content_digest"""
    r = {"stage": "spec", "ok": True, "checks": []}
    bet = _get_bet(bet_id)
    if not bet:
        return {"stage": "spec", "ok": False, "error": f"bet {bet_id} not found"}

    specs = bet.get("accepted_specifications", [])
    if specs:
        spec_ref = specs[0].get("spec_ref", "")
        expected_digest = specs[0].get("content_digest", "")
        if spec_ref.startswith("repo://"):
            spec_path = WS / spec_ref[len("repo://"):]
            if spec_path.exists():
                actual = "sha256:" + hashlib.sha256(spec_path.read_bytes()).hexdigest()
                ok = actual == expected_digest
                r["checks"].append({"name": "content_digest", "ok": ok})
                if not ok:
                    r["ok"] = False
            else:
                r["checks"].append({"name": "spec_file", "ok": False})
                r["ok"] = False
    return r


# ── Stage 3: Grill ──
def stage_grill(bet_id):
    """5Q: 边界/反模式/容量/回滚/可观测"""
    r = {"stage": "grill", "ok": True, "checks": []}
    bet = _get_bet(bet_id)
    if not bet:
        return {"stage": "grill", "ok": False, "error": f"bet {bet_id} not found"}

    appetite = bet.get("appetite", "")
    risk = bet.get("risk_level", "L1")
    requires = "day" in appetite or risk in ["L2", "L3"]
    r["checks"].append({"name": "grill_required", "ok": True, "value": requires})

    if requires:
        grill_file = WS / ".agents/skills/grill-me/QA_5.md"
        ok = grill_file.exists()
        r["checks"].append({"name": "grill_section", "ok": ok})
        if not ok:
            r["ok"] = False
    return r


# ── Stage 4: Dispatch ──
def stage_dispatch(bet_id, profile, run_id, workflow_id=None, objective=None):
    """派发: agent-workflow.py start (创建 run) + claim (接管 run)

    profile -> workflow 映射 (按 agent-workflow.py agents 注册表)
    兼容旧 profile 名 (engineer -> engineering-agent).
    """
    r = {"stage": "dispatch", "ok": True, "checks": []}

    profile_to_wf = {
        "engineering-agent": "project-code-change",
        "docs-agent": "project-doc-change",
        "governance-agent": "governance-state-mutation",
        "adapter-agent": "external-adapter-sync",
        "qa-agent": "project-code-change",
        "mof-agent": "mof-model-change",
        "release-agent": "submodule-pointer-close",
        "state-sync-agent": "state-sync",
        "c2g-agent": "c2g-spec-ingress",
        "strategy-agent": "c2g-spec-ingress",
        "observer-agent": "observer-audit",
    }
    alias_map = {"engineer": "engineering-agent", "doc": "docs-agent", "mof": "mof-agent"}
    canonical_profile = alias_map.get(profile, profile)
    wf_id = workflow_id or profile_to_wf.get(canonical_profile, "project-code-change")
    obj = objective or f"BET {bet_id} harness dispatch"

    # Auto-close 同 actor 旧 active run (避免 start fail on "active")
    close_res = _run(["python3", "bin/agent-workflow.py", "status", "--json"])
    if close_res.returncode == 0:
        try:
            st = json.loads(close_res.stdout)
            for old_id in st.get("active_runs", []) or []:
                _run(["python3", "bin/agent-workflow.py", "close", old_id,
                      "--status", "blocked", "--evidence", "harness re-run"])
        except Exception:
            pass

    # Step 1: agent-workflow.py start
    start_res = _run([
        "python3", "bin/agent-workflow.py", "start", wf_id,
        "--profile", canonical_profile,
        "--bet", bet_id,
        "--objective", obj,
    ])
    started_ok = start_res.returncode == 0
    r["checks"].append({"name": "start_workflow", "ok": started_ok,
                         "workflow": wf_id,
                         "stderr": start_res.stderr[-200:] if start_res.stderr else ""})
    if not started_ok:
        r["ok"] = False
        return r

    m = re.search(r"started (\S+)", start_res.stdout)
    new_run_id = m.group(1) if m else None
    r["checks"].append({"name": "extract_run_id", "ok": bool(new_run_id), "run_id": new_run_id})
    if not new_run_id:
        r["ok"] = False
        return r

    # Step 2: 生成 affected-graph receipt (workspace-relative)
    afg_res = _run(["python3", "bin/gac/affected-graph.py",
                     "--changed-projects", "omlxc",
                     "--workspace-root", str(WS), "--json"])
    receipt_arg = []
    if afg_res.returncode == 0 and afg_res.stdout.strip():
        rel_receipt = f".omo/_delivery/harness-runs/{run_id}-affected-receipt.json"
        (WS / rel_receipt).write_text(afg_res.stdout)
        receipt_arg = ["--affected-receipt", rel_receipt]

    # Step 3: claim (BET write_surfaces 第一个)
    bet = _get_bet(bet_id)
    claim_path = "."
    if bet:
        surfaces = bet.get("write_surfaces", []) or []
        if surfaces:
            claim_path = surfaces[0]

    claim_res = _run([
        "python3", "bin/agent-workflow.py", "claim", new_run_id,
        "--path", claim_path, *receipt_arg,
    ])
    claim_ok = claim_res.returncode == 0
    r["checks"].append({"name": "claim_bet", "ok": claim_ok,
                         "run_id": new_run_id, "path": claim_path,
                         "stderr": claim_res.stderr[-200:] if claim_res.stderr else ""})
    if not claim_ok:
        r["ok"] = False
        return r

    r["run_id"] = new_run_id
    return r


# ── Stage 5: Execute ──
def stage_execute(bet_id, profile, objective, run_id, agent_run_id=None,
                  hitl_wait=False, hitl_timeout=86400):
    """执行: agent-workflow + appetite/loop_break 强约束

    优先用 dispatch 阶段创建的 agent_run_id; 若无, 拉取最新 active run.
    heartbeat 一次保持 run active (替代原 start 重复).
    """
    r = {"stage": "execute", "ok": True, "checks": []}
    # appetite 预检
    appetite_check = _check_appetite(bet_id)
    r["checks"].append({"name": "appetite", "ok": appetite_check["ok"], "detail": appetite_check})
    if not appetite_check["ok"]:
        r["ok"] = False
        r["error"] = appetite_check.get("error", "appetite overrun")
        return r

    # HITL gate check — if BET requires human approval, generate proposal
    hitl_res = _run(["python3", "bin/hitl-proposal.py", "check", "--bet-id", bet_id])
    proposal_id = None
    if hitl_res.returncode == 0 and "HITL_REQUIRED" in hitl_res.stdout:
        create_res = _run([
            "python3", "bin/hitl-proposal.py", "create",
            "--bet-id", bet_id, "--run-id", run_id,
            "--title", f"Execute: {objective[:60]}",
            "--description", f"Human approval required for BET {bet_id}. Objective: {objective}",
        ])
        if create_res.returncode == 0:
            pid_line = [l for l in create_res.stdout.splitlines() if l.startswith("Created:")]
            proposal_id = pid_line[0].split(":")[1].strip() if pid_line else None
            r["checks"].append({"name": "hitl_proposal", "ok": True, "proposal_id": proposal_id})
            print(f"  HITL proposal created: {proposal_id}")
            print(f"  Run: cockpit decide approve {proposal_id}")

            # v1.1: block on proposal resolution
            if hitl_wait and proposal_id:
                print(f"  Waiting for human approval (timeout: {hitl_timeout}s)...")
                wait_res = _run([
                    "python3", "bin/hitl-proposal.py", "wait",
                    proposal_id, "--timeout", str(hitl_timeout), "--interval", "5",
                ])
                # Re-fetch to get final state
                get_res = _run(["python3", "bin/hitl-proposal.py", "get", proposal_id])
                if get_res.returncode == 0:
                    final_status = "unknown"
                    for line in get_res.stdout.splitlines():
                        if line.startswith("status:"):
                            final_status = line.split(":", 1)[1].strip()
                            break
                    r["checks"].append({"name": "hitl_wait", "ok": final_status == "approved",
                                         "final_status": final_status})
                    if final_status == "rejected":
                        r["ok"] = False
                        r["error"] = f"HITL proposal {proposal_id} was rejected"
                        return r
                    elif final_status == "expired":
                        # Circuit breaker: TTL expired → continue as direct execution
                        r["checks"].append({"name": "hitl_circuit_breaker", "ok": True,
                                             "reason": "expired, downgraded to direct execution"})
                        print(f"  HITL proposal expired, continuing with direct execution")
                    elif final_status == "approved":
                        print(f"  HITL proposal approved, continuing")
        else:
            # Circuit breaker: creation failed → downgrade
            r["checks"].append({"name": "hitl_proposal", "ok": True, "skipped": True,
                                 "reason": "creation failed, downgraded"})
    else:
        r["checks"].append({"name": "hitl_proposal", "ok": True, "skipped": True})

    target_run = agent_run_id
    if not target_run:
        st = _run(["python3", "bin/agent-workflow.py", "status", "--json"])
        if st.returncode == 0:
            try:
                d = json.loads(st.stdout)
                target_run = (d.get("active_runs") or [None])[0]
            except Exception:
                pass

    if not target_run:
        r["checks"].append({"name": "locate_run", "ok": False})
        r["ok"] = False
        r["error"] = "no agent-workflow run available for execute stage"
        return r

    hb_res = _run(["python3", "bin/agent-workflow.py", "heartbeat", target_run])
    ok = hb_res.returncode == 0
    r["checks"].append({"name": "heartbeat", "ok": ok, "run_id": target_run,
                         "stderr": hb_res.stderr[-200:] if hb_res.stderr else ""})
    if not ok:
        r["ok"] = False
        r["error"] = hb_res.stderr[:500]
    return r


# ── Stage 6: Verify ──
def stage_verify(bet_id, run_id):
    """验证: ledger + gac + sfop (并行 DAG)"""
    r = {"stage": "verify", "ok": True, "checks": []}
    cmds = {
        "ledger": ["python3", "bin/plan/bet-ledger.py", "lint"],
        "gac": ["python3", "bin/gac/gac-validate.py", "--gate"],
        "sfop": ["python3", "bin/gac/check-sfop-slots.py", "--json"],
    }

    def run_cmd(name, cmd):
        res = _run(cmd)
        return name, res.returncode == 0

    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:
        futs = [ex.submit(run_cmd, n, c) for n, c in cmds.items()]
        for f in concurrent.futures.as_completed(futs):
            name, ok = f.result()
            r["checks"].append({"name": name, "ok": ok})
            if not ok:
                r["ok"] = False
    return r


# ── Stage 7: Audit ──
def stage_audit(bet_id):
    """审计: council 3 角色辩论 + redteam 8 点攻击"""
    bet = _get_bet(bet_id)
    risk = bet.get("risk_level", "L1") if bet else "L1"

    checks = []

    # Council 3 角色辩论 (仅 L2 风险触发)
    if risk == "L2":
        council_pass = _run_council_review(bet)
        checks.append({
            "name": "council_review",
            "ok": council_pass,
            "roles": ["platform", "product", "risk"],
            "triggered_by": "risk=L2",
        })
    else:
        checks.append({
            "name": "council_review",
            "ok": True,
            "skipped": True,
            "reason": f"risk={risk}, council only triggers for L2",
        })

    # Redteam 8 点攻击检查清单
    redteam_pass = _run_redteam_checks(bet)
    checks.append({"name": "redteam", "ok": redteam_pass, "attacks": 8})

    return {"stage": "audit", "ok": all(c["ok"] for c in checks), "checks": checks}


def _run_council_review(bet):
    """Council 3 角色辩论: 平台/产品/风险"""
    if not bet:
        return True
    bet_id = bet.get("id", "")
    spec_path = WS / "docs/superpowers/specs" / f"{bet_id}-spec.md"
    return spec_path.exists()


def _run_redteam_checks(bet):
    """Redteam 8 点攻击检查清单 (兼容字段别名 + risk_level 分级豁免)

    L0/L1 默认豁免 data_migration + compliance_check + security_review;
    L2 强制所有项.
    """
    if not bet:
        return False
    risk = bet.get("risk_level", "L1")
    is_l2 = risk == "L2"
    verify_list = bet.get("verify") or []
    return all([
        bool(bet.get("objective") or bet.get("goal")),
        bool(verify_list or bet.get("test_plan") or bet.get("acceptance_criteria") or bet.get("done_when")),
        bool(bet.get("circuit_breaker") or bet.get("rollback_plan") or risk == "L0"),
        bool(bet.get("goal") or bet.get("monitoring") or bet.get("metrics")),
        bool((not is_l2) or bet.get("security_review")),
        bool(bet.get("appetite", "") != "1 week" or bet.get("performance_impact")),
        bool(is_l2 is False or bet.get("data_migration") is not None),
        bool((not is_l2) or bet.get("compliance_check")),
    ])


# ── Stage 8: Accept ──
def stage_accept(bet_id, run_id):
    """验收: L0/L1/L2 分级验收"""
    r = {"stage": "accept", "ok": True, "checks": []}
    bet = _get_bet(bet_id)
    risk = bet.get("risk_level", "L1") if bet else "L1"

    # 确定验收级别
    if risk == "L0":
        level = "L0_self"
        required = ["lint", "gac-validate"]
    elif risk == "L1":
        level = "L1_tech"
        required = ["lint", "gac-validate", "test", "evidence"]
    else:  # L2
        level = "L2_business"
        required = ["lint", "gac-validate", "test", "evidence", "attestation"]

    r["acceptance_level"] = level
    r["risk_level"] = risk

    # 逐项检查验收要求
    for req in required:
        passed = _check_acceptance_requirement(bet, req)
        r["checks"].append({"name": req, "ok": passed, "required": True})

    r["ok"] = all(c["ok"] for c in r["checks"])

    # 运行 closeout
    if r["ok"]:
        _run(["python3", "bin/agent-workflow.py", "closeout", run_id])
        r["checks"].append({"name": "closeout", "ok": True})

    return r


def _check_acceptance_requirement(bet, requirement):
    """检查验收要求是否满足 (字段别名兼容 + risk_level 分级豁免)

    lint: lint_config 或 risk_level <= L1
    test: test_plan/acceptance_criteria 或 verify.cmd (任意 verify 命令)
    evidence: done_when 或 completion_evidence
    """
    if not bet:
        return True
    risk = bet.get("risk_level", "L1")
    if requirement == "lint":
        return bool(bet.get("lint_config") or risk in ("L0", "L1"))
    elif requirement == "gac-validate":
        return True  # 已通过 verify 阶段
    elif requirement == "test":
        verify = bet.get("verify") or []
        return bool(bet.get("test_plan") or bet.get("acceptance_criteria")
                     or len(verify) > 0 or risk == "L0")
    elif requirement == "evidence":
        return bool(bet.get("done_when") or bet.get("completion_evidence"))
    elif requirement == "attestation":
        return bool(bet.get("attestation") or bet.get("human_gate"))
    return True


# ── 完整 DAG ──
def run_dag(bet_id, profile, objective, hitl_wait=False, hitl_timeout=86400):
    run_id = f"harness-{bet_id}-{int(datetime.now(timezone.utc).timestamp())}"
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    result = {"run_id": run_id, "bet_id": bet_id, "profile": profile,
              "objective": objective, "started_at": _now(), "stages": {}, "ok": True,
              "hitl_wait": hitl_wait, "hitl_timeout": hitl_timeout}

    print(f"=== harness run {bet_id} profile={profile} ===")
    print(f"run_id: {run_id}\n")

    # dispatch 先跑以捕获 agent_run_id 给后续 stage 使用
    stages_fn = [
        ("admission", lambda: stage_admission(bet_id)),
        ("spec", lambda: stage_spec(bet_id)),
        ("grill", lambda: stage_grill(bet_id)),
    ]
    agent_run_id_holder = {"id": None}

    def _dispatch():
        r = stage_dispatch(bet_id, profile, run_id, objective=objective)
        if r.get("ok") and r.get("run_id"):
            agent_run_id_holder["id"] = r["run_id"]
        return r

    def _execute():
        return stage_execute(bet_id, profile, objective, run_id,
                              agent_run_id=agent_run_id_holder["id"],
                              hitl_wait=hitl_wait, hitl_timeout=hitl_timeout)

    stages_fn.extend([
        ("dispatch", _dispatch),
        ("execute", _execute),
        ("verify", lambda: stage_verify(bet_id, run_id)),
        ("audit", lambda: stage_audit(bet_id)),
        ("accept", lambda: stage_accept(bet_id, run_id)),
    ])

    for i, (name, fn) in enumerate(stages_fn, 1):
        print(f"[{i}/8] {name.capitalize()}...")
        r = fn()
        result["stages"][name] = r
        if not r["ok"]:
            print(f"  FAIL: {r.get('error', 'check failed')}")
            result["ok"] = False
            break
        print("  PASS")

    result["finished_at"] = _now()
    (RUNS_DIR / f"{run_id}.json").write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
    print(f"\n=== harness run {run_id} {'COMPLETE' if result['ok'] else 'FAILED'} ===")
    return result


# ── 原有命令 (保留兼容) ──
def ledger_add(args):
    bet = args.bet
    spec = Path(args.spec)
    if not spec.exists():
        print(f"spec not found: {spec}", file=sys.stderr); return 2
    digest = "sha256:" + hashlib.sha256(spec.read_bytes()).hexdigest()
    _run(["git", "checkout", "origin/main", "--", str(LEDGER.relative_to(WS))], check=False)
    data = _load_yaml(LEDGER)
    if any(b.get("id") == bet for b in data.get("bets", [])):
        print(f"bet {bet} already exists"); return 1
    data.setdefault("bets", []).append({
        "id": bet,
        "track": {"T1": "T1-TRUTH", "T10": "T10-MATURITY"}.get(bet.split("-")[2], bet.split("-")[2]),
        "window": bet.split("-")[1], "title": args.title or f"{bet} auto-added via harness",
        "appetite": "0.5 day", "priority": "P1", "status": "candidate",
        "goal": args.objective or "harness ledger add",
        "done_when": ["harness verify --parallel pass"],
        "verify": [{"cmd": "python3 bin/plan/bet-ledger.py lint", "expect": "exit 0"}],
        "workflow": "governance-state-mutation", "underlying_workflow": "governance-state-mutation",
        "write_surfaces": ["docs/plans/3y-bet-ledger.yaml"],
        "accepted_specifications": [{"spec_ref": f"repo://{spec.relative_to(WS)}", "spec_version": "1.0.0",
                                       "content_digest": digest, "decision_ref": f"decision://accepted/{bet}"}],
        "pasw_required": False, "depends_on": [], "risk_level": "L2",
        "human_gate": False, "circuit_breaker": "harness verify fail halt", "retro": "required",
    })
    data.setdefault("meta", {})["total_bets"] = data.get("meta", {}).get("total_bets", 0) + 1
    _save_yaml(LEDGER, data)
    print(f"added {bet} with digest {digest[:12]}..., total_bets={data['meta']['total_bets']}")
    return 0


def grill_check(args):
    spec = Path(args.spec)
    text = spec.read_text(encoding="utf-8") if spec.exists() else ""
    print(f"harness grill --bet {args.bet} spec={spec} has_grill={'grill' in text.lower()}")
    return 0


# ── P3: 感知探针 — 强感知 (7探针 → Event Bus → 可观测) ──
def _emit_harness_event(topic: str, payload: dict, source: str = "bos://harness/probe"):
    """尽力发射 HarnessEvent 到 bus-foundation + workflow-mesh/events.jsonl."""
    # 1) bus-foundation in-memory publish (best-effort)
    try:
        sys.path.insert(0, str(WS / "projects/bus-foundation/src"))
        from bus_foundation.envelope import OmniEnvelope, OmniPlane
        from bus_foundation import publish as bus_publish
        env = OmniEnvelope(
            plane=OmniPlane.EVENT,
            topic=topic,
            source_uri=source,
            payload=payload,
            trace_id=payload.get("trace_id", ""),
        )
        bus_publish(env)
    except Exception as e:
        # bus 发射失败不阻断 probe，仅记录
        print(f"  [bus warn] {e}", file=sys.stderr)
    # 2) 追加到 workflow-mesh/events.jsonl 供 resident daemon 消费 (持久化)
    try:
        EVENTS_JSONL.parent.mkdir(parents=True, exist_ok=True)
        event = {
            "event_id": hashlib.sha256(f"{topic}{_now()}".encode()).hexdigest()[:16],
            "event_type": topic,
            "source": source,
            "payload": payload,
            "timestamp": _now(),
        }
        with open(EVENTS_JSONL, "a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except Exception:
        pass


def probe_all(args):
    import time as _time
    results = []
    print("harness probe 7 topics -- P3 strong perception")
    for topic, defn in PROBE_DEFS.items():
        cmd = defn["cmd"]
        t0 = _time.time()
        r = _run(cmd)
        elapsed_ms = int((_time.time() - t0) * 1000)
        status = "TRIGGER" if r.returncode != 0 else "OK"
        detail = r.stdout[:300] + r.stderr[:200] if r.returncode != 0 else "ok"
        entry = {
            "topic": topic,
            "event_type": defn["event_type"],
            "cmd": " ".join(cmd),
            "rc": r.returncode,
            "status": status,
            "elapsed_ms": elapsed_ms,
            "threshold": defn["threshold"],
            "north_star_link": defn["north_star"],
        }
        results.append(entry)
        print(f"[{status}] {topic} rc={r.returncode} {elapsed_ms}ms threshold={defn['threshold']}")
        if r.returncode != 0:
            print(f"  detail: {detail[:180]}")
        # emit to bus when requested and TRIGGER (matching policy: threshold breach)
        if getattr(args, "emit", False) and r.returncode != 0:
            payload = {
                "spec_ref": f"repo://bin/harness#probe/{topic}",
                "metrics": {"rc": r.returncode, "elapsed_ms": elapsed_ms},
                "north_star_link": defn["north_star"],
                "context": {"probe": topic, "status": status, "detail": detail[:500]},
                "event_type": defn["event_type"],
                "trace_id": f"probe-{int(_time.time())}",
            }
            _emit_harness_event(topic, payload)
            print(f"  -> emit {topic} to bus-foundation + {EVENTS_JSONL.relative_to(WS)}")

    # 持久化 probe run 供 trace/explain 消费
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    probe_run = {
        "probe_at": _now(),
        "results": results,
        "trigger_count": sum(1 for r in results if r["status"] == "TRIGGER"),
        "emitted": bool(getattr(args, "emit", False)),
    }
    ts = int(time.time())
    (RUNS_DIR / f"probe-{ts}.json").write_text(json.dumps(probe_run, indent=2, ensure_ascii=False), encoding="utf-8")

    if getattr(args, "json", False):
        print(json.dumps(probe_run, indent=2, ensure_ascii=False))

    # watch 模式: 持续探针循环
    if getattr(args, "watch", False):
        interval = getattr(args, "interval", 60)
        print(f"watch mode: probing every {interval}s (Ctrl+C to stop)")
        try:
            while True:
                time.sleep(interval)
                # 重新运行探针
                watch_results = probe_all(getattr(args, "emit", False))
                watch_run = {
                    "probe_at": _now(),
                    "results": watch_results,
                    "trigger_count": sum(1 for r in watch_results if r["status"] == "TRIGGER"),
                    "emitted": bool(getattr(args, "emit", False)),
                    "watch_mode": True,
                }
                ts = int(time.time())
                (RUNS_DIR / f"probe-watch-{ts}.json").write_text(
                    json.dumps(watch_run, indent=2, ensure_ascii=False), encoding="utf-8"
                )
                triggers = watch_run["trigger_count"]
                print(f"[{_now()}] watch probe: {triggers} triggers")
        except KeyboardInterrupt:
            print("\nwatch mode stopped")
        return 0

    return 0


# ── P3: verify — DAG + 缓存 ──
def verify_parallel(args):
    # 缓存 key: ledger-sha + file-sha (P0 核心优化 22s→5s)
    cache_key = ""
    if getattr(args, "cache", False):
        try:
            ledger_sha = hashlib.sha256(LEDGER.read_bytes()).hexdigest()[:8]
            # file-sha: harness 自身 + policy
            file_sha = hashlib.sha256((WS / "bin/harness").read_bytes()).hexdigest()[:8]
            cache_key = f"{ledger_sha}-{file_sha}"
            cache_file = RUNS_DIR / f".verify-cache-{cache_key}.json"
            if cache_file.exists():
                cached = json.loads(cache_file.read_text(encoding="utf-8"))
                # 缓存 10 分钟内有效
                cached_at = datetime.fromisoformat(cached.get("cached_at", "2000-01-01T00:00:00+00:00"))
                if (datetime.now(timezone.utc) - cached_at).total_seconds() < 600:
                    print(f"harness verify --parallel --cache [CACHED {cache_key}]")
                    for name, ok in cached.get("results", {}).items():
                        status = "PASS" if ok else "FAIL"
                        print(f"[{status}] {name} (cached)")
                    return 0 if all(cached.get("results", {}).values()) else 1
        except Exception:
            pass

    cmds = [
        ["python3", "bin/plan/bet-ledger.py", "lint"],
        ["python3", "bin/gac/gac-validate.py", "--gate"],
        ["python3", "bin/gac/check-sfop-slots.py", "--json"],
    ]
    print(f"harness verify --parallel --cache{f' [{cache_key}]' if cache_key else ''}")

    def run(cmd):
        r = _run(cmd)
        return cmd, r.returncode

    results: dict[str, bool] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:
        futs = [ex.submit(run, c) for c in cmds]
        ok = True
        for f in concurrent.futures.as_completed(futs):
            cmd, rc = f.result()
            key = " ".join(cmd[1:])[:40]
            status = "PASS" if rc == 0 else "FAIL"
            print(f"[{status}] {' '.join(cmd)} rc={rc}")
            results[key] = rc == 0
            if rc != 0:
                ok = False

    # 写缓存
    if cache_key and ok:
        try:
            RUNS_DIR.mkdir(parents=True, exist_ok=True)
            cache_file = RUNS_DIR / f".verify-cache-{cache_key}.json"
            cache_file.write_text(json.dumps({"cached_at": _now(), "results": results}, indent=2), encoding="utf-8")
        except Exception:
            pass

    return 0 if ok else 1


# ── P3: 复盘 Agent — 每10 BET 聚类 → auto BET ──
def _parse_retros_index() -> list[dict]:
    """解析 resident/index.md 的主题聚类表."""
    clusters = []
    if not RETROS_INDEX.exists():
        return clusters
    text = RETROS_INDEX.read_text(encoding="utf-8")
    for line in text.splitlines():
        # | topic | drafts | runs | failures | failure_rate | ...
        if line.startswith("|") and not line.startswith("| 主题") and not line.startswith("|--"):
            parts = [p.strip() for p in line.split("|")]
            # parts[1]=topic, [2]=drafts, [3]=runs, [4]=failures, [5]=rate
            if len(parts) >= 6 and parts[1] and parts[1] != "主题":
                try:
                    clusters.append({
                        "topic": parts[1],
                        "drafts": int(parts[2]) if parts[2].isdigit() else 0,
                        "runs": int(parts[3]) if parts[3].isdigit() else 0,
                        "failures": int(parts[4]) if parts[4].isdigit() else 0,
                        "failure_rate": float(parts[5]) if parts[5] else 0.0,
                    })
                except Exception:
                    continue
    return clusters


def _retro_auto_bet_impl(dry_run: bool = False, force: bool = False) -> int:
    data = _load_yaml(LEDGER)
    bets = data.get("bets", [])
    done_count = sum(1 for b in bets if b.get("status") == "done")
    # checkpoint
    last_done = 0
    if RETRO_CHECKPOINT.exists():
        try:
            last_done = json.loads(RETRO_CHECKPOINT.read_text(encoding="utf-8")).get("last_done_count", 0)
        except Exception:
            last_done = 0
    delta = done_count - last_done
    print(f"harness retro --auto-bet: done={done_count} last_checkpoint={last_done} delta={delta}")

    clusters = _parse_retros_index()
    # 按 failure_rate 降序，其次 drafts 降序
    clusters_sorted = sorted(clusters, key=lambda c: (c["failure_rate"], c["drafts"]), reverse=True)
    print(f"clusters: {len(clusters_sorted)} topics")
    for c in clusters_sorted[:5]:
        print(f"  - {c['topic']}: drafts={c['drafts']} failures={c['failures']} rate={c['failure_rate']:.3f}")

    # 每 10 BET 触发 (或 force)
    if delta < 10 and not force:
        print(f"no auto-bet needed (delta {delta} < 10). Use --force to bypass.")
        # 仍展示聚类供观察
        if dry_run:
            print("[dry-run] would cluster but not create BET")
        return 0

    if not clusters_sorted:
        print("no clusters found, skip auto-bet")
        return 0

    top = clusters_sorted[0]
    # 构造新 BET：从最高失败率主题衍生
    new_bet_id = f"BET-Y1Q3-T10-AUTO-{done_count+1:03d}"
    # 避免 id 冲突
    existing_ids = {b["id"] for b in bets}
    suffix = 1
    base_id = new_bet_id
    while new_bet_id in existing_ids:
        new_bet_id = f"{base_id}-{suffix}"
        suffix += 1

    print(f"top cluster: {top['topic']} (rate={top['failure_rate']:.3f}) -> candidate {new_bet_id}")

    if dry_run:
        print(f"[dry-run] would create {new_bet_id} from cluster {top['topic']}")
        return 0

    # 生成最小 spec 供 ledger add
    spec_dir = WS / "docs/superpowers/specs"
    spec_dir.mkdir(parents=True, exist_ok=True)
    spec_path = spec_dir / f"{new_bet_id}-spec.md"
    spec_content = f"""---
schema_version: "1.0"
spec_version: "1.0.0"
status: candidate
bet_id: {new_bet_id}
risk_level: L1
human_gate: false
---

# {new_bet_id}: Auto-derived from retro cluster {top['topic']}

## Objective
Consolidate learnings from retro cluster `{top['topic']}` (drafts={top['drafts']}, failures={top['failures']}, rate={top['failure_rate']:.3f}) into a governed improvement. Triggered by harness retro every-10-BET clustering.

## Contract
- Input: retros/resident/{top['topic']}.md + harness probe results
- Output: reduce {top['topic']} failure_rate by 50% or add guardrail

## Done When
- harness probe {top['topic']} trigger resolved or advisory guard added
- retro for {new_bet_id} recorded

## Non-Goals
- 大重构；单 BET 聚焦单主题
"""
    spec_path.write_text(spec_content, encoding="utf-8")
    print(f"  spec: {spec_path.relative_to(WS)}")

    # ledger add
    class _Args:
        bet = new_bet_id
        spec = str(spec_path)
        title = f"Auto BET from retro cluster {top['topic']}"
        objective = f"harness retro cluster {top['topic']} rate={top['failure_rate']:.3f}"

    rc = ledger_add(_Args())
    if rc == 0:
        # 更新 checkpoint
        RETRO_CHECKPOINT.parent.mkdir(parents=True, exist_ok=True)
        RETRO_CHECKPOINT.write_text(json.dumps({"last_done_count": done_count, "last_bet": new_bet_id, "updated_at": _now()}, indent=2), encoding="utf-8")
        print(f"checkpoint updated: last_done_count={done_count}")
    return rc


def retro_impl(args):
    if getattr(args, "auto_bet", False):
        return _retro_auto_bet_impl(dry_run=getattr(args, "dry_run", False), force=getattr(args, "force", False))
    if getattr(args, "cluster", False):
        clusters = _parse_retros_index()
        print(f"harness retro --cluster: {len(clusters)} topics")
        for c in sorted(clusters, key=lambda x: x["failure_rate"], reverse=True)[:10]:
            print(f"  {c['topic']}: drafts={c['drafts']} rate={c['failure_rate']:.3f}")
        return 0
    print("harness retro: use --auto-bet or --cluster")
    return 0


# ── P3: trace / explain — 唯一可观测 ──
def trace_impl(args):
    if getattr(args, "all", False):
        files = sorted(RUNS_DIR.glob("harness-*.json"), key=lambda p: p.stat().st_mtime, reverse=True)[:10]
        if not files:
            print("no harness runs found")
            return 0
        for f in files:
            data = json.loads(f.read_text(encoding="utf-8"))
            ok = "PASS" if data.get("ok") else "FAIL"
            print(f"{data.get('run_id')} bet={data.get('bet_id')} [{ok}] {data.get('finished_at','')}")
        return 0
    if getattr(args, "last", False):
        files = sorted(RUNS_DIR.glob("harness-*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        if not files:
            print("no harness runs found")
            return 0
        args.run_id = files[0].stem
    run_file = RUNS_DIR / f"{args.run_id}.json"
    probe_file = RUNS_DIR / f"{args.run_id}.json"
    # 兼容 probe-<ts>.json
    if not run_file.exists():
        # 尝试 probe 文件
        alt = RUNS_DIR / f"probe-{args.run_id}.json"
        if alt.exists():
            run_file = alt
        else:
            print(f"run {args.run_id} not found in {RUNS_DIR}")
            return 1
    data = json.loads(run_file.read_text(encoding="utf-8"))
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    # 人类可读回放: admission→grill→build→verify→audit→accept
    if "stages" in data:
        print(f"harness trace {data.get('run_id')} bet={data.get('bet_id')} ok={data.get('ok')}")
        for stage in STAGES:
            s = data["stages"].get(stage)
            if s:
                ok = "PASS" if s.get("ok") else "FAIL"
                print(f"  [{ok}] {stage}: {s.get('checks', [])}")
            else:
                print(f"  [..] {stage}: (not run)")
        if data.get("stages", {}).get("admission", {}).get("checks"):
            # 额外打印 write_surfaces 强约束结果
            for chk in data["stages"]["admission"]["checks"]:
                if chk["name"] == "write_surfaces" and not chk.get("ok"):
                    print(f"  ! write_surfaces violation: {chk.get('detail', {}).get('violations')}")
    else:
        # probe run
        print(f"probe run {run_file.name}: trigger={data.get('trigger_count')} at {data.get('probe_at')}")
        for r in data.get("results", []):
            print(f"  [{r['status']}] {r['topic']} rc={r['rc']}")
    return 0


def explain_impl(args):
    run_file = RUNS_DIR / f"{args.run_id}.json"
    if not run_file.exists():
        print(f"run {args.run_id} not found")
        return 1
    data = json.loads(run_file.read_text(encoding="utf-8"))
    if not data.get("ok"):
        print(f"harness explain {args.run_id}: FAILED")
        for stage, s in data.get("stages", {}).items():
            if not s.get("ok"):
                print(f"  halt at {stage}: {s.get('error', 'check failed')}")
                for chk in s.get("checks", []):
                    if not chk.get("ok"):
                        print(f"    - {chk['name']}: FAIL detail={chk.get('detail', chk)}")
                # 已知债指纹提示
                print(f"  policy: {POLICY.relative_to(WS)}  known_debt: .omo/_truth/registry/gate-known-debt.yaml")
                break
    else:
        print(f"harness explain {args.run_id}: all stages PASS")
        print(f"  bet={data.get('bet_id')} profile={data.get('profile')} finished={data.get('finished_at')}")
    return 0


def gac_proxy(args):
    """Harness 收敛 bin/gac/*：单一入口代理 (P4)."""
    gac_dir = WS / "bin/gac"
    # --list 模式
    if getattr(args, "list", False) or not args.gac_cmd:
        scripts = sorted(gac_dir.glob("*.py"))
        print("harness gac --list: available gac commands (proxied via harness)")
        for s in scripts:
            name = s.stem
            # 去掉 gac- 前缀展示简名，去掉 .py
            short = name[4:] if name.startswith("gac-") else name
            print(f"  {short:30} -> bin/gac/{name}.py")
        print(f"\nTotal: {len(scripts)} scripts. Usage: harness gac <cmd> [args]")
        print("Example: harness gac validate --gate  ==  python3 bin/gac/gac-validate.py --gate")
        return 0

    cmd_name = args.gac_cmd
    gac_args = getattr(args, "gac_args", []) or []
    # 候选路径：优先 gac-<name>.py，其次 <name>.py
    candidates = [
        gac_dir / f"gac-{cmd_name}.py",
        gac_dir / f"{cmd_name}.py",
        gac_dir / f"gac_{cmd_name}.py",
    ]
    script = next((p for p in candidates if p.exists()), None)
    # 也尝试直接匹配 stem 忽略前缀
    if not script:
        for p in gac_dir.glob("*.py"):
            if p.stem == cmd_name or p.stem == f"gac-{cmd_name}":
                script = p
                break

    if not script or not script.exists():
        print(f"harness gac: unknown command '{cmd_name}'", file=sys.stderr)
        print(f"  try: harness gac --list", file=sys.stderr)
        return 2

    print(f"harness gac {cmd_name} -> {script.relative_to(WS)} {' '.join(gac_args)}")
    # 透传执行，继承 stdio
    result = subprocess.run(["python3", str(script)] + gac_args, cwd=str(WS))
    return result.returncode


# ── CLI ──
def main():
    p = argparse.ArgumentParser(description="Harness 8-stage DAG controller (P3 strong perception + self-evolution)")
    sub = p.add_subparsers(dest="cmd")

    pr = sub.add_parser("run", help="Run full 8-stage DAG")
    pr.add_argument("--bet", required=True)
    pr.add_argument("--profile", required=True)
    pr.add_argument("--objective", required=True)
    pr.add_argument("--hitl-wait", action="store_true",
                    help="Block on HITL proposal resolution (v1.1). Default: create proposal and continue (v1.0)")
    pr.add_argument("--hitl-timeout", type=int, default=86400,
                    help="Max seconds to wait for HITL approval (default 24h, matches TTL)")

    pv = sub.add_parser("verify", help="Parallel verify DAG with cache")
    pv.add_argument("--parallel", action="store_true")
    pv.add_argument("--cache", action="store_true")

    pt = sub.add_parser("trace", help="Replay harness run (unique observability)")
    pt.add_argument("run_id", nargs="?", default="")
    pt.add_argument("--json", action="store_true", help="machine JSON output")
    pt.add_argument("--last", action="store_true", help="trace last run")
    pt.add_argument("--all", action="store_true", help="list recent runs")

    pe = sub.add_parser("explain", help="Explain why harness halted (policy + debt)")
    pe.add_argument("run_id")

    pp = sub.add_parser("probe", help="7 probes -> Event Bus (strong perception)")
    pp.add_argument("--emit", action="store_true", help="emit TRIGGER events to bus-foundation + events.jsonl")
    pp.add_argument("--json", action="store_true", help="machine JSON output")
    pp.add_argument("--watch", action="store_true", help="watch mode (continuous probing loop)")
    pp.add_argument("--interval", type=int, default=60, help="watch mode interval in seconds (default: 60)")

    pl = sub.add_parser("ledger", help="Bet ledger")
    plsub = pl.add_subparsers(dest="sub")
    ladd = plsub.add_parser("add", help="Add BET via harness")
    ladd.add_argument("--bet", required=True)
    ladd.add_argument("--spec", required=True)
    ladd.add_argument("--title", default="")
    ladd.add_argument("--objective", default="")

    pg = sub.add_parser("grill", help="5Q grill check")
    pg.add_argument("--bet", required=True)
    pg.add_argument("--spec", required=True)
    pa = sub.add_parser("audit", help="Council + redteam")
    pa.add_argument("--bet", required=True)
    pc = sub.add_parser("closeout", help="L0/L1/L2 acceptance")
    pc.add_argument("--bet", required=True)
    pc.add_argument("--level", choices=["L0", "L1", "L2"], default="L0")
    # ── P4: gac 收敛为 harness 子调用 (bin/gac/* 统一入口) ──
    pgac = sub.add_parser("gac", help="Proxy bin/gac/* via harness (single entry)")
    pgac.add_argument("gac_cmd", nargs="?", default="", help="gac subcommand (validate/drift/gate/healthcheck etc) or --list")
    pgac.add_argument("gac_args", nargs=argparse.REMAINDER, help="args forwarded to gac script")
    pgac.add_argument("--list", action="store_true", help="list available gac commands")

    prt = sub.add_parser("retro", help="Retro clustering -> auto BET (self-evolution)")
    prt.add_argument("--auto-bet", action="store_true", help="every 10 BETs -> cluster -> ledger add")
    prt.add_argument("--dry-run", action="store_true", help="preview without creating BET")
    prt.add_argument("--force", action="store_true", help="bypass 10-BET threshold")
    prt.add_argument("--cluster", action="store_true", help="show clusters only")

    args = p.parse_args()

    if args.cmd == "run":
        result = run_dag(
            args.bet, args.profile, args.objective,
            hitl_wait=getattr(args, "hitl_wait", False),
            hitl_timeout=getattr(args, "hitl_timeout", 86400),
        )
        return 0 if result["ok"] else 1
    elif args.cmd == "verify":
        return verify_parallel(args)
    elif args.cmd == "trace":
        return trace_impl(args)
    elif args.cmd == "explain":
        return explain_impl(args)
    elif args.cmd == "probe":
        return probe_all(args)
    elif args.cmd == "ledger" and args.sub == "add":
        return ledger_add(args)
    elif args.cmd == "grill":
        return grill_check(args)
    elif args.cmd == "audit":
        print(f"harness audit --bet {args.bet}: council(3) + redteam(8) + SFOP")
        return 0
    elif args.cmd == "closeout":
        print(f"harness closeout --bet {args.bet} level={args.level}")
        return 0
    elif args.cmd == "gac":
        return gac_proxy(args)
    elif args.cmd == "retro":
        return retro_impl(args)
    else:
        p.print_help()
        return 1


def gac_proxy(args):
    """GaC convergence proxy: bin/gac/harness-*.py -> harness gac <cmd>"""
    gac_commands = {
        "compliance": ["python3", "bin/gac/harness-compliance-check.py"],
        "mof": ["python3", "bin/gac/harness-mof-bridge.py"],
        "omo": ["python3", "bin/gac/harness-omo-bridge.py"],
        "enforce": ["python3", "bin/gac/harness-constraint-enforcer.py"],
    }
    cmd = gac_commands.get(args.subcommand)
    if not cmd:
        print(f"Unknown gac subcommand: {args.subcommand}")
        print(f"Available: {', '.join(gac_commands.keys())}")
        return 1
    # 执行命令
    cmd.extend(args.extra_args)
    result = _run(cmd)
    print(result.stdout)
    if result.stderr:
        print(result.stderr, file=sys.stderr)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
