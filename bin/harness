#!/usr/bin/env python3
"""
harness — Self-Evolving Harness Controller (8 阶段 DAG, unique S)
SSOT: .omo/_truth/registry/harness-policy.yaml
Usage:
  bin/harness run --bet <BET> --profile <profile> --objective "..."
  bin/harness verify --parallel --cache
  bin/harness trace <run-id> [--json] | --last | --all
  bin/harness explain <run-id>
  bin/harness probe [--emit] [--json] [--watch]
  bin/harness ledger add --bet <BET> --spec <spec>
  bin/harness retro --auto-bet [--dry-run] [--cluster]
  bin/harness grill --bet <BET> --spec <spec>
  bin/harness audit --bet <BET>
  bin/harness closeout --bet <BET> --level L0|L1|L2
P3: 感知 Agent (7探针→Event Bus→Retro闭环) + 复盘 Agent (每10 BET聚类→auto BET)
"""
import argparse, concurrent.futures, hashlib, json, os, re, subprocess, sys, time, yaml
from datetime import datetime, timezone
