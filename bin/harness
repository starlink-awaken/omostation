PROBE_RUNS_DIR = RUNS_DIR
RETROS_INDEX = WS / ".omo/_knowledge/retros/resident/index.md"
RETROS_DIR = WS / ".omo/_knowledge/retros/resident"

STAGES = ["admission", "spec", "grill", "dispatch", "execute", "verify", "audit", "accept"]

# ── 7 探针定义 (harness-policy.yaml §7) ──
