#!/usr/bin/env python3
"""Cockpit CLI root entrypoint (L3 human front-door).

Single unified entrypoint for human operators and AI agents in the workspace.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "bin" / "lib"))
from repo_root import code_root  # noqa: E402

# Self-heal interpreter: if running under generic python without rich, re-exec with cockpit's venv python
# 解释器路径经 code_root() 取 —— 这是**读侧** (用它 import cockpit 包), 跟随当前检出即可。
# 不用 canonical_root(): 那是写机器级配置用的, 在 CI / 临时检出里会因定位不到
# ~/Workspace 而抛错 (本仓 CI 的检出根不是 ~/Workspace)。原先硬编码
# /Users/xiamingxing/Workspace 同样不可取 —— 换个检出根就失效。
_COCKPIT_VENV_PYTHON = code_root() / "projects/cockpit/.venv/bin/python"
# 这段 re-exec 是给「手工跑 bin/cockpit」用的; 在 pytest 下它是地雷 ——
# tests/unit/test_phase8_unified_ecosystem.py:68 在**模块层** runpy.run_path(bin/cockpit),
# 于是收集阶段进程就被 execv 换成 `cockpit .venv/bin/python <pytest argv>`,
# pytest 当场消失 (实测 rc=2 且 stdout/stderr 皆 0 字节), 收集计数与 ERROR 行一起消失,
# 让 check-test-collection.py 的旧口径读成 pass (2026-11-12 实证)。
if (
    _COCKPIT_VENV_PYTHON.is_file()
    and sys.executable != str(_COCKPIT_VENV_PYTHON)
    and "pytest" not in sys.modules
    and not os.environ.get("PYTEST_CURRENT_TEST")
):
    try:
        import rich
    except ImportError:
        os.execv(str(_COCKPIT_VENV_PYTHON), [str(_COCKPIT_VENV_PYTHON)] + sys.argv)

# Ensure cockpit package is discoverable from workspace root
_ROOT = Path(__file__).resolve().parent.parent
_COCKPIT_SRC = _ROOT / "projects" / "cockpit" / "src"
if _COCKPIT_SRC.is_dir() and str(_COCKPIT_SRC) not in sys.path:
    sys.path.insert(0, str(_COCKPIT_SRC))

from cockpit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
