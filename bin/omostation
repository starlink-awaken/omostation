#!/usr/bin/env python3
"""
OMOStation Unified Root CLI Wrapper (ADR-0427 / Phase 8)
========================================================
Single entry point for multi-agent workspace operations, eliminating
PYTHONPATH fragmentation and providing unified command discovery.
"""

from __future__ import annotations

import importlib.util
import json
import sys
from pathlib import Path
from typing import NoReturn

_BIN_DIR = Path(__file__).resolve().parent
_RESOLVER_PATH = _BIN_DIR / "cockpit" / "env-resolver.py"
_spec = importlib.util.spec_from_file_location("env_resolver", _RESOLVER_PATH)
_env_resolver = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_env_resolver)

_ROOT = _env_resolver.setup_workspace_paths()
_RETIRED_BYPASS_COMMANDS = {"daemon", "watchdog", "scenario", "top", "run"}
_REFUSAL_MESSAGE = (
    "Mesh successor is pending; Cockpit PR #78 is retirement evidence only, "
    "never the delivered successor."
)


def _refuse_retired_bypass(command: str) -> NoReturn:
    print(
        json.dumps(
            {
                "ok": False,
                "status": "retired",
                "successor": "Mesh-bound capability admission",
                "successor_status": "pending",
                "retirement_evidence": "Cockpit PR #78",
                "value_indicator_policy": False,
                "command": command,
                "message": _REFUSAL_MESSAGE,
            },
            ensure_ascii=False,
        )
    )
    raise SystemExit(2)


def print_banner():
    print("""
╔══════════════════════════════════════════════════════════════════╗
║  🛰️  OMOStation Unified Cognitive Operating System (v2.8)        ║
╚══════════════════════════════════════════════════════════════════╝
    """)


def print_help():
    print_banner()
    print("""Usage: omostation <command> [options]

Core Commands:
  status        Show real-time multi-agent swarm status & 8D panel
  policy        Execute and explain Policy-as-Code rules (E-POL-*)
  resident      Inspect resident autonomous decisions & knowledge drafts
  distill       Run SEMA memory self-distillation & auto-crystallization
  gate          Execute full Governance-as-Code (GaC) local gate
  daemon/watchdog/scenario/top/run
                Retired; Mesh-bound capability admission is pending.
                Cockpit PR #78 is retirement evidence only, never the delivered successor.
    """)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd in _RETIRED_BYPASS_COMMANDS:
        _refuse_retired_bypass(cmd)

    if cmd == "status":
        from cockpit.tui.swarm_cli import main as status_main
        sys.argv = ["omostation-status"] + args
        status_main()
    elif cmd == "policy":
        from ecos.cli.constraint import main as constraint_main
        sys.exit(constraint_main(["policy"] + args))
    elif cmd == "resident":
        from omo.resident.decision import main as resident_main
        sys.argv = ["omo-resident"] + args
        resident_main()
    elif cmd == "distill":
        import runpy
        sys.argv = ["sema-distill"] + args
        runpy.run_path(str(_ROOT / "bin" / "ssot" / "sema-distill.py"), run_name="__main__")
    elif cmd == "gate":
        import subprocess
        subprocess.run(["make", "gac-local-gate"], cwd=_ROOT)
    else:
        print(f"Unknown command: '{cmd}'. Run 'omostation help' for available commands.")
        sys.exit(1)


if __name__ == "__main__":
    main()
