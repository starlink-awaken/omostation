    "Documents/@学习进化/_archive/基建架构-织星系统文档库/织星主权智能操作系统文档库/"
    "40-验收与运营/Agent体系全景总览-2026-09-08.html"
)

log = logging.getLogger("orchestrator")

# Error string the runner emits when it skipped a collector because the host was
# too loaded. Distinct from a timeout so consumers can tell "could not run" from
# "would not run".
DEFERRED_REASON = "Deferred: host load above budget"


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


BASE_KEYS = ("bets", "gates", "runtime", "code_root_health")
BASE_MAX_BYTES = 32 * 1024 * 1024
BASE_MAX_AGE_SECONDS = 300


def _base_digest(data: dict) -> str:
    return hashlib.sha256(json.dumps(
        {key: data.get(key) for key in BASE_KEYS}, ensure_ascii=False,
        sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode()).hexdigest()


def _base_clock(value: str) -> datetime:
    if not isinstance(value, str):
        raise ValueError("panorama_base_clock_invalid")
    clock = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if clock.tzinfo is None or clock.utcoffset() is None:
        raise ValueError("panorama_base_clock_invalid")
    return clock


def _read_panorama_base() -> tuple[dict, bytes, Path]:
    # The explicit runtime profile is required: a unit test or ad-hoc import
    # must not silently read the operator's canonical workspace.
    if not os.environ.get("OMOSTATION_STATE_ROOT"):
        raise ValueError("panorama_base_profile_unavailable")
    from repo_root import state_root
    path = state_root() / "runtime/dashboard/data.json"
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_size > BASE_MAX_BYTES:
            raise ValueError("panorama_base_type_or_budget_invalid")
        raw = stream.read(BASE_MAX_BYTES + 1)
        after = os.fstat(stream.fileno())
    identity = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)
    if (len(raw) > BASE_MAX_BYTES or identity(before) != identity(after)
            or identity(after) != identity(path.stat())):
        raise ValueError("panorama_base_changed_during_read")
    payload = json.loads(raw, parse_constant=lambda value: (_ for _ in ()).throw(ValueError("nonfinite")))
    if (not isinstance(payload, dict) or not isinstance(payload.get("bets"), dict)
            or not isinstance(payload.get("gates"), list)
            or any(not isinstance(gate, dict) or not isinstance(gate.get("id"), str)
                   for gate in payload["gates"])
            or not isinstance(payload.get("runtime"), dict)
            or not isinstance(payload.get("code_root_health"), dict)
            or not isinstance(payload.get("generated_at"), str)):
        raise ValueError("panorama_base_shape_invalid")
    return payload, raw, path


def _unknown_base_gates(data: dict) -> None:
    # The real mesh consumes verdict/status, not gate.live or source metadata.
    # Preserve original diagnostics, but never promote retained PASS to live truth.
    for gate in data.get("gates", []) if isinstance(data.get("gates"), list) else []:
        if not isinstance(gate, dict):
            continue
        gate.setdefault("source_verdict", gate.get("verdict") or gate.get("status"))
        gate["verdict"] = "UNKNOWN"
        if "status" in gate:
            gate.setdefault("source_status", gate["status"])
            gate["status"] = "UNKNOWN"
        gate["live"] = False


def merge_panorama_base(data: dict, previous: dict, attempted_at: str) -> None:
    """Overlay four producer-owned sections; all collector authority stays local."""
    states = data.setdefault("source_states", {})
    prior = (previous.get("source_states") or {}).get("panorama_base") or {}
    bound = False
    try:
        prior_clock = _base_clock(prior["observed_at"])
        bound = (prior_clock <= _base_clock(attempted_at)
                 and prior.get("source_lane") == "CANONICAL_BASE"
                 and isinstance(prior.get("data_sha256"), str)
                 and len(prior["data_sha256"]) == 64
                 and prior.get("base_sha256") == _base_digest(previous))
    except (KeyError, TypeError, ValueError):
        pass
    try:
        payload, raw, path = _read_panorama_base()
        age = (_base_clock(attempted_at) - _base_clock(payload["generated_at"])).total_seconds()
        if age < 0:
            raise ValueError("panorama_base_clock_future")
        # JSON exponent overflow (1e999) is parsed as inf, not parse_constant.
        # Validate the complete owned cohort before changing the retained cache.
        _base_digest(payload)
        for key in BASE_KEYS:
            data[key] = copy.deepcopy(payload[key])
        fresh = age <= BASE_MAX_AGE_SECONDS
        if not fresh:
            _unknown_base_gates(data)
        success = payload["generated_at"] if fresh else prior.get("last_success_at") if bound else None
        states["panorama_base"] = {
            "status": "OK" if fresh else "STALE_PARTIAL", "available": True,
            "source_lane": "CANONICAL_BASE", "source": str(path),
            "observed_at": payload["generated_at"], "last_attempt_at": attempted_at,
            "last_success_at": success, "last_success_status": "KNOWN" if success else "UNKNOWN",
            "data_sha256": hashlib.sha256(raw).hexdigest(),
            "base_sha256": _base_digest(data), "payload_age_seconds": age,
            "error": None if fresh else "panorama_base_payload_stale",
        }
    except Exception as exc:
        _unknown_base_gates(data)
        reason = str(exc) if isinstance(exc, ValueError) and str(exc).startswith("panorama_base_") else type(exc).__name__
        states["panorama_base"] = dict(prior if bound else {},
            status="STALE_UNAVAILABLE" if bound else "UNAVAILABLE", available=False,
            observed_at=prior.get("observed_at") if bound else None,
            last_attempt_at=attempted_at, last_success_at=prior.get("last_success_at") if bound else None,
            error=reason, base_sha256=_base_digest(data))



def _task_digest(tasks: dict) -> str:
    return hashlib.sha256(json.dumps(
        tasks, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode("utf-8")).hexdigest()


def _task_shape(tasks) -> bool:
    """Validate the published task DTO, which deliberately has no schema field."""
    if not isinstance(tasks, dict):
        return False
    if (tasks.get("source_kind") != "declared_state_root"
            or not isinstance(tasks.get("source_root"), str)
            or not Path(tasks["source_root"]).is_absolute()
            or not isinstance(tasks.get("source"), str)):
        return False
    total, open_count = tasks.get("total"), tasks.get("open_count")
    if type(total) is not int or type(open_count) is not int or not 0 <= open_count <= total:
        return False
    for key in ("by_status", "by_bucket"):
        counts = tasks.get(key)
        if (not isinstance(counts, dict) or any(
                not isinstance(name, str) or type(count) is not int or count < 0
                for name, count in counts.items()) or sum(counts.values()) != total):
            return False
    for key in ("open_recent", "recent", "recent_done"):
        rows = tasks.get(key)
        if not isinstance(rows, list) or any(
                not isinstance(row, dict) or not isinstance(row.get("id"), str)
                or not row["id"] or not isinstance(row.get("status"), str)
                or not isinstance(row.get("bucket"), str) for row in rows):
            return False
    return isinstance(tasks.get("duplicates"), list)


def _previous_task_binding(previous: dict) -> bool:
    state = (previous.get("source_states") or {}).get("tasks")
    tasks = previous.get("tasks")
    if not _task_shape(tasks) or not isinstance(state, dict):
        return False
    observed = state.get("observed_at")
    success = state.get("last_success_at")
    try:
        for stamp in (observed, success) if success is not None else (observed,):
            if not isinstance(stamp, str):
                return False
            clock = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
            if clock.tzinfo is None or clock.utcoffset() is None or clock > datetime.now(timezone.utc):
                return False
    except (ValueError, OverflowError):
        return False
    revision_id = state.get("revision_id")
    digest = state.get("data_sha256")
    return (
        state.get("source_lane") == "BOUND_PUBLICATION"
        and isinstance(revision_id, str) and len(revision_id) == 64
        and all(char in "0123456789abcdef" for char in revision_id)
        and isinstance(digest, str) and len(digest) == 64
        and all(char in "0123456789abcdef" for char in digest)
        and state.get("source") == f"projection://{revision_id}/data.json#tasks"
        and state.get("task_sha256") == _task_digest(tasks)
    )


def merge_published_tasks(data: dict, previous: dict, attempted_at: str) -> None:
    """Consume one verified publication; never query a second task queue or seed."""
    states = data.setdefault("source_states", {})
    previous_bound = _previous_task_binding(previous)
    previous_state = (previous.get("source_states") or {}).get("tasks") if previous_bound else {}
    previous_success = previous_state.get("last_success_at")
    try:
        from live_server import bound_payload_freshness
        from refresh import HEALTH_SEMANTICS
        revision = ProjectionRevisionStore(STATE_ROOT).load(require_fresh=True)
        raw = revision.artifact_bodies["data"]
        payload = json.loads(raw)
        tasks = payload.get("tasks") if isinstance(payload, dict) else None
        if not _task_shape(tasks):
            raise ValueError("projection_tasks_invalid")
        # Same 300-second policy as the actual core reader. A renewed manifest
        # lease never renews the original collection timestamp inside raw bytes.
        freshness = bound_payload_freshness(revision)
        if freshness["projection_status"] not in {"BOUND_FRESH", "STALE"}:
            raise ValueError(freshness["projection_error"] or "projection_tasks_clock_invalid")
        fresh = freshness["projection_status"] == "BOUND_FRESH"
        observed = freshness["payload_generated_at"]
        success = observed if fresh else previous_success
        data["tasks"] = copy.deepcopy(tasks)
        states["tasks"] = {
            "status": "OK" if fresh else "STALE_PARTIAL", "available": True,
            "observed_at": observed, "last_attempt_at": attempted_at,
            "last_success_at": success, "last_success_status": "KNOWN" if success else "UNKNOWN",
            "health_semantics": HEALTH_SEMANTICS, "source_lane": "BOUND_PUBLICATION",
            "source": f"projection://{revision.revision_id}/data.json#tasks",
            "source_root": tasks["source_root"], "source_kind": tasks["source_kind"],
            "revision_id": revision.revision_id, "producer_root_oid": revision.producer_root_oid,
            "data_sha256": hashlib.sha256(raw).hexdigest(), "task_sha256": _task_digest(tasks),
            "payload_age_seconds": freshness["payload_age_seconds"],
            "error": freshness["projection_error"],
        }
    except Exception as exc:
        reason = getattr(exc, "public_error", None)
        if reason is None:
            reason = str(exc) if isinstance(exc, ValueError) and str(exc).startswith("projection_") else type(exc).__name__
        if previous_bound:
            data["tasks"] = copy.deepcopy(previous["tasks"])
            states["tasks"] = dict(previous_state, status="STALE_UNAVAILABLE", available=False,
                                   last_attempt_at=attempted_at, error=reason)
        else:
            data.pop("tasks", None)
            states["tasks"] = {"status": "UNAVAILABLE", "available": False,
                               "observed_at": None, "last_attempt_at": attempted_at,
                               "last_success_at": None, "last_success_status": "UNKNOWN", "error": reason}
    # Metadata is separate from the exact DTO. Any old collector/seed envelope
    # must not survive as a competing task source.
    data.setdefault("live_sources", {}).pop("tasks", None)


class RefreshOrchestrator:
    """Orchestrates data collection and page generation."""

    # The refresh job runs every 300s, so a round must fit inside that window.
    # 60s was too tight for ~30 collectors at max_workers=5 under load: later
    # waves inherited almost no budget and reported "Collector deadline
    # exceeded", which cascaded into stale derived sources (strategy-projection).
    DEFAULT_COLLECTION_TIMEOUT = 240.0
    # 2x the logical CPU count on an 18-core host. Above this the collector
    # budgets cannot be met and the sources fail for load reasons, not source
    # reasons; deferring keeps the gates honest instead of painting them red.
    # 1x the logical CPU count. Observed collector timeouts begin around 20-30
    # on this 18-core host, so a 2x budget (36) never engaged before the failure.
    DEFAULT_MAX_LOAD = 18.0

    def __init__(self, registry: CollectorRegistry | None = None, max_workers: int = 5,
                 collection_timeout: float | None = None):
        self.registry = registry or get_registry()
        if collection_timeout is None:
            collection_timeout = self._configured_timeout()
        if max_workers < 1 or not math.isfinite(collection_timeout) or collection_timeout <= 0:
            raise ValueError("collector concurrency and collection timeout must be positive")
        self.max_workers = int(max_workers)
        self.collection_timeout = collection_timeout

    @classmethod
    def _configured_timeout(cls) -> float:
        raw = os.environ.get("ZHIXING_COLLECTION_TIMEOUT")
        if raw is None or not raw.strip():
            return cls.DEFAULT_COLLECTION_TIMEOUT
        try:
            value = float(raw)
        except ValueError:
            raise ValueError("ZHIXING_COLLECTION_TIMEOUT must be a positive number of seconds")
        if not math.isfinite(value) or value <= 0:
            raise ValueError("ZHIXING_COLLECTION_TIMEOUT must be a positive number of seconds")
        return value

    @classmethod
    def _configured_max_load(cls) -> float:
        raw = os.environ.get("ZHIXING_MAX_LOAD")
        if raw is None or not raw.strip():
            return cls.DEFAULT_MAX_LOAD
        try:
            value = float(raw)
        except ValueError:
            raise ValueError("ZHIXING_MAX_LOAD must be a positive number")
        if not math.isfinite(value) or value <= 0:
            raise ValueError("ZHIXING_MAX_LOAD must be a positive number")
        return value

    @classmethod
    def host_overloaded(cls) -> bool:
        """Report whether the host is too loaded to run collectors honestly.

        Under sustained overload the per-collector budgets cannot be met, so the
        sources fail and the cockpit gates go red for reasons that have nothing to
        do with the source itself. Deferring is the honest signal; a timeout is
        not.
        """
        try:
            return os.getloadavg()[0] > cls._configured_max_load()
        except (OSError, AttributeError):  # pragma: no cover - platform without getloadavg
            return False

    def load_previous(self) -> dict:
        """Load previous data from current.json or seed."""
        if CURRENT.exists():
            try:
                return json.loads(CURRENT.read_text(encoding="utf-8"))
            except Exception as exc:
                log.warning("Failed to load current.json: %s", exc)
        if SEED.exists():
            try:
                return json.loads(SEED.read_text(encoding="utf-8")).get("data", {})
            except Exception as exc:
                log.warning("Failed to load seed.json: %s", exc)
        return {}

    def run_collectors(self) -> list[tuple[str, dict | None, str | None]]:
        """Bound actual work, including shutdown, instead of timing done futures.

        The host is POSIX. Each collector owns a process session so a blocked
        Python call or subprocess cannot hold the refresh open. File IPC avoids
        waiting on a pipe inherited by a collector's descendants. Only these
        freshly created sessions are killed, on success as well as timeout.
        """
        collectors = list(self.registry.all())
        results: list[tuple[str, dict | None, str | None]] = []
        if not hasattr(os, "fork") or not hasattr(os, "setsid"):
            return [(c.name, None, "Isolated collector execution unavailable on this platform")
                    for c in collectors]
        deadline = time.monotonic() + self.collection_timeout
        active = {}
        pending = list(enumerate(collectors))
        with tempfile.TemporaryDirectory(prefix="zhixing-collect-") as directory:
            try:
                while pending or active:
                    while pending and len(active) < self.max_workers and time.monotonic() < deadline:
                        index, collector = pending.pop(0)
                        if self.host_overloaded():
                            results.append((collector.name, None, DEFERRED_REASON))
                            continue
                        result_path = Path(directory) / f"{index}.json"
                        try:
                            timeout = float(getattr(collector, "timeout", 48))
                            if not math.isfinite(timeout) or timeout < 0:
                                raise ValueError("invalid collector timeout")
                            worker_deadline = min(deadline, time.monotonic() + timeout + 2)
                            pid = os.fork()
                        except (OSError, TypeError, ValueError) as exc:
                            results.append((collector.name, None, f"Worker start failed: {exc}"))
                            continue
                        if pid == 0:
                            self._collector_worker(collector, result_path)
                        active[pid] = (collector, result_path, worker_deadline)
                    for pid, (collector, result_path, worker_deadline) in list(active.items()):
                        if result_path.exists():
                            try:
                                message = json.loads(result_path.read_text(encoding="utf-8"))
                                result = message["result"]
                                completed_at = message["completed_at"]
                                if not isinstance(completed_at, (float, int)) or not math.isfinite(completed_at):
                                    raise ValueError("invalid completion clock")
                                if (not isinstance(result, list) or len(result) != 3
                                        or result[0] != collector.name
                                        or (result[1] is not None and not isinstance(result[1], dict))
                                        or (result[2] is not None and not isinstance(result[2], str))):
                                    raise ValueError("invalid collector result")
                                results.append(tuple(result) if completed_at <= worker_deadline else
                                               (collector.name, None, "Collector deadline exceeded"))
                            except (OSError, ValueError, TypeError, KeyError) as exc:
                                results.append((collector.name, None, f"Worker result invalid: {exc}"))
                        elif time.monotonic() >= worker_deadline:
                            results.append((collector.name, None, "Collector deadline exceeded"))
                        else:
                            continue
                        self._stop_collector_worker(pid)
                        del active[pid]
                    if time.monotonic() >= deadline:
                        results.extend((c.name, None, "Collection deadline exceeded before start")
                                       for _, c in pending)
                        pending.clear()
                    if active:
                        time.sleep(min(0.02, max(0, deadline - time.monotonic())))
            finally:
                # Exceptions or interrupted refreshes must not strand our workers.
                for pid in active:
                    self._stop_collector_worker(pid)
        return results

    def _collector_worker(self, collector, result_path: Path):
        try:
            os.setsid()
            try:
                result = self._run_collector(collector)
                payload = json.dumps({"result": result, "completed_at": time.monotonic()},
                                     ensure_ascii=False, allow_nan=False)
            except BaseException as exc:
                payload = json.dumps({"result": (collector.name, None, f"{type(exc).__name__}: {exc}"),
                                      "completed_at": time.monotonic()})
            partial = result_path.with_suffix(".part")
            partial.write_text(payload, encoding="utf-8")
            os.replace(partial, result_path)
        finally:
            # Never run inherited parent cleanup or thread/atexit shutdown.
            os._exit(0)

    @staticmethod
    def _stop_collector_worker(pid: int):
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            # macOS can report EPERM as the sole leader exits, and a newly
            # forked worker may not have reached setsid yet. Kill only our own
            # still-unreaped child, then retry the session for descendants.
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                os.killpg(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
        while True:
            try:
                os.waitpid(pid, 0)
                break
            except InterruptedError:
                continue
            except ChildProcessError:
                break

    @staticmethod
    def _run_collector(collector):
        if collector.name != "personal_value_truth":
            return collector.run()
        try:
            from repo_root import state_root
            locator = os.environ.get("PANORAMA_CODE_ROOT")
            if not locator or not Path(locator).expanduser().is_absolute():
                raise ValueError("managed_code_root_unavailable")
            producer_root = Path(locator).expanduser().resolve()
            ledger_root = Path(state_root()).resolve()
            configured_state = os.environ.get("PANORAMA_ROOT")
            if configured_state and Path(configured_state).expanduser().resolve() != ledger_root:
                raise ValueError("managed_state_root_mismatch")
            # Reload the hash/schema-bound publication each round. Its code pin
            # is not the current HEAD and remains guarded after producer FF.
            revision = ProjectionRevisionStore(STATE_ROOT).load()
            producer_collector = producer_root / "bin/panorama/panorama-collect.py"
            if hashlib.sha256(producer_collector.read_bytes()).hexdigest() != revision.collector_sha256:
                raise ValueError("managed_collector_digest_mismatch")
            cleanliness = subprocess.run(
                ["git", "-C", str(producer_root), "status", "--porcelain", "--untracked-files=no"],
                capture_output=True, text=True, timeout=10, check=False,
            )
            if cleanliness.returncode != 0:
                raise ValueError("managed_code_cleanliness_unavailable")
            if cleanliness.stdout.strip():
                raise ValueError("managed_code_root_dirty")
            meter = producer_root / "bin/bc-os/north_star_meter_v2.py"
            if hashlib.sha256(meter.read_bytes()).hexdigest() != revision.value_meter_sha256:
                raise ValueError("managed_value_meter_digest_mismatch")
            pin = subprocess.run(
                ["git", "-C", str(producer_root), "rev-parse", "HEAD:projects/omo"],
                capture_output=True, text=True, timeout=10, check=False,
            )
            if pin.returncode != 0 or pin.stdout.strip() != revision.omo_gitlink_oid:
                raise ValueError("managed_omo_gitlink_mismatch")
            bound = personal_value.PersonalValueCollector(
                code_root=producer_root, workspace_root=ledger_root,
                expected_revision=revision.producer_root_oid,
            )
            name, value, error = bound.run()
            if isinstance(value, dict):
                value["observed_at"] = (value.get("value_truth") or {}).get("observed_at")
            return name, value, error
        except Exception as exc:
            reason = getattr(exc, "public_error", None) or str(exc) or type(exc).__name__
            return collector.name, personal_value.unavailable_projection(reason), None

    def merge_results(self, previous: dict, results: list[tuple[str, dict | None, str | None]]) -> dict:
        """Merge collector results into the data blob."""
        data = copy.deepcopy(previous)
        states = data.setdefault("source_states", {})
        values = data.setdefault("live_sources", {})
        observed_at = now()
        from refresh import source_health, prior_healthy_success, HEALTH_SEMANTICS

        merge_panorama_base(data, previous, observed_at)

        for name, value, error in results:
            previous_state = states.get(name) if isinstance(states.get(name), dict) else {}
            prior_success = prior_healthy_success(previous_state, values.get(name))
            if name == "personal_value_truth" and (error or value is None or value.get("available") is False):
                cached = values.get(name) or data.get(name)
                reason = str(error or (value or {}).get("reason") or "collector returned no value")
                value = personal_value.unavailable_projection(reason)
                if (isinstance(cached, dict) and isinstance(cached.get("value_truth"), dict)
                        and cached["value_truth"].get("schema") == "value-truth-snapshot/v1"):
                    value["value_truth"] = copy.deepcopy(cached["value_truth"])
                    value["observed_at"] = cached.get("observed_at") or cached["value_truth"].get("observed_at")
                    value["value_truth_state"] = "STALE_UNAVAILABLE"
                    value["retained_value_truth"] = True
                    value["panel_value"] = personal_value.project_panel_value(value["value_truth"])
                    value["panel_value"]["state_reason"] = [reason, "retained historical ledger observation"]
                values[name] = value
                data[name] = value
                previous_panel = data.get("panel_value")
                advisory = (
                    previous_panel.get("advisory", previous_panel)
                    if isinstance(previous_panel, dict)
                    else {}
                )
                data["panel_value"] = personal_value.project_panel_value(
                    value.get("value_truth"), advisory
                )

            if error == DEFERRED_REASON:
                # The round was skipped because the host was overloaded. Keep the
                # last good value and mark the source deferred, so a deferral is
                # never reported as a source failure.
                cached = values.get(name) if isinstance(values.get(name), dict) else {}
                states[name] = {
                    "status": "DEFERRED", "error": error,
                    "observed_at": cached.get("observed_at") or previous_state.get("observed_at"),
                    "last_attempt_at": observed_at, "last_success_at": prior_success,
                    "last_success_status": "KNOWN" if prior_success else "UNKNOWN",
                    "health_semantics": HEALTH_SEMANTICS,
                }
                if "last_success_at" not in previous_state:
                    states[name].pop("last_success_at", None)
            elif error or value is None:
                cached = values.get(name) if isinstance(values.get(name), dict) else {}
                states[name] = {
                    "status": "STALE_UNAVAILABLE" if cached else "UNAVAILABLE", "error": error,
                    "observed_at": cached.get("observed_at") or previous_state.get("observed_at"),
                    "last_attempt_at": observed_at, "last_success_at": prior_success,
                    "last_success_status": "KNOWN" if prior_success else "UNKNOWN",
                    "health_semantics": HEALTH_SEMANTICS,
                }
                if "last_success_at" not in previous_state:
                    states[name].pop("last_success_at", None)
            else:
                status = source_health(value)
                source_observed = value.get("observed_at")
                success = source_observed if status == "OK" else prior_success
                states[name] = {
                    "status": status, "observed_at": source_observed,
                    "last_attempt_at": observed_at, "last_success_at": success,
                    "last_success_status": "KNOWN" if success else "UNKNOWN",
                    "health_semantics": HEALTH_SEMANTICS,
                }
                values[name] = value
                if name == "documents" and isinstance(value, dict):
                    data["documents"] = value.get("documents", [])
                    data["documents_meta"] = {key: item for key, item in value.items() if key != "documents"}
                else:
                    data[name] = value

                # The Ledger-bound collector owns the canonical value panel.
                # Preserve the previous JSONL panel only inside the explicit
                # advisory envelope; it must never survive as gate truth.
                if name == "personal_value_truth" and isinstance(value, dict):
                    panel = value.get("panel_value")
                    if isinstance(panel, dict):
                        previous_panel = data.get("panel_value")
                        advisory = (
                            previous_panel.get("advisory", previous_panel)
                            if isinstance(previous_panel, dict)
                            else {}
                        )
                        data["panel_value"] = personal_value.project_panel_value(
                            value.get("value_truth"), advisory
                        )

        current_value = data.get("personal_value_truth")
        if (isinstance(current_value, dict) and current_value.get("available") is False
                and isinstance(data.get("panel_value"), dict) and data["panel_value"].get("state") == "proven"):
            data["panel_value"]["state"] = "unprovable"
            data["panel_value"].setdefault("state_reason", []).append(current_value.get("reason"))

        merge_published_tasks(data, previous, observed_at)

        data["generated_at"] = observed_at
        # Revision-bound generation + strategic projection — both are required by
        # observatory_query.ObservationIndex; without them every /api/v1/* query
        # fails with SNAPSHOT_SCHEMA_UNAVAILABLE (MOF/loops/search panels blank).
        import hashlib
        data["generation_id"] = hashlib.sha256((observed_at + data["generated_at"]).encode()).hexdigest()[:20]
        if isinstance(data.get("documents"), list):
            data["documents"] = [dict(row, generation_id=data["generation_id"]) if isinstance(row, dict) else row
                                 for row in data["documents"]]
        if isinstance(data.get("documents_meta"), dict):
            data["documents_meta"] = dict(data["documents_meta"], generation_id=data["generation_id"])
        from refresh import integrate_gantt, integrate_strategy, publish_strategy_artifacts
        integrate_gantt(data, previous)
        integrate_strategy(data, previous)
        publish_strategy_artifacts(data)
        return data

    def validate(self, data: dict) -> list[str]:
        """Validate data against schema. Returns list of errors."""
        return validate_data(data)

    def render(self, data: dict, template_path: Path | None = None) -> str:
        """Render the HTML page with embedded data and UI scripts."""
        template_path = template_path or (APP / "template.html")
        template = template_path.read_text(encoding="utf-8")

        # Compute metadata
        result_state = self._compute_result_state(data)
        source_refs = self._compute_source_refs(data)
        data.setdefault("metadata", {})["result_state"] = result_state
        data["metadata"]["source_refs_publication"] = source_refs

        # Slim data for HTML embedding without mutating original data
        render_data = dict(data)
        if "strategic" in render_data and isinstance(render_data["strategic"], dict):
            strat = dict(render_data["strategic"])
            if "trace" in strat and isinstance(strat["trace"], dict):
                tr = dict(strat["trace"])
                nodes = tr.get("nodes")
                if isinstance(nodes, list) and len(nodes) > 100:
                    tr["nodes"] = nodes[:100]
                    tr["nodes_trimmed"] = True
                edges = tr.get("edges")
                if isinstance(edges, list) and len(edges) > 100:
                    tr["edges"] = edges[:100]
                    tr["edges_trimmed"] = True
                strat["trace"] = tr
            render_data["strategic"] = strat

        # Encode data
        encoded = json.dumps(render_data, ensure_ascii=False, separators=(",", ":")).replace("<", "\\u003c")

        # Concatenate UI scripts
        ui_files = [
            "data_access.js", "ui_extensions.js", "strategy_ui.js", "workbench_ui.js",
            "panoramic_ui.js", "next_ui.js", "topology_ui.js", "mof_ui.js", "ecosystem_ui.js",
        ]
        ui_parts: list[str] = []
        for fname in ui_files:
            fpath = APP / fname
            if fpath.exists():
                ui_parts.append(fpath.read_text().replace("</script", "<\\/script"))
        ui = "\n".join(ui_parts)

        # Replace placeholders
        result = template
        result = result.replace("__SNAPSHOT_JSON__", encoded)
        result = result.replace("__OBSERVED_AT__", data.get("observed_at", "unknown"))
        result = result.replace("__LEDGER_SHA__", data.get("portfolio", {}).get("ledger_sha256", "unknown"))
        result = result.replace("__RESULT_STATE__", result_state)
        result = result.replace("__SOURCE_REFS__", source_refs)
        if ui:
            result = result.replace("</body>", "<script>" + ui + "</script>\n</body>")

        return result

    @staticmethod
    def _atomic_write(path: Path, payload: str) -> None:
        """Atomic replace so concurrent readers never observe a partial snapshot."""
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(payload, encoding="utf-8")
        os.replace(tmp, path)

    def publish(self, data: dict, page_path: Path | None = None) -> None:
        """Publish data to dist/ (and root for compat) and render HTML."""
        DIST_DIR.mkdir(parents=True, exist_ok=True)
        html = self.render(data)
        encoded_data = json.dumps(data, ensure_ascii=False, indent=2)

        # 1. Output to isolated dist/ (atomic — readers must never see partial JSON)
        self._atomic_write(DIST_DIR / "current.json", encoded_data)
        self._atomic_write(DIST_DIR / "index.html", html)

        # 2. Dual-write to root for transition backwards-compatibility
        self._atomic_write(CURRENT, encoded_data)
        target_page = page_path or PAGE
        self._atomic_write(target_page, html)

        # 3. Legacy publication is an explicit operator capability, never an
        # implicit side effect of a normal refresh.
        if legacy_doc_publication_enabled() and LEGACY_DOC_PAGE.parent.is_dir():
            try:
                LEGACY_DOC_PAGE.write_text(html, encoding="utf-8")
            except Exception as exc:
                log.warning("Could not sync to legacy doc page: %s", exc)

    def refresh(self) -> dict:
        """Run a full refresh cycle and publish. Returns the data blob."""
        started = time.monotonic()
        previous = self.load_previous()
        results = self.run_collectors()
        data = self.merge_results(previous, results)
        errors = self.validate(data)
        if errors:
            log.warning("Schema validation warnings: %s", errors)
        self.publish(data)
        elapsed = time.monotonic() - started
        log.info("Refresh complete in %.1fs with %d sources", elapsed, len(results))
        return data

    @staticmethod
    def _compute_result_state(data: dict) -> str:
        """Compute overall result state from source health."""
        states = data.get("source_states", {})
        if not states:
            return "UNKNOWN"
        failed = sum(1 for s in states.values() if s.get("status") in {"UNAVAILABLE", "STALE_UNAVAILABLE", "ERROR", "FAIL", "FAILED", "UNPROVABLE", "UNKNOWN"})
        total = len(states)
        if failed == 0:
            if any(s.get("status") == "DEGRADED" for s in states.values()):
                return "DEGRADED"
            if any(s.get("status") in {"PARTIAL", "STALE_PARTIAL"} for s in states.values()):
                return "PARTIAL"
            return "OBSERVED"
        elif failed < total / 3:
            return "PARTIAL"
        elif failed < total * 2 / 3:
            return "DEGRADED"
        else:
            return "UNAVAILABLE"

    @staticmethod
    def _compute_source_refs(data: dict) -> str:
        """Compute source references string."""
        states = data.get("source_states", {})
        refs = []
        for name, state in sorted(states.items()):
            status = state.get("status", "UNKNOWN")
            refs.append(f"{name}:{status}")
        return ", ".join(refs)


def main() -> int:
    """CLI entry point for launchd / cron."""
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    orch = RefreshOrchestrator()
    data = orch.refresh()
    state = data.get("metadata", {}).get("result_state", "UNKNOWN")
    print(json.dumps({"status": "ok", "state": state, "sources": len(data.get("source_states", {}))}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
