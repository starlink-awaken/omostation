/**
 * ecosystem_ui.js — 双重视界引导舱、主权待办决策池与全域 360° 生态全息穿透中枢
 */
(function() {
  let currentPersona = 'sovereign'; // 'sovereign' | 'agent'
  let currentAgentRole = 'engineering'; // 'engineering' | 'review' | 'knowledge' | 'governance'
  let liveProposals = [];
  let proposalRead = { state: 'loading', observedAt: null };
  let proposalReadSequence = 0;

  function isRecord(value) {
    return value !== null && typeof value === 'object' && !Array.isArray(value);
  }

  function requireBusinessResponse(payload) {
    if (!isRecord(payload) || payload._stub || payload.error || payload.ok === false ||
        payload.success === false || ['error', 'failed', 'failure'].includes(String(payload.status || '').toLowerCase())) {
      throw new Error('提案接口未返回可用业务记录');
    }
    const data = Object.prototype.hasOwnProperty.call(payload, 'data') ? payload.data : payload;
    if (!isRecord(data) || data._stub || data.error || data.ok === false || data.success === false ||
        ['error', 'failed', 'failure'].includes(String(data.status || '').toLowerCase())) {
      throw new Error('提案记录结构不可用');
    }
    return data;
  }

  function validateProposal(p) {
    return isRecord(p) && typeof p.id === 'string' && /^[A-Za-z0-9_-]{1,160}$/.test(p.id) &&
      typeof p.title === 'string' && ['pending', 'approved', 'rejected'].includes(p.status) &&
      ['description', 'agent_id', 'proposal_type'].every(key => p[key] === undefined || typeof p[key] === 'string') &&
      (p.payload === undefined || (isRecord(p.payload) &&
        ['remediation_cmd', 'diff_summary'].every(key => p.payload[key] === undefined || typeof p.payload[key] === 'string')));
  }

  function proposalQueueLabel() {
    if (proposalRead.state === 'loading') return '提案队列读取中';
    if (proposalRead.state !== 'ready') return '提案队列读取不可用';
    const count = liveProposals.filter(p => p.status === 'pending').length;
    return count > 0 ? `${count} 项待决（读取结果）` : '无待决提案（读取结果）';
  }

  function proposalSourceLabel() {
    const clock = proposalRead.observedAt;
    return clock ? `来源时间：${clock}；仅反映提案队列。` : '来源时间未记录；仅反映提案队列。';
  }

  function refreshProposalViews() {
    if (currentPersona === 'sovereign') renderPersonaGuidanceBar();
    const modal = document.getElementById('sovereign-cockpit-drawer-modal');
    const content = document.getElementById('sovereign-cockpit-drawer-content');
    if (modal && modal.style.display === 'flex' && content) content.innerHTML = getSovereignFullCardHtml(true);
  }

  function refreshProposals() {
    const sequence = ++proposalReadSequence;
    liveProposals = [];
    proposalRead = { state: 'loading', observedAt: null };
    refreshProposalViews();
    return fetch('/api/v1/proposals/list?status=pending')
      .then(res => {
        if (!res.ok) throw new Error('提案读取 HTTP ' + res.status);
        return res.json();
      })
      .then(payload => {
        const data = requireBusinessResponse(payload);
        if (!Array.isArray(data.proposals) || !data.proposals.every(validateProposal) ||
            new Set(data.proposals.map(p => p.id)).size !== data.proposals.length) {
          throw new Error('提案列表结构不可用');
        }
        const clock = payload.generated_at || payload.freshness?.observed_at || null;
        if (clock !== null && (typeof clock !== 'string' || !Number.isFinite(Date.parse(clock)))) {
          throw new Error('提案来源时间不可用');
        }
        if (payload.freshness !== undefined) {
          const f = payload.freshness;
          if (!isRecord(f) || f.state !== 'FRESH' || !clock || !Number.isFinite(f.ttl_seconds) ||
              f.ttl_seconds <= 0 || (Date.now() - Date.parse(clock)) / 1000 > f.ttl_seconds ||
              Date.parse(clock) - Date.now() > 60000) throw new Error('提案来源已过期或时间不可用');
        }
        if (sequence !== proposalReadSequence) return;
        liveProposals = data.proposals;
        proposalRead = { state: 'ready', observedAt: clock };
        refreshProposalViews();
      })
      .catch(err => {
        if (sequence !== proposalReadSequence) return;
        liveProposals = [];
        proposalRead = { state: 'error', observedAt: null };
        refreshProposalViews();
        console.warn('Failed to fetch live proposals:', err);
      });
  }
  let swarmTopology = null;
  let isSovereignPinned = (function() {
    try {
      return localStorage.getItem('zhixing_sovereign_pinned') === '1';
    } catch(e) {
      return false;
    }
  })();

  // === 1. 双重视界引导舱初始化 ===
  window.initPersonaSystem = function() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const personaParam = (urlParams.get('persona') || urlParams.get('mode') || '').toLowerCase();
      const hash = (window.location.hash || '').toLowerCase();
      if (personaParam === 'agent' || personaParam === 'headless' || hash === '#agent' || hash.includes('persona=agent')) {
        currentPersona = 'agent';
      } else if (personaParam === 'sovereign' || personaParam === 'exec' || hash === '#sovereign') {
        currentPersona = 'sovereign';
      } else {
        const saved = localStorage.getItem('zhixing_persona');
        if (saved && (saved === 'sovereign' || saved === 'agent')) {
          currentPersona = saved;
        }
      }
    } catch (e) {
      console.warn('URL params parsing failed:', e);
    }
    updatePersonaUI();
    fetchInitialData();
  };

  function fetchInitialData() {
    refreshProposals();

    // 拉取蜂群实时遥测
    fetch('/api/v1/swarm/topology')
      .then(res => res.json())
      .then(payload => {
        swarmTopology = payload.data || payload;
        if (currentPersona === 'agent') {
          renderPersonaGuidanceBar();
        }
      })
      .catch(err => console.warn('Failed to fetch swarm topology:', err));
  }

  window.switchPersona = function(persona) {
    currentPersona = persona;
    localStorage.setItem('zhixing_persona', persona);
    updatePersonaUI();
  };

  function updatePersonaUI() {
    const btnSovereign = document.getElementById('btn-persona-sovereign');
    const btnAgent = document.getElementById('btn-persona-agent');
    if (btnSovereign && btnAgent) {
      if (currentPersona === 'sovereign') {
        btnSovereign.classList.add('active');
        btnAgent.classList.remove('active');
      } else {
        btnAgent.classList.add('active');
        btnSovereign.classList.remove('active');
      }
    }
    renderPersonaGuidanceBar();
  }

  function renderPersonaGuidanceBar() {
    const bar = document.getElementById('persona-guidance-bar');
    if (!bar) return;

    if (currentPersona === 'sovereign') {
      const pendingCount = liveProposals.filter(p => p.status === 'pending').length;
      if (isSovereignPinned) {
        bar.innerHTML = getSovereignFullCardHtml(false);
      } else {
        bar.innerHTML = renderSovereignCapsuleHtml(pendingCount);
        if (pendingCount > 0) {
          showSovereignAdjudicationToast(pendingCount);
        } else {
          window.dismissSovereignToast();
        }
      }
    } else {
      // 智能体作业指引舱
      window.dismissSovereignToast();
      const summary = swarmTopology?.summary || {};
      bar.innerHTML = `
        <div class="persona-guidance-card agent-mode">
          <div class="row" style="align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px">
            <div style="flex:1;min-width:320px">
              <div style="display:flex;align-items:center;gap:8px">
                <span style="font-size:16px">🤖</span>
                <strong style="font-size:15px;color:#1e40af">智能体作业指引舱 (Agent Task & Compliance Guidance)</strong>
                <span class="chip good" style="font-weight:600;font-size:10px">ADR-0203 强制工作流合规</span>
                <span class="chip neutral mono" style="font-size:10px">活跃工作树: ${Number.isInteger(summary.active_worktrees_count) && summary.active_worktrees_count >= 0 ? summary.active_worktrees_count + ' 个（接口记录）' : '未记录'}</span>
              </div>
              <p class="small" style="color:#1e3a8a;margin:6px 0 10px;line-height:1.5">
                检测到您以 AI 智能体身份协同接入。请选择您的专属专业角色，获取强制准入前置清单、受管路径范围、BOS 接口与法定行动信封。
              </p>

              <!-- 4 类核心 Agent 角色选择器 -->
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
                <button class="btn ${currentAgentRole === 'engineering' ? 'chip good' : ''}" style="font-size:11px;padding:4px 10px" onclick="selectAgentRole('engineering')">
                  🔨 工程交付 Agent (Delivery)
                </button>
                <button class="btn ${currentAgentRole === 'review' ? 'chip good' : ''}" style="font-size:11px;padding:4px 10px" onclick="selectAgentRole('review')">
                  ⚖️ 架构审议 Agent (Review)
                </button>
                <button class="btn ${currentAgentRole === 'knowledge' ? 'chip good' : ''}" style="font-size:11px;padding:4px 10px" onclick="selectAgentRole('knowledge')">
                  🧠 知识因果 Agent (Knowledge)
                </button>
                <button class="btn ${currentAgentRole === 'governance' ? 'chip good' : ''}" style="font-size:11px;padding:4px 10px" onclick="selectAgentRole('governance')">
                  🛡️ 治理审计 Agent (Audit)
                </button>
              </div>

              <!-- 角色引导详情 -->
              ${renderAgentRoleGuidance()}

              <!-- Agent Preflight 变更前置仿真探针 -->
              <div style="margin-top:14px;border-top:1px dashed #bfdbfe;padding-top:12px">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                  <strong style="font-size:13px;color:#1e40af;display:flex;align-items:center;gap:6px">
                    <span>🛡️</span>
                    <span>Agent 变更前置仿真探针 (Preflight Sandbox & Probe)</span>
                  </strong>
                  <span class="small muted" style="font-size:11px">修改代码前自动核验 Write Owner 归属与 GaC 拦截风险</span>
                </div>

                <div style="background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;padding:10px 12px">
                  <!-- 常用快速预设 Pills -->
                  <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px">
                    <span class="small muted" style="font-size:10.5px">快捷预设:</span>
                    <button type="button" class="btn" style="font-size:10px;padding:2px 6px;background:white" onclick="setPreflightTarget('projects/omo/kernel.py')">OMO 治理核</button>
                    <button type="button" class="btn" style="font-size:10px;padding:2px 6px;background:white" onclick="setPreflightTarget('projects/ecos/protocol.py')">eCOS 协议</button>
                    <button type="button" class="btn" style="font-size:10px;padding:2px 6px;background:white" onclick="setPreflightTarget('docs/plans/3y-bet-ledger.yaml')">3Y 台账</button>
                    <button type="button" class="btn" style="font-size:10px;padding:2px 6px;background:#fff1f2;border-color:#fecdd3;color:#be123c" onclick="setPreflightTarget('.omo/standards/scene-card-lifecycle.yaml')">受限 SSOT ❌</button>
                    <button type="button" class="btn" style="font-size:10px;padding:2px 6px;background:white" onclick="setPreflightTarget('template.html')">UI 模板</button>
                  </div>

                  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px">
                    <input type="text" id="preflight-path-input" placeholder="输入待修改文件路径，如 projects/omo/kernel.py" value="projects/omo/kernel.py" style="flex:1;min-width:230px;padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:12px;font-family:var(--mono)">
                    <select id="preflight-branch-select" style="padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:12px">
                      <option value="main">分支: main (❌ 保护主仓)</option>
                      <option value="feat-worktree" selected>分支: feat-worktree (✅ 隔离工作树)</option>
                    </select>
                    <button class="btn" style="background:var(--blue);color:white;font-size:12px;padding:6px 12px" onclick="runPreflightSimulation()">
                      🚀 运行探针仿真
                    </button>
                  </div>
                  <div id="preflight-probe-result" style="display:none;padding:8px 10px;border-radius:6px;font-size:11.5px"></div>
                </div>
              </div>

              <!-- 0ms 纯语义 Context Pack 一键复制条 -->
              <div style="margin-top:10px;display:flex;justify-content:space-between;align-items:center;background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:8px 12px">
                <div style="font-size:11px;color:#1e40af">
                  <strong>⚡ 0ms 极速自省：</strong>一键复制包含身份、隔离红线、避坑铁律与 BOS 目录的高信息密度 Markdown Context
                </div>
                <button class="btn" style="font-size:11px;background:white;color:#1e40af;border-color:#93c5fd;font-weight:600" onclick="copyPureSemanticContextPack()">
                  📋 复制极速 LLM Context Pack
                </button>
              </div>
            </div>

            <!-- 右侧快捷指令与信封装配 -->
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end">
              <button class="btn" style="font-size:11.5px;color:#1e40af;border-color:#bfdbfe;background:#eff6ff;font-weight:600" onclick="openContextPackModal()">
                ⚡ 认领并装配法定任务信封 (Context Pack)
              </button>
              <button class="btn" style="font-size:11px;color:var(--muted)" onclick="copyAgentGuidancePrompt()">
                📋 复制当前角色任务引导 Prompt
              </button>
              <div class="small muted" style="font-size:10.5px">
                法定工作流: <code>bootstrap ➔ start ➔ claim ➔ closeout</code>
              </div>
            </div>
          </div>
        </div>
      `;
    }
  }

  function renderSovereignCapsuleHtml(pendingCount) {
    return `
      <div class="sovereign-hud-capsule" role="region" aria-label="主权执掌者态势导读条">
        <div class="sovereign-hud-title-zone" onclick="openSovereignCockpitDrawer()" title="点击展开夏明星态势导读与署名自进化舱">
          <span style="font-size:15px">👑</span>
          <strong style="font-size:12.5px;color:#92400e">夏明星态势导读</strong>
          <span class="chip warn" style="font-size:9.5px;padding:1px 6px">主权控制</span>
        </div>

        <div class="sovereign-hud-badges" onclick="openSovereignCockpitDrawer()" style="cursor:pointer">
          <span class="sovereign-hud-chip" title="模型加载证据">🎯 <b>模型加载：未记录</b></span>
          <span class="sovereign-hud-chip" title="交付与价值证据">⚡ <b>交付/省时：未记录</b> · <a href="#next" onclick="event.stopPropagation()">查看周报</a></span>
          <span class="sovereign-hud-chip ${proposalRead.state !== 'ready' || pendingCount > 0 ? 'warn' : 'neutral'}" id="sovereign-hud-pending-chip">
            ${escHtml(proposalQueueLabel())}
          </span>
        </div>

        <div class="sovereign-hud-actions">
          <button class="sovereign-btn-drawer-trigger" onclick="openSovereignCockpitDrawer()">
            <span>👑 展开自进化舱</span>
            <span style="font-size:10px">➔</span>
          </button>
          <button class="btn btn-pin-toggle" onclick="togglePinSovereignInPage()" title="在页面内平铺展开大卡片">
            📌 平铺
          </button>
        </div>
      </div>
    `;
  }

  function getSovereignFullCardHtml(isDrawerMode) {
    const pendingCount = liveProposals.filter(p => p.status === 'pending').length;
    return `
      <div class="persona-guidance-card sovereign-mode" style="${isDrawerMode ? 'box-shadow:none;border:none;background:transparent;padding:0' : ''}">
        <div class="row" style="align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px">
          <div style="flex:1;min-width:320px">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
              <span style="font-size:16px">👑</span>
              <strong style="font-size:15px;color:#92400e">主权执掌者视界 · 夏明星态势导读与署名自进化舱</strong>
              <span class="chip warn" style="font-weight:600;font-size:10px">人类意志最高控制权 (Human In Command)</span>
              <span class="chip ${proposalRead.state !== 'ready' || pendingCount > 0 ? 'warn' : 'neutral'} sovereign-pending-badge-item" id="sovereign-pending-badge" style="font-weight:600;font-size:10px">${escHtml(proposalQueueLabel())}</span>
              ${!isDrawerMode ? `
                <button class="btn btn-pin-toggle pinned" onclick="togglePinSovereignInPage()" style="margin-left:auto;font-size:10.5px;padding:2px 8px" title="收为轻量微标与抽屉模式">
                  📥 收为抽屉模式
                </button>
              ` : ''}
            </div>
            <p class="small" style="color:#78350f;margin:6px 0 10px;line-height:1.5">
              智能体提案在此供审阅。后端裁决记录不代表真人身份签名、治理验收通过或实际省时。
            </p>
            
            <!-- 执掌者 30 秒态势三问 (Executive HUD) -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px;margin:10px 0 12px;background:#fffdf7;border:1px solid #fde68a;border-radius:8px;padding:12px 14px">
              <div style="display:flex;flex-direction:column;gap:3px">
                <div style="font-size:11px;font-weight:700;color:#92400e;display:flex;align-items:center;gap:4px">
                  <span>🎯</span><span>系统当下在忙什么？</span>
                </div>
                <div style="font-size:12px;color:#78350f;line-height:1.45">
                  模型加载、显存与回路健康：<b>本页未记录</b>。请查看对应观测页的来源与时间。
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:3px">
                <div style="font-size:11px;font-weight:700;color:#92400e;display:flex;align-items:center;gap:4px">
                  <span>⚡</span><span>今天为我交付/节省了什么？</span>
                </div>
                <div style="font-size:12px;color:#78350f;line-height:1.45">
                  交付数量与省时：<b>本页未记录</b>。<a href="#personal">查看现有周报与价值证据</a>，以各项验收记录为准。
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:3px;background:#fef3c7;padding:6px 10px;border-radius:6px;border:1px solid #f59e0b">
                <div style="font-size:11px;font-weight:700;color:#b45309;display:flex;align-items:center;gap:4px">
                  <span>👑</span><span>当下唯一需要我拍板的事？</span>
                </div>
                <div id="hud-decision-item" class="hud-decision-item" style="font-size:12px;color:#92400e;line-height:1.45">
                  ${escHtml(proposalQueueLabel())}。${escHtml(proposalSourceLabel())}
                </div>
              </div>
            </div>

            <!-- 署名自进化 4 步流向链 -->
            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11px;margin-bottom:12px">
              <span style="background:white;border:1px solid #fde68a;padding:3px 8px;border-radius:5px;color:#92400e">1. 外部信号捕获</span>
              <span style="color:#b45309">➔</span>
              <span style="background:white;border:1px solid #fde68a;padding:3px 8px;border-radius:5px;color:#92400e">2. 本地端侧推理草案</span>
              <span style="color:#b45309">➔</span>
              <span style="background:#fef3c7;border:1px solid #d97706;padding:3px 8px;border-radius:5px;color:#b45309;font-weight:600">3. 👑 夏明星物理署名裁决</span>
              <span style="color:#b45309">➔</span>
              <span style="background:white;border:1px solid #fde68a;padding:3px 8px;border-radius:5px;color:#92400e">4. 知识沉淀与 SEMA 进化</span>
            </div>
          </div>

          <!-- 右侧统计与直达指令 -->
          <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end">
            <div style="display:flex;gap:6px;flex-wrap:wrap">
              <button class="btn" style="font-size:11.5px;color:#b45309;border-color:#fde68a;background:#fffbeb" onclick="${isDrawerMode ? 'closeSovereignCockpitDrawer();' : ''}location.hash='#ledger'">
                📜 待验收 BET 交付台账
              </button>
              <button class="btn" style="font-size:11.5px;color:#1e40af;border-color:#bfdbfe;background:#eff6ff" onclick="${isDrawerMode ? 'closeSovereignCockpitDrawer();' : ''}location.hash='#topology'">
                🌐 巡检架构拓扑与接口
              </button>
              <button class="btn" style="font-size:11.5px;color:#047857;border-color:#a7f3d0;background:#ecfdf5" onclick="${isDrawerMode ? 'closeSovereignCockpitDrawer();' : ''}location.hash='#mof-grid'">
                🛡️ MOF 元规约验真
              </button>
            </div>
            <div class="small muted" style="font-size:10.5px">
              隔离生效、活跃 Agent 与显存负载：<b>本页未记录</b>
            </div>
          </div>
        </div>

        <!-- 真实待办决策池列表 (Live Adjudication Queue) -->
        <div style="margin-top:14px;border-top:1px dashed #fde68a;padding-top:12px">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <strong style="font-size:13px;color:#92400e;display:flex;align-items:center;gap:6px">
              <span>📋</span>
              <span>提案队列读取结果 (Pending Proposals Queue)</span>
            </strong>
            <span class="small muted" style="font-size:11px">操作结果以真实后端记录为准，不作为真人签名证明</span>
          </div>

          <div class="prop-queue-grid" id="sovereign-prop-grid">
            ${renderProposalCards(liveProposals.slice(0, 4))}
          </div>
        </div>
      </div>
    `;
  }

  window.openSovereignCockpitDrawer = function() {
    const modal = document.getElementById('sovereign-cockpit-drawer-modal');
    if (!modal) return;
    const content = document.getElementById('sovereign-cockpit-drawer-content');
    if (content) {
      content.innerHTML = getSovereignFullCardHtml(true);
    }
    const pinBtn = document.getElementById('btn-pin-sovereign-card');
    if (pinBtn) {
      pinBtn.classList.toggle('pinned', isSovereignPinned);
      pinBtn.textContent = isSovereignPinned ? '📌 已固定在页面' : '📌 固定在页面';
    }
    modal.style.display = 'flex';
    window.dismissSovereignToast();
  };

  window.closeSovereignCockpitDrawer = function() {
    const modal = document.getElementById('sovereign-cockpit-drawer-modal');
    if (modal) modal.style.display = 'none';
    const pendingCount = liveProposals.filter(p => p.status === 'pending').length;
    if (!isSovereignPinned && pendingCount > 0 && currentPersona === 'sovereign') {
      showSovereignAdjudicationToast(pendingCount);
    }
  };

  window.togglePinSovereignInPage = function() {
    isSovereignPinned = !isSovereignPinned;
    try {
      localStorage.setItem('zhixing_sovereign_pinned', isSovereignPinned ? '1' : '0');
    } catch(e) {}

    if (isSovereignPinned) {
      const modal = document.getElementById('sovereign-cockpit-drawer-modal');
      if (modal) modal.style.display = 'none';
      window.dismissSovereignToast();
    }
    renderPersonaGuidanceBar();
  };

  window.dismissSovereignToast = function() {
    const toast = document.getElementById('sovereign-toast-alert');
    if (toast) toast.remove();
  };

  function showSovereignAdjudicationToast(count) {
    if (count <= 0 || isSovereignPinned) {
      window.dismissSovereignToast();
      return;
    }
    const modal = document.getElementById('sovereign-cockpit-drawer-modal');
    if (modal && modal.style.display === 'flex') return;

    let toast = document.getElementById('sovereign-toast-alert');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'sovereign-toast-alert';
      toast.className = 'sovereign-toast-alert';
      document.body.appendChild(toast);
    }
    toast.innerHTML = `
      <div class="toast-icon">👑</div>
      <div class="toast-body" onclick="openSovereignCockpitDrawer()" style="cursor:pointer">
        <div class="toast-title">主权待办提请 · 等待物理署名</div>
        <div class="toast-desc">队列中有 <b>${count}</b> 项智能体提炼的草案与自愈提案，点击即刻进入自进化舱批复。</div>
      </div>
      <button class="btn" style="padding:4px 10px;font-size:11px;background:#fef3c7;border-color:#f59e0b;color:#92400e;font-weight:600" onclick="openSovereignCockpitDrawer()">
        处理 ➔
      </button>
      <button class="auth-close-btn" style="margin-left:4px" onclick="event.stopPropagation();dismissSovereignToast()" title="暂缓提醒">✕</button>
    `;
  }

  function renderProposalCards(props) {
    if (proposalRead.state !== 'ready' || !props || !props.length) {
      return `<div style="grid-column:1/-1;padding:16px;text-align:center;color:var(--muted);background:white;border-radius:6px">${escHtml(proposalQueueLabel())}。${escHtml(proposalSourceLabel())}</div>`;
    }

    return props.map(p => {
      const isApproved = p.status === 'approved';
      const isRejected = p.status === 'rejected';
      const payload = p.payload || {};
      const diffSummary = payload.diff_summary || '';
      return `
        <div class="prop-card ${isApproved ? 'adjudicated' : ''}" id="card-prop-${p.id}">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:6px">
            <strong style="font-size:12.5px;color:#92400e;line-height:1.4">${escHtml(p.title)}</strong>
            <span class="chip ${p.proposal_type === 'self_healing' ? 'warn' : 'neutral'}" style="font-size:10px">
              ${escHtml(p.proposal_type)}
            </span>
          </div>

          <div style="font-size:11.5px;color:#475569">
            提报 Agent: <code class="mono" style="font-size:10.5px;color:#1e40af">${escHtml(p.agent_id)}</code>
          </div>

          <div class="small muted" style="font-size:11px;line-height:1.4;background:#fffdfa;border:1px solid #fef3c7;padding:6px 8px;border-radius:4px">
            <b>建议动作:</b> ${payload.remediation_cmd ? `<code>${escHtml(payload.remediation_cmd)}</code>` : escHtml((p.description || '').slice(0, 100)) + '...'}
          </div>

          ${diffSummary ? `
            <details style="font-size:10.5px;color:var(--muted)">
              <summary style="cursor:pointer;color:var(--blue)">查看拟应用 Diff 变更</summary>
              <pre class="mono" style="background:#f8fafc;padding:6px;border-radius:4px;overflow-x:auto;margin:4px 0 0">${escHtml(diffSummary)}</pre>
            </details>
          ` : ''}

          <!-- 签署印章 -->
          <div class="signed-stamp ${isApproved ? 'stamped' : isRejected ? 'stamped stamp-rejected' : ''}" id="stamp-${p.id}">
            ${isApproved ? '后端记录：APPROVED' : isRejected ? '后端记录：REJECTED' : ''}
          </div>

          <!-- 决策操作条 -->
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:8px;border-top:1px dashed #fde68a" id="action-bar-${p.id}">
            <span class="small mono muted" style="font-size:10px">${p.id}</span>
            ${(!isApproved && !isRejected) ? `
              <div style="display:flex;gap:6px">
                <button class="btn" style="padding:3px 8px;font-size:11px;color:#b91c1c;border-color:#fca5a5" onclick="quickAdjudicate('${p.id}', 'rejected')">
                  驳回
                </button>
                <button class="btn" style="padding:3px 10px;font-size:11px;color:#15803d;background:#f0fdf4;border-color:#86efac;font-weight:600" onclick="quickAdjudicate('${p.id}', 'approved')">
                  👑 提交采纳
                </button>
              </div>
            ` : `
              <span class="small" style="color:#15803d;font-weight:600">后端已记录此裁决状态（非真人签名证明）</span>
            `}
          </div>
        </div>
      `;
    }).join('');
  }

  window.quickAdjudicate = function(propId, verdict) {
    if (typeof propId !== 'string' || !/^[A-Za-z0-9_-]{1,160}$/.test(propId) ||
        !['approved', 'rejected'].includes(verdict)) return;
    const cards = document.querySelectorAll('#card-prop-' + propId);
    const stamps = document.querySelectorAll('#stamp-' + propId);
    const actionBars = document.querySelectorAll('#action-bar-' + propId);

    const note = verdict === 'approved' 
      ? 'Approved by Sovereign Owner 夏明星 (符合治理准入规范，准予固化)'
      : 'Rejected by Sovereign Owner 夏明星 (需补充完整因果证据与受管路径)';

    // 发起真实 POST 裁决
    return fetch('/api/v1/proposals/adjudicate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: propId,
        verdict: verdict,
        reviewer_note: note,
        adjudicator: '夏明星'
      })
    })
      .then(res => {
        if (!res.ok) throw new Error('裁决提交 HTTP ' + res.status);
        return res.json();
      })
      .then(result => {
        const record = requireBusinessResponse(result);
        if (record.id !== propId || record.status !== verdict ||
            typeof record.adjudicated_at !== 'string' || !Number.isFinite(Date.parse(record.adjudicated_at)) ||
            typeof record.audit_digest !== 'string' || !/^sha256:[0-9a-f]{64}$/.test(record.audit_digest)) {
          throw new Error('未收到匹配的后端裁决与审计记录');
        }
        stamps.forEach(stamp => {
          stamp.textContent = verdict === 'approved' ? '后端记录：APPROVED' : '后端记录：REJECTED';
          stamp.className = 'signed-stamp stamped' + (verdict === 'rejected' ? ' stamp-rejected' : '');
        });
        cards.forEach(card => card.classList.add('adjudicated'));
        actionBars.forEach(actionBar => {
          actionBar.textContent = `${propId}：后端已记录裁决（非真人签名证明）`;
        });
        if (typeof window.logTelemetry === 'function') {
          window.logTelemetry('ADJUDICATE', `后端返回裁决记录: ${propId} ➔ ${verdict.toUpperCase()}；实际收益未记录`);
        }
        // Re-read the queue; a local verdict does not prove its remaining count or value KPIs.
        refreshProposals();

        // 自动触发实时事件大厅刷新
        if (typeof window.ZhixingRefreshPersonalEvents === 'function') {
          setTimeout(() => window.ZhixingRefreshPersonalEvents(), 600);
        }
      })
      .catch(err => {
        alert('裁决提交未确认成功: ' + err.message);
      });
  };

  window.selectAgentRole = function(role) {
    currentAgentRole = role;
    renderPersonaGuidanceBar();
  };

