  // 法定任务信封装配弹窗 (Context Pack Modal)
  window.openContextPackModal = function() {
    let modal = document.getElementById('context-pack-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'context-pack-modal';
      modal.className = 'dispatch-modal-backdrop';
      document.body.appendChild(modal);
    }
    modal.style.display = 'flex';

    const roleConfigs = {
      engineering: { profile: 'delivery-engineer', bet: 'BET-Y1Q4-T10-161', obj: '完善全景驾驶舱主权裁决与 Agent 调度闭环' },
      review: { profile: 'architecture-reviewer', bet: 'BET-Y1Q1-02', obj: '核验 MOF 协议与 DFSQ 八层单向依赖合规性' },
      knowledge: { profile: 'knowledge-curator', bet: 'BET-Y1Q3-K01', obj: '增量抽取 KOS 知识因果图谱与经验网络' },
      governance: { profile: 'compliance-auditor', bet: 'BET-Y1Q4-T7-02', obj: '执行全域 GaC 门禁回归与 write-owners 审计' }
    };
    const c = roleConfigs[currentAgentRole] || roleConfigs.engineering;
    const sessionName = `session-${currentAgentRole}-${Date.now().toString().slice(-4)}`;

    modal.innerHTML = `
      <div class="dispatch-modal-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <strong style="font-size:16px;color:#1e40af">⚡ 法定任务信封装配器 (Context Pack Dispatcher)</strong>
          <button class="drawer-close-btn" onclick="closeContextPackModal()">✕</button>
        </div>
        <p class="small muted" style="margin:0 0 12px">
          根据 ADR-0203 规约，任何智能体作业必须严格声明角色、目标 BET 并使用隔离工作树。
        </p>

        <div style="display:grid;gap:10px;font-size:12px">
          <div>
            <b>分配角色 Profile:</b> <code class="mono">${c.profile}</code>
          </div>
          <div>
            <b>绑定 BET 台账:</b> <code class="mono">${c.bet}</code>
          </div>
          <div>
            <b>法定执行目标:</b> <span>${c.obj}</span>
          </div>
          <div>
            <b>建议执行脚本 (一键复制):</b>
            <pre class="mono" id="context-pack-script" style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:10px;font-size:11px;overflow-x:auto">
# 1. 物理隔离工作树 Claim
bash bin/gac/gac-worktree.sh claim ${sessionName}

# 2. 启动受管 Agent 任务信封 (ADR-0203)
uv run python bin/agent-workflow.py start bet-execution --profile ${c.profile} --bet ${c.bet} --objective "${c.obj}"

# 3. 验收与合规门禁
python3 bin/gac/harness-compliance-check.py --report</pre>
          </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
          <button class="btn" onclick="closeContextPackModal()">关闭</button>
          <button class="btn" style="background:var(--blue);color:white" onclick="copyContextPackScript()">
            📋 复制标准执行脚本
          </button>
        </div>
      </div>
    `;
  };

  window.closeContextPackModal = function() {
    const modal = document.getElementById('context-pack-modal');
    if (modal) modal.style.display = 'none';
  };

  window.copyContextPackScript = function() {
    const pre = document.getElementById('context-pack-script');
    if (pre) {
      navigator.clipboard.writeText(pre.innerText.trim()).then(() => {
        alert('📋 法定任务信封执行脚本已复制到剪贴板！');
        closeContextPackModal();
      }).catch(() => {
        prompt('请手动复制脚本:', pre.innerText.trim());
      });
    }
  };

  window.copyAgentGuidancePrompt = function() {
