  // === 2. 全域 360° 生态血缘与有机穿透抽屉 ===
  window.initUniversalHologramDrawer = function() {
    document.addEventListener('click', function(e) {
      const target = e.target.closest('[data-entity-id]');
      if (target) {
        const entityId = target.getAttribute('data-entity-id');
        if (entityId) {
          e.preventDefault();
          window.openUniversalHologramDrawer(entityId);
        }
      }
    });
  };

  window.openUniversalHologramDrawer = function(entityId) {
    const backdrop = document.getElementById('universal-hologram-drawer-backdrop');
    const drawer = document.getElementById('universal-hologram-drawer');
    const title = document.getElementById('hologram-title');
    const badge = document.getElementById('hologram-badge');
    const content = document.getElementById('hologram-content');

    if (!drawer || !backdrop || !content) return;

    backdrop.style.display = 'block';
    drawer.style.display = 'flex';
    setTimeout(() => {
      backdrop.classList.add('active');
      drawer.classList.add('open');
    }, 10);

    if (title) title.textContent = `全息血缘: ${entityId}`;
    if (badge) badge.textContent = 'LOADING';
    content.innerHTML = `
      <div style="padding:40px;text-align:center;color:var(--muted)">
        <div style="font-size:24px;margin-bottom:8px">🌐</div>
        <div>正在动态穿透计算 [${entityId}] 的六维全息生态血缘图谱...</div>
      </div>
    `;

    fetch(`/api/v1/entity/hologram?id=${encodeURIComponent(entityId)}`)
      .then(res => res.json())
      .then(payload => {
        const d = payload.data || payload;
        renderHologramDrawerContent(d);
      })
      .catch(err => {
        content.innerHTML = `
          <div style="color:var(--red);padding:20px;background:var(--redwash);border-radius:8px">
            <strong>全息血缘穿透失败:</strong> ${err.message}
          </div>
        `;
      });
  };

  window.closeUniversalHologramDrawer = function() {
    const backdrop = document.getElementById('universal-hologram-drawer-backdrop');
    const drawer = document.getElementById('universal-hologram-drawer');
    if (!drawer || !backdrop) return;

    backdrop.classList.remove('active');
    drawer.classList.remove('open');
    setTimeout(() => {
      backdrop.style.display = 'none';
      drawer.style.display = 'none';
    }, 280);
  };

  function renderHologramDrawerContent(data) {
    const title = document.getElementById('hologram-title');
    const badge = document.getElementById('hologram-badge');
    const content = document.getElementById('hologram-content');

    if (title) title.textContent = data.title || data.id;
    if (badge) badge.textContent = (data.entity_type || 'ENTITY').toUpperCase();

    const lin = data.lineage || {};
    const jumps = data.quick_jumps || [];

    // 检查是否有待决提案关联
    const hasPendingProps = liveProposals.some(p => p.description && p.description.includes(data.id));

    content.innerHTML = `
      <!-- 基础元数据身份证 -->
      <div class="hologram-dim-card" style="background:#fff;border-left:4px solid var(--blue)">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div>
            <div style="display:flex;align-items:center;gap:6px">
              <span class="chip good mono" style="font-weight:700">${data.layer || 'LAYER'}</span>
              <strong style="font-size:15px">${data.title}</strong>
              <span class="small muted">(${data.id})</span>
            </div>
            <div class="small muted" style="margin-top:4px">${data.layer_name || ''} · ${data.role || ''}</div>
          </div>
          <span class="chip ${lin.gates_and_evidence?.status === 'PASS' ? 'good' : 'warn'}">
            ${lin.gates_and_evidence?.status || 'PASS'}
          </span>
        </div>
        <p class="small muted" style="margin:8px 0 0;line-height:1.4">${data.summary || ''}</p>
        ${hasPendingProps ? `
          <div style="margin-top:8px;background:#fffdfa;border:1px solid #fde68a;padding:6px 10px;border-radius:5px;font-size:11.5px;color:#92400e;display:flex;justify-content:space-between;align-items:center">
            <span>⚠️ 该组件存在待夏明星主权裁决的提案</span>
            <button class="btn" style="padding:2px 6px;font-size:10.5px;color:#b45309" onclick="roamToAnchor('#personal')">直达决策池 ➔</button>
          </div>
        ` : ''}
      </div>

      <!-- 快捷跨板块漫游导航 -->
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px">
        ${jumps.map(j => `
          <button class="hologram-jump-btn" onclick="roamToAnchor('${j.hash}', '${j.tab || ''}')">
            ${j.label} ➔
          </button>
        `).join('')}
      </div>

      <!-- 维度 1: MOF 元模型约束与质量门禁 -->
      <div class="hologram-dim-card">
        <div class="hologram-dim-title">
          <span>🛡️</span>
          <span>MOF 契约与质量门禁 (MOF Contracts & Gates)</span>
        </div>
        <div class="hologram-pill-group">
          ${(lin.mof_contracts || []).map(c => `
            <div class="hologram-pill" onclick="roamToAnchor('#mof-grid')">
              <span style="color:#047857">✓</span>
              <span>${c}</span>
            </div>
          `).join('')}
        </div>
        <div class="small muted" style="margin-top:6px;font-size:10.5px">
          证据链级别: <b>${lin.gates_and_evidence?.evidence_level || 'Level 3'}</b> · 校验摘要: <code>${lin.gates_and_evidence?.audit_digest || 'sha256:...'}</code>
        </div>
      </div>

      <!-- 维度 2: 上下游有机依赖拓扑 -->
      <div class="hologram-dim-card">
        <div class="hologram-dim-title">
          <span>↕</span>
          <span>上下游有机调用链 (Dependencies & Consumers)</span>
        </div>
        <div style="font-size:11.5px;margin-bottom:4px;color:var(--muted)">上游所依赖的基础模块:</div>
        <div class="hologram-pill-group" style="margin-bottom:10px">
          ${(lin.upstream_dependencies || []).map(up => `
            <div class="hologram-pill" onclick="window.openUniversalHologramDrawer('${up}')">
              <span>↑ ${up}</span>
            </div>
          `).join('') || '<span class="small muted">无上游依赖 (属于根基协议层)</span>'}
        </div>
        <div style="font-size:11.5px;margin-bottom:4px;color:var(--muted)">下游消费与集成者:</div>
        <div class="hologram-pill-group">
          ${(lin.downstream_consumers || []).map(down => `
            <div class="hologram-pill" onclick="window.openUniversalHologramDrawer('${down}')">
              <span>↓ ${down}</span>
            </div>
          `).join('') || '<span class="small muted">无下游直接调用者</span>'}
        </div>
      </div>

      <!-- 维度 3: 承载的三年规划 BET 台账 -->
      <div class="hologram-dim-card">
        <div class="hologram-dim-title">
          <span>▤</span>
          <span>关联三年规划 BET 台账 (3Y-BET-LEDGER)</span>
        </div>
        <div class="hologram-pill-group">
          ${(lin.associated_bets || []).map(b => `
            <div class="hologram-pill" onclick="roamToAnchor('#ledger')">
              <span style="color:#b45309">●</span>
              <span>${b}</span>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- 维度 4: 本地主权算力与模型星系绑定 -->
      <div class="hologram-dim-card">
        <div class="hologram-dim-title">
          <span>☵</span>
          <span>主权算力与模型星系 (Compute & Model Galaxy)</span>
        </div>
        <div class="hologram-pill-group">
          ${(lin.compute_and_models || []).map(m => `
            <div class="hologram-pill" onclick="roamToAnchor('#topology', 'galaxy')">
              <span style="color:#1d4ed8">⚡</span>
              <span>${m}</span>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- 维度 5: 活跃 Agent 工作树与并发冲突风险 -->
      <div class="hologram-dim-card" style="${lin.agent_worktrees?.risk_level === 'CRITICAL' ? 'border-color:var(--red);background:var(--redwash)' : ''}">
        <div class="hologram-dim-title">
          <span>↔</span>
          <span>并发工作树与冲突防御 (Multi-Agent Collision Guard)</span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;margin-bottom:6px">
          <span>当前挂载工作树数: <b>${lin.agent_worktrees?.active_count || 0}</b></span>
          <span class="chip ${lin.agent_worktrees?.risk_level === 'CLEAN' ? 'good' : lin.agent_worktrees?.risk_level === 'HIGH' ? 'warn' : 'bad'}">
            风险: ${lin.agent_worktrees?.risk_level || 'CLEAN'}
          </span>
        </div>
        ${lin.agent_worktrees?.branches?.length ? `
          <div class="small muted" style="margin-top:4px">
            活跃分支: <code>${lin.agent_worktrees.branches.join(', ')}</code><br>
            作业 Agent: <code>${lin.agent_worktrees.agents.join(', ')}</code>
          </div>
        ` : '<div class="small muted">目前无并发争用，工作树状态干净。</div>'}
      </div>

      <!-- 维度 6: 开放接口契约全景 -->
      <div class="hologram-dim-card">
        <div class="hologram-dim-title">
          <span>⚙</span>
          <span>对外开放接口契约 (Exported Interfaces)</span>
        </div>
        <div class="statline" style="padding:0">
          <div><strong>${lin.interfaces_summary?.mcp_tools || 0}</strong><span>MCP Tools</span></div>
          <div><strong>${lin.interfaces_summary?.bos_services || 0}</strong><span>BOS Services</span></div>
          <div><strong>${lin.interfaces_summary?.cli_commands || 0}</strong><span>CLI Commands</span></div>
        </div>
      </div>
    `;
  }

  // Agent 变更前置仿真探针
  window.runPreflightSimulation = async function() {
    const pathInput = document.getElementById('preflight-path-input');
    const branchSelect = document.getElementById('preflight-branch-select');
    const resultBox = document.getElementById('preflight-probe-result');
    if (!resultBox) return;

    const path = (pathInput ? pathInput.value : '').trim();
    const branch = (branchSelect ? branchSelect.value : 'main').trim();

    if (!path) {
      resultBox.style.display = 'block';
      resultBox.style.background = '#fef2f2';
      resultBox.style.border = '1px solid #fecaca';
      resultBox.style.color = '#991b1b';
      resultBox.innerHTML = '⚠️ 请先输入拟修改的文件路径。';
      return;
    }

    resultBox.style.display = 'block';
    resultBox.style.background = '#f1f5f9';
    resultBox.style.border = '1px solid #cbd5e1';
    resultBox.style.color = '#334155';
    resultBox.innerHTML = '⏳ 正在向 GaC 守卫与 Write Owners 探针探测...';

    try {
      const res = await fetch(`/api/v1/agent/preflight?path=${encodeURIComponent(path)}&branch=${encodeURIComponent(branch)}`);
      const json = await res.json();
      const data = json.data || {};

      const isSafe = data.safe_to_edit;
      resultBox.style.background = isSafe ? '#f0fdf4' : '#fef2f2';
      resultBox.style.border = `1px solid ${isSafe ? '#86efac' : '#fca5a5'}`;
      resultBox.style.color = isSafe ? '#166534' : '#991b1b';

      resultBox.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <strong>${isSafe ? '✅ 变更仿真探针：放行 (SAFE TO PROCEED)' : '❌ 变更仿真探针：阻断风险 (BLOCKED)'}</strong>
          <span class="chip ${isSafe ? 'good' : 'bad'}" style="font-size:10px">${isSafe ? '工作树合规' : '主仓违规'}</span>
        </div>
        <div style="font-size:11.5px;line-height:1.5;margin-bottom:6px">
          <b>模块归属:</b> <code>${data.owner || '未归类'}</code> · <b>建议动作:</b> <code>${data.recommended_action || ''}</code>
        </div>
        <div style="font-size:11px;margin-bottom:6px">
          ${(data.guidance || []).map(g => `<div>${g}</div>`).join('')}
        </div>
        ${!isSafe ? `
          <div style="margin-top:6px;padding-top:6px;border-top:1px dashed #fca5a5">
            <button class="btn" style="font-size:11px;padding:3px 8px;background:white;color:#991b1b;border-color:#fca5a5" onclick="navigator.clipboard.writeText('bash bin/gac/gac-worktree.sh claim my-session').then(()=>alert('已复制工作树认领命令：bash bin/gac/gac-worktree.sh claim my-session'))">
              📋 复制隔离工作树起手指令
            </button>
          </div>
        ` : ''}
      `;
    } catch (e) {
      resultBox.style.background = '#fef2f2';
      resultBox.style.border = '1px solid #fca5a5';
      resultBox.style.color = '#991b1b';
      resultBox.innerHTML = `❌ 探针请求异常: ${e.message}`;
    }
  };

  // 复制纯语义极速 Context Pack
  window.copyPureSemanticContextPack = async function() {
    try {
      const res = await fetch('/api/v1/agent/readiness');
      const json = await res.json();
      const data = json.data || {};
      const env = data.environment || {};
      const ident = data.agent_identity || {};
      const act = data.action_envelope || {};
      const axioms = data.safeguard_axioms || [];
      const metrics = data.vital_metrics || {};

      const mdText = `# OMOStation Sovereign OS — Agent Rapid Context Pack
> Generated at: ${data.timestamp || new Date().toISOString()} | Service: ${data.service} | Status: ${data.status}

## 1. Environment & Physical Isolation
- Execution Mode: ${env.mode}
- PASW Enforced: ${env.pasw_enforced} (Main branch is strictly read-only)
- Mandatory Worktree Bootstrap: \`${env.mandatory_worktree_bootstrap}\`
- Forbidden Actions: ${(env.forbidden_actions || []).join('; ')}

## 2. Identity & Governance Scope
- Principal: ${ident.sovereign_principal}
- Governance: ${ident.governance_mode}
- Write Surfaces Allowlist: ${(ident.write_surfaces_allowlist || []).join(', ')}
- Immutable Surfaces: ${(ident.immutable_surfaces || []).join(', ')}

## 3. Recommended Action Envelope
- Active Action ID: ${act.active_action_id}
- Recommended Next Task: ${act.recommended_next_task}
- Bootstrap Command: \`${act.workflow_bootstrap_command}\`
- Start Command: \`${act.workflow_start_command}\`
- Compliance Check: \`${act.compliance_check_command}\`

## 4. Five Safeguard Axioms (Avoid Pitfalls)
${axioms.map((a, i) => `${i + 1}. ${a}`).join('\n')}

## 5. System Vital Metrics
- Portfolio Completion: ${metrics.portfolio_done_bets}/${metrics.portfolio_total_bets} (${metrics.completion_rate})
- Active OODA Loops: ${metrics.live_loops_count}
- GaC Rules Enforced: ${metrics.gac_rules_enforced}
- Inference Gateway: ${metrics.inference_gateway}
`;

      await navigator.clipboard.writeText(mdText);
      alert('✅ 纯语义 LLM Context Pack 已复制到剪贴板！\\n包含物理隔离红线、Write Owners 范围、5 大避坑铁律与法定启动指令，可直接用于 Prompt 注入。');
    } catch (e) {
      alert(`复制失败: ${e.message}`);
    }
  };

  // 快捷填入并触发 Preflight 仿真
  window.setPreflightTarget = function(path) {
    const input = document.getElementById('preflight-path-input');
    if (input) {
      input.value = path;
      if (typeof window.runPreflightSimulation === 'function') {
        window.runPreflightSimulation();
      }
    }
  };

  // 跨板块与跨 Tab 漫游平滑跳转
  window.roamToAnchor = function(hash, subtab) {
    window.closeUniversalHologramDrawer();
    location.hash = hash;
    const target = document.querySelector(hash);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth' });
    }
    if (subtab && window.switchTopologyTab) {
      setTimeout(() => {
        window.switchTopologyTab(subtab);
      }, 200);
    }
  };

  // === 4. 全域全息指挥罗盘 (Omni-Command Palette) & 实时遥测流 ===
  let currentOmniFilter = 'all';
  let omniResults = [];
  let selectedOmniIndex = 0;
  let omniDebounceTimer = null;
  let liveTelemetryEventSource = null;

  window.openCommandPalette = function() {
    const modal = document.getElementById('omni-command-modal');
    const input = document.getElementById('omni-palette-input');
    if (!modal) return;
    modal.style.display = 'flex';
    if (input) {
      input.value = '';
      input.focus();
    }
    setOmniFilter('all');
    performOmniSearch('');
  };

  window.closeCommandPalette = function() {
    const modal = document.getElementById('omni-command-modal');
    if (modal) modal.style.display = 'none';
  };

  window.setOmniFilter = function(filter) {
    currentOmniFilter = filter;
    document.querySelectorAll('#omni-category-chips .omni-chip').forEach(chip => {
      chip.classList.toggle('active', chip.getAttribute('onclick')?.includes(`'${filter}'`));
    });
    const input = document.getElementById('omni-palette-input');
    performOmniSearch(input ? input.value : '');
  };

  function performOmniSearch(query) {
    clearTimeout(omniDebounceTimer);
    omniDebounceTimer = setTimeout(() => {
      executeOmniSearch(query.trim());
    }, 120);
  }

  async function executeOmniSearch(q) {
    const container = document.getElementById('omni-results-container');
    const countEl = document.getElementById('omni-results-count');
    if (!container) return;

    let localMatches = getLocalEntitiesMatches(q, currentOmniFilter);
    
    // 如果存在后端搜索接口，拉取补充真实数据
    try {
      let url = `/api/v1/search?q=${encodeURIComponent(q)}&limit=30`;
      if (currentOmniFilter !== 'all') {
        const kindMap = { bet: 'bet', mof: 'constraint', scene: 'scene', model: 'model', bos: 'service', proposal: 'proposal' };
        if (kindMap[currentOmniFilter]) {
          url += `&kind=${kindMap[currentOmniFilter]}`;
        }
      }
      const res = await fetch(url);
      if (res.ok) {
        const payload = await res.json();
        const serverItems = (payload.data && payload.data.items) || [];
        const seen = new Set(localMatches.map(m => m.id));
        for (const item of serverItems) {
          if (!seen.has(item.id)) {
            localMatches.push({
              id: item.id,
              title: item.title || item.id,
              kind: item.kind || 'entity',
              status: item.declared_status || item.facts?.status || 'active',
              desc: item.facts?.raw_id || item.source?.path || item.kind,
              source: 'api'
            });
            seen.add(item.id);
          }
        }
      }
    } catch (e) {
      console.warn('Omni remote search fallback:', e);
    }

    omniResults = localMatches.slice(0, 40);
    selectedOmniIndex = 0;
    if (countEl) {
      const meshNodes = ((((window.D||{}).strategic||{}).cross_plane_mesh||{}).summary||{}).total_nodes;
      countEl.dataset.locked = '1';
      countEl.textContent = meshNodes!=null
        ? (`匹配到 ${omniResults.length} 项 (全域 ${meshNodes} 节点)`)
        : (`匹配到 ${omniResults.length} 项 (全域节点 NO_DATA)`);
    }

    renderOmniResults();
  }

  function getLocalEntitiesMatches(q, filter) {
    const results = [];
    const lowerQ = q.toLowerCase();

    // 1. 静态 Snapshot 中的 entities (如果 window.D 可用)
    const snapshotD = window.D || (document.getElementById('snapshot') ? JSON.parse(document.getElementById('snapshot').textContent) : null);
    if (snapshotD) {
      // BET 台账
      if ((filter === 'all' || filter === 'bet') && snapshotD.portfolio && snapshotD.portfolio.candidate_bets) {
        for (const b of snapshotD.portfolio.candidate_bets) {
          const str = (typeof b === 'string' ? b : (b.id + ' ' + (b.title || ''))).toLowerCase();
          if (!lowerQ || str.includes(lowerQ)) {
            const id = typeof b === 'string' ? b : b.id;
            results.push({
              id: id.startsWith('bet:') ? id : `bet:${id}`,
              title: typeof b === 'string' ? b : (b.title || b.id),
              kind: 'bet',
              status: 'active',
              desc: '三年规划战略台账投注项',
              hash: '#orient'
            });
          }
        }
      }

      // Next Actions
      if ((filter === 'all' || filter === 'bet' || filter === 'proposal') && snapshotD.next_actions) {
        for (const act of snapshotD.next_actions) {
          const str = `${act.id} ${act.title || ''} ${act.summary || ''}`.toLowerCase();
          if (!lowerQ || str.includes(lowerQ)) {
            results.push({
              id: act.id,
              title: act.title || act.id,
              kind: 'action',
              status: act.status || 'pending',
              desc: act.summary || '治理自愈与演进动作',
              hash: '#tasks'
            });
          }
        }
      }

      // 治理门禁
      if ((filter === 'all' || filter === 'mof') && snapshotD.roadmap && snapshotD.roadmap.gates) {
        for (const g of snapshotD.roadmap.gates) {
          const str = `${g.id} ${g.owner_role || ''}`.toLowerCase();
          if (!lowerQ || str.includes(lowerQ)) {
            results.push({
              id: `gate:${g.id}`,
              title: `门禁 ${g.id}: ${g.owner_role || '准入核验'}`,
              kind: 'gate',
              status: g.state || 'active',
              desc: `Exit: ${(g.exit || []).join('; ')}`,
              hash: '#orient'
            });
          }
        }
      }
    }

    // 2. liveProposals (真实待决提案)
    if (filter === 'all' || filter === 'proposal') {
      for (const p of liveProposals) {
        const str = `${p.id} ${p.title || ''} ${p.summary || ''}`.toLowerCase();
        if (!lowerQ || str.includes(lowerQ)) {
          results.push({
            id: p.id,
            title: p.title || p.id,
            kind: 'proposal',
            status: p.status,
            desc: `提出者: ${p.proposer || 'resident-guardian'} · 类型: ${p.type}`,
            hash: '#workbench'
          });
        }
      }
    }

    // 3. MOF 核心硬约束
    if (filter === 'all' || filter === 'mof') {
      const mofAxioms = [
        { id: 'META-CON-01', title: '全域单向分层契约 (DFSQ/SFOP)', kind: 'mof', desc: '禁止向上逆向引用，严格遵循道法术器结构', hash: '#mof-matrix' },
        { id: 'META-CON-04', title: '主权状态自引用边界隔离', kind: 'mof', desc: '严禁向 .omo/ 写入长生命周期运行逻辑', hash: '#mof-matrix' },
        { id: 'META-CON-08', title: '主权算力路由锁定 (AetherForge)', kind: 'mof', desc: '所有本地推理强制走 bos://compute/aetherforge/infer', hash: '#compute' }
      ];
      for (const m of mofAxioms) {
        const str = `${m.id} ${m.title} ${m.desc}`.toLowerCase();
        if (!lowerQ || str.includes(lowerQ)) {
          results.push(m);
        }
      }
    }

    // 4. 业务场景卡与 BOS 服务
    if (filter === 'all' || filter === 'scene' || filter === 'bos') {
      const presets = [
        { id: 'SCENE-001', title: '技术调研与架构决策 (Tech Research)', kind: 'scene', desc: '5阶段价值旅程 · 影子演进中', hash: '#workbench' },
        { id: 'SCENE-002', title: '代码演化与自动化重构 (Refactor)', kind: 'scene', desc: '5阶段价值旅程 · 严密受控', hash: '#workbench' },
        { id: 'bos://compute/aetherforge/infer', title: 'AetherForge 本地大模型统一推理网关', kind: 'bos', desc: '主权本地算力调度中心', hash: '#compute' },
        { id: 'bos://governance/c2g/adjudicate', title: 'C2G 人类意志主权签署裁决服务', kind: 'bos', desc: '夏明星签名核验与自适应强化学习', hash: '#governance' }
      ];
      for (const pr of presets) {
        if (filter === 'scene' && pr.kind !== 'scene') continue;
        if (filter === 'bos' && pr.kind !== 'bos') continue;
        const str = `${pr.id} ${pr.title} ${pr.desc}`.toLowerCase();
        if (!lowerQ || str.includes(lowerQ)) {
          results.push(pr);
        }
      }
    }

    return results;
  }

  function renderOmniResults() {
    const container = document.getElementById('omni-results-container');
    if (!container) return;

    if (omniResults.length === 0) {
      container.innerHTML = `
        <div style="padding:32px;text-align:center;color:var(--muted)">
          <div style="font-size:24px;margin-bottom:6px">🔍</div>
          <div>未找到匹配的全域实体</div>
          <div class="small" style="margin-top:4px">可尝试搜索 BET、MOF、SCENE、aetherforge 或切换筛选分类</div>
        </div>
      `;
      return;
    }

    container.innerHTML = omniResults.map((item, idx) => {
      const isSelected = idx === selectedOmniIndex;
      const kindColor = getKindColor(item.kind);
      return `
        <div class="omni-result-item ${isSelected ? 'selected' : ''}" id="omni-item-${idx}" onclick="selectOmniItem(${idx})">
          <div style="display:flex;align-items:center;gap:10px;overflow:hidden;flex:1">
            <span class="chip" style="font-size:9.5px;text-transform:uppercase;padding:2px 6px;background:${kindColor.bg};color:${kindColor.text};border-color:${kindColor.border}">
              ${item.kind}
            </span>
            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <div style="font-weight:600;font-size:13px;color:var(--ink);display:flex;align-items:center;gap:6px">
                <span>${escHtml(item.title || item.id)}</span>
                <span class="mono small muted" style="font-size:10.5px">#${escHtml(item.id)}</span>
              </div>
              <div class="small muted" style="font-size:11px;overflow:hidden;text-overflow:ellipsis">
                ${escHtml(item.desc || '')}
              </div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
            <button class="btn" style="padding:3px 8px;font-size:10px;background:var(--bluewash);border-color:var(--blue);color:var(--blue)" onclick="event.stopPropagation(); window.openUniversalHologramDrawer('${item.id}'); closeCommandPalette();">
              🌐 全息
            </button>
            <button class="btn" style="padding:3px 8px;font-size:10px;background:#f8fafc" onclick="event.stopPropagation(); selectOmniItem(${idx});">
              🧭 穿透 ➔
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  function getKindColor(kind) {
    const k = (kind || '').toLowerCase();
    if (k.includes('bet')) return { bg: '#e0f2fe', text: '#0369a1', border: '#7dd3fc' };
    if (k.includes('mof') || k.includes('constraint')) return { bg: '#fee2e2', text: '#b91c1c', border: '#fca5a5' };
    if (k.includes('scene')) return { bg: '#fef3c7', text: '#b45309', border: '#fde68a' };
    if (k.includes('model') || k.includes('compute')) return { bg: '#ede9fe', text: '#6d28d9', border: '#c4b5fd' };
    if (k.includes('proposal')) return { bg: '#fdf2f8', text: '#be185d', border: '#fbcfe8' };
    if (k.includes('bos') || k.includes('service')) return { bg: '#ecfdf5', text: '#047857', border: '#6ee7b7' };
    return { bg: '#f1f5f9', text: '#475569', border: '#cbd5e1' };
  }

  window.selectOmniItem = function(idx) {
    if (idx < 0 || idx >= omniResults.length) return;
    const item = omniResults[idx];
    closeCommandPalette();
    window.openUniversalHologramDrawer(item.id);
    if (item.hash) {
      setTimeout(() => {
        window.roamToAnchor(item.hash, item.tab);
      }, 300);
    }
  };

  // 全局键盘监听 (⌘K / ESC / 上下选择)
  window.addEventListener('keydown', (e) => {
    const modal = document.getElementById('omni-command-modal');
    const isModalOpen = modal && modal.style.display !== 'none';

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (isModalOpen) {
        closeCommandPalette();
      } else {
        openCommandPalette();
      }
      return;
    }

    if (!isModalOpen) return;

    if (e.key === 'Escape') {
      closeCommandPalette();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (omniResults.length > 0) {
        selectedOmniIndex = (selectedOmniIndex + 1) % omniResults.length;
        renderOmniResults();
        const cur = document.getElementById(`omni-item-${selectedOmniIndex}`);
        if (cur) cur.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (omniResults.length > 0) {
        selectedOmniIndex = (selectedOmniIndex - 1 + omniResults.length) % omniResults.length;
        renderOmniResults();
        const cur = document.getElementById(`omni-item-${selectedOmniIndex}`);
        if (cur) cur.scrollIntoView({ block: 'nearest' });
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      selectOmniItem(selectedOmniIndex);
    }
  });

  // 绑定输入事件
  function bindOmniInput() {
    const input = document.getElementById('omni-palette-input');
    if (input && !input._bound) {
      input._bound = true;
      input.addEventListener('input', (e) => {
        performOmniSearch(e.target.value);
      });
    }
  }

  // === 5. 实时遥测流 (SSE Client) & 事件浮窗终端 ===
  window.initLiveTelemetryStream = function() {
    if (liveTelemetryEventSource) return;
    try {
      liveTelemetryEventSource = new EventSource('/api/v1/events/stream');
      const badge = document.getElementById('telemetry-stream-badge');
      const dot = badge ? badge.querySelector('.telemetry-pulse-dot') : null;
      const text = badge ? badge.querySelector('span:last-child') : null;

      liveTelemetryEventSource.onopen = () => {
        if (text) text.textContent = '实时遥测流: 已连接';
        if (dot) dot.style.background = '#10b981';
      };

      liveTelemetryEventSource.addEventListener('connected', (e) => {
        try {
          const data = JSON.parse(e.data);
          appendTelemetryLog('SYSTEM', '实时遥测流握手事件已收到；显存与回路健康未记录');
        } catch (err) {}
      });

      liveTelemetryEventSource.addEventListener('pulse', (e) => {
        try {
          const p = JSON.parse(e.data);
          const time = new Date(p.timestamp).toLocaleTimeString();
          appendTelemetryLog('PULSE', `[${time}] 收到周期 #${p.cycle} 心跳事件；回路健康未记录`, '#38bdf8');
        } catch (err) {}
      });

      liveTelemetryEventSource.addEventListener('snapshot_updated', (e) => {
        try {
          const s = JSON.parse(e.data);
          const time = new Date(s.timestamp || Date.now()).toLocaleTimeString();
          appendTelemetryLog('SNAPSHOT', `[${time}] 收到快照更新事件 (代际: ${s.generation_id || '未记录'})；新鲜度请查来源状态`, '#60a5fa');
          refreshProposals();
          if (typeof window.requestSnapshotRefresh === 'function') {
            window.requestSnapshotRefresh(s);
          }
        } catch (err) {}
      });

      liveTelemetryEventSource.onerror = () => {
        if (text) text.textContent = '实时遥测流: 重连中...';
        if (dot) dot.style.background = '#f59e0b';
      };
    } catch (e) {
      console.warn('SSE not supported or failed to connect:', e);
    }
  };

  window.toggleTelemetryTicker = function() {
    const drawer = document.getElementById('telemetry-ticker-drawer');
    if (!drawer) return;
    if (drawer.style.display === 'none' || !drawer.style.display) {
      drawer.style.display = 'flex';
    } else {
      drawer.style.display = 'none';
    }
  };

  window.clearTelemetryLogs = function() {
    const term = document.getElementById('telemetry-terminal-logs');
    if (term) term.innerHTML = '<div class="ticker-line"><span class="ticker-time">[CLEARED]</span> <span>终端日志已清空</span></div>';
  };

  function appendTelemetryLog(source, msg, color = '#38bdf8') {
    const term = document.getElementById('telemetry-terminal-logs');
    if (!term) return;
    const time = new Date().toLocaleTimeString();
    const row = document.createElement('div');
    row.className = 'ticker-line';
    row.innerHTML = `<span class="ticker-time">[${time}]</span> <span class="ticker-source" style="color:${color}">[${source}]</span> <span>${escHtml(msg)}</span>`;
    term.appendChild(row);
    if (term.childNodes.length > 80) {
      term.removeChild(term.firstChild);
    }
    term.scrollTop = term.scrollHeight;
  }

  function escHtml(str) {
    return String(str || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // 自动挂载
  function mountAll() {
    window.initPersonaSystem();
    window.initUniversalHologramDrawer();
    bindOmniInput();
    window.initLiveTelemetryStream();
  }

  document.addEventListener('DOMContentLoaded', mountAll);
})();

/**
 * 生态整合追加层 — Phase 2/4 (systemic-integration plan, ~/.claude/plans/dashboard-immutable-possum.md)
 * 只做加法：本 IIFE 在全部 8 个 *_ui.js 文件执行完毕后运行（脚本拼接顺序中排最后），
 * 只用 prepend/append 往已存在的 section 里插入新卡片，绝不对任何 section 做 innerHTML=
 * 覆盖，因此不依赖也不改变各 section 原本由哪个文件、以什么方式写入内容。
 */
(function () {
  'use strict';
  const byId = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // === Layer 4: cockpit-ui 精选功能深链（诚实标注：需本地先跑 `bun dev` 才可达） ===
  const COCKPIT_DEV_ORIGIN = 'http://localhost:5173';
  const cockpitLinks = [
    { panelId: 'health', route: '/l4-health', label: 'L4 域健康', note: '分层健康度与风险可视化' },
    { panelId: 'trace', route: '/decision-graph', label: '决策因果图', note: '节点展开与路径高亮交互' },
    { panelId: 'swarm', route: '/swarm', label: 'Swarm 协同', note: 'Agent 协同实时态卡片' },
    { panelId: 'value', route: '/bcos', label: 'BCOS 北极星', note: '北极星价值度量（NOT_PROVEN 标注保持不变）' },
    { panelId: 'gov', route: '/governance-domain', label: '治理域工作台', note: '域治理、合规检查、SSOT 巡检完整表单流' }
  ];
  function buildCockpitCard(entry) {
    const url = COCKPIT_DEV_ORIGIN + entry.route;
    const wrap = document.createElement('div');
    wrap.className = 'card gap ecosystem-cockpit-link';
    wrap.style.cssText = 'border:1px dashed var(--blue);background:var(--bluewash)';
    wrap.innerHTML = '<div class="row" style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">' +
      '<div><b>🧭 cockpit-ui · ' + esc(entry.label || entry.route) + '</b>' +
      '<div class="small muted" style="margin-top:3px">' + esc(entry.note || '') + '（' + esc(entry.route) + '）</div></div>' +
      '<a class="btn small" href="' + esc(url) + '" target="_blank" rel="noopener">在 cockpit-ui 中打开 →</a></div>' +
      '<p class="small muted" style="margin:6px 0 0">深链，非嵌入；需本地先执行 <code>bun dev</code>（cockpit-ui 默认端口 5173）才可达，未启动时链接会打不开。</p>';
    return wrap;
  }
  function mountCockpitLinks() {
    cockpitLinks.forEach(entry => {
      const section = byId(entry.panelId);
      if (!section || section.querySelector('.ecosystem-cockpit-link')) return;
      const head = section.querySelector('.section-head');
      const card = buildCockpitCard(entry);
      if (head && head.nextSibling) head.parentNode.insertBefore(card, head.nextSibling);
      else section.appendChild(card);
    });
  }

  // === Layer 2（简化、零风险版）: 战略/战术/战斗 三态导航目录 ===
  // 不克隆、不搬移任何现有面板内容（面板内部归属复杂，克隆有 DOM/ID 冲突风险）；
  // 只提供一张真实存在的板块的三态索引卡片，帮助按"目的高度"而不是按字母/主题重新找到已存在的真实入口。
  const lensGroups = [
    { key: 'strategy', label: '🎯 战略视角', desc: '回答"我们要成为什么样的系统" — 纲领、体系地图、目标承诺', ids: ['panorama', 'orient', 'ledger'] },
    { key: 'tactics', label: '⚔️ 战术视角', desc: '回答"当前在打哪几场仗，下一步法定动作是什么"', ids: ['next', 'ledger', 'gov'] },
    { key: 'battle', label: '🛰️ 战斗/落地视角', desc: '回答"此刻系统真实在发生什么，证据是什么"', ids: ['swarm', 'metrics', 'health', 'logs'] }
  ];
  const panelLabel = {
    panorama: '白皮书指导', orient: '全景总览', ledger: '3Y台账与甘特', next: '接下来做什么', gov: '恢复准入',
    swarm: 'Agent 协同', metrics: '指标度量', health: '健康诊断', logs: '事件日志'
  };
  function buildStrategyLensCard() {
    const card = document.createElement('div');
    card.className = 'card gap ecosystem-lens-card';
    card.innerHTML = '<h3 style="margin:0 0 4px">🧭 全景总览 · 战略 / 战术 / 战斗三态速览</h3>' +
      '<p class="small muted" style="margin:0 0 12px">用三个"目的高度"重新进入下面同一套真实板块；此处只做索引跳转，不复制、不合成任何数据 —— 真实数字请在目标板块里看。</p>' +
      '<div class="grid three gap" style="grid-template-columns:repeat(3,minmax(0,1fr))">' +
      lensGroups.map(group => '<div class="card" style="background:var(--paper)"><b>' + esc(group.label) + '</b>' +
        '<div class="small muted gap">' + esc(group.desc) + '</div>' +
        '<div class="small gap">' + group.ids.map(id => '<a href="#' + esc(id) + '">' + esc(panelLabel[id] || id) + '</a>').join(' · ') + '</div></div>').join('') +
      '</div>';
    return card;
  }
  function mountStrategyLensCard() {
    const panoramaNodes = [...document.querySelectorAll('[id="panorama"]')];
    panoramaNodes.forEach(section => {
      if (section.querySelector('.ecosystem-lens-card')) return;
      const head = section.querySelector('.section-head');
      const card = buildStrategyLensCard();
      if (head && head.nextSibling) head.parentNode.insertBefore(card, head.nextSibling);
      else section.insertBefore(card, section.firstChild);
    });
  }

  // === 跨板块合成条（镜头卡模式，纯深链不复制数据）===
  function buildLensCard(title, desc, targets) {
    const card = document.createElement('div');
    card.className = 'card gap ecosystem-lens-card';
    card.setAttribute('data-lens-card', title);
    card.innerHTML = '<h3 style="margin:0 0 4px">🔍 ' + esc(title) + '</h3>' +
      '<p class="small muted" style="margin:0 0 10px">' + esc(desc) + ' — 此处只做索引跳转，不复制、不合成任何数据。</p>' +
      '<div class="small gap" style="display:flex;flex-wrap:wrap;gap:6px">' +
      targets.map(t => '<a href="#' + esc(t.href) + '" class="chip" style="text-decoration:none;background:var(--bluewash);border-color:var(--blue);color:var(--blue)">' + esc(t.label) + ' <span class="muted">· ' + esc(t.desc) + '</span></a>').join('') +
      '</div>';
    return card;
  }
  function mountLensCard(title, desc, targets) {
    const section = byId('orient');
    if (!section || section.querySelector('[data-lens-card="' + title + '"]')) return;
    const head = section.querySelector('.section-head') || section.querySelector('.orient-l0');
    const card = buildLensCard(title, desc, targets);
    card.setAttribute('data-synthesis-card', 'cross-domain');
    if (head && head.nextSibling) head.parentNode.insertBefore(card, head.nextSibling);
    else section.insertBefore(card, section.firstChild);
  }

  // BET-Y2Q2-T8-04: 跨板块合成镜头卡 — 与 lens-card 不同，合成卡会聚合跨板块数据
  function buildSynthesisCard(title, desc, targets) {
    const card = document.createElement('div');
    card.className = 'card gap ecosystem-lens-card synthesis-card';
    card.setAttribute('data-synthesis-card', title);
    card.style.cssText = 'border-left:3px solid var(--teal);background:linear-gradient(135deg, var(--paper) 0%, var(--greenwash) 100%)';
    card.innerHTML = '<h3 style="margin:0 0 4px">🔗 ' + esc(title) + '</h3>' +
      '<p class="small muted" style="margin:0 0 10px">' + esc(desc) + ' — 跨板块合成，不复制原始数据。</p>' +
      '<div class="small gap" style="display:flex;flex-wrap:wrap;gap:6px">' +
      targets.map(t => '<a href="#' + esc(t.href) + '" class="chip" style="text-decoration:none;background:var(--greenwash);border-color:var(--teal);color:var(--teal)">' + esc(t.label) + ' <span class="muted">· ' + esc(t.desc) + '</span></a>').join('') +
      '</div>';
    return card;
  }
  function mountSynthesisCard(title, desc, targets) {
    const section = byId('orient');
    if (!section || section.querySelector('[data-synthesis-card="' + title + '"]')) return;
    const head = section.querySelector('.section-head') || section.querySelector('.orient-l0');
    const card = buildSynthesisCard(title, desc, targets);
    if (head && head.nextSibling) head.parentNode.insertBefore(card, head.nextSibling);
    else section.insertBefore(card, section.firstChild);
  }

  // === 全域能力地图: 织星 25 板块 + cockpit-ui 56 路由，一张页面看全部 ===
  const _horizons = window.ZHIXING_STRATEGIC_HORIZONS || [
    { horizonId: 'h-sovereign', title: '👑 主权中心与决策中枢', desc: '最高执掌视野 · 北极星价值 · 中枢决策', subPanels: ['personal', 'orient', 'workbench'] },
    { horizonId: 'h-strategy', title: '🧭 战略路线与任务推进', desc: '三年台账 · 法定行动 · 体系拓扑', subPanels: ['ledger', 'next', 'arch', 'topology', 'atlas'] },
    { horizonId: 'h-scenes', title: '🃏 业务场景与价值流转', desc: '场景生命周期 · 伴随验证 · 4大闭环回路', subPanels: ['scene-system', 'loops', 'value', 'metrics'] },
    { horizonId: 'h-swarm', title: '🤖 智能蜂群与算力织网', desc: 'Agent 状态 · 算力服务 · 因果拓扑', subPanels: ['swarm', 'trace', 'logs'] },
    { horizonId: 'h-governance', title: '🛡️ 治理防御与知识全景', desc: 'L4 门禁 · MOF 约束 · 知识资产', subPanels: ['gov', 'health', 'mof-grid', 'capabilities', 'know', 'knowledge-memory', 'learning', 'skills-inventory', 'panorama'] }
  ];

  const _titles = window.ZHIXING_PANEL_TITLES || (window.ZHIXING_NAV_LABELS ? Object.fromEntries(Object.entries(window.ZHIXING_NAV_LABELS).map(function(pair){ return [pair[0], pair[1].replace(/^[^\s]+\s/, '')]; })) : {});
  const zhixingLabel = Object.assign({ 'ecosystem-map': '全域能力地图' }, panelLabel, _titles);
  const cockpitGroups = [
    { label: '总览与导航', items: [['/', '首页'], ['/guide', '驾驶舱指南'], ['/system-map', '系统地图'], ['/capabilities', '能力全景']] },
    { label: '工作案件', items: [['/cases', '案件']] },
    { label: '运行与观测', items: [['/overview', '概览中心'], ['/mesh', '网格与 MCP'], ['/topology', '全局拓扑'], ['/compute', '算力调配'], ['/observability', '可观测性'], ['/logs', '日志查看器']] },
    { label: '治理与合规', items: [['/governance-domain', '治理域'], ['/command-audit', '命令评分卡'], ['/governance-pulse', '治理脉搏'], ['/l4-health', 'L4 域健康'], ['/debt', '债务治理'], ['/alerts', '告警中心'], ['/harness', 'Harness 合规'], ['/intent', 'Intent 编译器'], ['/governance-self-check', '治理自检']] },
    { label: '知识与研究', items: [['/research', '研究中心'], ['/knowledge', '知识中枢'], ['/knowledge-action', '知识到行动'], ['/engines', '引擎调度'], ['/assets', '技术资产库'], ['/kems', 'KEMS 质量治理'], ['/scene-cards', '场景卡评审'], ['/decision-inbox', '决策收件箱'], ['/decision-graph', '决策因果图'], ['/scenes', '场景总览'], ['/scene-graph', '场景图'], ['/calibration', '校准中心'], ['/external-resources', '外部能力目录']] },
    { label: 'Agent 与链路', items: [['/commands', '命令全景'], ['/chain', '链路编排'], ['/swarm', 'Swarm 协同'], ['/agents', 'Agent 监控'], ['/bcos', 'BCOS 北极星'], ['/brain', '智能大脑'], ['/gbrain-admin', 'GBrain 管理']] },
    { label: '开发工具', items: [['/tasks', '任务中心'], ['/performance', '性能监控'], ['/sandbox', '隔离沙箱'], ['/console', '控制台'], ['/workflows', '工作流'], ['/domain-apps', '领域应用']] },
    { label: '工作台', items: [['/workbench/ecos-workflow', 'eCOS 工作流'], ['/workbench/infrastructure-ops', '基础设施运维'], ['/workbench/knowledge-execution', '知识执行'], ['/workbench/kos', 'KOS 工作台'], ['/workbench/memory-injector', '记忆注入'], ['/workbench/platform-control', '平台控制'], ['/workbench/runtime-ops', '运行时运维'], ['/workbench/system-assurance', '系统保障']] },
    { label: '系统配置', items: [['/settings', '系统设置']] }
  ];

  window.filterEcosystemMap = function(query) {
    query = (query || '').toLowerCase().trim();
    const items = document.querySelectorAll('.eco-filter-item');
    let matched = 0;
    items.forEach(el => {
      const text = el.getAttribute('data-search') || el.textContent.toLowerCase();
      if (!query || text.includes(query)) {
        el.style.display = '';
        matched++;
      } else {
        el.style.display = 'none';
      }
    });
    const countEl = document.getElementById('ecosystem-search-count');
    if (countEl) {
      countEl.textContent = query ? ('匹配到 ' + matched + ' 项') : '共 81 个全域功能入口';
    }
  };

  function buildEcosystemMap() {
    const wrap = document.createElement('div');
    const zhixingCount = _horizons.reduce((n, h) => n + h.subPanels.length, 0);
    const cockpitCount = cockpitGroups.reduce((n, g) => n + g.items.length, 0);
    wrap.innerHTML = '<div class="section-head">' +
      '<div class="eyebrow"><span class="eyebrow-text">🗺️ 全域能力地图</span> <span style="margin-left:6px;font-size:11px;color:var(--muted)">Ecosystem Capability Map</span></div>' +
      '<h1 id="title-ecosystem-map">一张页面看全部：织星 dashboard + cockpit-ui</h1>' +
      '<p class="lead">全景规划要求"尽可能覆盖所有相关功能，不遗漏"——逐条核对源码后的真实清单：织星 dashboard 现有 ' + zhixingCount + ' 个核心板块（全部可直接点开并高亮定位），cockpit-ui 现有 ' + cockpitCount + ' 个功能路由（深链，本地 <code>bun dev</code> 跑在 5173 端口即可直通）。</p>' +
      '<div style="display:flex;align-items:center;gap:12px;margin:14px 0 6px;flex-wrap:wrap">' +
        '<input type="text" id="ecosystem-search-input" placeholder="🔍 快速过滤板块与路由（输入 loops, mof, agent, 治理, 知识...）" style="flex:1;min-width:280px;max-width:520px;padding:8px 14px;border:1px solid var(--line);border-radius:8px;font-size:12.5px;background:var(--surface);color:var(--ink)" oninput="window.filterEcosystemMap(this.value)">' +
        '<span id="ecosystem-search-count" style="font-size:12px;font-weight:600;color:var(--blue)">共 ' + (zhixingCount + cockpitCount) + ' 个全域功能入口</span>' +
      '</div></div>' +
      '<div class="card gap"><h3 style="margin:0 0 12px">📍 织星 · 5 大战略视界体系（本站，' + zhixingCount + ' 核心板块）</h3>' +
      '<div class="grid two gap">' +
      _horizons.map(h => '<div class="card eco-filter-item" data-search="' + esc(h.title + ' ' + h.desc + ' ' + h.subPanels.join(' ')) + '" style="background:var(--paper);border-left:3px solid var(--blue)">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><b>' + esc(h.title) + '</b><span class="chip neutral" style="font-size:10px">' + h.subPanels.length + ' 板块</span></div>' +
        '<p class="small muted" style="margin:0 0 8px;font-size:11px">' + esc(h.desc) + '</p>' +
        '<div class="small gap" style="display:flex;flex-wrap:wrap;gap:6px">' +
        h.subPanels.map(id => '<a href="#' + esc(id) + '" class="chip" style="text-decoration:none;font-size:11px;background:#fff;border:1px solid var(--line);padding:2px 8px;border-radius:4px" onclick="location.hash=\'#' + esc(id) + '\'">' + esc(zhixingLabel[id] || id) + '</a>').join('') +
        '</div></div>').join('') +
      '</div></div>' +
      '<div class="card gap"><h3 style="margin:0 0 12px">🧭 cockpit-ui · 8 大功能域工作台（外部，' + cockpitCount + ' 路由深链）</h3>' +
      '<p class="small muted" style="margin:0 0 10px">诚实标注：以下链接指向 <code>http://localhost:' + COCKPIT_DEV_ORIGIN.split(':').pop() + '</code>，需在 cockpit-ui 项目里执行 <code>bun dev</code>（未启动时点击不会有响应）。</p>' +
      '<div class="grid two gap">' +
      cockpitGroups.map(g => '<div class="card eco-filter-item" data-search="' + esc(g.label + ' ' + g.items.map(x=>x[0]+' '+x[1]).join(' ')) + '" style="background:var(--paper)">' +
        '<b>' + esc(g.label) + '</b><div class="small gap" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:5px">' +
        g.items.map(([path, label]) => '<a href="' + esc(COCKPIT_DEV_ORIGIN + path) + '" target="_blank" rel="noopener" class="chip" style="font-size:11px;text-decoration:none">' + esc(label) + ' <span class="muted" style="font-size:9.5px">' + esc(path) + '</span></a>').join('') + '</div></div>').join('') +
      '</div></div>';
    return wrap;
  }
  function mountEcosystemMap() {
    const section = byId('ecosystem-map');
    if (!section || section.querySelector('[data-mounted="ecosystem-map"]')) return;
    section.innerHTML = '';
    const mapEl = buildEcosystemMap();
    mapEl.setAttribute('data-mounted', 'ecosystem-map');
    section.appendChild(mapEl);
  }

  function mountEcosystemIntegration() {
    try { mountCockpitLinks(); } catch (e) { console.warn('mountCockpitLinks', e); }
    try { mountStrategyLensCard(); } catch (e) { console.warn('mountStrategyLensCard', e); }
    try { mountLensCard('我现在卡在哪', '当前系统卡点全景', [{href:'gov',label:'恢复准入',desc:'哪个门没过'},{href:'health',label:'健康诊断',desc:'聚合分数'},{href:'swarm',label:'Agent 协同',desc:'谁卡住了'},{href:'ledger',label:'路线与 BET',desc:'战役进度'},{href:'loops',label:'回路观测',desc:'熔断状态'}]); } catch (e) { console.warn('mountLensCard', e); }
    try { mountLensCard('价值产出如何', '价值证据与度量趋势', [{href:'value',label:'价值验收',desc:'NOT_PROVEN / PROVEN'},{href:'metrics',label:'指标度量',desc:'趋势'},{href:'personal',label:'主权中心',desc:'事件流'}]); } catch (e) { console.warn('mountLensCard', e); }
    // BET-Y2Q2-T8-04: 跨板块合成镜头卡 — 价值-治理合成条
    try { mountSynthesisCard('价值-治理合成条', '写操作诚信与价值证据跨板块合成', [{href:'value',label:'价值验收',desc:'PROVEN 证据'},{href:'gov',label:'治理准入',desc:'写操作合规'},{href:'ledger',label:'BET 台账',desc:'战役诚信'}]); } catch (e) { console.warn('mountSynthesisCard (value-gov)', e); }
    // BET-Y2Q2-T8-04: 跨板块合成镜头卡 — 健康-执行合成条
    try { mountSynthesisCard('健康-执行合成条', '系统健康状态与执行回路跨板块合成', [{href:'health',label:'健康诊断',desc:'聚合分数'},{href:'loops',label:'回路观测',desc:'熔断状态'},{href:'swarm',label:'Agent 协同',desc:'执行链路'}]); } catch (e) { console.warn('mountSynthesisCard (health-exec)', e); }
    try { mountEcosystemMap(); } catch (e) { console.warn('mountEcosystemMap', e); }
  }
  // 脚本本身在拼接顺序中排最后、且以内联方式在 body 结束标签前执行，此时全部 section 已挂载完毕，
  // 无需等待 DOMContentLoaded 即可安全操作 DOM；同时仍监听一次 DOMContentLoaded 作兜底。
  mountEcosystemIntegration();
  document.addEventListener('DOMContentLoaded', mountEcosystemIntegration);
})();
