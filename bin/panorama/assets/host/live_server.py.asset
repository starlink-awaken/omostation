        elif route.path == "/api/v1/resident":
            self._handle_resident_status()
        elif route.path == "/api/v1/compute/live":
            self._handle_compute_live()
        elif route.path.startswith('/api/v1/'):
            operation = route.path[len('/api/v1/'):]
            try:
                values = parse_qs(route.query, keep_blank_values=True, strict_parsing=True, max_num_fields=12) if route.query else {}
                if any(len(items) != 1 for items in values.values()) or len(route.query) > 8192:
                    raise ValueError('invalid query')
                params = {key: items[0] for key, items in values.items()}
            except ValueError:
                self._json(400, {'error': 'INVALID_QUERY', 'read_only': True})
                return
            try:
                index = self.server.snapshot_store.load()
                result = pinned_document(index, self.server.document_root, params) if operation == 'document' else index.query(operation, params)
                self._json(200, result)
            except QueryError as error:
                self._json(error.status, {'error': error.code, 'read_only': True})
            except DocumentError as error:
                self._json(error.status, {'error': error.reason, 'read_only': True})
        elif route.path == "/api/logs":
            try:
                params = parse_qs(route.query, keep_blank_values=True, strict_parsing=True, max_num_fields=2) if route.query else {}
                if set(params) - {"limit", "source"} or any(len(values) != 1 for values in params.values()):
                    raise ValueError("invalid query")
                limit = int(params.get("limit", ["100"])[0])
                source = params.get("source", ["all"])[0]
                result = collect_logs(self.server.sources, limit=limit, source=source)
            except ValueError:
                self._json(400, {"error": "invalid_query", "allowed_sources": list(self.server.sources), "limit_range": [1, 200]})
                return
            self._json(200, result)
        elif route.path == "/__panorama_data__":
            # Prefer same-generation projection from current.json; fall back to
            # panorama_cache.json only when it is not older than CURRENT.
            try:
                import json as _json
                from pathlib import Path as _Path
                from datetime import datetime as _dt

                def _parse_ts(value):
                    if not isinstance(value, str) or not value:
                        return None
                    try:
                        return _dt.fromisoformat(value.replace("Z", "+00:00"))
                    except ValueError:
                        return None

                snap_candidates = [
                    _Path(__file__).resolve().parent / "dist/current.json",
                    _Path(__file__).resolve().parent / "current.json",
                ]
                snap_path = next((p for p in snap_candidates if p.exists()), None)
                cache_path = _Path(__file__).resolve().parent / "panorama_cache.json"
                if snap_path and snap_path.exists():
                    full = _json.loads(snap_path.read_text())
                    embed = {
                        "generated_at": full.get("generated_at") or full.get("observed_at") or "",
                        "generation_id": full.get("generation_id"),
                        "source": snap_path.name,
                        "knowledge_health": full.get("knowledge_health", {}),
                        "knowledge_growth": full.get("knowledge_growth", {}),
                        "experience_network": full.get("experience_network", {}),
                        "skill_inventory": full.get("skill_inventory", {}),
                        "experience_graph": full.get("experience_graph", {}),
                        "knowledge_inbound": full.get("knowledge_inbound", []),
                        "scene_cards": full.get("scene_cards", {}),
                        "signal_poller": full.get("signal_poller", {}),
                        "journey_executions": full.get("journey_executions", {}),
                        "journeys": full.get("journeys", {}),
                        "connectors": full.get("connectors", {}),
                        "remote_hygiene": full.get("remote_hygiene", {}),
                        "bos_verifier": full.get("bos_verifier", {}),
                        "service_keeper": full.get("service_keeper", {}),
                        "decision_proposals": full.get("decision_proposals", {}),
                        "recent_features": full.get("recent_features", {}),
                        "memory_dual_track": full.get("memory_dual_track", {}),
                    }
                    self._json(200, embed)
                    return
                if cache_path.exists():
                    cached = _json.loads(cache_path.read_text())
                    self._json(200, {**cached, "source": "panorama_cache.json", "stale_warning": "current_json_missing"})
                    return
                self._json(503, {"error": "cache_not_ready"})
            except Exception as _e:
                self._json(500, {"error": "panorama_error", "detail": str(_e)})
        elif route.path == "/api/snapshot":
            # Lightweight endpoint for incremental refresh - returns only essential data
            try:
                candidates = [
                    Path(__file__).resolve().parent / "dist/current.json",
                    Path(__file__).resolve().parent / "current.json",
                ]
                snap_path = next((p for p in candidates if p.exists()), None)
                if snap_path and snap_path.exists():
                    import json as _json
                    full = _json.loads(snap_path.read_text())
                    # Return lightweight version for polling
                    lightweight = {
                        "observed_at": full.get("observed_at"),
                        "generation_id": full.get("generation_id"),
                        "source_states": full.get("source_states", {}),
                        "refresh": full.get("refresh", {}),
                        "agents_count": len(full.get("agents", [])),
                        "gates_count": len(full.get("gates", [])),
                        "events_count": len(full.get("recent_events", {}).get("events", [])),
                        "metrics_kpi": full.get("metrics_kpi", {}),
                        "health_score": full.get("metrics_kpi", {}).get("health_score"),
                        "events_per_hour": full.get("metrics_kpi", {}).get("events_per_hour_24h"),
                        "failed_sources": full.get("refresh", {}).get("failed_sources", []),
                    }
                    self._json(200, lightweight)
                else:
                    self._json(503, {"error": "snapshot_not_ready"})
            except Exception as e:
                self._json(500, {"error": str(e)})
        elif route.path.startswith('/api/v1/'):
            # Stub API endpoints for UI extensions - return valid empty responses
            self._json(200, {"_stub": True, "endpoint": route.path, "status": "ok", "data": []})
        elif route.path.endswith('.js') and not route.query:
            # Serve external UI JS files (workbench, next, topology, mof, panoramic)
            js_name = Path(route.path).name
            js_file = Path(__file__).resolve().parent / js_name
            if js_file.exists() and js_file.parent == Path(__file__).resolve().parent:
                self._send(200, js_file.read_bytes(), "application/javascript; charset=utf-8")
            else:
                self._json(404, {"error": "js_not_found"})
            return
        else:
            self._json(404, {"error": "not_found"})

    def do_POST(self):
        if not self._allowed():
            return
        route = urlsplit(self.path)
        if route.path == "/api/v1/compute/infer":
            self._handle_compute_infer()
            return
        if route.path.startswith('/api/v1/'):
            operation = route.path[len('/api/v1/'):]
            if operation in ('copilot/ask', 'proposals/submit', 'proposals/adjudicate', 'health/auto-heal', 'health/execute-heal', 'bos/invoke', 'loops/step'):
                try:
                    content_len = int(self.headers.get('Content-Length', 0))
                    if content_len > 65536:
                        self._json(413, {'error': 'PAYLOAD_TOO_LARGE'})
                        return
                    body = self.rfile.read(content_len) if content_len > 0 else b'{}'
                    params = json.loads(body.decode('utf-8')) if body else {}
                    if not isinstance(params, dict):
                        raise ValueError('payload must be dict')
                except Exception:
                    self._json(400, {'error': 'INVALID_JSON_PAYLOAD'})
                    return
                try:
                    index = self.server.snapshot_store.load()
                    result = index.query(operation, params)
                    self._json(200, result)
                except QueryError as error:
                    self._json(error.status, {'error': error.code})
                except Exception as err:
                    self._json(500, {'error': str(err)})
                return
        self._reject_method()

    def _reject_method(self):
        if self._allowed():
            self._json(405, {"error": "read_only_get_only"})

    do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_HEAD = do_TRACE = _reject_method


def make_server(port=DEFAULT_PORT, page_path=PAGE_PATH, sources=None,
                snapshot_path=SNAPSHOT_PATH, document_root=DOCUMENT_ROOT):
    server = DashboardServer(("127.0.0.1", port), DashboardHandler)
    server.page_path = Path(page_path)
    server.sources = dict(DEFAULT_SOURCES if sources is None else sources)
    server.snapshot_path = Path(snapshot_path)
    server.snapshot_store = SnapshotStore(snapshot_path)
    server.document_root = Path(document_root)
    return server


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("--port must be between 1 and 65535")
    server = make_server(port=args.port)
    print(json.dumps({"service": "zhixing-dashboard-live", "read_only": True,
                      "url": "http://127.0.0.1:" + str(server.server_port)}), flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
