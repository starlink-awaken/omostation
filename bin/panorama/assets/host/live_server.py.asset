def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def resolve_dashboard_code_identity(code_root=CODE_ROOT):
    """Prove the running reader is one clean, exact Git tree."""
    root = Path(code_root).resolve()

    def git_bytes(*args):
        completed = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True,
            timeout=10,
            check=False,
        )
        if completed.returncode != 0:
            raise ProjectionStateError(
                "IDENTITY_UNBOUND", "projection_identity_unbound"
            )
        return completed.stdout

    code_oid = git_bytes("rev-parse", "HEAD").decode("ascii").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", code_oid):
        raise ProjectionStateError("IDENTITY_UNBOUND", "projection_identity_unbound")
    if git_bytes("status", "--porcelain=v1", "--untracked-files=all"):
        raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
    tree_listing = git_bytes("ls-tree", "-r", "--full-tree", "HEAD")
    tree_sha256 = hashlib.sha256(tree_listing).hexdigest()
    file_hashes = []
    for name in _DASHBOARD_CODE_FILES:
        bound = git_bytes("show", f"HEAD:{name}")
        executing = (root / name).read_bytes()
        if bound != executing:
            raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
        file_hashes.append(f"{name}:{hashlib.sha256(bound).hexdigest()}\n")
    code_bundle_sha256 = hashlib.sha256(
        "".join(file_hashes).encode("ascii")
    ).hexdigest()
    return {
        "code_oid": code_oid,
        "tree_sha256": tree_sha256,
        "code_bundle_sha256": code_bundle_sha256,
    }


def probe_dashboard_code_identity(code_root=CODE_ROOT):
    """Cheaply prove HEAD and a clean tracked/untracked worktree."""
    root = Path(code_root).resolve()
    try:
        completed = subprocess.run(
            [
                "git",
                "-C",
                str(root),
                "status",
                "--porcelain=v2",
                "--branch",
                "--untracked-files=all",
            ],
            capture_output=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ProjectionStateError(
            "IDENTITY_UNBOUND", "projection_identity_unbound"
        ) from exc
    if completed.returncode != 0:
        raise ProjectionStateError("IDENTITY_UNBOUND", "projection_identity_unbound")
    lines = completed.stdout.splitlines()
    oid_prefix = b"# branch.oid "
    oid_lines = [line for line in lines if line.startswith(oid_prefix)]
    if len(oid_lines) != 1:
        raise ProjectionStateError("IDENTITY_UNBOUND", "projection_identity_unbound")
    try:
        code_oid = oid_lines[0][len(oid_prefix):].decode("ascii")
    except UnicodeDecodeError as exc:
        raise ProjectionStateError(
            "IDENTITY_UNBOUND", "projection_identity_unbound"
        ) from exc
    if not re.fullmatch(r"[0-9a-f]{40}", code_oid):
        raise ProjectionStateError("IDENTITY_UNBOUND", "projection_identity_unbound")
    if any(not line.startswith(b"# ") for line in lines):
        raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
    return {"code_oid": code_oid}


class DashboardCodeIdentityCache:
    """Single-flight cache for an expensive, revision-bound code identity."""

    def __init__(self, *, resolver=None, probe=None):
        self._resolver = resolver or resolve_dashboard_code_identity
        self._probe = probe or probe_dashboard_code_identity
        self._condition = threading.Condition(threading.Lock())
        self._resolving = False
        self._generation = 0
        self._last_failure_key = None
        self._last_failure_generation = None
        self._last_failure = None
        self._key = None
        self._identity = None

    def _fingerprints(self):
        return tuple(
            _regular_file_fingerprint(
                CODE_ROOT / name,
                status="CODE_DRIFT",
                public_error="projection_code_drift",
            )
            for name in _DASHBOARD_CODE_FILES
        )

    def resolve(self, binding):
        try:
            files = self._fingerprints()
        except Exception:
            with self._condition:
                self._key = None
                self._identity = None
            raise
        expected_oid = binding[-1] if binding else None
        request_key = tuple(binding) + (expected_oid, files)

        # Coalesce overlapping page/API requests into one Git probe and one
        # full identity resolution. Waiters may reuse that proof only when the
        # exact projection binding and protected-file fingerprints still match.
        with self._condition:
            if self._resolving:
                waiting_generation = self._generation
                self._condition.wait_for(lambda: not self._resolving)
                try:
                    waited_files = self._fingerprints()
                except Exception:
                    self._key = None
                    self._identity = None
                    raise
                if waited_files != files:
                    self._key = None
                    self._identity = None
                    raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
                if (
                    self._last_failure_generation == waiting_generation
                    and self._last_failure_key == request_key
                    and self._last_failure is not None
                ):
                    status, public_error = self._last_failure
                    raise ProjectionStateError(status, public_error)
                if self._key == request_key and self._identity is not None:
                    return dict(self._identity)
            self._generation += 1
            generation = self._generation
            self._last_failure_key = None
            self._last_failure_generation = None
            self._last_failure = None
            self._resolving = True

        try:
            observed = self._probe()
            observed_oid = observed.get("code_oid")
            if observed_oid != expected_oid:
                raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
            if self._fingerprints() != files:
                raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")

            key = tuple(binding) + (observed_oid, files)
            with self._condition:
                if self._key == key and self._identity is not None:
                    if self._fingerprints() != files:
                        raise ProjectionStateError(
                            "CODE_DRIFT", "projection_code_drift"
                        )
                    return dict(self._identity)

            identity = self._resolver()
            if identity.get("code_oid") != observed_oid:
                raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
            if self._fingerprints() != files:
                raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
            with self._condition:
                self._key = key
                self._identity = dict(identity)
            return dict(identity)
        except Exception as exc:
            with self._condition:
                self._key = None
                self._identity = None
                if isinstance(exc, ProjectionStateError):
                    self._last_failure_key = request_key
                    self._last_failure_generation = generation
                    self._last_failure = (exc.status, exc.public_error)
            raise
        finally:
            with self._condition:
                self._resolving = False
                self._condition.notify_all()


def _regular_file_fingerprint(path, *, status, public_error):
    try:
        metadata = Path(path).lstat()
    except OSError as exc:
        raise ProjectionStateError(status, public_error) from exc
    if not stat.S_ISREG(metadata.st_mode):
        raise ProjectionStateError(status, public_error)
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def projection_code_identity_binding(projection_store, revision):
    """Bind a cached code proof to the exact pointer and manifest controls."""
    pointer_fingerprint = _regular_file_fingerprint(
        projection_store.pointer_path,
        status="POINTER_UNAVAILABLE",
        public_error="projection_pointer_unavailable",
    )
    manifest_fingerprint = _regular_file_fingerprint(
        revision.manifest_path,
        status="MANIFEST_UNAVAILABLE",
        public_error="projection_manifest_unavailable",
    )
    return (
        revision.revision_id,
        revision.manifest_sha256,
        pointer_fingerprint,
        manifest_fingerprint,
        revision.dashboard_code_oid,
    )


def safe_identifier(value):
    if isinstance(value, int) and not isinstance(value, bool):
        value = str(value)
    if not isinstance(value, str) or not IDENTIFIER.fullmatch(value) or SENSITIVE.search(value):
        return None
    return value


TERMINAL_PUBLICATION_STATES = frozenset({
    "MERGED", "CLOSED", "WITHDRAWN", "REJECTED", "SUPERSEDED",
})
ACTIONABLE_PUBLICATION_VERIFICATION = "READY_FOR_OPERATION_SPECIFIC_HUMAN_AUTHORIZATION"


def pending_publication_projection(pending):
    """Project only actionable exact-commit publications without hiding history."""
    source = pending if isinstance(pending, dict) else {}
    items = source.get("items") if isinstance(source.get("items"), list) else []
    actionable = []
    terminal_count = 0
    invalid_count = 0
    for item in items:
        if not isinstance(item, dict):
            invalid_count += 1
            continue
        state = str(item.get("state") or "").upper()
        verification = str(item.get("verification") or "").upper()
        if state in TERMINAL_PUBLICATION_STATES:
            terminal_count += 1
        elif (
            state not in ("", "UNKNOWN")
            and verification == ACTIONABLE_PUBLICATION_VERIFICATION
        ):
            actionable.append(item)
        else:
            invalid_count += 1
    projected = {
        "schema": "pending-publication-projection/v2",
        "available": bool(source),
        "items": actionable,
        "terminal_items_count": terminal_count,
        "invalid_items_count": invalid_count,
        "source_schema": source.get("schema"),
        "source_manifest_sha256": source.get("manifest_sha256"),
        "source_path": source.get("manifest_path"),
        "checked_at": source.get("checked_at"),
    }
    return {key: value for key, value in projected.items() if value is not None}


def actionable_publication_items(pending):
    return pending_publication_projection(pending)["items"]


