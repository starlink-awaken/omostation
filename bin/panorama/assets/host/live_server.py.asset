                        "samples": {
                            "qualifying": qualifying,
                            "target": 30,
                            "remaining": max(0, 30 - qualifying),
                        },
                        "revision_baseline": panel_value.get("revision_baseline"),
                        "thresholds": panel_value.get("thresholds") or [],
                        "validation": snapshot.get("value_evidence_validation", {}),
                        "operator_contract": {
                            "helper_path": "/Users/xiamingxing/.local/share/zhixing-dashboard/bin/value-operator.py",
                            "canonical_evidence": "/Users/xiamingxing/Workspace/.omo/_delivery/ingress/value-evidence.jsonl",
                            "minimum_net_saved_seconds": 60,
                            "required_confirm": "--confirm-real-human-post-baseline",
                            "no_synthetic_backfill": True,
                        },
                    },
                    "read_interfaces": snapshot.get("agent_read_interfaces", {}),
                    "safety_boundaries": [
                        "OMO is the single control plane and dispatcher.",
                        "Do not activate Claims Authority without fresh operation-specific Human authorization.",
                        "Do not publish an exact-commit candidate without its own operation-specific authorization.",
                        "Do not synthesize, backfill, or duplicate real-use value evidence.",
