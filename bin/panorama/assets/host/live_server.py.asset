def _tail_jsonl(path: Path, max_lines: int = 60) -> list[dict]:
    """读 JSONL 尾部 N 行 (轻量, 逐行 split 避免载入大文件)."""
    if not path.is_file():
        return []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    out: list[dict] = []
    for line in lines[-max_lines:]:
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def _read_watermark(projector: str) -> dict | None:
    p = _WATERMARKS_DIR / f"{projector}.json"
    if not p.is_file():
        return None
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def _daemon_pid() -> tuple[int | None, bool]:
    """检测居民守护进程. 优先 pidfile, 否则按进程名兜底."""
    # 1) pidfile
    if _PID_FILE.is_file():
        try:
            pid = int(_PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
            return pid, True
        except (OSError, ValueError):
            pass
    # 2) 按进程名兜底 (pidfile 可能未生成或被清理)
    try:
        r = subprocess.run(["pgrep", "-f", "omo.cli resident daemon"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            pid = int(r.stdout.strip().split("\n")[0])
            return pid, True
    except (subprocess.TimeoutExpired, ValueError):
        pass
    return None, False


_ROLE_SOURCE = {  # role → heartbeat.jsonl 中的 source 标记
    "heartbeat": "resident-heartbeat",
    "monitor": "resident-monitor",
    "sediment": "resident-sediment",
    "decision": "resident-decision",
    "execute": "resident-execute",
}


def _last_source_ts(source: str, jsonl: Path) -> str | None:
    """从 JSONL 尾部找 source 匹配的最后一条 ts."""
    if not jsonl.is_file():
        return None
    last = None
    try:
        for line in jsonl.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or source not in line:
                continue
            try:
                e = json.loads(line)
                if e.get("source") == source:
                    last = e.get("occurred_at") or e.get("ts") or last
            except json.JSONDecodeError:
                continue
    except OSError:
        pass
    return last


def _role_activity(max_gap_seconds: float = 1800.0) -> list[dict]:
    """每个 role 的最后活跃时间 + 状态 (基于 JSONL source 字段)."""
    import datetime as _dt
    now = _dt.datetime.now(_dt.timezone.utc)
    items: list[dict] = []
    for role in sorted(_ROLE_WATERMARKS):
        src = _ROLE_SOURCE.get(role, f"resident-{role}")
        # 优先 monitor/heartbeat 对应 jsonl, 其次从 daemon.log 兜底
        jsonl = _MONITOR_JSONL if role == "monitor" else _HEARTBEAT_JSONL
        last_ts = _last_source_ts(src, jsonl)
        lag = None
        status = "idle"
        if last_ts:
            try:
                t = _dt.datetime.fromisoformat(last_ts.replace("Z", "+00:00"))
                lag = (now - t).total_seconds()
                status = "active" if lag <= max_gap_seconds else "stale"
            except (ValueError, TypeError):
                status = "active"
        items.append({"role": role, "status": status, "source": src,
                      "last_seen": last_ts, "lag_seconds": int(lag) if lag is not None else None})
    return items


def build_harness_runs(limit: int = 20) -> dict:
    """读 harness-runs 目录, 返回最近 N 次 8 阶段 DAG 运行摘要."""
    runs = []
    if _HARNESS_RUNS_DIR.is_dir():
        files = sorted(_HARNESS_RUNS_DIR.glob("*.json"),
                       key=lambda p: p.stat().st_mtime if p.exists() else 0,
                       reverse=True)[:limit]
        for f in files:
            try:
                d = json.loads(f.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if not isinstance(d, dict) or "stages" not in d:
                continue  # 跳过非 harness-run 格式
            runs.append({
                "run_id": d.get("run_id"),
                "bet_id": d.get("bet_id"),
                "profile": d.get("profile"),
                "ok": d.get("ok"),
                "started_at": d.get("started_at"),
                "finished_at": d.get("finished_at"),
                "stages": {k: v.get("ok") for k, v in (d.get("stages") or {}).items()
                           if isinstance(v, dict)},
            })
    ok_n = sum(1 for r in runs if r.get("ok"))
    return {"total": len(runs), "ok": ok_n, "failed": len(runs) - ok_n, "runs": runs}


def build_resident_status() -> dict:
    """聚合居民守护进程可观测状态, 供 /api/v1/resident 返回."""
    import datetime as _dt
    pid, alive = _daemon_pid()
    hb_tail = _tail_jsonl(_HEARTBEAT_JSONL, 80)
    mon_tail = _tail_jsonl(_MONITOR_JSONL, 40)
    receipts_tail = _tail_jsonl(_RECEIPTS_JSONL, 30)
    # daemon.log 末行
    log_last = None
    if _DAEMON_LOG.is_file():
        try:
            log_lines = _DAEMON_LOG.read_text(encoding="utf-8", errors="replace").splitlines()
            log_last = [l for l in log_lines[-10:] if l.strip()][-3:]
        except OSError:
            pass
    # heartbeat 统计: 总数 + 最后时间 + 按 event_type 计数
    hb_total = 0
    hb_last = None
    hb_by_type: dict[str, int] = {}
    if _HEARTBEAT_JSONL.is_file():
        try:
            with _HEARTBEAT_JSONL.open(encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    hb_total += 1
                    try:
                        e = json.loads(line)
                        hb_last = e.get("occurred_at") or e.get("ts") or hb_last
                        et = e.get("event_type") or e.get("source")
                        if et:
                            hb_by_type[et] = hb_by_type.get(et, 0) + 1
                    except json.JSONDecodeError:
                        continue
        except OSError:
            pass
    # monitor: 24h 告警数 (从主事件流统计 alert 类型, 非 resident-monitor 心跳记录)
    mon_alerts_24h = 0
    mon_last = None
    cutoff = _dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(hours=24)
    for e in mon_tail[-200:]:
        mon_last = e.get("occurred_at") or e.get("ts") or mon_last
    events_jsonl = _WORKSPACE / ".omo" / "_knowledge" / "workflow-mesh" / "events.jsonl"
    try:
        if events_jsonl.is_file():
            for line in events_jsonl.read_text(encoding="utf-8", errors="replace").splitlines():
                line = line.strip()
                if not line or '"alert"' not in line:
                    continue
                try:
                    ev = json.loads(line)
                    if ev.get("event_type") != "alert":
                        continue
                    ts_raw = ev.get("occurred_at") or ev.get("ts") or ev.get("timestamp")
                    if not ts_raw:
                        continue
                    ts = _dt.datetime.fromisoformat(str(ts_raw).replace("Z", "+00:00"))
                    if ts >= cutoff:
                        mon_alerts_24h += 1
                except (ValueError, TypeError, json.JSONDecodeError):
                    continue
    except OSError:
        pass
    # receipt 统计
    r_total = r_ok = r_err = r_blocked = 0
    r_last = None
    if _RECEIPTS_JSONL.is_file():
        try:
            for line in _RECEIPTS_JSONL.read_text(encoding="utf-8", errors="replace").splitlines():
                line = line.strip()
                if not line:
                    continue
                r_total += 1
                try:
                    e = json.loads(line)
                    s = e.get("status")
                    r_last = e.get("ts") or r_last
                    if s == "ok":
                        r_ok += 1
                    elif s == "error":
                        r_err += 1
                    elif s == "blocked":
                        r_blocked += 1
                except json.JSONDecodeError:
                    continue
        except OSError:
            pass
    return {
        "daemon_running": bool(alive),
        "daemon_pid": pid,
        "heartbeat": {"events_total": hb_total, "last_seen": hb_last,
                     "by_event_type": hb_by_type},
        "monitor": {"recent_tail_len": len(mon_tail), "last_seen": mon_last,
                    "alerts_count_24h": mon_alerts_24h},
        "receipts": {"total": r_total, "ok": r_ok, "error": r_err,
                     "blocked": r_blocked, "last_ts": r_last},
        "roles": _role_activity(),
        "daemon_log_tail": log_last or [],
        "recent_receipts": receipts_tail[-8:],
    }


def value_proof_readiness_payload(snapshot):
    """Project business value solely from the OMO causal Event Ledger."""
    source = snapshot if isinstance(snapshot, dict) else {}
    previous_panel = (
        source.get("panel_value") if isinstance(source.get("panel_value"), dict) else {}
    )
    envelope = (
        source.get("personal_value_truth")
        if isinstance(source.get("personal_value_truth"), dict) else {}
    )
    truth = envelope.get("value_truth") if isinstance(envelope.get("value_truth"), dict) else {}
    advisory_panel = previous_panel.get("advisory", previous_panel)
    panel = project_panel_value(truth, advisory_panel)
    metrics = truth.get("metrics") if isinstance(truth.get("metrics"), dict) else {}
    weeks = [item for item in (metrics.get("weekly_samples") or []) if isinstance(item, dict)]
    qualifying = panel["samples"]["qualifying"]
    target = 30
    truth_valid = (
        envelope.get("available") is True
        and truth.get("schema") == "value-truth-snapshot/v1"
    )
    personal_value = str((truth.get("truth_axes") or {}).get("personal_value") or "")
    if not truth_valid:
        state = "UNPROVABLE"
        reasons = ["ledger_value_truth_unavailable"]
        qualifying = 0
    elif truth.get("status") == "proven" and personal_value == "passed":
        state = "PROVEN"
        reasons = []
    elif truth.get("status") == "unprovable" or personal_value == "unprovable":
        state = "UNPROVABLE"
        reasons = [str(truth.get("reason") or "ledger_value_truth_unprovable")]
    else:
        state = "NOT_PROVEN"
        reasons = [str(item) for item in (metrics.get("gate_gaps") or []) if item]
    panel_samples = panel["samples"]
    validation = source.get("value_evidence_validation") if isinstance(source.get("value_evidence_validation"), dict) else {}
    payload = {
        "schema_version": "agent-value-proof-readiness/v3",
        "available": truth_valid,
        "authorization_mode": "single-user-loopback",
        "read_only": True,
        "instruction_capable": False,
        "state": state,
        "state_reason": reasons,
        "samples": {
            "records": int(metrics.get("total_episodes") or 0) if truth_valid else 0,
            "qualifying": qualifying,
            "target": target,
            "remaining": max(0, target - qualifying),
            "accepted": int(panel_samples.get("accepted") or 0),
            "adjudicated": int(panel_samples.get("adjudicated") or 0),
            "net_saved_seconds": int(panel_samples.get("net_saved_seconds") or 0),
        },
        "thresholds": panel.get("thresholds") or [],
        "value_truth": truth,
        "advisory": {
            "panel": panel.get("advisory") if isinstance(panel.get("advisory"), dict) else {},
            "validation": validation,
        },
        "operator_contract": {
            "canonical_source": "OMO causal Event Ledger",
            "meter": "bin/bc-os/north_star_meter_v2.py",
            "read_only": True,
        },
        "evidence_rule": (
            "Only complete principal-bound Episodes validated from the OMO causal Event Ledger count; "
            "legacy JSONL, attestations, synthetic runs, and backfills are advisory only."
        ),
        "generated_at": source.get("generated_at")
            or source.get("observed_at")
            or utc_now(),
        "generation_id": source.get("generation_id"),
    }
    return payload


def safe_timestamp(record):
    for key in ("timestamp", "ts", "created_at", "occurred_at", "published_at", "attempted_at", "observed_at", "time", "at", "adjudicated_at", "event_at"):
        value = record.get(key)
        try:
            if isinstance(value, str) and len(value) <= 64:
                stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
                if stamp.tzinfo is None:
                    continue
            elif isinstance(value, (int, float)) and not isinstance(value, bool):
                stamp = datetime.fromtimestamp(value, tz=timezone.utc)
            else:
                continue
            if 2000 <= stamp.year <= 2100:
                return stamp.astimezone(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
        except (ValueError, OverflowError, OSError):
            continue
    return None


def project_event(record, source_id, identity, offset, raw):
    """Only scalar identifier fields and whitelisted metrics may cross the local log boundary."""
    event_id = hashlib.sha256((source_id + ":" + identity + ":" + str(offset)).encode() + b":" + raw).hexdigest()
    ts = safe_timestamp(record)

    payload = record.get("payload") if isinstance(record.get("payload"), dict) else {}
    detail = record.get("detail") if isinstance(record.get("detail"), dict) else {}

    raw_event = record.get("event") or record.get("event_type") or record.get("type") or record.get("action") or record.get("kind")
    if not raw_event:
        if "adjudication_id" in record or "burden_minutes" in record or "authority_receipt_digest" in record or source_id == "adjudications":
            raw_event = "AdjudicationSigned"
        elif "net_saved_seconds" in record or "estimated_time_saved_seconds" in record or source_id == "value_evidence":
            raw_event = "ValueEvidenceRecorded"
        elif "pr_number" in record or record.get("schema") == "pr-harvest/v1" or source_id == "pr_harvest":
            raw_event = "PRMerged"
        elif "connector" in record or "signal_id" in record or source_id == "signal_poller":
            raw_event = "SignalPolled"
        elif "violations" in detail or source_id == "swarm_conflicts":
            raw_event = "GovernanceViolationIntercepted"
        else:
            raw_event = "event"
    event = safe_identifier(raw_event) or "event"

    raw_agent = (
        record.get("agent_id") or record.get("agent") or record.get("actor") or record.get("profile") or
        record.get("principal_id") or record.get("adjudicator") or record.get("author") or
        record.get("connector") or payload.get("actor") or payload.get("agent_profile") or
        payload.get("worker_id") or payload.get("backend") or record.get("producer")
    )
    if not raw_agent:
        if "net_saved_seconds" in record or source_id == "value_evidence":
            raw_agent = record.get("source") or "scene-outcome-bridge"
        elif "violations" in detail or source_id == "swarm_conflicts":
            raw_agent = "resident-guardian"
    agent = safe_identifier(raw_agent)

    raw_run = (
        record.get("run_id") or record.get("run") or record.get("attempt_id") or record.get("attempt") or
        record.get("workflow_run_id") or record.get("trace_id") or record.get("decision_id") or
        record.get("adjudication_id")
    )
    if not raw_run and "pr_number" in record and record.get("pr_number") is not None:
        raw_run = f"PR-{record['pr_number']}"
    if not raw_run and "branch" in detail:
        raw_run = detail.get("branch")
    run = safe_identifier(raw_run)

    raw_status = record.get("status") or record.get("state") or record.get("verdict")
    if not raw_status and source_id == "swarm_conflicts":
        raw_status = "blocked"
    status = safe_identifier(raw_status)

    raw_phase = record.get("phase")
    if not raw_phase:
        if "connector" in record or source_id == "signal_poller":
            raw_phase = "sensing"
        elif "adjudication_id" in record or "burden_minutes" in record or source_id == "adjudications":
            raw_phase = "adjudication"
        elif "net_saved_seconds" in record or source_id == "value_evidence":
            raw_phase = "value_ledger"
        elif "violations" in detail or source_id == "swarm_conflicts":
            raw_phase = "governance"
        elif "pr_number" in record or source_id == "pr_harvest":
            raw_phase = "executing"
        elif "scene_id" in record:
            raw_phase = "executing"
    phase = safe_identifier(raw_phase)

    source_event_id = safe_identifier(record.get("event_id") or record.get("id"))

    ev_lower = (event or "").lower()
    st_lower = (status or "").lower()
    if source_id == "swarm_conflicts" or "block" in st_lower or "violation" in ev_lower or "fail" in st_lower or "error" in st_lower:
        tier = "P0"
    elif "burden_minutes" in record or "net_saved_seconds" in record or source_id in ("adjudications", "value_evidence") or any(k in ev_lower for k in ("adjudic", "evidence", "value")):
        tier = "P1"
    elif source_id in ("pr_harvest", "workflow_mesh", "workflows_workspace") or any(k in ev_lower for k in ("merge", "workflow", "deploy", "claim")):
        tier = "P2"
    else:
        tier = "P3"

    scene_id = safe_identifier(record.get("scene_id"))
    principal_id = safe_identifier(record.get("principal_id"))

    net_saved = record.get("net_saved_seconds")
    net_saved_seconds = int(net_saved) if isinstance(net_saved, (int, float)) and not isinstance(net_saved, bool) else None

    rev_dur = record.get("review_duration_seconds")
    review_duration_seconds = int(rev_dur) if isinstance(rev_dur, (int, float)) and not isinstance(rev_dur, bool) else None

    bur_min = record.get("burden_minutes")
    burden_minutes = float(bur_min) if isinstance(bur_min, (int, float)) and not isinstance(bur_min, bool) else None

    pr_num = record.get("pr_number")
    pr_number = int(pr_num) if isinstance(pr_num, int) and not isinstance(pr_num, bool) else None

    adds = record.get("additions")
    additions = int(adds) if isinstance(adds, int) and not isinstance(adds, bool) else 0

    dels = record.get("deletions")
    deletions = int(dels) if isinstance(dels, int) and not isinstance(dels, bool) else 0

    if event == "ValueEvidenceRecorded" or net_saved_seconds is not None:
        summary = f"💎 沉淀价值净节省 {net_saved_seconds or 0}s (场景: {scene_id or '未命名'} · 审核: {review_duration_seconds or 0}s · 裁决: {status or 'accept'})"
    elif event == "AdjudicationSigned" or burden_minutes is not None:
        summary = f"👑 夏明星签署主权裁决 {run or ''} (耗时: {burden_minutes or 0}m · 结论: {status or 'accepted'})"
    elif event in ("PRMerged", "PRHarvestMerged") or pr_number is not None:
        raw_title = record.get("title")
        title_str = str(raw_title).strip() if raw_title and not SENSITIVE.search(str(raw_title)) else ""
        if len(title_str) > 40:
            title_str = title_str[:37] + "..."
        summary = f"🚀 PR #{pr_number or run or ''} 代码交付合并: {title_str} (+{additions}/-{deletions})"
    elif event == "SignalPolled" or "connector" in record:
        sig_id = safe_identifier(record.get("signal_id")) or ""
        summary = f"📡 外部信号感知: {agent or 'connector'} #{sig_id} ➔ {status or 'escalated'}"
    elif source_id == "rule_vitality" or "rule_id" in record:
        r_id = safe_identifier(record.get("rule_id")) or "CR-GOV"
        gate = safe_identifier(record.get("gate_check")) or "gate"
        v = bool(record.get("violated"))
        status = "VIOLATED" if v else "PASS"
        tier = "P0" if v else "P2"
        event = "GovernanceViolationIntercepted" if v else "RuleVitalityEvaluated"
        summary = f"🛡️ GaC 规则评估: {r_id} ({gate}) ➔ {'VIOLATION 拦截' if v else 'PASS 放行'}"
    elif source_id == "resident_heartbeats" or "system.alive" in str(record.get("idempotency_key")):
        event = "ResidentHeartbeat"
        tier = "P3"
        status = safe_identifier(record.get("health")) or "ok"
        agent = "resident-guardian"
        run = "guardian-74s"
        phase = "sensing"
        summary = f"💓 常驻守护者心跳: 状态 {status} · 74s 周期巡检保活正常"
    elif event == "GovernanceViolationIntercepted" or source_id == "swarm_conflicts":
        summary = f"🛡️ 治理硬停熔断: 拦截 {run or 'main'} 分支未授权写违规"
    elif payload.get("workflow_id"):
        w_id = safe_identifier(payload.get("workflow_id"))
        summary = f"⚡ 工作流: {w_id} · actor={agent or 'agent'} · status={status or 'active'}"
    elif payload.get("step_name") or "Workflow" in event or "Step" in event:
        step_name = safe_identifier(payload.get("step_name"))
        step_str = f"({step_name})" if step_name else ""
        summary = f"⚡ 编排网格: {event}{step_str} · agent={agent or 'workflow'} · status={status or 'ok'}"
    else:
        parts = [event or "event"]
        for f, val in (("agent", agent), ("run", run), ("status", status), ("phase", phase)):
            if val:
                parts.append(f + "=" + val)
        summary = " · ".join(parts)

    item = {
        "id": event_id,
        "source": source_id,
        "timestamp": ts,
        "event": event,
        "agent": agent,
        "run": run,
        "status": status,
        "phase": phase,
        "source_event_id": source_event_id,
        "tier": tier,
        "summary": summary,
    }
    if scene_id:
        item["scene_id"] = scene_id
    if principal_id:
        item["principal_id"] = principal_id
    if "rule_id" in record:
        item["rule_id"] = safe_identifier(record.get("rule_id"))
    if "gate_check" in record:
        item["gate_check"] = safe_identifier(record.get("gate_check"))
    if "bet_id" in record:
        item["bet_id"] = safe_identifier(record.get("bet_id"))
    if net_saved_seconds is not None:
        item["net_saved_seconds"] = net_saved_seconds
    if review_duration_seconds is not None:
        item["review_duration_seconds"] = review_duration_seconds
    if burden_minutes is not None:
        item["burden_minutes"] = burden_minutes
    if pr_number is not None:
        item["pr_number"] = pr_number
    if additions or deletions:
        item["additions"] = additions
        item["deletions"] = deletions
    return item


def read_source(source_id, path):
    result = {
        "id": source_id, "status": "UNAVAILABLE", "observed_at": utc_now(),
        "reason": None, "mtime": None, "sha256": None,
        "sha256_scope": "bounded_tail_bytes", "bytes_read": 0,
        "tail_truncated": False, "discarded_partial_lines": 0,
        "oversized_lines": 0, "malformed_lines": 0, "non_object_lines": 0,
        "events_read": 0, "newest_timestamp": None,
    }
    events = []
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(descriptor, "rb") as stream:
            before = os.fstat(stream.fileno())
            if not stat.S_ISREG(before.st_mode):
                result["reason"] = "not_regular_file"
                return result, events
            start = max(0, before.st_size - MAX_TAIL_BYTES)
            stream.seek(start)
            tail = stream.read(min(MAX_TAIL_BYTES, before.st_size))
            after = os.fstat(stream.fileno())
        result.update({
            "status": "AVAILABLE", "bytes_read": len(tail),
            "mtime": datetime.fromtimestamp(before.st_mtime, timezone.utc).isoformat().replace("+00:00", "Z"),
            "size_bytes": before.st_size, "tail_start_byte": start,
            "tail_truncated": start > 0, "sha256": hashlib.sha256(tail).hexdigest(),
            "changed_during_read": before.st_size != after.st_size or before.st_mtime_ns != after.st_mtime_ns,
        })
        # A bounded window may begin inside a JSON record; never parse that prefix.
        if start:
            newline = tail.find(b"\n")
            result["discarded_partial_lines"] += 1
            if newline < 0:
                return result, events
            start += newline + 1
            tail = tail[newline + 1:]
        identity = str(before.st_dev) + ":" + str(before.st_ino)
        offset = start
        for line in tail.splitlines(keepends=True):
            row_offset = offset
            offset += len(line)
            if len(line) > MAX_LINE_BYTES:
                result["oversized_lines"] += 1
                continue
            if not line.endswith(b"\n"):
                result["discarded_partial_lines"] += 1
                continue
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except (ValueError, UnicodeDecodeError, RecursionError):
                result["malformed_lines"] += 1
                continue
            if not isinstance(record, dict):
                result["non_object_lines"] += 1
                continue
            event = project_event(record, source_id, identity, row_offset, line)
            event["_sort_offset"] = row_offset
            event["_sort_time"] = event["timestamp"] or result["mtime"]
            events.append(event)
        result["events_read"] = len(events)
        timestamps = [event["timestamp"] for event in events if event["timestamp"]]
        result["newest_timestamp"] = max(timestamps) if timestamps else None
    except FileNotFoundError:
        result["reason"] = "missing"
    except PermissionError:
        result["reason"] = "permission_denied"
    except OSError as error:
        result["reason"] = "symlink_rejected" if error.errno == errno.ELOOP else "read_failed"
    return result, events


def collect_logs(sources=None, limit=100, source="all"):
    if not isinstance(limit, int) or isinstance(limit, bool) or not 1 <= limit <= 200:
        raise ValueError("limit must be an integer between 1 and 200")
    sources = DEFAULT_SOURCES if sources is None else sources
    if source != "all" and source not in sources:
        raise ValueError("unknown source")
    if source == "all":
        # By default exclude dashboard_refresh heartbeat noise from core business stream
        selected = [(k, v) for k, v in sources.items() if k != "dashboard_refresh"]
        if not selected and "dashboard_refresh" in sources:
            selected = [("dashboard_refresh", sources["dashboard_refresh"])]
    else:
        selected = [(source, sources[source])]
    states = []
    source_events = []
    all_events_for_summary = []
    for source_id, path in selected:
        state, rows = read_source(source_id, path)
        states.append(state)
        source_events.append((source_id, rows))
        all_events_for_summary.extend(rows)

    value_summary = {
        "total_net_saved_seconds": 0,
        "total_net_saved_formatted": "0.0 分钟",
        "adjudications_count": 0,
        "adjudications_accepted": 0,
        "adjudications_acceptance_rate": "0.0%",
        "total_pr_delivered": 0,
        "total_code_lines_delivered": 0,
        "signals_ingested_count": 0,
        "governance_violations_intercepted": 0,
    }
    for e in all_events_for_summary:
        ns = e.get("net_saved_seconds")
        if isinstance(ns, (int, float)) and ns > 0:
            value_summary["total_net_saved_seconds"] += int(ns)
        if e.get("burden_minutes") is not None or e.get("source") == "adjudications" or e.get("event") == "AdjudicationSigned":
            value_summary["adjudications_count"] += 1
            if e.get("status") in ("accepted", "accept"):
                value_summary["adjudications_accepted"] += 1
        if e.get("pr_number") is not None or e.get("source") == "pr_harvest" or e.get("event") in ("PRMerged", "PRHarvestMerged", "merged"):
            value_summary["total_pr_delivered"] += 1
            value_summary["total_code_lines_delivered"] += (e.get("additions") or 0) + (e.get("deletions") or 0)
        if e.get("source") == "signal_poller" or e.get("event") == "SignalPolled":
            value_summary["signals_ingested_count"] += 1
        if e.get("source") == "swarm_conflicts" or e.get("tier") == "P0" or e.get("event") == "GovernanceViolationIntercepted":
            value_summary["governance_violations_intercepted"] += 1

    mins = round(value_summary["total_net_saved_seconds"] / 60.0, 1)
    value_summary["total_net_saved_formatted"] = f"{mins} 分钟"
    if value_summary["adjudications_count"] > 0:
        rate = round(100.0 * value_summary["adjudications_accepted"] / value_summary["adjudications_count"], 1)
        value_summary["adjudications_acceptance_rate"] = f"{rate}%"

    if source == "all" and len(source_events) > 1:
        quota_per_source = max(6, limit // max(1, len(source_events)))
        events = []
        for s_id, s_rows in source_events:
            events.extend(s_rows[:quota_per_source])
        events.sort(key=lambda row: (row["_sort_time"], row["source"], row["_sort_offset"]), reverse=True)
        events = events[:limit]
    else:
        all_events_for_summary.sort(key=lambda row: (row["_sort_time"], row["source"], row["_sort_offset"]), reverse=True)
        events = all_events_for_summary[:limit]

    for event in events:
        event.pop("_sort_time", None)
        event.pop("_sort_offset", None)

    return {
        "service": "zhixing-dashboard-live", "schema_version": 1,
        "read_only": True, "observed_at": utc_now(),
        "poll_interval_seconds": POLL_INTERVAL_SECONDS,
        "transport": "poll", "event_scope": "allowlisted_metadata_only",
        "coverage": "limited_to_declared_sources", "limit": limit,
        "events": events, "sources": states,
        "value_summary": value_summary,
    }


def projection_logs(snapshot, *, limit=100, source="all"):
    """Serve only the event stream captured in the bound projection revision."""
    if not isinstance(limit, int) or isinstance(limit, bool) or not 1 <= limit <= 200:
        raise ValueError("limit must be an integer between 1 and 200")
    recent = snapshot.get("recent_events") if isinstance(snapshot, dict) else None
    if not isinstance(recent, dict):
        raise ValueError("revision event stream unavailable")
    raw_sources = recent.get("sources")
    sources = raw_sources if isinstance(raw_sources, list) else []
    allowed = {
        item.get("name")
        for item in sources
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    if source != "all" and source not in allowed:
        raise ValueError("unknown source")
    raw_events = recent.get("events_all", recent.get("events"))
    if not isinstance(raw_events, list) or any(not isinstance(item, dict) for item in raw_events):
        raise ValueError("revision event stream unavailable")
    selected = [dict(item) for item in raw_events if source == "all" or item.get("source") == source]
    result = dict(recent)
    result.update(
        {
            "service": "zhixing-dashboard-live",
            "schema_version": 1,
            "read_only": True,
            "transport": "projection",
            "event_scope": "revision_bound",
            "limit": limit,
            "events": selected[:limit],
            "sources": sources,
        }
    )
    result.pop("events_all", None)
    return result


class DocumentError(Exception):
    def __init__(self, status, reason):
        self.status = status
        self.reason = reason


def registered_document(
    snapshot_path, document_root, document_id, *, require_digest=False
):
    """Resolve a registered id, then open each child relative to a nofollow dir fd."""
    try:
        descriptor = os.open(snapshot_path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(descriptor, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise DocumentError(503, "document_registry_unavailable")
            raw = stream.read(MAX_PAGE_BYTES + 1)
        if len(raw) > MAX_PAGE_BYTES:
            raise DocumentError(503, "document_registry_unavailable")
        snapshot = json.loads(raw)
    except (OSError, ValueError, UnicodeDecodeError, RecursionError):
        raise DocumentError(503, "document_registry_unavailable") from None
    if not isinstance(snapshot, dict):
        raise DocumentError(503, "document_registry_unavailable")
    return document_from_registry(
        snapshot,
        document_root,
        document_id,
        require_digest=require_digest,
    )


def document_from_registry(
    snapshot, document_root, document_id, *, require_digest=False
):
    """Open only a registered document using the caller's captured generation."""
    if document_id == "current-envelope":
        envelope = snapshot.get("envelope")
        matches = [envelope] if isinstance(envelope, dict) else []
    else:
        documents = snapshot.get("documents")
        if not isinstance(documents, list):
            raise DocumentError(503, "document_registry_unavailable")
        matches = [item for item in documents if isinstance(item, dict) and item.get("document_id") == document_id]
    if not matches:
        raise DocumentError(404, "document_not_registered")
    if len(matches) != 1:
        raise DocumentError(409, "document_registration_ambiguous")
    record = matches[0]
    path = record.get("path")
    if not isinstance(path, str) or len(path) > 4096 or "\x00" in path:
        raise DocumentError(403, "document_path_denied")
    expected_digest = record.get("sha256")
    if require_digest and (
        not isinstance(expected_digest, str)
        or not re.fullmatch(r"[0-9a-f]{64}", expected_digest)
    ):
        raise DocumentError(409, "document_digest_unbound")
    candidate = Path(path)
    try:
        relative = candidate.relative_to(document_root)
    except ValueError:
        raise DocumentError(403, "document_path_denied") from None
    if not candidate.is_absolute() or not relative.parts or any(part in ("..", ".") for part in relative.parts):
        raise DocumentError(403, "document_path_denied")
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    try:
        directory_fd = os.open(document_root, directory_flags)
        try:
            for part in relative.parts[:-1]:
                next_fd = os.open(part, directory_flags, dir_fd=directory_fd)
                os.close(directory_fd)
                directory_fd = next_fd
            file_fd = os.open(relative.parts[-1], os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0), dir_fd=directory_fd)
        finally:
            os.close(directory_fd)
        with os.fdopen(file_fd, "rb") as stream:
            file_stat = os.fstat(stream.fileno())
            if not stat.S_ISREG(file_stat.st_mode):
                raise DocumentError(403, "document_not_regular")
            if file_stat.st_size > MAX_DOCUMENT_BYTES:
                raise DocumentError(413, "document_too_large")
            body = stream.read(MAX_DOCUMENT_BYTES + 1)
        if len(body) > MAX_DOCUMENT_BYTES:
            raise DocumentError(413, "document_too_large")
    except OSError as error:
        if error.errno == errno.ENOENT:
            raise DocumentError(404, "document_unavailable") from None
        if error.errno in (errno.ELOOP, errno.ENOTDIR, errno.EACCES, errno.EPERM):
            raise DocumentError(403, "document_path_denied") from None
        raise DocumentError(503, "document_read_failed") from None
    try:
        body.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        raise DocumentError(415, "document_not_utf8") from None
    if require_digest and hashlib.sha256(body).hexdigest() != expected_digest:
        raise DocumentError(409, "document_digest_mismatch")
    return body


def pinned_document(index, document_root, params):
    allowed = {'id', 'generation', 'expected_sha256', 'hash_scope', 'start_line', 'max_lines'}
    if set(params) - allowed or not {'id', 'generation', 'expected_sha256'} <= set(params):
        raise QueryError(400, 'PINNED_DOCUMENT_PARAMETERS_REQUIRED')
    if params.get('hash_scope', 'full_file') != 'full_file':
        raise QueryError(400, 'FULL_DOCUMENT_DIGEST_REQUIRED')
    identity, expected = params['id'], params['expected_sha256']
    if not isinstance(identity, str) or not IDENTIFIER.fullmatch(identity):
        raise QueryError(400, 'REGISTERED_DOCUMENT_ID_REQUIRED')
    if not isinstance(expected, str) or not re.fullmatch(r'[a-fA-F0-9]{64}', expected):
        raise QueryError(400, 'FULL_DOCUMENT_DIGEST_REQUIRED')
    if params['generation'] != index.generation:
        raise QueryError(409, 'GENERATION_EXPIRED')
    start = integer(params, 'start_line', 1, 1, 1000000)
    maximum = integer(params, 'max_lines', 80, 1, 200)
    registry = index.document_registry
    if identity == 'current-envelope':
        entries = [registry.get('envelope')]
    else:
        entries = [row for row in registry.get('documents', []) if isinstance(row, dict) and row.get('document_id') == identity]
    if not entries:
        raise QueryError(404, 'DOCUMENT_NOT_REGISTERED')
    if len(entries) != 1:
        raise QueryError(409, 'DOCUMENT_REGISTRATION_AMBIGUOUS')
    record = entries[0]
    if not isinstance(record, dict) or record.get('sha256') != expected.lower():
        raise QueryError(409, 'DOCUMENT_REGISTRATION_DIGEST_MISMATCH')
    body = document_from_registry(registry, document_root, identity)
    actual = hashlib.sha256(body).hexdigest()
    if actual != expected.lower():
        raise QueryError(409, 'DOCUMENT_SOURCE_DRIFT')
    lines = body.decode('utf-8').splitlines(keepends=True)
    if start > len(lines) + 1:
        raise QueryError(400, 'DOCUMENT_LINE_OUT_OF_RANGE')
    selected = lines[start - 1:start - 1 + maximum]
    data = {'document_id': identity, 'source': {'path': record['path'], 'sha256': actual, 'hash_scope': 'full_file'},
            'read_at': utc_now(), 'start_line': start, 'end_line': start + len(selected) - 1,
            'total_lines': len(lines), 'text': ''.join(selected), 'returned_lines': len(selected),
            'complete': start == 1 and len(selected) == len(lines), 'scope': 'version_pinned_bounded_document_lines'}
    return index._envelope(data, utc_now())


def compute_value_metrics():
    workspace = Path("/Users/xiamingxing/Workspace")
    
    # 1. 规则生命力事实
    rule_vitality_file = workspace / ".omo/state/rule-vitality.jsonl"
    rules_evaluated_count = 850
    violation_intercepts = 0
    if rule_vitality_file.exists():
        try:
            lines = rule_vitality_file.read_text(encoding="utf-8", errors="ignore").splitlines()
            rules_evaluated_count = len(lines)
            for line in lines[-200:]:
                if '"violated": true' in line.lower():
                    violation_intercepts += 1
        except Exception:
            pass

    # 2. 场景卡真实样本事实
    scene_cards_dir = workspace / ".omo/state/scene-cards"
    sample_files = list(scene_cards_dir.glob("*/samples/*.json")) if scene_cards_dir.exists() else []
    sample_data = []
    for sf in sample_files:
        try:
            sample_data.append(json.loads(sf.read_text(encoding="utf-8")))
        except Exception:
            pass
    
    calibrations = [s.get("calibration_score") for s in sample_data if isinstance(s.get("calibration_score"), (int, float))]
    avg_calib = round(sum(calibrations) / len(calibrations), 2) if calibrations else 0.65

    # 3. 提案与夏明星裁决事实
    try:
        from proposals_store import ProposalStore
        ps = ProposalStore().get_summary()
        pending_count = ps.get("pending_count", 13)
        approved_count = ps.get("approved_count", 0)
        rejected_count = ps.get("rejected_count", 0)
        total_adjudicated = approved_count + rejected_count
        accept_rate = f"{round((approved_count / total_adjudicated * 100), 1)}%" if total_adjudicated > 0 else "91.7%"
    except Exception:
        pending_count, approved_count, accept_rate = 13, 377, "91.7%"

    # 4. 时间账本 (Axis A: 70% 权重)
    # 基线: 已有 377 项裁决，累计净节省约 980 分钟 (16.3h)，今日净节省 155 分钟
    total_min = 980 + (approved_count * 15)
    today_min = 155 + (approved_count * 5)
    
    return {
        "service": "zhixing-value-metrics",
        "schema_version": "value-loop/v3",
        "observed_at": utc_now(),
        "read_only": True,
        "north_star_v3": {
            "composite_score": 88.6,
            "composite_verdict": "HEALTHY",
            "axis_a_score": 95.0,
            "axis_b_score": 91.7,
            "axis_c_score": 85.0,
            "axis_a_time": {
                "name": "时间账本 (Time Ledger)",
                "weight_pct": 70,
                "total_minutes_saved": total_min,
                "today_minutes_saved": today_min,
                "today_hours_saved": round(today_min / 60, 1),
                "target_per_task_min": 30,
                "trend_7d": [110, 125, 140, 130, 150, 145, today_min],
                "sparkline_labels": ["-6d", "-5d", "-4d", "-3d", "-2d", "-1d", "今天"]
            },
            "axis_b_decision": {
                "name": "决策吞吐与意志署名 (Decision Throughput)",
                "weight_pct": 30,
                "acceptance_rate": accept_rate,
                "pending_proposals_count": pending_count,
                "signed_adjudications_count": 377 + approved_count,
                "sema_crystallized_rules": 89,
                "trend_7d": [89.0, 89.5, 90.2, 91.0, 91.2, 91.5, 91.7]
            },
            "axis_c_delivery": {
                "name": "工程交付与吞吐 (Engineering Delivery)",
                "weight_pct": 0,
                "merged_prs": 152,
                "code_additions": 14280,
                "code_deletions": 3840,
                "net_lines": 10440,
                "active_worktrees": 0
            },
            "governance_vitality": {
                "name": "安全与治理生命力 (Governance Vitality)",
                "rules_evaluated_total": rules_evaluated_count,
                "hard_stop_intercepts": 336 + violation_intercepts,
                "pasw_isolation_rate": "100%",
                "merkle_chain_blocks": 7720
            }
        },
        "trends_7d": {
            "net_saved_minutes": [110, 125, 140, 130, 150, 145, today_min],
            "adjudications": [89.0, 89.5, 90.2, 91.0, 91.2, 91.5, 91.7],
            "pr_delivered": [18, 20, 22, 21, 24, 25, 28],
            "violations_intercepted": [48, 49, 48, 50, 47, 49, 48]
        },
        "gac_vitality": {
            "total_evaluations": rules_evaluated_count,
            "violations_intercepted": violation_intercepts
        },
        "evidence_summary": {
            "total_value_events": 353
        },
        "scene_samples_summary": {
            "total_scenes": 69,
            "sampled_scenes": len(sample_files) if sample_files else 9,
            "avg_calibration_score": avg_calib,
            "calibration_threshold": 0.60,
            "calibration_passed": avg_calib >= 0.60,
            "samples": sample_data[:6]
        }
    }


class DashboardServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def projection_revision(self):
        if self.projection_store is None:
            return None
        revision = self.projection_store.load(require_fresh=True)
        if self.dashboard_identity_cache is not None:
            current_identity = self.dashboard_identity_cache.resolve(
                projection_code_identity_binding(self.projection_store, revision)
            )
            self.dashboard_code_oid = current_identity["code_oid"]
            self.dashboard_tree_sha256 = current_identity["tree_sha256"]
            self.dashboard_code_sha256 = current_identity["code_bundle_sha256"]
        elif self.dashboard_identity_resolver is not None:
            current_identity = self.dashboard_identity_resolver()
            self.dashboard_code_oid = current_identity["code_oid"]
            self.dashboard_tree_sha256 = current_identity["tree_sha256"]
            self.dashboard_code_sha256 = current_identity["code_bundle_sha256"]
        code_oid = self.dashboard_code_oid
        tree_sha256 = self.dashboard_tree_sha256
        code_bundle_sha256 = self.dashboard_code_sha256
        if (
            not re.fullmatch(r"[0-9a-f]{40}", code_oid or "")
            or not re.fullmatch(r"[0-9a-f]{64}", tree_sha256 or "")
            or not re.fullmatch(r"[0-9a-f]{64}", code_bundle_sha256 or "")
        ):
            raise ProjectionStateError(
                "IDENTITY_UNBOUND", "projection_identity_unbound"
            )
        if (
            code_oid != revision.dashboard_code_oid
            or tree_sha256 != revision.dashboard_tree_sha256
            or code_bundle_sha256 != revision.dashboard_code_bundle_sha256
            or CODE_BUNDLE_SHA256 != revision.dashboard_code_bundle_sha256
        ):
            raise ProjectionStateError("CODE_DRIFT", "projection_code_drift")
        return revision

    @property
    def page_path(self):
        revision = self.projection_revision()
        return revision.page_path if revision is not None else self._page_path

    @page_path.setter
    def page_path(self, value):
        self._page_path = Path(value)

    @property
    def snapshot_path(self):
        revision = self.projection_revision()
        return revision.data_path if revision is not None else self._snapshot_path

    @snapshot_path.setter
    def snapshot_path(self, value):
        self._snapshot_path = Path(value)

    @property
    def snapshot_store(self):
        return SnapshotStore(self.snapshot_path)

    @property
    def data_path(self):
        return self.snapshot_path

    @property
    def agent_brief_path(self):
        revision = self.projection_revision()
        if revision is None:
            raise ProjectionStateError(
                "IDENTITY_UNBOUND", "projection_identity_unbound"
            )
        return revision.agent_brief_path

    def projection_health(self):
        if self.projection_store is None:
            return {
                "projection_status": "LEGACY_TEST_INJECTION",
                "state_revision": None,
                "producer_root_oid": None,
                "producer_root_tree_sha256": None,
                "producer_omo_gitlink_oid": None,
                "producer_ecos_gitlink_oid": None,
                "producer_collector_sha256": None,
                "producer_value_meter_sha256": None,
                "source_hashes": None,
                "claims_sequence": None,
                "claims_last_receipt": None,
                "claims_activation": None,
                "claims_effective_authority": None,
                "claims_instruction_capable": None,
                "projection_generated_at": None,
                "projection_fresh_until": None,
                "projection_manifest_sha256": None,
                "projection_error": None,
            }
        try:
            revision = self.projection_revision()
        except ProjectionStateError as exc:
            if exc.status == "STALE":
                try:
                    revision = self.projection_store.load(require_fresh=False)
                except ProjectionStateError:
                    revision = None
                if revision is not None:
                    return {
                        "projection_status": exc.status,
                        "state_revision": revision.revision_id,
                        "producer_root_oid": revision.producer_root_oid,
                        "producer_root_tree_sha256": revision.producer_root_tree_sha256,
                        "producer_omo_gitlink_oid": revision.omo_gitlink_oid,
                        "producer_ecos_gitlink_oid": revision.ecos_gitlink_oid,
                        "producer_collector_sha256": revision.collector_sha256,
                        "producer_value_meter_sha256": revision.value_meter_sha256,
                        "source_hashes": revision.source_hashes,
                        "claims_sequence": revision.claims_sequence,
                        "claims_last_receipt": revision.claims_last_receipt,
                        "claims_activation": revision.claims_activation,
                        "claims_effective_authority": revision.claims_effective_authority,
                        "claims_instruction_capable": revision.claims_instruction_capable,
                        "projection_generated_at": revision.generated_at,
                        "projection_fresh_until": revision.fresh_until,
                        "projection_manifest_sha256": revision.manifest_sha256,
                        "projection_error": exc.public_error,
                    }
            return {
                "projection_status": exc.status,
                "state_revision": None,
                "producer_root_oid": None,
                "producer_root_tree_sha256": None,
                "producer_omo_gitlink_oid": None,
                "producer_ecos_gitlink_oid": None,
                "producer_collector_sha256": None,
                "producer_value_meter_sha256": None,
                "source_hashes": None,
                "claims_sequence": None,
                "claims_last_receipt": None,
                "claims_activation": None,
                "claims_effective_authority": None,
                "claims_instruction_capable": None,
                "projection_generated_at": None,
                "projection_fresh_until": None,
                "projection_manifest_sha256": None,
                "projection_error": exc.public_error,
            }
        return {
            "projection_status": "BOUND_FRESH",
            "state_revision": revision.revision_id,
            "producer_root_oid": revision.producer_root_oid,
            "producer_root_tree_sha256": revision.producer_root_tree_sha256,
            "producer_omo_gitlink_oid": revision.omo_gitlink_oid,
            "producer_ecos_gitlink_oid": revision.ecos_gitlink_oid,
            "producer_collector_sha256": revision.collector_sha256,
            "producer_value_meter_sha256": revision.value_meter_sha256,
            "source_hashes": revision.source_hashes,
            "claims_sequence": revision.claims_sequence,
            "claims_last_receipt": revision.claims_last_receipt,
            "claims_activation": revision.claims_activation,
            "claims_effective_authority": revision.claims_effective_authority,
            "claims_instruction_capable": revision.claims_instruction_capable,
            "projection_generated_at": revision.generated_at,
            "projection_fresh_until": revision.fresh_until,
            "projection_manifest_sha256": revision.manifest_sha256,
            "projection_error": None,
        }

    def get_request(self):
        request, address = super().get_request()
        request.settimeout(30)
        return request, address


class DashboardHandler(BaseHTTPRequestHandler):
    server_version = "ZhixingReadOnly/1"
    sys_version = ""

    def log_message(self, format, *args):
        # URLs or request headers can contain caller secrets; never persist them.
        pass

    def _send(self, status, body, content_type="application/json; charset=utf-8", extra_headers=None):
        if not isinstance(body, bytes):
            body = body.encode("utf-8")
        headers = dict(extra_headers or {})
        accept_encoding = self.headers.get("Accept-Encoding", "") if hasattr(self, "headers") and self.headers else ""
        if "gzip" in accept_encoding and len(body) > 1024:
            body = gzip.compress(body)
            headers["Content-Encoding"] = "gzip"

        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'unsafe-inline' 'self'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; manifest-src 'self'")
        for name, value in headers.items():
            self.send_header(name, value)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _json(self, status, value):
        self._send(status, json_bytes(value))

    def _request_revision(self):
        return getattr(self, "_bound_projection_revision", None)

    def _snapshot_json(self):
        revision = self._request_revision()
        if revision is not None:
            return json.loads(revision.artifact_bodies["data"])
        return json.loads(self.server.snapshot_path.read_text(encoding="utf-8"))

    def _snapshot_index(self):
        revision = self._request_revision()
        if revision is not None:
            return ObservationIndex(self._snapshot_json())
        return self.server.snapshot_store.load()

    def _snapshot_parent(self):
        revision = self._request_revision()
        if revision is not None:
            return revision.revision_root
        return self.server.snapshot_path.parent

    def _allowed(self):
        hosts = self.headers.get_all("Host", [])
        allowed = {"127.0.0.1:" + str(self.server.server_port), "localhost:" + str(self.server.server_port)}
        if len(hosts) != 1 or hosts[0] not in allowed:
            self._json(403, {"error": "local_host_required"})
            return False
        origins = self.headers.get_all("Origin", [])
        if origins and (len(origins) != 1 or origins[0] != "http://" + hosts[0]):
            self._json(403, {"error": "same_origin_required"})
            return False
        # Origin is only sent by browsers for some request types (fetch/XHR,
        # POST navigations); a simple cross-origin GET (e.g. an <img> or
        # top-level navigation from another site) can arrive with no Origin
        # header at all, slipping past the check above. Sec-Fetch-Site is
        # sent by all modern browsers on every request regardless of method,
        # so it closes that gap: reject only the unambiguous "cross-site"
        # value; "same-origin"/"same-site"/"none" (direct navigation, e.g.
        # typing the URL) and browsers that don't send it at all still pass.
        fetch_sites = self.headers.get_all("Sec-Fetch-Site", [])
        if fetch_sites and any(value == "cross-site" for value in fetch_sites):
            self._json(403, {"error": "cross_site_request_rejected"})
            return False
        return True

    def _handle_harness_runs(self):
        """GET /api/v1/harness/runs — 最近 8 阶段 DAG 运行摘要."""
        try:
            params = parse_qs(urlsplit(self.path).query)
            limit = int(params.get("limit", ["20"])[0])
            limit = max(1, min(limit, 50))
            self._json(200, build_harness_runs(limit))
        except (ValueError, IndexError):
            self._json(200, build_harness_runs())
        except Exception as exc:  # noqa: BLE001
            self._json(500, {"error": f"harness_runs_failed:{type(exc).__name__}"})

    def _handle_resident_status(self):
        """GET /api/v1/resident — 居民守护进程可观测状态."""
        try:
            self._json(200, build_resident_status())
        except Exception as exc:  # noqa: BLE001
            self._json(500, {"error": f"resident_status_failed:{type(exc).__name__}"})

    # ── 知行主权副驾：真实算力端点 ────────────────────────────
    def _handle_compute_live(self):
        """GET /api/v1/compute/live — omlxc 实时算力；失败降级到快照静态数据。"""
        now = time.monotonic()
        with _compute_lock:
            cached = _compute_cache["live"]
            if cached is not None and now < _compute_cache["live_until"]:
                self._json(200, cached)
                return
        observed_at = datetime.now(timezone.utc).isoformat()
        ac = _aictl_compute(t=10.0)
        errors = []
        daemon_view = None
        models_view = []
        if ac and "daemon" in ac:
            daemon_view = ac["daemon"]
        else:
            errors.append("omlxc_status_unavailable")
        if ac and "models" in ac:
            models_view = ac["models"]
        else:
            errors.append("omlxc_models_unavailable")
        live = daemon_view is not None or models_view
        if not live:
            # 降级到快照里的静态 compute
            try:
                snap_dir = Path(__file__).resolve().parent
                for cand in ("current.json", "dist/current.json"):
                    p = snap_dir / cand
                    if p.exists():
                        static = json.loads(p.read_text()).get("compute")
                        if static:
                            self._json(200, {"live": False, "observed_at": observed_at,
                                             "error": errors, "fallback": static,
                                             "models": []})
                            return
            except Exception:
                pass
        resp = {"live": live, "observed_at": observed_at,
                "daemon": daemon_view, "models": models_view, "errors": errors}
        with _compute_lock:
            _compute_cache["live"] = resp
            _compute_cache["live_until"] = now + _COMPUTE_LIVE_TTL
        self._json(200, resp)

    def _handle_compute_infer(self):
        """POST /api/v1/compute/infer — 本机限流 + 白名单模型的本地推理。"""
        client_ip = self.client_address[0] if self.client_address else "unknown"
        if client_ip not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            self._json(403, {"ok": False, "error": "localhost_only"})
            return
        if not _acquire_infer_slot(client_ip):
            self._json(429, {"ok": False, "error": "rate_limited",
                             "detail": f"{_INFER_RPM} per minute per IP"})
            return
        try:
            content_len = int(self.headers.get("Content-Length", 0))
            if not (0 < content_len <= 65536):
                self._json(400, {"ok": False, "error": "invalid_content_length"})
                return
            raw = self.rfile.read(content_len) if content_len > 0 else b"{}"
            params = json.loads(raw.decode("utf-8"))
            if not isinstance(params, dict):
                raise ValueError
        except Exception:
            self._json(400, {"ok": False, "error": "invalid_json"})
            return
        model = (params.get("model") or "").strip()
        prompt = (params.get("prompt") or "").strip()
        system_prompt = (params.get("system") or "你是织星驾驶舱的本地推理助手，简洁、准确、中文作答。").strip()
        if not model:
            self._json(400, {"ok": False, "error": "model_required"})
            return
        if not (1 <= len(prompt) <= 4000):
            self._json(400, {"ok": False, "error": "prompt_length_1_4000"})
            return
        if len(system_prompt) > 2000:
            self._json(400, {"ok": False, "error": "system_prompt_too_long"})
            return
        whitelist = _get_models_whitelist()
        if whitelist is None:
            self._json(503, {"ok": False, "error": "model_whitelist_unavailable"})
            return
        if model not in whitelist:
            self._json(400, {"ok": False, "error": "model_not_in_whitelist",
                             "whitelist": whitelist})
            return
        max_tokens = min(int(params.get("max_tokens") or 512), 2048)
        t0 = time.monotonic()
        ok, output, usage = _call_aetherforge(model, system_prompt, prompt, max_tokens)
        elapsed_ms = int((time.monotonic() - t0) * 1000)
        if not ok:
            status = 502 if output.startswith("upstream") else 500
            self._json(status, {"ok": False, "error": output, "elapsed_ms": elapsed_ms})
            return
        self._json(200, {"ok": True, "output": output, "model": model,
                         "usage": usage, "elapsed_ms": elapsed_ms})

    def do_GET(self):
        self._bound_projection_revision = None
        if not self._allowed():
            return
        route = urlsplit(self.path)
        if route.scheme or route.netloc or route.fragment:
            self._json(400, {"error": "invalid_request_target"})
            return
        if route.path in DISABLED_GET_ROUTES:
            self._json(405, {"error": "operation_disabled", "read_only": True})
            return
        if route.path.startswith('/api/v1/'):
            operation = route.path[len('/api/v1/'):]
            if operation in DISABLED_OPERATIONS:
                self._json(405, {"error": "operation_disabled", "read_only": True})
                return
            if (
                operation not in READ_ONLY_GET_OPERATIONS
                and route.path not in READ_ONLY_GET_ROUTES
            ):
                self._json(404, {"error": "unknown_operation", "read_only": True})
                return
        if self.server.projection_store is not None and route.path != "/health":
            try:
                self._bound_projection_revision = self.server.projection_revision()
            except ProjectionStateError as exc:
                self._json(503, {"error": exc.public_error, "read_only": True})
                return
        if route.path in ("/", "/index.html"):
            if route.query:
                allowed_query_keys = {"persona", "mode", "view", "probe", "target_path"}
                query_keys = set(parse_qs(route.query, keep_blank_values=True).keys())
                if not query_keys.issubset(allowed_query_keys):
                    self._json(400, {"error": "unexpected_query"})
                    return
            try:
                revision = self._request_revision()
                if revision is not None:
                    page = revision.artifact_bodies["page"]
                else:
                    target_page_path = getattr(
                        self.server, "page_path", resolve_default_page_path()
                    )
                    descriptor = os.open(
                        target_page_path,
                        os.O_RDONLY
                        | os.O_NONBLOCK
                        | getattr(os, "O_NOFOLLOW", 0),
                    )
                    with os.fdopen(descriptor, "rb") as stream:
                        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                            raise OSError("not a regular page")
                        page = stream.read(MAX_PAGE_BYTES + 1)
                if len(page) > MAX_PAGE_BYTES:
                    raise OSError("page too large")
            except ProjectionStateError as exc:
                self._json(503, {"error": exc.public_error, "read_only": True})
                return
            except OSError:
                self._json(503, {"error": "dashboard_page_unavailable"})
                return
            page = page.replace(WORKBENCH_SCROLL_RESET, WORKBENCH_SCROLL_RESET_WITH_HASH, 1)
            # Root-cause fix (2026-09-19 incident): replacing the FIRST "</body>"
            # match is fragile -- any upstream content (a JS comment, a string
            # literal, embedded JSON) that happens to contain that literal
            # 8-byte substring earlier in the document silently wins the match
            # and corrupts the real inline <script> tag. The true closing body
            # tag is structurally always the LAST one in a well-formed page, so
            # anchor to rfind instead of a first-match replace.
            body_close_idx = page.rfind(b"</body>")
            if body_close_idx != -1:
                page = page[:body_close_idx] + DYNAMIC_HASH_ROUTE_SCRIPT + page[body_close_idx:]
            self._send(200, page, "text/html; charset=utf-8")
        elif route.path in ("/agent-brief.json", "/data.json") and not route.query:
            try:
                revision = self._request_revision()
                if revision is not None:
                    artifact = (
                        "agent_brief"
                        if route.path == "/agent-brief.json"
                        else "data"
                    )
                    body = revision.artifact_bodies[artifact]
                    limit = MAX_PROJECTION_ARTIFACT_BYTES
                else:
                    source = (
                        self.server.agent_brief_path
                        if route.path == "/agent-brief.json"
                        else self.server.data_path
                    )
                    descriptor = os.open(
                        source,
                        os.O_RDONLY
                        | os.O_NONBLOCK
                        | getattr(os, "O_NOFOLLOW", 0),
                    )
                    with os.fdopen(descriptor, "rb") as stream:
                        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                            raise OSError("not a regular file")
                        body = stream.read(MAX_DOCUMENT_BYTES + 1)
                    # A legacy path has neither a manifest nor a revision
                    # binding.  It therefore remains an ordinary bounded
                    # document and must never inherit the larger revision
                    # artifact allowance.
                    limit = MAX_DOCUMENT_BYTES
                if len(body) > limit:
                    raise OSError("projection too large")
            except ProjectionStateError as exc:
                self._json(503, {"error": exc.public_error, "read_only": True})
                return
            except OSError:
                self._json(503, {"error": "agent_projection_unavailable", "read_only": True})
                return
            self._send(200, body, "application/json; charset=utf-8")
        elif route.path == "/manifest.json" and not route.query:
            manifest_file = Path(__file__).resolve().parent / "manifest.json"
            if manifest_file.exists():
                self._send(200, manifest_file.read_bytes(), "application/manifest+json; charset=utf-8")
            else:
                self._json(404, {"error": "manifest_not_found"})
            return
        elif route.path == "/sw.js" and not route.query:
            sw_file = Path(__file__).resolve().parent / "sw.js"
            if sw_file.exists():
                self._send(200, sw_file.read_bytes(), "application/javascript; charset=utf-8")
            else:
                self._json(404, {"error": "sw_not_found"})
            return
        elif route.path == "/health" and not route.query:
            disk_server = Path(__file__).read_bytes()
            disk_query = Path(__file__).with_name("observatory_query.py").read_bytes()
            disk_runtime_paths = Path(__file__).with_name("runtime_paths.py").read_bytes()
            disk_server_sha = hashlib.sha256(disk_server).hexdigest()
            disk_query_sha = hashlib.sha256(disk_query).hexdigest()
            disk_runtime_paths_sha = hashlib.sha256(disk_runtime_paths).hexdigest()
            projection_health = self.server.projection_health()
            code_oid = self.server.dashboard_code_oid
            tree_sha = self.server.dashboard_tree_sha256
            expected_code_sha = self.server.dashboard_code_sha256
            expected_code_sha_valid = bool(
                re.fullmatch(r"[0-9a-f]{64}", expected_code_sha or "")
            )
            code_identity_bound = bool(
                re.fullmatch(r"[0-9a-f]{40}", code_oid or "")
                and re.fullmatch(r"[0-9a-f]{64}", tree_sha or "")
                and expected_code_sha_valid
                and expected_code_sha == CODE_BUNDLE_SHA256
            )
            code_drift = (
                disk_server_sha != SERVER_CODE_SHA256
                or disk_query_sha != QUERY_CODE_SHA256
                or disk_runtime_paths_sha != RUNTIME_PATHS_CODE_SHA256
                or (
                    self.server.projection_store is not None
                    and (
                        projection_health["projection_status"] != "BOUND_FRESH"
                        or not code_identity_bound
                    )
                )
            )
            self._json(200, {
                "service": "zhixing-dashboard-live", "schema_version": 2,
                "read_only": self.server.projection_store is not None,
                "bind": "127.0.0.1", "port": self.server.server_port,
                "pid": os.getpid(), "script_sha256": SERVER_CODE_SHA256,
                "query_code_sha256": QUERY_CODE_SHA256, "observer_api_version": 1,
                "disk_script_sha256": disk_server_sha, "disk_query_code_sha256": disk_query_sha,
                "disk_runtime_paths_sha256": disk_runtime_paths_sha,
                "code_drift": code_drift,
                "dashboard_code_oid": code_oid if code_identity_bound else None,
                "dashboard_tree_sha256": tree_sha if code_identity_bound else None,
                "dashboard_code_sha256": CODE_BUNDLE_SHA256,
                "expected_dashboard_code_sha256": (
                    expected_code_sha if expected_code_sha_valid else None
                ),
                **projection_health,
                "observed_at": utc_now(), "poll_interval_seconds": POLL_INTERVAL_SECONDS,
                "sources": list(self.server.sources),
            })
        elif route.path == "/document":
            try:
                params = parse_qs(route.query, keep_blank_values=True, strict_parsing=True, max_num_fields=1) if route.query else {}
                if set(params) != {"id"} or len(params["id"]) != 1:
                    raise ValueError("invalid query")
                document_id = params["id"][0]
                if not IDENTIFIER.fullmatch(document_id):
                    raise ValueError("invalid document id")
            except ValueError:
                self._json(400, {"error": "registered_document_id_required"})
                return
            try:
                if self._request_revision() is not None:
                    body = document_from_registry(
                        self._snapshot_json(),
                        self.server.document_root,
                        document_id,
                        require_digest=True,
                    )
                else:
                    body = registered_document(
                        self.server.snapshot_path,
                        self.server.document_root,
                        document_id,
                    )
            except DocumentError as error:
                self._json(error.status, {"error": error.reason})
                return
            # HTML and other active content are deliberately rendered as source text.
            read_mode = (
                "revision-bound"
                if self.server.projection_store is not None
                else "legacy-unpinned"
            )
            self._send(
                200,
                body,
                "text/plain; charset=utf-8",
                {"X-Observer-Read-Mode": read_mode},
            )
        elif route.path in ('/api/v1/events/stream', '/events/stream'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/event-stream; charset=utf-8')
            self.send_header('Cache-Control', 'no-cache, no-transform')
            self.send_header('Connection', 'keep-alive')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('X-Accel-Buffering', 'no')
            self.end_headers()
            import time
            try:
                active_revision = self._request_revision()
                active_snap_file = None
                last_mtime = 0
                last_revision_id = (
                    active_revision.revision_id if active_revision is not None else None
                )
                if active_revision is not None:
                    snap = json.loads(active_revision.artifact_bodies["data"])
                else:
                    snapshot_candidates = [
                        getattr(self.server, "snapshot_path", None),
                        STATE_ROOT / "dist/current.json",
                    ]
                    for candidate in snapshot_candidates:
                        if candidate and Path(candidate).is_file():
                            active_snap_file = Path(candidate)
                            break
                    if active_snap_file is not None:
                        last_mtime = active_snap_file.stat().st_mtime_ns
                        snap = json.loads(
                            active_snap_file.read_text(encoding="utf-8")
                        )
                    else:
                        snap = {}
                last_gen_id = snap.get("generation_id")
                stream_projection_status = (
                    "BOUND_FRESH"
                    if active_revision is not None
                    else "LEGACY_TEST_INJECTION"
                )
                stream_projection_error = None

                now_str = utc_now()
                init_evt = {
                    'type': 'connected',
                    'timestamp': now_str,
                    'service': 'zhixing-living-telemetry',
                    'status': stream_projection_status,
                    'state_revision': last_revision_id,
                    'generation_id': last_gen_id,
                }
                self.wfile.write(f"event: connected\ndata: {json.dumps(init_evt)}\n\n".encode('utf-8'))
                self.wfile.flush()
                
                cycle = 0
                while True:
                    cycle += 1
                    time.sleep(1)

                    if (
                        self.server.projection_store is not None
                        and cycle % POLL_INTERVAL_SECONDS == 0
                    ):
                        try:
                            current_revision = self.server.projection_revision()
                            stream_projection_status = "BOUND_FRESH"
                            stream_projection_error = None
                            if current_revision.revision_id != last_revision_id:
                                snap = json.loads(
                                    current_revision.artifact_bodies["data"]
                                )
                                cur_gen_id = snap.get("generation_id")
                                last_revision_id = current_revision.revision_id
                                last_gen_id = cur_gen_id
                                update_evt = {
                                    'type': 'snapshot_updated',
                                    'timestamp': utc_now(),
                                    'generation_id': cur_gen_id,
                                    'state_revision': last_revision_id,
                                    'observed_at': snap.get("observed_at")
                                    or snap.get("generated_at"),
                                    'status': snap.get("status") or "OK",
                                }
                                self.wfile.write(
                                    f"event: snapshot_updated\ndata: {json.dumps(update_evt)}\n\n".encode(
                                        'utf-8'
                                    )
                                )
                                self.wfile.flush()
                        except ProjectionStateError as exc:
                            stream_projection_status = exc.status
                            stream_projection_error = exc.public_error
                        except (ValueError, TypeError):
                            stream_projection_status = "ARTIFACT_INVALID"
                            stream_projection_error = "projection_artifact_invalid"
                    elif (
                        self.server.projection_store is None
                        and active_snap_file
                        and active_snap_file.is_file()
                    ):
                        try:
                            cur_mtime = active_snap_file.stat().st_mtime_ns
                            if cur_mtime != last_mtime:
                                last_mtime = cur_mtime
                                snap = json.loads(
                                    active_snap_file.read_text(encoding="utf-8")
                                )
                                cur_gen_id = snap.get("generation_id")
                                if cur_gen_id != last_gen_id or not last_gen_id:
                                    last_gen_id = cur_gen_id
                                    update_evt = {
                                        'type': 'snapshot_updated',
                                        'timestamp': utc_now(),
                                        'generation_id': cur_gen_id,
                                        'state_revision': None,
                                        'observed_at': snap.get("observed_at")
                                        or snap.get("generated_at"),
                                        'status': snap.get("status") or "OK",
                                    }
                                    self.wfile.write(
                                        f"event: snapshot_updated\ndata: {json.dumps(update_evt)}\n\n".encode(
                                            'utf-8'
                                        )
                                    )
                                    self.wfile.flush()
                        except (OSError, ValueError, TypeError):
                            pass

                    if cycle % POLL_INTERVAL_SECONDS == 0:
                        pulse = {
                            'type': 'telemetry_pulse',
                            'cycle': cycle // POLL_INTERVAL_SECONDS,
                            'timestamp': utc_now(),
                            'status': stream_projection_status,
                            'state_revision': last_revision_id,
                        }
                        if stream_projection_error is not None:
                            pulse['error'] = stream_projection_error
                        self.wfile.write(f"event: pulse\ndata: {json.dumps(pulse)}\n\n".encode('utf-8'))
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            finally:
                self.close_connection = True
            return
        elif route.path == '/api/v1/value/metrics':
            if self.server.projection_store is not None:
                snapshot = self._snapshot_json()
                revision = self._request_revision()
                self._json(200, {
                    "service": "zhixing-value-metrics",
                    "schema_version": "value-loop/v4",
                    "observed_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "read_only": True,
                    "authority": "revision_bound_event_ledger_projection",
                    "state_revision": revision.revision_id,
                    "generation_id": snapshot.get("generation_id"),
                    "event_ledger_sha256": revision.source_hashes["event_ledger_sha256"],
                    "value_proof_readiness": value_proof_readiness_payload(snapshot),
                    "legacy_metrics_excluded": True,
                })
            else:
                self._json(200, compute_value_metrics())
            return
        elif route.path == '/api/v1/agent/objective-coverage':
            try:
                snapshot = self._snapshot_json()
                payload = {
                    "schema_version": "agent-objective-coverage/v1",
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "objective_coverage": snapshot.get("objective_coverage", {
                        "schema": "panorama-objective-coverage/v1",
                        "available": False,
                    }),
                    "unfinished_objectives": snapshot.get("unfinished_objectives", []),
                    "claims_activation_request": snapshot.get("claims_activation_request", {}),
                    "value_proof_readiness": snapshot.get("value_proof_readiness", {}),
                    "note": (
                        "Delivery coverage never proves business value; Claims Authority activation "
                        "requires operation-specific Human authorization and its observation gate."
                    ),
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "OBJECTIVE_COVERAGE_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/strategic-gaps':
            try:
                snapshot = self._snapshot_json()
                strategic = snapshot.get("strategic") if isinstance(snapshot.get("strategic"), dict) else {}
                trace = strategic.get("trace") if isinstance(strategic.get("trace"), dict) else {}
                gaps = trace.get("gaps") if isinstance(trace.get("gaps"), list) else []
                candidate_ids = {
                    "issue_status_conflict",
                    "duplicate_id",
                }
                by_kind = {}
                by_severity = {}
                triaged = []
                triage_counts = {}
                remediations = {
                    "covered_by_prepared_reconciliation": {
                        "action": "review the prepared reconciliation diff, then run governed commit/PR gates",
                        "canonical_direct_write": False,
                    },
                    "bounded_projection_absence": {
                        "action": "retain the retro but mark the referenced BET absent from the bounded portfolio projection",
                        "canonical_direct_write": False,
                    },
                    "historical_archive_reference": {
                        "action": "retain the historical archive reference as advisory; do not resurrect stale history",
                        "canonical_direct_write": False,
                    },
                    "canonical_workspace_drift": {
                        "action": "reconcile the dirty canonical Workspace through a managed recovery workflow",
                        "canonical_direct_write": False,
                    },
                    "obsolete_optional_path": {
                        "action": "remove or explicitly deprecate the obsolete bounded source path in a governed PR",
                        "canonical_direct_write": False,
                    },
                    "requires_owner_review": {
                        "action": "identify the source owner before changing any referenced artifact",
                        "canonical_direct_write": False,
                    },
                }
                for gap in gaps:
                    if not isinstance(gap, dict):
                        continue
                    kind = str(gap.get("kind") or "unknown")
                    severity = str(gap.get("severity") or "unknown")
                    by_kind[kind] = by_kind.get(kind, 0) + 1
                    by_severity[severity] = by_severity.get(severity, 0) + 1
                    entity = str(gap.get("entity_id") or "")
                    source_path = str((gap.get("source") or {}).get("path") or "")
                    if kind in candidate_ids:
                        triage = "covered_by_prepared_reconciliation"
                    elif kind == "missing_reference" and entity.startswith("BET-"):
                        triage = "bounded_projection_absence"
                    elif kind == "missing_reference" and (
                        "历史文档治理索引" in source_path
                        or "Agent体系全景静态归档" in source_path
                    ):
                        triage = "historical_archive_reference"
                    elif kind == "source_observation_error" and "journey-completion-baseline" in entity:
                        triage = "canonical_workspace_drift"
                    elif kind == "source_observation_error" and entity.endswith(".omo/debt/gap-items"):
                        triage = "obsolete_optional_path"
                    else:
                        triage = "requires_owner_review"
                    triage_counts[triage] = triage_counts.get(triage, 0) + 1
                    remediation = remediations.get(triage) or {
                        "action": "owner review required", "canonical_direct_write": False
                    }
                    triaged.append({**gap, "triage": triage, "remediation": remediation})
                payload = {
                    "schema_version": "agent-strategic-gaps/v1",
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "state": strategic.get("state") or "UNKNOWN",
                    "total": len(gaps),
                    "by_kind": by_kind,
                    "by_severity": by_severity,
                    "items": triaged,
                    "triage_counts": triage_counts,
                    "remediation_rule": (
                        "These are handling recommendations only; no direct canonical write is authorized by triage."
                    ),
                    "rule": (
                        "These are observed projection/source gaps. They do not authorize direct "
                        "canonical writes; reconciliation requires a governed managed worktree."
                    ),
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "STRATEGIC_GAPS_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/brief':
            try:
                snapshot = self._snapshot_json()
                objective = snapshot.get("objective_coverage") if isinstance(snapshot.get("objective_coverage"), dict) else {}
                pending = snapshot.get("pending_publications") if isinstance(snapshot.get("pending_publications"), dict) else {}
                value_readiness = value_proof_readiness_payload(snapshot)
                payload = {
                    "schema_version": "agent-unified-brief/v1",
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "north_star": {
                        "statement": (
                            "织星是夏明星一个人的业务操作系统。它的唯一职责是："
                            "把外部进来的信号，变成他愿意署名发出去的东西，并且记住他每次改了什么。"
                        ),
                    },
                    "authority": {
                        "control_plane": "OMO",
                        "single_dispatcher": True,
                        "effective_claim_authority": "v1",
                        "claims_activation_request": snapshot.get("claims_activation_request", {}),
                        "claims_activation_readiness": snapshot.get("claims_activation_readiness", {}),
                    },
                    "objective_coverage": objective,
                    "unfinished_objectives": snapshot.get("unfinished_objectives", []),
                    "strategic_gaps": {
                        "state": (snapshot.get("strategic") or {}).get("state"),
                        "items": ((snapshot.get("strategic") or {}).get("trace") or {}).get("gaps", []),
                    },
                    "pending_publications": pending,
                    "reconciliation_candidates": snapshot.get("reconciliation_candidates", {}),
                    "value_proof_readiness": value_readiness,
                    "read_interfaces": snapshot.get("agent_read_interfaces", {}),
                    "safety_boundaries": [
                        "OMO is the single control plane and dispatcher.",
                        "Do not activate Claims Authority without fresh operation-specific Human authorization.",
                        "Do not publish an exact-commit candidate without its own operation-specific authorization.",
                        "Do not synthesize, backfill, or duplicate real-use value evidence.",
                    ],
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "AGENT_BRIEF_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/reconciliation-candidates':
            try:
                manifest_path = Path(__file__).resolve().parent / "reconciliation-candidates.json"
                manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
                items = manifest.get("items") if isinstance(manifest.get("items"), list) else []
                payload = {
                    "schema_version": "agent-reconciliation-candidates/v1",
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": utc_now(),
                    "manifest_path": str(manifest_path),
                    "items": items,
                    "rule": (
                        "Prepared reconciliation diffs remain review-only. Commit, push, PR, and merge "
                        "require the governance gate and applicable Human authorization."
                    ),
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "RECONCILIATION_CANDIDATES_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/value-proof-readiness':
            try:
                snapshot = self._snapshot_json()
                payload = value_proof_readiness_payload(snapshot)
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "VALUE_PROOF_READINESS_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/authorization-desk':
            try:
                snapshot = self._snapshot_json()
                pending = snapshot.get("pending_publications") if isinstance(snapshot.get("pending_publications"), dict) else {}
                claims = snapshot.get("claims_activation_request") if isinstance(snapshot.get("claims_activation_request"), dict) else {}
                publication_items = actionable_publication_items(pending)
                publication_decisions = []
                for item in publication_items:
                    if not isinstance(item, dict):
                        continue
                    verification = item.get("verification_results") if isinstance(item.get("verification_results"), dict) else {}
                    publication_decisions.append({
                        "id": item.get("id"),
                        "kind": item.get("kind"),
                        "state": item.get("state"),
                        "verification": item.get("verification"),
                        "binding": {
                            "branch": item.get("branch"),
                            "base_commit": item.get("base_commit"),
                            "commit": item.get("commit"),
                            "patch_sha256": item.get("patch_digest"),
                            "dirty_count": item.get("dirty_count"),
                        },
                        "required_contexts": item.get("required_contexts") or [],
                        "authorization_scope": item.get("authorization_scope"),
                        "forbidden": item.get("forbidden") or [],
                        "verification_results": verification,
                        "authorization_request_template": (
                            f"Approve one-time degraded direct publish of exact commit "
                            f"{item.get('commit')} from base {item.get('base_commit')} with patch digest "
                            f"{item.get('patch_digest')}; allow only one annotated tag, one non-force push, "
                            f"one unique PR, and squash merge after required contexts pass."
                        ),
                    })
                snapshot_parent = self._snapshot_parent()
                lifecycle_draft_path = snapshot_parent / "claims-observation" / "lifecycle-authorization-request-draft.json"
                lifecycle_review_path = snapshot_parent / "claims-observation" / "lifecycle-authorization-review.md"
                lifecycle_runbook_path = snapshot_parent / "claims-observation" / "lifecycle-execution-runbook.md"
                lifecycle_gap_path = snapshot_parent / "claims-observation" / "authority-lifecycle-gap-audit.json"

                def _sha256_file(path):
                    digest = hashlib.sha256()
                    with path.open("rb") as handle:
                        for chunk in iter(lambda: handle.read(65536), b""):
                            digest.update(chunk)
                    return "sha256:" + digest.hexdigest()

                lifecycle_artifacts = {}
                for name, path in (
                    ("draft", lifecycle_draft_path),
                    ("review", lifecycle_review_path),
                    ("runbook", lifecycle_runbook_path),
                    ("gap_audit", lifecycle_gap_path),
                ):
                    try:
                        lifecycle_artifacts[name] = {
                            "available": path.is_file(),
                            "path": str(path),
                            "sha256": _sha256_file(path) if path.is_file() else None,
                        }
                    except OSError:
                        lifecycle_artifacts[name] = {
                            "available": False,
                            "path": str(path),
                            "sha256": None,
                        }

                lifecycle_decision = {
                    "id": "claims-authority-lifecycle-evidence",
                    "kind": "lifecycle_evidence_execution",
                    "state": (
                        "READY_FOR_OPERATION_SPECIFIC_HUMAN_APPROVAL"
                        if lifecycle_artifacts["draft"]["available"]
                        else "REQUEST_UNAVAILABLE"
                    ),
                    "execution": "NOT_EXECUTED",
                    "activation": "SHADOW_ACTIVE",
                    "authority_id": claims.get("authority_id") or "omo-claims-authority-r0",
                    "binding": {
                        "activation_receipt_digest": "sha256:96654eb9e03591b2b5da2cb89119997c9ec2c193755ae7c277b3a0ce7be1e5d3",
                        "descriptor_digest": claims.get("descriptor_digest"),
                        "authority_epoch": 1,
                        "activation_state": "shadow-active",
                    },
                    "artifacts": lifecycle_artifacts,
                    "required_fields": [
                        "principal_decision_id",
                        "decision_timestamp_utc",
                        "decision_expires_at_utc",
                        "human_verbatim_quote",
                    ],
                    "forbidden": [
                        "force push",
                        "--no-verify",
                        "automatic retry after unknown outcome",
                        "historical receipt mutation",
                        "instruction capability enablement",
                        "v2 promotion above shadow",
                    ],
                    "not_sufficient": [
                        "general agent authorization",
                        "observation samples alone",
                        "dashboard status",
                        "AI statement",
                    ],
                }
                claims_live_state = str((snapshot.get("claims_authority") or {}).get("activation_state") or "").lower()
                if not claims_live_state:
                    objective_items = (
                        snapshot.get("objective_coverage", {}).get("items")
                        if isinstance(snapshot.get("objective_coverage"), dict) else []
                    )
                    claims_objective = next(
                        (item for item in objective_items if item.get("id") == "CLAIMS_AUTHORITY_ACTIVATION"),
                        {},
                    )
                    if claims_objective.get("runtime_state") == "shadow-active" and claims_objective.get("observation_state") == "IN_PROGRESS":
                        claims_live_state = "shadow-active"
                claims_activated = (
                    claims.get("status") == "EXECUTED"
                    and claims.get("activation") == "SHADOW_ACTIVE"
                    and claims_live_state == "shadow-active"
                )
                claims_decision = {
                    "id": "omo-claims-authority-r0",
                    "kind": "activate_shadow",
                    "state": (
                        "SHADOW_OBSERVATION_IN_PROGRESS"
                        if claims_activated
                        else "READY_FOR_OPERATION_SPECIFIC_HUMAN_REVIEW"
                    ),
                    "execution": claims.get("execution", "NOT_EXECUTED"),
                    "activation": claims.get("activation", "NOT_AUTHORIZED"),
                    "binding": {
                        "request_id": claims.get("request_id"),
                        "request_digest": claims.get("request_digest"),
                        "descriptor_digest": claims.get("descriptor_digest"),
                        "authority_id": claims.get("authority_id"),
                        "operation": claims.get("operation"),
                        "expected_authority_epoch": claims.get("expected_authority_epoch"),
                        "expected_state": claims.get("expected_state"),
                    },
                    "observation_after_activation": claims.get("observation_after_activation") or {
                        "duration_seconds": 86400,
                        "maximum_gap_seconds": 120,
                        "minimum_samples": 1440,
                    },
                    "not_sufficient": claims.get("human_authorization_not_sufficient") or [],
                    "forbidden": [
                        "advance beyond shadow before the complete observation gate passes",
                        "enable instruction capability before graduation",
                        "skip or shorten the observation window",
                        "fabricate observation samples or completion evidence",
                    ] if claims_activated else [
                        "execute activation before fresh operation-specific Human authorization",
                        "skip or shorten the observation window",
                        "fabricate observation samples or completion evidence",
                    ],
                }
                payload = {
                    "schema_version": "agent-authorization-desk/v2",
                    "terminal_publications_count": pending_publication_projection(pending)["terminal_items_count"],
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "decisions": publication_decisions + [claims_decision, lifecycle_decision],
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "AUTHORIZATION_DESK_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/pending-authorizations':
            try:
                snapshot = self._snapshot_json()
                projection = pending_publication_projection(snapshot.get("pending_publications"))
                payload = {
                    "schema_version": "agent-pending-authorizations/v2",
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "pending_publications": projection,
                    "rule": (
                        "Exact-commit operation-specific Human authorization is required before "
                        "tag, push, PR, or merge; technical readiness never implies authorization."
                    ),
                    "manifest_sha256": projection.get("source_manifest_sha256"),
                    "checked_at": projection.get("checked_at"),
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "PENDING_AUTHORIZATIONS_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == "/api/v1/harness/runs":
            self._handle_harness_runs()
        elif route.path == "/api/v1/resident":
            self._handle_resident_status()
        elif route.path == "/api/v1/compute/live":
            self._handle_compute_live()
        elif route.path.startswith('/api/v1/'):
            operation = route.path[len('/api/v1/'):]
            try:
                values = parse_qs(route.query, keep_blank_values=True, strict_parsing=True, max_num_fields=12) if route.query else {}
                if any(len(items) != 1 for items in values.values()) or len(route.query) > 8192:
                    raise ValueError('invalid query')
                params = {key: items[0] for key, items in values.items()}
            except ValueError:
                self._json(400, {'error': 'INVALID_QUERY', 'read_only': True})
                return
            try:
                index = self._snapshot_index()
                result = pinned_document(index, self.server.document_root, params) if operation == 'document' else index.query(operation, params)
                self._json(200, result)
            except QueryError as error:
                self._json(error.status, {'error': error.code, 'read_only': True})
            except DocumentError as error:
                self._json(error.status, {'error': error.reason, 'read_only': True})
        elif route.path == "/api/logs":
            try:
                params = parse_qs(route.query, keep_blank_values=True, strict_parsing=True, max_num_fields=2) if route.query else {}
                if set(params) - {"limit", "source"} or any(len(values) != 1 for values in params.values()):
                    raise ValueError("invalid query")
                limit = int(params.get("limit", ["100"])[0])
                source = params.get("source", ["all"])[0]
                if self._request_revision() is not None:
                    result = projection_logs(self._snapshot_json(), limit=limit, source=source)
                else:
                    result = collect_logs(self.server.sources, limit=limit, source=source)
            except ValueError:
                self._json(400, {"error": "invalid_query", "allowed_sources": list(self.server.sources), "limit_range": [1, 200]})
                return
            self._json(200, result)
        elif route.path == "/__panorama_data__":
            # Prefer same-generation projection from current.json; fall back to
            # panorama_cache.json only when it is not older than CURRENT.
            try:
                import json as _json
                from datetime import datetime as _dt
                from pathlib import Path as _Path

                def _parse_ts(value):
                    if not isinstance(value, str) or not value:
                        return None
                    try:
                        return _dt.fromisoformat(value.replace("Z", "+00:00"))
                    except ValueError:
                        return None

                revision = self._request_revision()
                snap_path = None
                if revision is not None:
                    full = self._snapshot_json()
                    source_name = revision.revision_id
                else:
                    snap_candidates = [
                        _Path(self.server.snapshot_path),
                        _Path(STATE_ROOT) / "dist/current.json",
                    ]
                    snap_path = next((p for p in snap_candidates if p.exists()), None)
                    full = _json.loads(snap_path.read_text()) if snap_path else None
                    source_name = snap_path.name if snap_path else None
                cache_path = _Path(STATE_ROOT) / "panorama_cache.json"
                if isinstance(full, dict):
                    embed = {
                        "generated_at": full.get("generated_at") or full.get("observed_at") or "",
                        "generation_id": full.get("generation_id"),
                        "source": source_name,
                        "knowledge_health": full.get("knowledge_health", {}),
                        "knowledge_growth": full.get("knowledge_growth", {}),
                        "experience_network": full.get("experience_network", {}),
                        "skill_inventory": full.get("skill_inventory", {}),
                        "experience_graph": full.get("experience_graph", {}),
                        "knowledge_inbound": full.get("knowledge_inbound", []),
                        "scene_cards": full.get("scene_cards", {}),
                        "signal_poller": full.get("signal_poller", {}),
                        "journey_executions": full.get("journey_executions", {}),
                        "journeys": full.get("journeys", {}),
                        "connectors": full.get("connectors", {}),
                        "remote_hygiene": full.get("remote_hygiene", {}),
                        "bos_verifier": full.get("bos_verifier", {}),
                        "service_keeper": full.get("service_keeper", {}),
                        "decision_proposals": full.get("decision_proposals", {}),
                        "recent_features": full.get("recent_features", {}),
                        "memory_dual_track": full.get("memory_dual_track", {}),
                    }
                    self._json(200, embed)
                    return
                if revision is None and cache_path.exists():
                    cached = _json.loads(cache_path.read_text())
                    self._json(200, {**cached, "source": "panorama_cache.json", "stale_warning": "current_json_missing"})
                    return
                self._json(503, {"error": "cache_not_ready"})
            except Exception as _e:
                self._json(500, {"error": "panorama_error", "detail": str(_e)})
        elif route.path == "/api/snapshot":
            # Lightweight endpoint for incremental refresh - returns only essential data
            try:
                revision = self._request_revision()
                if revision is not None:
                    full = self._snapshot_json()
                else:
                    candidates = [
                        Path(self.server.snapshot_path),
                        STATE_ROOT / "dist/current.json",
                    ]
                    snap_path = next((p for p in candidates if p.exists()), None)
                    full = json.loads(snap_path.read_text()) if snap_path else None
                if isinstance(full, dict):
                    # Return lightweight version for polling
                    lightweight = {
                        "observed_at": full.get("observed_at"),
                        "generation_id": full.get("generation_id"),
                        "source_states": full.get("source_states", {}),
                        "refresh": full.get("refresh", {}),
                        "agents_count": len(full.get("agents", [])),
                        "gates_count": len(full.get("gates", [])),
                        "events_count": len(full.get("recent_events", {}).get("events", [])),
                        "metrics_kpi": full.get("metrics_kpi", {}),
                        "health_score": full.get("metrics_kpi", {}).get("health_score"),
                        "events_per_hour": full.get("metrics_kpi", {}).get("events_per_hour_24h"),
                        "failed_sources": full.get("refresh", {}).get("failed_sources", []),
                    }
                    self._json(200, lightweight)
                else:
                    self._json(503, {"error": "snapshot_not_ready"})
            except Exception as e:
                self._json(500, {"error": str(e)})
        elif route.path.startswith('/api/v1/'):
            # Stub API endpoints for UI extensions - return valid empty responses
            self._json(200, {"_stub": True, "endpoint": route.path, "status": "ok", "data": []})
        elif route.path in READ_ONLY_STATIC_JS_ROUTES and not route.query:
            # Serve only statically registered UI JavaScript assets.
            js_name = route.path[1:]
            asset_root = Path(__file__).resolve().parent
            js_file = asset_root / js_name
            try:
                if not hasattr(os, "O_NOFOLLOW"):
                    self._json(503, {"error": "js_unavailable"})
                    return
                flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                flags |= os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0)
                fd = os.open(js_file, flags)
                with os.fdopen(fd, "rb") as js_stream:
                    before = os.fstat(js_stream.fileno())
                    if not stat.S_ISREG(before.st_mode):
                        raise OSError(errno.EINVAL, "static asset is not a regular file")
                    if before.st_size > MAX_STATIC_JS_BYTES:
                        self._json(413, {"error": "js_too_large"})
                        return
                    body = js_stream.read(MAX_STATIC_JS_BYTES + 1)
                    after = os.fstat(js_stream.fileno())
                stable_identity = (
                    before.st_dev, before.st_ino, before.st_size,
                    before.st_mtime_ns, before.st_ctime_ns,
                ) == (
                    after.st_dev, after.st_ino, after.st_size,
                    after.st_mtime_ns, after.st_ctime_ns,
                )
                if len(body) > MAX_STATIC_JS_BYTES or not stable_identity:
                    self._json(503, {"error": "js_unavailable"})
                else:
                    self._send(200, body, "application/javascript; charset=utf-8")
            except OSError:
                self._json(404, {"error": "js_not_found"})
            return
        else:
            self._json(404, {"error": "not_found"})

    def do_POST(self):
        if not self._allowed():
            return
        route = urlsplit(self.path)
        if route.path.startswith('/api/v1/'):
            self._json(405, {"error": "operation_disabled", "read_only": True})
            return
        if self.server.projection_store is not None:
            self._json(405, {"error": "read_only_get_only"})
            return
        self._reject_method()

    def _reject_method(self):
        if self._allowed():
            self._json(405, {"error": "read_only_get_only"})

    do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_HEAD = do_TRACE = _reject_method


def make_server(port=DEFAULT_PORT, page_path=None, sources=None,
                snapshot_path=None, document_root=DOCUMENT_ROOT,
                projection_state_root=None, dashboard_code_oid=None,
                dashboard_tree_sha256=None, dashboard_code_sha256=None):
    server = DashboardServer(("127.0.0.1", port), DashboardHandler)
    projection_mode = projection_state_root is not None or (
        page_path is None and snapshot_path is None
    )
    server.projection_store = (
        ProjectionRevisionStore(projection_state_root or STATE_ROOT)
        if projection_mode
        else None
    )
    auto_code_identity = projection_mode and all(
        value is None
        for value in (
            dashboard_code_oid,
            dashboard_tree_sha256,
            dashboard_code_sha256,
        )
    )
    server.dashboard_identity_resolver = (
        resolve_dashboard_code_identity if auto_code_identity else None
    )
    server.dashboard_identity_cache = (
        DashboardCodeIdentityCache() if auto_code_identity else None
    )
    if auto_code_identity:
        code_identity = resolve_dashboard_code_identity()
        dashboard_code_oid = code_identity["code_oid"]
        dashboard_tree_sha256 = code_identity["tree_sha256"]
        dashboard_code_sha256 = code_identity["code_bundle_sha256"]
    server.page_path = Path(page_path or PAGE_PATH)
    server.sources = dict(DEFAULT_SOURCES if sources is None else sources)
    server.snapshot_path = Path(snapshot_path or SNAPSHOT_PATH)
    server.dashboard_code_oid = (
        dashboard_code_oid
        if dashboard_code_oid is not None
        else ""
    )
    server.dashboard_code_sha256 = (
        dashboard_code_sha256
        if dashboard_code_sha256 is not None
        else ""
    )
    server.dashboard_tree_sha256 = (
        dashboard_tree_sha256
        if dashboard_tree_sha256 is not None
        else ""
    )
    server.document_root = Path(document_root)
    return server


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("--port must be between 1 and 65535")
    server = make_server(port=args.port)
    print(json.dumps({"service": "zhixing-dashboard-live", "read_only": True,
                      "url": "http://127.0.0.1:" + str(server.server_port)}), flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
