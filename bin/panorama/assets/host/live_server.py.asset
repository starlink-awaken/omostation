# ── 算力端点: 缓存 / 限流 / 模型白名单 ──────────────────────
_compute_cache: dict = {"live": None, "live_until": 0.0, "models_whitelist": None,
                        "whitelist_until": 0.0, "gateway_key": None, "gateway_key_until": 0.0}
_compute_lock = threading.Lock()
_infer_calls: dict = {}  # client_ip -> [timestamp, ...]
_INFER_RPM = 6
_INFER_TTL = 60.0
_WHITELIST_TTL = 60.0
_GATEWAY_KEY_TTL = 300.0
_COMPUTE_LIVE_TTL = 10.0


def _aictl_compute(t: float = 10.0) -> dict | None:
    """跑 aictl compute 并解析 JSON; 失败返回 None。"""
    try:
        r = subprocess.run(["aictl", "compute"], capture_output=True, text=True, timeout=t)
        if r.returncode != 0:
            return None
        return json.loads(r.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
        return None


def _omlxc_json(cmd: list[str], t: float = 5.0):
    """跑 omlxc 子命令并解析 JSON; 失败返回 None（不抛）。"""
    try:
        r = subprocess.run(["omlxc", *cmd, "--json"], capture_output=True, text=True, timeout=t)
        if r.returncode != 0:
            return None
        return json.loads(r.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
        return None


def _get_gateway_key():
    """取 AetherForge Bearer key（与 aetherforge-gw-guard 同路径：Keychain）。"""
    now = time.monotonic()
    with _compute_lock:
        k = _compute_cache["gateway_key"]
        if k and now < _compute_cache["gateway_key_until"]:
            return k
    try:
        r = subprocess.run(["security", "find-generic-password", "-s", "aetherforge-gateway", "-w"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        key = r.stdout.strip()
    except (subprocess.TimeoutExpired, OSError):
        return None
    with _compute_lock:
        _compute_cache["gateway_key"] = key
        _compute_cache["gateway_key_until"] = now + _GATEWAY_KEY_TTL
    return key


def _get_models_whitelist():
    """从 omlxc models list 取 loaded 模型 id 白名单; 失败返回 None。"""
    now = time.monotonic()
    with _compute_lock:
        w = _compute_cache["models_whitelist"]
        if w is not None and now < _compute_cache["whitelist_until"]:
            return w
    data = _omlxc_json(["models", "list"], t=8.0)
    if not data or "data" not in data:
        return None
    items = data["data"].get("items") or []
    ids = [it["id"] for it in items if it.get("loaded") and it.get("id")]
    with _compute_lock:
        _compute_cache["models_whitelist"] = ids
        _compute_cache["whitelist_until"] = now + _WHITELIST_TTL
    return ids


def _acquire_infer_slot(client_ip: str):
    """令牌桶: 每 IP 每 _INFER_TTL 秒 _INFER_RPM 次; 成功返回 True。"""
    now = time.monotonic()
    with _compute_lock:
        ts = _infer_calls.get(client_ip, [])
        ts = [x for x in ts if now - x < _INFER_TTL]
        _infer_calls[client_ip] = ts
        if len(ts) >= _INFER_RPM:
            return False
        ts.append(now)
        return True


def _call_aetherforge(model: str, system_prompt: str, user_prompt: str, max_tokens: int):
    """调用 AetherForge OpenAI 兼容代理; 返回 (ok, output_or_error, usage_dict)。"""
    key = _get_gateway_key()
    if not key:
        return False, "gateway_key_unavailable", None
    body = json.dumps({"model": model,
                       "messages": [{"role": "system", "content": system_prompt},
                                   {"role": "user", "content": user_prompt}],
                       "max_tokens": max_tokens, "stream": False}).encode("utf-8")
    u = urlsplit(AETHERFORGE_PROXY)
    try:
        conn = HTTPConnection(u.hostname, u.port, timeout=120)
        conn.request("POST", "/v1/chat/completions", body=body,
                     headers={"Content-Type": "application/json",
                              "Authorization": f"Bearer {key}"})
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8", "replace")
        if resp.status != 200:
            return False, f"upstream_{resp.status}", None
        data = json.loads(raw)
        choice = (data.get("choices") or [{}])[0]
        msg = choice.get("message") or {}
        output = msg.get("content")
        if output is None:
            return False, "upstream_no_content", None
        return True, output.strip(), data.get("usage")
    except (HTTPException, OSError, json.JSONDecodeError) as exc:
        return False, f"upstream_error:{type(exc).__name__}", None
