                    },
                    "objective_coverage": objective,
                    "unfinished_objectives": snapshot.get("unfinished_objectives", []),
                    "strategic_gaps": {
                        "state": (snapshot.get("strategic") or {}).get("state"),
                        "items": ((snapshot.get("strategic") or {}).get("trace") or {}).get("gaps", []),
                    },
                    "pending_publications": pending,
                    "reconciliation_candidates": snapshot.get("reconciliation_candidates", {}),
                    "value_proof_readiness": {
