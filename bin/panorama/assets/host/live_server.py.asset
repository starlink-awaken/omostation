        elif route.path == '/api/v1/agent/authorization-desk':
            try:
                snapshot = json.loads(SNAPSHOT_PATH.read_text(encoding="utf-8"))
                pending = snapshot.get("pending_publications") if isinstance(snapshot.get("pending_publications"), dict) else {}
                claims = snapshot.get("claims_activation_request") if isinstance(snapshot.get("claims_activation_request"), dict) else {}
                publication_items = actionable_publication_items(pending)
                publication_decisions = []
                for item in publication_items:
                    if not isinstance(item, dict):
                        continue
                    verification = item.get("verification_results") if isinstance(item.get("verification_results"), dict) else {}
                    publication_decisions.append({
                        "id": item.get("id"),
                        "kind": item.get("kind"),
                        "state": item.get("state"),
                        "verification": item.get("verification"),
                        "binding": {
                            "branch": item.get("branch"),
                            "base_commit": item.get("base_commit"),
                            "commit": item.get("commit"),
                            "patch_sha256": item.get("patch_digest"),
                            "dirty_count": item.get("dirty_count"),
                        },
                        "required_contexts": item.get("required_contexts") or [],
                        "authorization_scope": item.get("authorization_scope"),
                        "forbidden": item.get("forbidden") or [],
                        "verification_results": verification,
                        "authorization_request_template": (
                            f"Approve one-time degraded direct publish of exact commit "
                            f"{item.get('commit')} from base {item.get('base_commit')} with patch digest "
                            f"{item.get('patch_digest')}; allow only one annotated tag, one non-force push, "
                            f"one unique PR, and squash merge after required contexts pass."
                        ),
                    })
                lifecycle_draft_path = SNAPSHOT_PATH.parent / "claims-observation" / "lifecycle-authorization-request-draft.json"
                lifecycle_review_path = SNAPSHOT_PATH.parent / "claims-observation" / "lifecycle-authorization-review.md"
                lifecycle_runbook_path = SNAPSHOT_PATH.parent / "claims-observation" / "lifecycle-execution-runbook.md"
                lifecycle_gap_path = SNAPSHOT_PATH.parent / "claims-observation" / "authority-lifecycle-gap-audit.json"

                def _sha256_file(path):
                    digest = hashlib.sha256()
                    with path.open("rb") as handle:
                        for chunk in iter(lambda: handle.read(65536), b""):
                            digest.update(chunk)
                    return "sha256:" + digest.hexdigest()

                lifecycle_artifacts = {}
                for name, path in (
                    ("draft", lifecycle_draft_path),
                    ("review", lifecycle_review_path),
                    ("runbook", lifecycle_runbook_path),
                    ("gap_audit", lifecycle_gap_path),
                ):
                    try:
                        lifecycle_artifacts[name] = {
                            "available": path.is_file(),
                            "path": str(path),
                            "sha256": _sha256_file(path) if path.is_file() else None,
                        }
                    except OSError:
                        lifecycle_artifacts[name] = {
                            "available": False,
                            "path": str(path),
                            "sha256": None,
                        }

                lifecycle_decision = {
                    "id": "claims-authority-lifecycle-evidence",
                    "kind": "lifecycle_evidence_execution",
                    "state": (
                        "READY_FOR_OPERATION_SPECIFIC_HUMAN_APPROVAL"
                        if lifecycle_artifacts["draft"]["available"]
                        else "REQUEST_UNAVAILABLE"
                    ),
                    "execution": "NOT_EXECUTED",
                    "activation": "SHADOW_ACTIVE",
                    "authority_id": claims.get("authority_id") or "omo-claims-authority-r0",
                    "binding": {
                        "activation_receipt_digest": "sha256:96654eb9e03591b2b5da2cb89119997c9ec2c193755ae7c277b3a0ce7be1e5d3",
                        "descriptor_digest": claims.get("descriptor_digest"),
                        "authority_epoch": 1,
                        "activation_state": "shadow-active",
                    },
                    "artifacts": lifecycle_artifacts,
                    "required_fields": [
                        "principal_decision_id",
                        "decision_timestamp_utc",
                        "decision_expires_at_utc",
                        "human_verbatim_quote",
                    ],
                    "forbidden": [
                        "force push",
                        "--no-verify",
                        "automatic retry after unknown outcome",
                        "historical receipt mutation",
                        "instruction capability enablement",
                        "v2 promotion above shadow",
                    ],
                    "not_sufficient": [
                        "general agent authorization",
                        "observation samples alone",
                        "dashboard status",
                        "AI statement",
                    ],
                }
                claims_live_state = str((snapshot.get("claims_authority") or {}).get("activation_state") or "").lower()
                if not claims_live_state:
                    objective_items = (
                        snapshot.get("objective_coverage", {}).get("items")
                        if isinstance(snapshot.get("objective_coverage"), dict) else []
                    )
                    claims_objective = next(
                        (item for item in objective_items if item.get("id") == "CLAIMS_AUTHORITY_ACTIVATION"),
                        {},
                    )
                    if claims_objective.get("runtime_state") == "shadow-active" and claims_objective.get("observation_state") == "IN_PROGRESS":
                        claims_live_state = "shadow-active"
                claims_activated = (
                    claims.get("status") == "EXECUTED"
                    and claims.get("activation") == "SHADOW_ACTIVE"
                    and claims_live_state == "shadow-active"
                )
                claims_decision = {
                    "id": "omo-claims-authority-r0",
                    "kind": "activate_shadow",
                    "state": (
                        "SHADOW_OBSERVATION_IN_PROGRESS"
                        if claims_activated
                        else "READY_FOR_OPERATION_SPECIFIC_HUMAN_REVIEW"
                    ),
                    "execution": claims.get("execution", "NOT_EXECUTED"),
                    "activation": claims.get("activation", "NOT_AUTHORIZED"),
                    "binding": {
                        "request_id": claims.get("request_id"),
                        "request_digest": claims.get("request_digest"),
                        "descriptor_digest": claims.get("descriptor_digest"),
                        "authority_id": claims.get("authority_id"),
                        "operation": claims.get("operation"),
                        "expected_authority_epoch": claims.get("expected_authority_epoch"),
                        "expected_state": claims.get("expected_state"),
                    },
                    "observation_after_activation": claims.get("observation_after_activation") or {
                        "duration_seconds": 86400,
                        "maximum_gap_seconds": 120,
                        "minimum_samples": 1440,
                    },
                    "not_sufficient": claims.get("human_authorization_not_sufficient") or [],
                    "forbidden": [
                        "advance beyond shadow before the complete observation gate passes",
                        "enable instruction capability before graduation",
                        "skip or shorten the observation window",
                        "fabricate observation samples or completion evidence",
                    ] if claims_activated else [
                        "execute activation before fresh operation-specific Human authorization",
                        "skip or shorten the observation window",
                        "fabricate observation samples or completion evidence",
                    ],
                }
                payload = {
                    "schema_version": "agent-authorization-desk/v2",
                    "terminal_publications_count": pending_publication_projection(pending)["terminal_items_count"],
                    "authorization_mode": "single-user-loopback",
                    "read_only": True,
                    "instruction_capable": False,
                    "generated_at": snapshot.get("generated_at")
                        or snapshot.get("observed_at")
                        or utc_now(),
                    "generation_id": snapshot.get("generation_id"),
                    "decisions": publication_decisions + [claims_decision, lifecycle_decision],
                }
                self._json(200, payload)
            except (OSError, ValueError, TypeError) as exc:
                self._json(503, {
                    "error": "AUTHORIZATION_DESK_UNAVAILABLE",
                    "detail": type(exc).__name__,
                    "read_only": True,
                })
            return
        elif route.path == '/api/v1/agent/pending-authorizations':
            try:
                snapshot = json.loads(SNAPSHOT_PATH.read_text(encoding="utf-8"))
