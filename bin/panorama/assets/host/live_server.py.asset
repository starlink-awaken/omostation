def _resolve_workspace() -> Path:
    """定位 Workspace 根 (含 .omo/_truth). 兼容 launchd / 直接运行 / 模块导入."""
    base = Path(__file__).resolve().parent
    for p in [base, *base.parents]:
        if (p / ".omo" / "_truth").is_dir():
            return p
    env = os.environ.get("ZHIXING_WORKSPACE")
    if env and (Path(env) / ".omo").is_dir():
        return Path(env)
    return Path.home() / "Workspace"


