IDENTIFIER = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}\Z")
SENSITIVE = re.compile(r"(?:gh[pousr]_|sk[-_]|bearer|password|secret|api[-_]?key)", re.IGNORECASE)


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def safe_identifier(value):
    if isinstance(value, int) and not isinstance(value, bool):
        value = str(value)
    if not isinstance(value, str) or not IDENTIFIER.fullmatch(value) or SENSITIVE.search(value):
        return None
    return value


TERMINAL_PUBLICATION_STATES = frozenset({
    "MERGED", "CLOSED", "WITHDRAWN", "REJECTED", "SUPERSEDED",
})
ACTIONABLE_PUBLICATION_VERIFICATION = "READY_FOR_OPERATION_SPECIFIC_HUMAN_AUTHORIZATION"


def pending_publication_projection(pending):
    """Project only actionable exact-commit publications without hiding history."""
    source = pending if isinstance(pending, dict) else {}
    items = source.get("items") if isinstance(source.get("items"), list) else []
    actionable = []
    terminal_count = 0
    invalid_count = 0
    for item in items:
        if not isinstance(item, dict):
            invalid_count += 1
            continue
        state = str(item.get("state") or "").upper()
        verification = str(item.get("verification") or "").upper()
        if state in TERMINAL_PUBLICATION_STATES:
            terminal_count += 1
        elif (
            state not in ("", "UNKNOWN")
            and verification == ACTIONABLE_PUBLICATION_VERIFICATION
        ):
            actionable.append(item)
        else:
            invalid_count += 1
    projected = {
        "schema": "pending-publication-projection/v2",
        "available": bool(source),
        "items": actionable,
        "terminal_items_count": terminal_count,
        "invalid_items_count": invalid_count,
        "source_schema": source.get("schema"),
        "source_manifest_sha256": source.get("manifest_sha256"),
        "source_path": source.get("manifest_path"),
        "checked_at": source.get("checked_at"),
    }
    return {key: value for key, value in projected.items() if value is not None}


def actionable_publication_items(pending):
    return pending_publication_projection(pending)["items"]


