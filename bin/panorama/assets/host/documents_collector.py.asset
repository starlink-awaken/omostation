"""Documents collector — reads document registry."""

from __future__ import annotations

import json
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

from collectors.base import DataCollector, CollectionError
from collectors.registry import register

APP = Path(__file__).resolve().parent.parent


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


@register("documents", timeout=30)
class DocumentsCollector(DataCollector):

    name = "documents"

    def collect(self) -> dict:
        from refresh import LIBRARY
        from strategy_sources import collect_registered_documents
        observation = collect_registered_documents(LIBRARY)
        documents = []
        for row in observation["documents"]:
            record = dict(row)
            record["document_id"] = row["id"]
            record["hash_scope"] = "full_file" if row.get("observed_sha256") else "registry_metadata_only"
            documents.append(record)
        return dict(observation, documents=documents, total=len(documents))

    def validate(self, data: dict) -> bool:
        return isinstance(data.get("documents"), list)
