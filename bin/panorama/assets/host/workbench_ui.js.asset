  `;
  document.head.appendChild(style);
  const readingStyle = document.createElement('style');
  readingStyle.textContent = '#workbench-results{max-height:420px;overflow:auto;overscroll-behavior:contain}.workbench-grid{align-items:start}@media(max-width:720px){.workbench-grid>article:nth-child(2){order:-1}#workbench-results{max-height:180px}}';
  document.head.appendChild(readingStyle);
  let section = byId('workbench');
  if (!section) {
    section = document.createElement('section');
    section.id = 'workbench';
    section.className = 'section workbench-section';
    byId('main').insertBefore(section, byId('orient') || null);
  }
  section.innerHTML = '<div class="workbench-head"><h1>项目工作台</h1><button class="btn" id="workbench-reading-hold" aria-pressed="false">固定阅读</button></div><p class="workbench-mode">观察、查证与审议准备 · 有效控制由 OMO 准入后执行</p><div id="workbench-update-notice" class="note" hidden></div><div id="workbench-status" class="workbench-status-line">正在读取同代观察…</div><div class="workbench-grid"><article class="card"><h2>当前需要关注</h2><div id="workbench-attention" class="workbench-attention"></div><p id="workbench-attention-scope" class="workbench-message muted"></p></article><article class="card"><h2>查找一个对象</h2><label class="sr-only" for="workbench-search">全局元数据搜索</label><div class="workbench-search-tools"><input id="workbench-search" type="search" placeholder="自然语言意图、BET、Agent、文档、能力或来源 ID"><label for="workbench-search-mode">检索引擎<select id="workbench-search-mode"><option value="">默认精确索引</option><option value="hybrid">⚡ 本地主权 Hybrid RAG</option><option value="lexical">📝 关键词索引 (BM25)</option><option value="semantic">🧠 向量语义召回 (BGE-M3)</option></select></label><label for="workbench-kind">对象类型<select id="workbench-kind"><option value="">全部类型</option></select></label></div><p id="workbench-search-count" class="workbench-message muted"></p><div id="workbench-results"></div><div class="workbench-pager"><button class="btn" id="workbench-search-prev" disabled>上一页</button><button class="btn" id="workbench-search-next" disabled>下一页</button></div></article></div><div class="workbench-tabs" role="tablist" aria-label="工作台视角"><button class="btn" data-workbench-tab="interlock" role="tab" aria-selected="false">🌐 3D 联锁矩阵</button><button class="btn" data-workbench-tab="agents" role="tab" aria-selected="false">🤖 智能体中枢</button><button class="btn" data-workbench-tab="bets" role="tab" aria-selected="false">📊 BET 全要素契约</button><button class="btn" data-workbench-tab="workflows" role="tab" aria-selected="false">⚡ 动态工作流调度</button><button class="btn" data-workbench-tab="scenes" role="tab" aria-selected="false">🃏 业务场景卡沙盘</button><button class="btn" data-workbench-tab="journeys" role="tab" aria-selected="false">🧭 用户旅程与价值闭环</button><button class="btn" data-workbench-tab="assets" role="tab" aria-selected="false">📦 业务域与主权资产</button><button class="btn" data-workbench-tab="bos" role="tab" aria-selected="false">🌐 BOS 服务总线</button><button class="btn" data-workbench-tab="tokenomics" role="tab" aria-selected="false">⚡ 算力经济大盘</button><button class="btn" data-workbench-tab="swarm" role="tab" aria-selected="false">🐝 蜂群态势网</button><button class="btn" data-workbench-tab="object" role="tab" aria-selected="true">🔍 对象与 C0-C3 上下文</button><button class="btn" data-workbench-tab="coverage" role="tab" aria-selected="false">资料覆盖</button><button class="btn" data-workbench-tab="controls" role="tab" aria-selected="false">约束与控制准备</button><button class="btn" data-workbench-tab="changes" role="tab" aria-selected="false">观察变化</button></div><article id="workbench-tab-interlock" class="card" hidden></article><article id="workbench-tab-agents" class="card" hidden></article><article id="workbench-tab-bets" class="card" hidden></article><article id="workbench-tab-workflows" class="card" hidden></article><article id="workbench-tab-scenes" class="card" hidden></article><article id="workbench-tab-journeys" class="card" hidden></article><article id="workbench-tab-assets" class="card" hidden></article><article id="workbench-tab-bos" class="card" hidden></article><article id="workbench-tab-tokenomics" class="card" hidden></article><article id="workbench-tab-swarm" class="card" hidden></article><div id="workbench-tab-object"><article id="workbench-entity" class="card workbench-entity"><h2>选择对象，沿来源继续</h2><p>用 ID 保留同一对象上下文。尚未关联、未验证与过期会单独显示。</p></article></div><article id="workbench-tab-coverage" class="card" hidden><h2>资料覆盖，不等于已知全宇宙</h2><div id="workbench-coverage" class="workbench-coverage"></div></article><article id="workbench-tab-controls" class="card" hidden><h2>控制动作的入口与条件</h2><p class="workbench-boundary-summary">本机没有写操作接口。下方列出正式 owner 与前置条件，可准备审议，但不会派工、审批、修改预算、记忆或规则。</p><div id="workbench-controls" class="workbench-controls"></div></article><article id="workbench-tab-changes" class="card" hidden><h2>最近两次有效观察的变化</h2><p class="small">采样变化不是完整事件流；未再观察到不代表业务删除。</p><div class="workbench-search-tools"><label for="workbench-from-generation">旧代号<input id="workbench-from-generation" type="text" placeholder="from_generation"></label><button class="btn" id="workbench-changes-read">比较观察</button></div><pre id="workbench-changes-output" class="workbench-code"></pre></article><div class="workbench-tabs"><button class="btn" id="workbench-check-update">检查新快照</button><a class="btn" href="/api/v1/manifest">Agent 读取接口</a><a class="btn" href="#panorama">展开宏观图</a></div><div id="workbench-lineage-tracer" class="lineage-drawer" hidden></div><p id="workbench-state-message" class="workbench-message muted"></p>';

  let personal = byId('personal');
  if (!personal) {
    personal = document.createElement('section');
