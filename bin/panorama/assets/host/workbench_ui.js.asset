    .workbench-section{min-width:0}.workbench-head{display:flex;gap:12px;align-items:center;justify-content:space-between;margin:12px 0}.workbench-head h1{font-size:27px;margin:0}.workbench-mode{font-size:13px;color:var(--muted);margin:7px 0 12px}.workbench-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(290px,.85fr);gap:16px}.workbench-attention{display:grid;gap:9px}.workbench-attention article{padding:12px 14px;background:#f6f9fc;border-left:3px solid var(--amber);border-radius:0 8px 8px 0;min-width:0}.workbench-attention h3{font-size:15px;margin:0 0 5px}.workbench-attention p{font-size:13px;margin:5px 0;overflow-wrap:anywhere}.workbench-search-tools{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.workbench-search-tools input{width:100%;min-width:150px}.workbench-search-tools label{flex:1;min-width:120px;font-size:13px}.workbench-search-tools select{width:100%}.workbench-tabs{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0}.workbench-tabs button[aria-selected=true]{border-color:var(--blue);background:var(--bluewash)}.workbench-result{display:block;width:100%;text-align:left;padding:12px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--ink);margin:8px 0;overflow-wrap:anywhere}.workbench-result strong{display:block;font-size:15px}.workbench-result small{font-size:12px;color:var(--muted)}.workbench-result:hover{border-color:var(--blue)}.workbench-entity{margin-top:15px;min-width:0;overflow-wrap:anywhere}.workbench-entity h2{font-family:var(--display);font-size:23px}.workbench-axis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:12px 0}.workbench-axis>div{border:1px solid var(--line);padding:11px;background:#f6f9fc;border-radius:8px;overflow-wrap:anywhere;font-size:13px}.workbench-axis strong{display:block;font-size:15px;margin-top:5px}.workbench-pairs{display:grid;grid-template-columns:115px minmax(0,1fr);gap:8px 12px;font-size:14px}.workbench-pairs dt{color:var(--muted)}.workbench-pairs dd{mar