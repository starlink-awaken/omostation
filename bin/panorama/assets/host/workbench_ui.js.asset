  personal.innerHTML = '<header id="personal-now" class="personal-hero"><div class="personal-eyebrow">知行个人工作页 / 项目与证据概览</div><h1>项目交付与证据持续完善</h1><p><b>当前为持续交付的 MVP。</b> 本页汇总工程进度和来源证据；工程完成不代表本人采纳或愿景达成，真实使用与收益仍待独立证据。</p><div id="personal-now-status" class="personal-status"></div><div class="personal-route"><div><b>👑 主权意志</b><span id="personal-route-principal">工程进度 · NO_DATA</span></div><div><b>⚡ 主权算力</b><span id="personal-route-compute">compute · NO_DATA</span></div><div><b>🛡️ 治理熔断</b><span id="personal-route-gov">gates · NO_DATA</span></div><div><b>💎 个人价值观察</b><span id="personal-route-value">收益未报告</span></div></div></header><div class="personal-grid"><article id="personal-principal" class="card personal-card"><div class="row"><h2>👑 Principal 主权裁决中心</h2><span class="chip good">夏明星 (Principal)</span></div><p class="personal-rule">操作权限与人工确认以独立收据为准；本页只作观察。</p><div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px"><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px"><span class="small muted" style="display:block">工程BET完成比例</span><strong id="personal-bet-rate" style="font-size:16px;color:#15803d">—</strong><span id="personal-bet-detail" class="small" style="color:var(--muted);display:block">portfolio NO_DATA · 不代表本人采纳或愿景达成</span></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px"><span class="small muted" style="display:block">不可逆越权统计</span><strong style="font-size:16px;color:#15803d">未核实</strong><span class="small" style="color:var(--muted);display:block">暂无独立的范围与时间窗口统计</span></div></div><div style="margin-top:9px;font-size:12px;color:var(--muted);border-top:1px dashed #d5e2ec;padding-top:7px">确认依据：独立授权与操作收据；页面不生成署名或采纳结论</div></article><article id="personal-compute" class="card personal-card"><div class="row"><h2>⚡ AetherForge 本地主权算力</h2><span class="chip good" id="personal-compute-chip">compute · live</span></div><p class="personal-rule">算力状态来自观察数据；模型目录与健康信号不证明实际推理可用。</p><div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px"><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px"><span class="small muted" style="display:block">统一显存池负载</span><strong id="personal-compute-mem" style="font-size:16px;color:#3a64b3">—</strong><span id="personal-compute-mem-sub" class="small" style="color:var(--muted);display:block">compute NO_DATA</span></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px"><span class="small muted" style="display:block">主权大模型池</span><strong id="personal-compute-models" style="font-size:16px;color:#3a64b3">—</strong><span id="personal-compute-models-sub" class="small" style="color:var(--muted);display:block">models NO_DATA</span></div></div><div style="margin-top:9px;font-size:12px;color:var(--muted);border-top:1px dashed #d5e2ec;padding-top:7px">离线与泄露边界：尚无本页可复读的专项核验证据</div></article><article id="personal-guardian" class="card personal-card wide"><div class="row"><div><h2>🛡️ 常驻守护者 (Resident Guardian) 巡检与熔断中枢</h2><p class="personal-rule">展示来源中的门禁与 Agent 快照；不替代实时权限检查和独立验收。</p></div><div style="display:flex;gap:6px;align-items:center"><span class="chip warn">熔断状态未核实</span><span class="chip good" id="personal-chain-chip">门禁来源快照</span></div></div><div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px"><div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:10px"><span class="small muted" style="display:block">门禁判定</span><strong id="personal-gate-pass" style="font-size:16px;color:#15803d">—</strong><span id="personal-gate-pass-sub" class="small" style="color:var(--muted);display:block">live gates</span></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:10px"><span class="small muted" style="display:block">Agent 快照数</span><strong id="personal-agent-count" style="font-size:16px;color:#2e7e79">—</strong><span id="personal-agent-count-sub" class="small" style="color:var(--muted);display:block">live agents</span></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:10px"><span class="small muted" style="display:block">阻塞工程项</span><strong id="personal-blocked" style="font-size:16px;color:#15803d">—</strong><span id="personal-blocked-sub" class="small" style="color:var(--muted);display:block">blocked BET</span></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:10px"><span class="small muted" style="display:block">GaC 门禁基线</span><strong id="personal-gate-total" style="font-size:16px;color:#15803d">—</strong><span id="personal-gate-total-sub" class="small" style="color:var(--muted);display:block">gate checkpoints</span></div></div><div style="margin-top:10px;background:#edf5f8;border-radius:6px;padding:8px 12px;display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><b>巡检防线:</b> 来源状态以各自观测时点为准；详见 #gov</span><span class="mono" style="color:var(--blue)">GaC 结果以独立收据为准</span></div></article><article id="personal-blockers" class="card personal-card wide"><h2>真正阻塞</h2><p class="personal-rule">只有数据安全、不可逆操作、误写主仓、重复执行、无法恢复继续硬停；其他缺口仅在当前阶段后置，仍保留在原规划中，也不视为完成。</p><div id="personal-blocker-list" class="personal-list"><p class="small muted">正在读取当前观察…</p></div><a class="small" href="#gov">查看完整 A1–A9 门禁 →</a></article><article id="personal-next" class="card personal-card"><h2>下一步三件事</h2><div class="personal-next-list" id="personal-next-list"><p class="small muted">正在读取 agent-brief 行动清单…</p></div></article><article id="personal-safety" class="card personal-card wide"><h2>🛡️ 安全边界</h2><div id="personal-safety-list" class="personal-list"></div></article><article id="personal-first-loop" class="card personal-card"><h2>距离第一个可用闭环</h2><p class="personal-rule">不使用虚构百分比，只显示三个可复读检查点。</p><div id="personal-loop-checkpoints" class="personal-checkpoints"></div><a class="small" href="#swarm">查看完整 Agent 与协作面 →</a></article><article id="personal-scenes" class="card personal-card wide"><div class="row"><div><h2>业务场景卡生命周期漏斗 (Scene Card Lifecycle Funnel)</h2><p class="personal-rule">依据 <code>.omo/standards/scene-card-lifecycle.yaml</code> 治理规范：五级晋升通道严禁跳级，影子阶段需 3-sample 伴随验证，辅助阶段需 30-sample 生产证明 + 校准度 ≥ 0.6。</p></div><div style="display:flex;gap:6px;align-items:center"><span class="chip good" id="personal-scene-total-chip">场景 · NO_DATA</span><span class="chip neutral" id="personal-scene-cov-chip">coverage · live</span></div></div><div id="personal-scene-funnel" class="personal-scene-viz"></div></article><article id="personal-week" class="card personal-card"><h2>本周完成</h2><div id="personal-week-list" class="personal-list"></div><p class="personal-rule">只用本页快照生成可下载草稿，来源缺失或陈旧会保留；不代表本人签发或采纳。</p><button class="btn" id="personal-delivery-generate" type="button">生成交付摘要</button><button class="btn" id="personal-delivery-download" type="button" disabled>下载Markdown</button><div id="personal-delivery-result" hidden><label for="personal-delivery-preview">项目交付摘要（本页快照）· 只读预览</label><textarea id="personal-delivery-preview" class="workbench-code" readonly rows="14" style="width:100%;box-sizing:border-box" aria-label="交付摘要只读预览"></textarea></div><p id="personal-delivery-status" class="personal-rule" role="status">尚未生成草稿；下载仅保存到本地。</p><a class="small" href="#ledger">查看完整 BET 与甘特 →</a></article><article id="personal-agents" class="card personal-card"><h2>Agent 当前状态</h2><div id="personal-agent-list" class="personal-list"></div><a class="small" href="#swarm">查看全部 Agent 观察 →</a></article><article id="personal-events" class="card personal-card wide"><div class="row"><div><h2>⚡ 事件记录与工程活动</h2><p class="personal-rule">事件活动不等于本人采纳或净收益；真实使用与收益未报告。</p></div><div style="display:flex;gap:6px;align-items:center"><span id="personal-event-connection" class="chip good">事件来源待观察</span><span class="chip neutral">证据有效性须独立核验</span></div></div><div id="personal-northstar-v3-bar" style="margin-top:10px;padding:8px 12px;background:linear-gradient(90deg,#eff6ff 0%,#f0fdf4 100%);border:1px solid #bfdbfe;border-radius:6px;display:flex;justify-content:space-between;align-items:center;font-size:12px"><span><b>💎 北极星 v3 综合价值度量:</b> <span id="ns-v3-score" style="font-weight:700;color:#15803d">NO_DATA</span> · 轴A(时间): <span id="ns-v3-axis-a">—</span> · 轴B(主权): <span id="ns-v3-axis-b">—</span> · 轴C(吞吐): <span id="ns-v3-axis-c">—</span></span><span class="chip good" style="font-size:10px;padding:2px 6px">70% 时间 + 30% 主权</span></div><div id="personal-event-kpi-bar" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px"><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px;display:flex;flex-direction:column;justify-content:space-between"><div style="display:flex;justify-content:space-between;align-items:center"><span class="small muted">累计净节省时间 (轴A)</span><span class="chip good" style="font-size:9px;padding:1px 4px">70% 权重</span></div><strong id="kpi-net-saved" style="font-size:17px;color:#15803d;display:block;margin:3px 0">-- 分钟</strong><span class="small" style="color:var(--muted);display:block">真实业务时间账本</span><div id="sparkline-net-saved" style="height:26px;margin-top:6px"></div></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px;display:flex;flex-direction:column;justify-content:space-between"><div style="display:flex;justify-content:space-between;align-items:center"><span class="small muted">夏明星主权裁决 (轴B)</span><span class="chip good" style="font-size:9px;padding:1px 4px">30% 权重</span></div><strong id="kpi-adjudications" style="font-size:17px;color:#15803d;display:block;margin:3px 0">-- 次</strong><span class="small" style="color:var(--muted);display:block">终局意志署名采纳</span><div id="sparkline-adjudications" style="height:26px;margin-top:6px"></div></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px;display:flex;flex-direction:column;justify-content:space-between"><div style="display:flex;justify-content:space-between;align-items:center"><span class="small muted">代码交付增量 (轴C)</span><span class="chip neutral" style="font-size:9px;padding:1px 4px">物理吞吐</span></div><strong id="kpi-pr-delivery" style="font-size:17px;color:#3a64b3;display:block;margin:3px 0">-- 个 PR</strong><span id="kpi-code-lines" class="small" style="color:var(--muted);display:block">-- 行交付 (+/-)</span><div id="sparkline-pr-delivery" style="height:26px;margin-top:6px"></div></div><div style="background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:9px;display:flex;flex-direction:column;justify-content:space-between"><div style="display:flex;justify-content:space-between;align-items:center"><span class="small muted">治理防御与规则活力</span><span class="chip warn" style="font-size:9px;padding:1px 4px">状态以来源为准</span></div><strong id="kpi-violations" style="font-size:17px;color:#e11d48;display:block;margin:3px 0">-- 次熔断</strong><span id="kpi-rule-evals" class="small" style="color:var(--muted);display:block">规则评估 · live</span><div id="sparkline-violations" style="height:26px;margin-top:6px"></div></div></div><div class="row" style="margin-top:12px;gap:6px;flex-wrap:wrap;align-items:center"><div style="display:flex;gap:4px;flex-wrap:wrap" id="personal-event-filters"><button type="button" class="btn btn-tiny active" data-event-filter="all">全部价值流</button><button type="button" class="btn btn-tiny" data-event-filter="p1-adj">👑 主权裁决 (P1)</button><button type="button" class="btn btn-tiny" data-event-filter="p1-val">💎 时间账本 (P1)</button><button type="button" class="btn btn-tiny" data-event-filter="p2-pr">🚀 代码交付 (P2)</button><button type="button" class="btn btn-tiny" data-event-filter="p2-wf">⚡ 网格流转 (P2)</button><button type="button" class="btn btn-tiny" data-event-filter="p3-sig">📡 外部信号 (P3)</button><button type="button" class="btn btn-tiny" data-event-filter="p0-gov">🛡️ 治理防御 (P0)</button></div><span id="personal-event-status" class="small muted" style="margin-left:auto">正在读取高价值事件…</span></div><div id="personal-event-list" class="personal-list" style="margin-top:10px;max-height:480px;overflow-y:auto"></div><div style="margin-top:10px;display:flex;justify-content:space-between;align-items:center;font-size:12px;border-top:1px dashed #d5e2ec;padding-top:8px"><span class="small muted">💡 提示：点击 <b>🃏 场景</b> 徽章直达沙盘卡片并高亮；点击 <b>🛡️ 规约</b> / <b>📜 投注</b> 穿透六维全息抽屉</span><a class="small" href="#logs">打开完整实时日志大厅 →</a></div></article></div>';

  // Hydrate immediately after mount; end-of-file call may run before helpers settle.
  try { if (typeof hydratePersonalLiveStats === 'function') hydratePersonalLiveStats(); } catch (e) { console.warn('hydratePersonalLiveStats', e); }
  try { if (typeof renderSceneFunnel === 'function') renderSceneFunnel(); } catch (e) { console.warn('renderSceneFunnel', e); }

  // Nav 构建已统一到 window.ZHIXING_NAV_GROUPS（定义在 ui_extensions.js）。
  // 这里负责把锚点渲染进 nav DOM，区分核心模式与工程全景模式的层级标记。
  const nav = document.querySelector('aside nav');
  if (nav && window.ZHIXING_NAV_GROUPS) {
    const labels = window.ZHIXING_NAV_LABELS || {};
    const GROUPS = window.ZHIXING_NAV_GROUPS;
    const CORE_PANEL_IDS = new Set(['orient', 'personal', 'workbench', 'ledger', 'next', 'arch', 'gov', 'mof-grid', 'ecosystem-map']);
    const existing = new Map([...nav.querySelectorAll('a')].map(a => [a.hash.slice(1), a]));
    const anchors = {};
    GROUPS.forEach(g => {
      [g.id, ...g.secondaryIds].forEach(id => {
        let a = existing.get(id);
        if (!a) { a = document.createElement('a'); a.href = '#' + id; }
        if (labels[id]) a.innerHTML = '<span class="nav-symbol">' + labels[id].split(' ')[0] + '</span>' + labels[id].replace(/^[^\s]+\s/, '');
        a.setAttribute('data-asd-panel', g.asdPanel || '');
        const isCore = CORE_PANEL_IDS.has(id);
        a.className = isCore ? 'nav-item-core' : 'nav-item-engineering';
        a.setAttribute('data-nav-tier', isCore ? 'core' : 'engineering');
        anchors[id] = a;
      });
    });
    nav.replaceChildren();
    var addedSeparator = false;
    GROUPS.forEach(g => {
      if (g.primary === false && !addedSeparator) {
        var sep = document.createElement('div');
        sep.className = 'workbench-nav-sep';
        sep.textContent = '个人工作区';
        nav.appendChild(sep);
        addedSeparator = true;
      }
      const group = document.createElement('div');
      group.className = 'workbench-nav-group';
      group.setAttribute('data-nav-group', g.id);
      const heading = document.createElement('div');
      heading.className = 'workbench-nav-title';
      heading.textContent = g.label;
      group.appendChild(heading);
      [g.id, ...g.secondaryIds].forEach(id => { if (anchors[id]) group.appendChild(anchors[id]); });
      nav.appendChild(group);
    });

    if (typeof window.setNavMode === 'function') {
      window.setNavMode(window.currentNavMode || 'engineering', { skipSave: true });
    }
  }

  function route() {
    const [view, query = ''] = location.hash.slice(1).split('?');
    const params = new URLSearchParams(query);
    return { view: view || 'object', params, entity: params.get('entity'), generation: params.get('generation') || generation };
  }
  function href(identity) { return '#workbench?' + new URLSearchParams({ entity: identity, generation }); }
  function link(identity, title) { return '<a class="workbench-inline-link" data-observer-entity="' + safe(identity) + '" href="' + safe(href(identity)) + '">' + safe(title || identity) + '</a>'; }
  function message(target, content, bad = false) { const node = byId(target); node.textContent = content; node.classList.toggle('bad', bad); }
  async function read(operation, params = {}, pin = true) {
    if (!protocolSupported) throw new Error('FILE_SNAPSHOT: 请使用本机 HTTP 工作台获取查询能力。');
    const query = new URLSearchParams(params);
    if (pin) query.set('generation', route().generation);
    const response = await fetch('/api/v1/' + operation + (query.size ? '?' + query : ''), { cache: 'no-store' });
    const raw = await response.text();
    const payload = JSON.parse(raw);
    Object.defineProperty(payload, '__wireJSON', { value: raw, enumerable: false });
    if (!response.ok) {
      const error = new Error(payload.error || 'QUERY_UNAVAILABLE'); error.code = payload.error; error.status = response.status;
      if (response.status === 409 && payload.error === 'GENERATION_EXPIRED') showUpdate(null, '当前页面与服务已换代，请明确载入新快照后继续。');
      throw error;
    }
    if (pin && payload.generation_id !== route().generation) throw new Error('GENERATION_RESPONSE_MISMATCH');
    return payload;
  }
  // Explicit fields only: never serialize the snapshot, artifact previews or metadata.
  function buildPersonalDeliverySummary(snapshot) {
    const record = value => value && typeof value === 'object' && !Array.isArray(value) ? value : {};
    const text = (value, limit = 300) => {
      if (typeof value !== 'string' || !value.trim()) return 'UNKNOWN';
      return value.slice(0, limit).replace(/[\u0000-\u0020\u007f-\u009f\u2028-\u202e\u2066-\u2069]/g, ' ')
        .replace(/[&<>[\]\x60\\*_#!|]/g, c => '&#' + c.charCodeAt(0) + ';')
        .replace(/\b(https?|javascript|data|file):/gi, '$1&#58;');
    };
    const count = value => Number.isSafeInteger(value) && value >= 0 ? String(value) : 'UNKNOWN';
    const hash = (value, size) => typeof value === 'string' && new RegExp('^[a-f0-9]{' + size + '}$', 'i').test(value) ? value : 'UNKNOWN';
    const clock = value => typeof value === 'string' && Number.isFinite(Date.parse(value)) ? text(value) : 'UNKNOWN';
    const data = record(snapshot), portfolio = record(data.portfolio), tasks = record(data.tasks);
    const states = record(data.source_states);
    const lines = ['# 项目交付摘要（本页快照）', '',
      '草稿 · 非本人签发；真实使用与收益未报告。',
      '边界：任务done不等于BET/KR/HumanOutcome；工程声明数不代表本人采纳率。',
      '仅导出本页有限列表和元数据，不含证据正文；SHA为来源声明，未重新计算或验证原件。', '',
      '快照生成时刻：' + clock(data.generated_at) + '（不替代逐源时钟）', '',
      '## 来源与有效性'];
    function sourceLine(name, source, state) {
      const stamp = source.observed_at ?? state.observed_at;
      const age = (Date.now() - Date.parse(stamp)) / 1000;
      const freshness = clock(stamp) === 'UNKNOWN' || age < -60 ? 'UNKNOWN' : age > 600 ? 'STALE' : 'RECENT';
      lines.push('- ' + name + '：status=' + text(state.status ?? source.status ?? source.state, 80)
        + '；observed_at=' + clock(stamp) + '；age=' + freshness
        + '；OID=' + hash(source.sha ?? source.oid ?? state.sha ?? state.oid, 40)
        + '；来源=' + text(source.source ?? state.source, 512)
        + '；当前有效性未证明（需独立验收）');
    }
    sourceLine('portfolio', portfolio, record(states.portfolio));
    sourceLine('tasks', tasks, record(states.tasks));
    sourceLine('next_actions', {}, record(states.agent_brief));
    lines.push('- Ledger SHA256=' + hash(portfolio.ledger_sha256, 64), '',
      '## 工程进度声明', '工程BET声明总数=' + count(portfolio.actual));
    const counts = record(portfolio.counts);
    lines.push(['done', 'in_progress', 'pending', 'blocked'].map(key => key + '=' + count(counts[key])).join('；'),
      '', '## 最近已完成任务（本页最多10项）');
    const recent = Array.isArray(tasks.recent_done) ? tasks.recent_done : null;
    const done = (recent || []).filter(item => record(item).status === 'done').slice(0, 10);
    if (!done.length) lines.push(recent ? '本页列表为空或无合格done记录，不等于全域零交付。' : 'UNKNOWN：任务列表缺失或畸形。');
    done.forEach(item => {
      lines.push('- ' + text(item.id) + ' · ' + text(item.title) + '；status=done；completed_at=' + clock(item.completed_at));
      const artifacts = Array.isArray(item.artifacts) ? item.artifacts : null;
      if (!artifacts || !artifacts.length) lines.push('  - 原件元数据 UNKNOWN（缺失或本页未列出）。');
      (artifacts || []).slice(0, 3).forEach(value => {
        const artifact = record(value);
        lines.push('  - 路径=' + text(artifact.path, 512) + '；status=' + text(artifact.status, 80)
          + '；SHA256=' + hash(artifact.sha256, 64) + '；bytes=' + count(artifact.bytes)
          + '；truncated=' + (typeof artifact.truncated === 'boolean' ? String(artifact.truncated) : 'UNKNOWN'));
      });
    });
    lines.push('', '## 未完成BET声明（本页最多20项）');
    const bets = Array.isArray(portfolio.bet_records) ? portfolio.bet_records
      : Array.isArray(portfolio.nonterminal) ? portfolio.nonterminal : null;
    const open = (bets || []).filter(item => ['pending', 'in_progress', 'blocked'].includes(record(item).status)).slice(0, 20);
    if (!open.length) lines.push(bets ? '本页未列出未完成BET，不推定全部已完成。' : 'UNKNOWN：BET列表缺失或畸形。');
    open.forEach(item => lines.push('- ' + text(item.id) + ' · ' + text(item.title)
      + '；status=' + text(item.status, 80) + '；owner=' + text(item.owner, 100) + '（仅声明，非活跃执行证明）'));
    lines.push('', '## 声明的下一动作（最多3项，非派工）');
    const actions = Array.isArray(data.next_actions) ? data.next_actions : null;
    if (!actions || !actions.length) lines.push('UNKNOWN：本页无可读下一动作声明。');
    (actions || []).slice(0, 3).forEach(value => {
      const item = record(value);
      lines.push('- ' + text(item.id) + ' · ' + text(item.title) + '；state=' + text(item.state, 80)
        + '；' + text(item.detail, 500) + '；source=' + text(item.source)
        + '；执行条件=' + text(item.execution_authority, 300));
    });
    lines.push('', '停止边界：仅本地审阅草稿；执行、验收、状态变更及本人收益须另有真实证据。', '');
    const stamp = clock(data.generated_at) === 'UNKNOWN' ? 'unknown'
      : new Date(data.generated_at).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
    return {markdown: lines.join('\n'), filename: 'project-delivery-summary-' + stamp + '.md'};
  }

  function initPersonalDeliveryExport() {
    const generate = byId('personal-delivery-generate'), download = byId('personal-delivery-download');
    const preview = byId('personal-delivery-preview'), result = byId('personal-delivery-result');
    const status = byId('personal-delivery-status');
    if (!generate || !download || !preview || !result || !status || generate._deliveryBound) return;
    generate._deliveryBound = true;
    preview.readOnly = true;
    download.disabled = true;
    let draft = null;
    generate.addEventListener('click', () => {
      draft = buildPersonalDeliverySummary(pickDashData());
      preview.value = draft.markdown;
      result.hidden = false;
      download.disabled = false;
      status.textContent = '已生成本页快照草稿；请审阅来源、缺失与陈旧标记后下载。';
    });
    download.addEventListener('click', () => {
      if (!draft) return;
      let url, anchor;
      try {
        const blob = new Blob([preview.value], {type: 'text/markdown;charset=utf-8'});
        url = URL.createObjectURL(blob);
        anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = draft.filename;
        document.body.appendChild(anchor);
        anchor.click();
        status.textContent = '已请求浏览器保存Markdown；文件是否落盘请查看浏览器下载。';
      } catch (_) {
        status.textContent = '本地下载不可用；预览已保留，可手动保存。';
      } finally {
        if (anchor) anchor.remove();
        if (url) setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
    });
  }

  function personalWeekStart() {
    const value = new Date(D.generated_at || Date.now());
    if (!Number.isFinite(value.getTime())) return null;
    const offset = (value.getDay() + 6) % 7;
    value.setHours(0, 0, 0, 0); value.setDate(value.getDate() - offset);
    return value;
  }
  function hardStopClass(item) {
    const fixed = {'gate:A2': '无法恢复', 'gate:A4': '不可逆操作 / 重复执行', 'gate:A5': '无法恢复'};
    if (fixed[item.id]) return fixed[item.id];
    const value = [item.title, item.description, item.next_action].join(' ');
    if (/隐私|敏感|凭据|credential|secret|data safety/i.test(value)) return '数据安全';
    if (/不可逆|删除|外发|支付|主机变更|irreversible/i.test(value)) return '不可逆操作';
    if (/共享主仓|误写|worktree|shared main/i.test(value)) return '误写主仓';
    if (/重复|幂等|duplicate|idempotent|blind retry/i.test(value)) return '重复执行';
    if (/无法恢复|恢复边界|rollback|settlement|recovery/i.test(value)) return '无法恢复';
    return null;
  }

  function hydratePersonalLiveStats() {
    const live = pickDashData();
    const pf = live.portfolio || {};
    const done = (pf.counts && pf.counts.done != null) ? pf.counts.done : null;
    const actual = (pf.actual != null) ? pf.actual : null;
    const blocked = (pf.counts && pf.counts.blocked != null) ? pf.counts.blocked : ((pf.nonterminal||[]).filter(b => String(b.status||'').toLowerCase()==='blocked').length);
    const validProgress = Number.isFinite(actual) && actual > 0 && Number.isFinite(done) && done >= 0 && done <= actual;
    const rate = validProgress ? (Math.round(done / actual * 1000) / 10) : null;
    const cmp = live.compute || {};
    const gates = live.gates || [];
    const gatePass = gates.filter(g => {
      const v = String(g.verdict || g.status || '').toUpperCase();
      return (v.includes('PASS') || v === 'OK' || v.includes('HEALTHY') || v.includes('VERIFIED')) && !v.includes('PARTIAL');
    }).length;
    const agents = live.live_agents || live.agents || [];
    const set = (id, val) => { const el = byId(id); if (el) el.textContent = val; };
    set('personal-bet-rate', rate != null ? (rate + '%') : 'NO_DATA');
    set('personal-bet-detail', validProgress ? (done + ' / ' + actual + ' 工程BET完成 · 不代表本人采纳或愿景达成') : 'portfolio NO_DATA');
    set('personal-route-principal', validProgress ? ('工程BET完成 ' + done + '/' + actual) : '工程进度 · NO_DATA');
    set('personal-compute-mem', (cmp.current_model_memory_gb != null && cmp.final_ceiling_gb != null) ? (cmp.current_model_memory_gb + ' / ' + cmp.final_ceiling_gb + ' GB') : 'NO_DATA');
    set('personal-compute-mem-sub', cmp.status ? ('status=' + cmp.status) : 'compute NO_DATA');
    set('personal-compute-models', cmp.model_count != null ? (cmp.model_count + ' 模型') : 'NO_DATA');
    set('personal-compute-models-sub', cmp.loaded_count != null ? ('loaded ' + cmp.loaded_count) : 'models NO_DATA');
    set('personal-compute-chip', 'compute · ' + (cmp.status || 'NO_DATA'));
    set('personal-route-compute', cmp.status ? ('AF · ' + cmp.status) : 'compute · NO_DATA');
    set('personal-gate-pass', gates.length ? (gatePass + '/' + gates.length) : 'NO_DATA');
    set('personal-gate-pass-sub', 'live PASS');
    set('personal-gate-total', gates.length ? String(gates.length) : 'NO_DATA');
    set('personal-gate-total-sub', 'gate checkpoints');
    set('personal-route-gov', gates.length ? ('PASS ' + gatePass + '/' + gates.length) : 'gates · NO_DATA');
    set('personal-agent-count', String(agents.length));
    set('personal-agent-count-sub', 'live agents');
    set('personal-blocked', String(blocked != null ? blocked : '—'));
    set('personal-blocked-sub', 'blocked BET');
    set('personal-route-value', '收益未报告 · 事件数不代表本人采纳');
  }

  function renderPersonalNextActions() {
    const list = byId('personal-next-list');
    if (!list) return;
    const actions = Array.isArray(D.next_actions) ? D.next_actions.slice(0, 3) : [];
    if (!actions.length) { list.innerHTML = '<p class="small muted">暂无法定行动（agent-brief 未就绪）</p>'; return; }
    list.innerHTML = actions.map((a, i) => '<a href="#next" class="personal-item" style="text-decoration:none;color:var(--ink)"><div class="personal-item-head"><b>' + (i+1) + '. ' + safe(a.title || a.id || '未命名行动') + '</b>' + chip(a.state || 'REQUIRED', /BLOCKED|UNAVAILABLE/i.test(a.state||'') ? 'warn' : 'neutral') + '</div><p>' + safe(a.detail || a.gate || '') + '</p></a>').join('');
  }

  function renderPersonalBase() {
    initPersonalDeliveryExport();
    const freshness = (() => { const age = (Date.now() - Date.parse(D.generated_at)) / 1000; return !Number.isFinite(age) ? 'UNKNOWN' : age > 600 ? 'STALE' : 'FRESH'; })();
    byId('personal-now-status').innerHTML = chip('MVP 持续交付', 'neutral') + chip('只读观察', 'neutral') + chip(freshness, freshness === 'FRESH' ? 'good' : 'warn') + '<span class="small muted">快照 ' + safe(dt(D.generated_at)) + '</span>';
    const start = personalWeekStart(), end = new Date(D.generated_at || Date.now());
    const completed = list(D.portfolio?.bet_records).filter(item => {
      const stamp = item.status === 'done' && item.done_at ? new Date(item.done_at) : null;
      return stamp && Number.isFinite(stamp.getTime()) && start && stamp >= start && stamp <= end;
    }).sort((a, b) => String(b.done_at).localeCompare(String(a.done_at))).slice(0, 5);
    byId('personal-week-list').innerHTML = completed.length ? completed.map(item => '<div class="personal-item"><b>' + safe(item.title || item.id) + '</b><p class="mono">' + safe(item.id) + ' · ' + safe(item.done_at) + '</p></div>').join('') : '<p class="small muted">本周没有可按有效 done_at 复读的完成项；缺日期的 done 不计入。</p>';
    const agents = list(D.live_agents), active = agents.filter(item => /active|working|running|blocked|stale|error|suspect/i.test(item.status || ''));
    byId('personal-agent-list').innerHTML = active.length ? active.slice(0, 6).map(item => '<div class="personal-item"><div class="personal-item-head"><b>' + safe(item.name || item.id) + '</b>' + chip(item.status || 'unknown', /block|stale|error/i.test(item.status || '') ? 'warn' : 'neutral') + '</div><p>' + safe(item.source || '未声明来源') + ' · ' + safe(item.role || '未关联角色') + '</p></div>').join('') : '<p class="small muted">当前快照没有 active/working/blocked/stale Agent；已折叠 ' + safe(agents.filter(item => /idle/i.test(item.status || '')).length) + ' 个 idle inventory。当前 Codex 会话与 OMO assignment identity 尚未统一关联。</p>';
    const gateA1 = list(D.runtime?.gates).find(item => item.id === 'A1');
    const dashboardVisible = D.local_server?.status === 'READY' && D.local_server?.read_only === true;
    const referenceCell = D.reference_cell?.latest;
    const referenceCellFresh = D.source_states?.reference_cell?.status === 'OK';
    const referenceCellQualified = referenceCell?.qualification_state === 'R0_CANARY_VERIFIED' && referenceCell?.ledger_bound === false && referenceCell?.value_indicator_policy === false;
    const referenceCellCanary = referenceCellFresh && referenceCellQualified && referenceCell?.freshness?.state === 'FRESH';
    const referenceCellHistorical = referenceCellFresh && referenceCellQualified && referenceCell?.freshness?.state === 'STALE';
    renderPersonalNextActions();
    const safetyList = byId('personal-safety-list');
    if (safetyList) {
      const bounds = Array.isArray(D.safety_boundaries) ? D.safety_boundaries : [];
      safetyList.innerHTML = bounds.length ? bounds.map(b => '<div class="personal-item"><b>⚠️ ' + safe(b) + '</b></div>').join('') : '<p class="small muted">无特殊安全限制</p>';
    }
    const checkpoints = [
      {title: '基础安全可执行', state: 'partial', note: gateA1?.verdict || '待专项复验'},
      {title: 'Direct Local 真实三角色任务', state: referenceCellCanary ? 'canary' : referenceCellHistorical ? 'historical' : 'not-run', note: referenceCellCanary ? 'R0 canary 已验证 · 正式 Ledger 交付未完成' : referenceCellHistorical ? '历史 R0 canary 已验证 · 当前可用性待复跑 · 正式 Ledger 交付未完成' : '尚无当前可判定的 digest-bound Reference Cell canary'},
      {title: 'Dashboard 同源可见', state: dashboardVisible ? 'visible' : 'unknown', note: dashboardVisible ? '本机只读入口 READY' : '当前入口未证明'}
    ];
    byId('personal-loop-checkpoints').innerHTML = checkpoints.map(item => '<div class="personal-checkpoint" data-state="' + safe(item.state) + '"><i></i><div><b>' + safe(item.title) + '</b><br><small>' + safe(item.note) + '</small></div>' + chip(item.state === 'canary' ? 'R0 CANARY' : item.state === 'historical' ? 'HISTORICAL' : item.state.toUpperCase(), ['visible', 'canary'].includes(item.state) ? 'good' : 'warn') + '</div>').join('');
    hydratePersonalLiveStats();
    renderSceneFunnel();
  }
  function renderSceneFunnel() {
    const el = byId('personal-scene-funnel');
    if (!el) return;
    const live = pickDashData();
    const sc = (live.strategic && live.strategic.scene_cards) || live.scene_cards || {};
    const byLf = sc.by_lifecycle || {};
    const total = (sc.total != null) ? sc.total : Object.values(byLf).reduce((a,b)=>a+Number(b||0),0);
    const meta = [
      { id: 'draft', name: 'Draft', zh: '草案阶段', color: '#60778c', bg: '#f1f5f9', border: '#cbd5e1', exit: '初始规范与约束定义，静态规则校验通过' },
      { id: 'shadow', name: 'Shadow', zh: '影子伴随', color: '#ac721a', bg: '#fffbeb', border: '#fde68a', exit: '零业务副作用，需 3-sample 伴随无偏证据' },
      { id: 'assisted', name: 'Assisted', zh: '辅助协同', color: '#3a64b3', bg: '#eff6ff', border: '#bfdbfe', exit: '人机协同草稿，需 30-sample + 校准度 ≥ 0.6' },
      { id: 'supervised', name: 'Supervised', zh: '监督自治', color: '#2e7e79', bg: '#f0fdf4', border: '#bbf7d0', exit: '受管自治执行，高危人类裁决，100-sample 连续无误' },
      { id: 'routine', name: 'Routine', zh: '例行守护', color: '#15803d', bg: '#ecfdf5', border: '#a7f3d0', exit: '完全成熟自动化，常驻日常守护与长程监控' }
    ];
    if (!total) {
      el.innerHTML = '<div class="empty">scene_cards NO_DATA（不伪造 67）</div>';
      if (byId('personal-scene-total-chip')) byId('personal-scene-total-chip').textContent = '场景 · NO_DATA';
      return;
    }
    const stages = meta.map(s => {
      const count = Number(byLf[s.id] || 0);
      const pct = Math.round(count / total * 1000) / 10;
      return Object.assign({}, s, { count, pct });
    });
    const cardsHtml = stages.map((s, idx) => '<div class="scene-stage-card" style="background:' + s.bg + ';border-color:' + s.border + '"><span class="scene-stage-num" style="background:' + s.color + ';color:#fff">L' + (idx + 1) + '</span><div class="scene-stage-name" style="color:' + s.color + '">' + s.name + '</div><div class="scene-stage-zh">' + s.zh + '</div><div class="scene-stage-count" style="color:' + s.color + '">' + s.count + ' <small style="font-size:11px;color:var(--muted)">(' + s.pct + '%)</small></div><div class="scene-stage-exit">' + s.exit + '</div></div>').join('');
    const segmentsHtml = stages.map(s => '<div class="scene-dist-segment" style="width:' + ((s.count / total) * 100) + '%;background:' + s.color + '" title="' + s.name + ' (' + s.zh + '): ' + s.count + ' 个 (' + s.pct + '%)"></div>').join('');
    const trail = stages.map(s => s.name + ' ' + s.count).join(' ➔ ');
    el.innerHTML = '<div class="scene-funnel-pipeline">' + cardsHtml + '</div><div style="margin-top:10px"><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:3px"><span>生命周期全量分布 (' + total + ' 场景卡 · live)</span><span>' + trail + '</span></div><div class="scene-dist-bar">' + segmentsHtml + '</div></div>';
    if (byId('personal-scene-total-chip')) byId('personal-scene-total-chip').textContent = total + ' 场景卡';
    if (byId('personal-scene-cov-chip')) byId('personal-scene-cov-chip').textContent = 'by_lifecycle live';
  }
  function renderPersonalSummary(result) {
    const attention = list(result?.data?.attention).slice(0, 5);
    byId('personal-blocker-list').innerHTML = attention.length ? attention.map(item => {
      const stop = hardStopClass(item);
      return '<div class="personal-item"><div class="personal-item-head"><b>' + safe(item.title || item.id) + '</b>' + chip(stop ? '条件硬停 · ' + stop : '阶段后置', stop ? 'warn' : 'neutral') + '</div><p>' + safe(item.description || item.type) + '</p><p class="small muted">只在当前任务触达该面且 admission 拒绝时阻断；阶段后置不改变长期规划。下一步：' + safe(item.next_action || '核对权威来源') + '</p></div>';
    }).join('') : '<p class="small muted">本次观察没有列出关注项；这不证明硬阻塞为零，执行前仍需按五类检查 admission。</p>';
  }
  let personalEventsCache = [];
  let personalEventsFilter = 'all';

  function filterPersonalEvents(items, filter) {
    if (filter === 'all') return items;
    if (filter === 'p1-adj') return items.filter(e => e.tier === 'P1' && (e.burden_minutes !== undefined || e.source === 'adjudications' || (e.event && e.event.includes('Adjudic'))));
    if (filter === 'p1-val') return items.filter(e => e.tier === 'P1' && (e.net_saved_seconds !== undefined || e.source === 'value_evidence' || (e.event && e.event.includes('Value'))));
    if (filter === 'p2-pr') return items.filter(e => e.tier === 'P2' && (e.pr_number !== undefined || e.source === 'pr_harvest' || (e.event && e.event.includes('PR'))));
    if (filter === 'p2-wf') return items.filter(e => e.tier === 'P2' && (e.source === 'workflow_mesh' || e.source === 'workflows_workspace'));
    if (filter === 'p3-sig') return items.filter(e => e.source === 'signal_poller' || (e.event && e.event.includes('Signal')));
    if (filter === 'p0-gov') return items.filter(e => e.tier === 'P0' || e.source === 'swarm_conflicts');
    return items;
  }

  function renderSparklineSvg(dataPoints, color = '#15803d', fillColor = 'rgba(21, 128, 61, 0.12)', height = 26) {
    if (!Array.isArray(dataPoints) || dataPoints.length < 2) return '';
    const width = 140;
    const minVal = Math.min(...dataPoints);
    const maxVal = Math.max(...dataPoints);
    const range = (maxVal - minVal) === 0 ? 1 : (maxVal - minVal);
    const pad = 2;
    const h = height - pad * 2;

    const coords = dataPoints.map((val, idx) => {
      const x = Math.round((idx / (dataPoints.length - 1)) * width);
      const y = Math.round(pad + (1 - (val - minVal) / range) * h);
      return [x, y];
    });

    const polyline = coords.map(p => `${p[0]},${p[1]}`).join(' ');
    const polygon = `0,${height} ` + polyline + ` ${width},${height}`;

    return `
      <svg viewBox="0 0 ${width} ${height}" style="width:100%;height:${height}px;overflow:visible;display:block" preserveAspectRatio="none">
        <polygon points="${polygon}" fill="${fillColor}" />
        <polyline points="${polyline}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="${coords[coords.length - 1][0]}" cy="${coords[coords.length - 1][1]}" r="3" fill="${color}" />
      </svg>
    `;
  }

  function renderPersonalEventsList() {
    const container = byId('personal-event-list');
    if (!container) return;
    const filtered = filterPersonalEvents(personalEventsCache, personalEventsFilter);
    if (!filtered.length) {
      container.innerHTML = '<p class="small muted" style="padding:16px;text-align:center">当前筛选类别无已读取的事件证据；保留物理真值，不据此推断系统无活动。</p>';
      return;
    }
    container.innerHTML = filtered.map(item => {
      const tierChip = item.tier === 'P0' ? '<span class="chip warn" style="font-size:10px;background:#fee2e2;color:#991b1b;border-color:#f87171">P0 阻断</span>' :
                       item.tier === 'P1' ? '<span class="chip good" style="font-size:10px;background:#f3e8ff;color:#6b21a8;border-color:#d8b4fe">P1 价值/主权</span>' :
                       item.tier === 'P2' ? '<span class="chip neutral" style="font-size:10px;background:#dbeafe;color:#1e40af;border-color:#93c5fd">P2 交付/网格</span>' :
                       '<span class="chip neutral" style="font-size:10px">P3 信号/例行</span>';
      const sceneBtn = item.scene_id ? `<button type="button" class="chip good" style="cursor:pointer;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;font-size:10px" onclick="if(window.ZhixingSelectScene)window.ZhixingSelectScene('${safe(item.scene_id)}');">🃏 场景: ${safe(item.scene_id)}</button>` : '';
      const ruleBtn = item.rule_id ? `<button type="button" class="chip warn" style="cursor:pointer;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;font-size:10px" onclick="if(window.openUniversalHologramDrawer)window.openUniversalHologramDrawer('${safe(item.rule_id)}');">🛡️ 规约: ${safe(item.rule_id)}</button>` : '';
      const betBtn = item.bet_id ? `<button type="button" class="chip neutral" style="cursor:pointer;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;font-size:10px" onclick="if(window.openUniversalHologramDrawer)window.openUniversalHologramDrawer('${safe(item.bet_id)}');">📜 投注: ${safe(item.bet_id)}</button>` : '';
      const runBtn = item.run ? `<span class="chip mono" style="font-size:10px">⚡ ${safe(item.run)}</span>` : '';
      const agentChip = item.agent ? `<span class="chip neutral" style="font-size:10px">🤖 ${safe(item.agent)}</span>` : '';
      const sovereignBadge = (item.source === 'adjudications' || item.actor === '夏明星') ? '<span class="chip good" style="font-size:10px;background:#fef3c7;color:#92400e;border:1px solid #fde68a">👑 夏明星终验</span>' : '';
      const netSaved = item.net_saved_seconds ? `<span class="chip good" style="font-size:10px;background:#dcfce7;color:#166534">⏱️ 净节省 +${safe(item.net_saved_seconds)}s</span>` : '';
      const burden = item.burden_minutes ? `<span class="chip warn" style="font-size:10px;background:#fef3c7;color:#92400e">⏳ 耗时 ${safe(item.burden_minutes)}m</span>` : '';
      const prCode = (item.additions || item.deletions) ? `<span class="chip good" style="font-size:10px;background:#e0f2fe;color:#0369a1">+${safe(item.additions || 0)} / -${safe(item.deletions || 0)}</span>` : '';

      return `
        <div class="personal-event" style="display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-bottom:1px solid #edf2f7">
          <div style="min-width:70px;text-align:right">
            <time style="font-size:11px;color:var(--muted);display:block">${safe(dt(item.timestamp))}</time>
            <div style="margin-top:2px">${tierChip}</div>
          </div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600;color:var(--ink);line-height:1.4">${safe(item.summary || item.event || '未声明事件')}</div>
            <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center;margin-top:4px">
              <span class="small muted" style="font-size:11px">${safe(item.source)}</span>
              ${sovereignBadge}
              ${sceneBtn}
              ${ruleBtn}
              ${betBtn}
              ${runBtn}
              ${agentChip}
              ${netSaved}
              ${burden}
              ${prCode}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function initPersonalEventFilters() {
    const filterContainer = byId('personal-event-filters');
    if (!filterContainer || filterContainer._initialized) return;
    filterContainer._initialized = true;
    filterContainer.addEventListener('click', e => {
      const btn = e.target.closest('button[data-event-filter]');
      if (!btn) return;
      filterContainer.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      personalEventsFilter = btn.getAttribute('data-event-filter') || 'all';
      renderPersonalEventsList();
    });
  }

  let valueMetricsCache = null;
  window.ZhixingRefreshPersonalEvents = function() {
    loadPersonalEvents();
  };

  async function readPersonalProjection(url) {
    const delays = [300, 900];
    for (let attempt = 0; attempt <= delays.length; attempt += 1) {
      const response = await fetch(url, {method: 'GET', cache: 'no-store', credentials: 'omit'});
      if (response.status !== 503 || attempt === delays.length) return response;
      let body;
      try {
        body = await response.clone().json();
      } catch {
        return response;
      }
      if (body?.error !== 'projection_validation_busy' || body?.read_only !== true) return response;
      await new Promise(resolve => setTimeout(resolve, delays[attempt]));
    }
  }

  async function loadPersonalEvents() {
    const setKpi = (id, value = 'NO_DATA') => { const el = byId(id); if (el) el.textContent = value; };
    ['kpi-net-saved', 'kpi-adjudications', 'kpi-pr-delivery', 'kpi-code-lines', 'kpi-violations',
      'ns-v3-score', 'ns-v3-axis-a', 'ns-v3-axis-b', 'ns-v3-axis-c', 'kpi-rule-evals'].forEach(id => setKpi(id));
    ['sparkline-net-saved', 'sparkline-adjudications', 'sparkline-pr-delivery', 'sparkline-violations'].forEach(id => {
      const el = byId(id); if (el) el.innerHTML = '';
    });
    personalEventsCache = [];
    valueMetricsCache = null;
    if (!protocolSupported) {
      byId('personal-event-status').textContent = '文件快照模式不读取实时事件；请使用本机 HTTP 入口。';
      byId('personal-event-list').innerHTML = '';
      return;
    }
    try {
      initPersonalEventFilters();
      const [logsRes, metricsRes] = await Promise.allSettled([
        readPersonalProjection('/api/logs?limit=40&source=all'),
        readPersonalProjection('/api/v1/value/metrics')
      ]);

      if (logsRes.status !== 'fulfilled' || !logsRes.value.ok) throw new Error('事件来源不可用');
      if (logsRes.status === 'fulfilled' && logsRes.value.ok) {
        const result = await logsRes.value.json();
        personalEventsCache = list(result.events);
        const summary = result.value_summary || {};
        const observedCount = value => Number.isFinite(value) && value >= 0;
        if (observedCount(summary.total_net_saved_seconds)) {
          setKpi('kpi-net-saved', summary.total_net_saved_formatted || (summary.total_net_saved_seconds / 60).toFixed(1) + ' 分钟');
        }
        const rate = summary.adjudications_acceptance_rate;
        const rateText = Number.isFinite(rate) && rate >= 0 && rate <= 100 ? rate + '%'
          : (typeof rate === 'string' && /^(?:100(?:\.0+)?|[0-9]{1,2}(?:\.[0-9]+)?)%$/.test(rate) ? rate : 'NO_DATA');
        if (observedCount(summary.adjudications_count)) setKpi('kpi-adjudications', summary.adjudications_count + ' 次 (' + rateText + ')');
        if (observedCount(summary.total_pr_delivered)) setKpi('kpi-pr-delivery', summary.total_pr_delivered + ' 个 PR');
        if (observedCount(summary.total_code_lines_delivered)) setKpi('kpi-code-lines', summary.total_code_lines_delivered + ' 行代码吞吐');
        if (observedCount(summary.governance_violations_intercepted)) setKpi('kpi-violations', summary.governance_violations_intercepted + ' 次熔断拦截');
      }

      if (metricsRes.status === 'fulfilled' && metricsRes.value.ok) {
        valueMetricsCache = await metricsRes.value.json();
        const ns = valueMetricsCache.north_star_v3 || {};
        if (byId('ns-v3-score')) byId('ns-v3-score').textContent = `${ns.composite_score != null ? ns.composite_score : '—'} / 100 (${ns.composite_verdict || 'NO_DATA'})`;
        if (byId('ns-v3-axis-a')) byId('ns-v3-axis-a').textContent = `${ns.axis_a_score != null ? ns.axis_a_score : '—'}%`;
        if (byId('ns-v3-axis-b')) byId('ns-v3-axis-b').textContent = `${ns.axis_b_score != null ? ns.axis_b_score : '—'}%`;
        if (byId('ns-v3-axis-c')) byId('ns-v3-axis-c').textContent = `${ns.axis_c_score != null ? ns.axis_c_score : '—'}%`;

        // 渲染 4 大 KPI Sparklines
        const trends = valueMetricsCache.trends_7d || {};
        if (byId('sparkline-net-saved')) byId('sparkline-net-saved').innerHTML = renderSparklineSvg(trends.net_saved_minutes, '#15803d', 'rgba(21,128,61,0.12)');
        if (byId('sparkline-adjudications')) byId('sparkline-adjudications').innerHTML = renderSparklineSvg(trends.adjudications, '#15803d', 'rgba(21,128,61,0.12)');
        if (byId('sparkline-pr-delivery')) byId('sparkline-pr-delivery').innerHTML = renderSparklineSvg(trends.pr_delivered, '#3a64b3', 'rgba(58,100,179,0.12)');
        if (byId('sparkline-violations')) byId('sparkline-violations').innerHTML = renderSparklineSvg(trends.violations_intercepted, '#e11d48', 'rgba(225,29,72,0.12)');

        if (byId('kpi-rule-evals') && valueMetricsCache.gac_vitality) {
          byId('kpi-rule-evals').textContent = `${valueMetricsCache.gac_vitality.total_evaluations != null ? valueMetricsCache.gac_vitality.total_evaluations : '—'} 条生产规则评估`;
        }

        // 同步注入 #value 页面指标
        const valMetrics = document.querySelectorAll('#value .metric');
        if (valMetrics.length >= 3) {
          valMetrics[0].innerHTML = `真实价值样本<b>${valueMetricsCache.evidence_summary?.total_value_events != null ? valueMetricsCache.evidence_summary.total_value_events : 'NO_DATA'}</b><span class="small muted">有证据才计数</span>`;
          valMetrics[1].innerHTML = `连续观察窗口<b>${(window.D && window.D.live_agents && window.D.live_agents.length) ? (window.D.live_agents.length + ' agents') : 'NO_DATA'}</b><span class="small muted">live agents 观测</span>`;
          valMetrics[2].innerHTML = `最终愿景验收<b>${ns.composite_score != null ? (ns.composite_score + '%') : 'NO_DATA'}</b><span class="small muted">北极星 v3 · 缺测不冒充达标</span>`;
        }
      }

      byId('personal-event-status').textContent = '已读取 ' + personalEventsCache.length + ' 条来源事件 · 活动记录不等于本人采纳或收益'
        + (metricsRes.status === 'fulfilled' && metricsRes.value.ok ? '' : '；价值指标来源不可用');
      renderPersonalEventsList();
    } catch (error) {
      byId('personal-event-status').textContent = '事件读取不可用：' + error.message + '。保留未知，不显示为正常。';
      byId('personal-event-list').innerHTML = '';
    }
  }
  function showUpdate(next, reason) {
    newGeneration = next;
    const node = byId('workbench-update-notice'); node.hidden = false; node.replaceChildren();
    const text = document.createElement('span'); text.textContent = reason || '新快照 ' + next + ' 已可用；当前阅读版本保持不变。'; node.appendChild(text);
    const button = document.createElement('button'); button.className = 'btn'; button.textContent = '保留工作现场并载入新版本';
    button.onclick = () => reloadCurrent(next); node.appendChild(document.createTextNode(' ')); node.appendChild(button);
  }
  let selectedRunId = null;
  let selectedWfTemplateId = null;
  let wfViewMode = 'runs'; // 'runs' | 'templates'
  function renderWorkflowsTab() {
    const container = byId('workbench-tab-workflows');
    if (!container) return;
    const S = D.strategic || {};
    const traceRuns = list(S.trace?.nodes).filter(n => n.kind === 'run');
    const recordRuns = list(S.records?.runs);
    const runMap = new Map();
    for (const r of recordRuns) { if (r && r.id) runMap.set(r.id, r); }
    for (const r of traceRuns) { if (r && r.id && !runMap.has(r.id)) runMap.set(r.id, r); }
    const allRuns = Array.from(runMap.values());
    if (!selectedRunId && allRuns.length > 0) selectedRunId = allRuns[0].id;

    // 25 个标准工作流规范模板
    const wfTemplates = list(S.trace?.nodes).filter(n => n.kind === 'workflow');
    if (!selectedWfTemplateId && wfTemplates.length > 0) selectedWfTemplateId = wfTemplates[0].id;

    const currentRun = allRuns.find(r => r.id === selectedRunId) || allRuns[0];
    const facts = currentRun?.facts || {};
    const currentTemplate = wfTemplates.find(t => t.id === selectedWfTemplateId) || wfTemplates[0];
    const tfacts = currentTemplate?.facts || {};

    // 动态真值状态机推导
    const step1Done = Boolean(facts.locks?.length || facts.actor);
    const step1Text = facts.locks?.length ? `✓ ${facts.locks.length} 锁已持有` : (facts.actor ? '✓ 准入授权' : '⚪ 待准入');

    const step2Done = Boolean(facts.spec_ref || facts.spec_digest);
    const step2Text = step2Done ? (facts.spec_version ? `✓ v${facts.spec_version} 固化` : '✓ Spec 已散列') : '⚪ 待绑定 Spec';

    const step3Done = Boolean(facts.packet_id || facts.work_packet_hash);
    const step3Text = step3Done ? (facts.packet_id ? `✓ ${facts.packet_id}` : '✓ 已派工') : '⚪ 待派发 WP';

    let step4Class = 'pending';
    let step4Text = '⚪ 待裁决';
    let step4Sub = '门禁待验';
    const rStatus = String(currentRun?.status || '').toLowerCase();
    if (rStatus === 'blocked') {
      step4Class = 'blocked';
      step4Text = '🛑 阻塞 (BLOCKED)';
      step4Sub = '门禁未放行或依赖缺失';
    } else if (rStatus === 'ok' || rStatus === 'completed' || rStatus === 'verified') {
      step4Class = 'done';
      step4Text = '✓ 验收通行';
      step4Sub = '主权裁决无异议';
    } else if (rStatus === 'failed') {
      step4Class = 'blocked';
      step4Text = '❌ 判定失败';
      step4Sub = '门禁触发硬停';
    } else if (rStatus === 'active' || rStatus === 'running') {
      step4Class = 'active';
      step4Text = '⚡ 判定执行中';
      step4Sub = '运行态观察中';
    }

    let step5Class = 'pending';
    let step5Text = '⏳ 待上游放行';
    let step5Sub = '等待验收闭环';
    if (step4Class === 'done') {
      if (list(facts.evidence_refs).length > 0) {
        step5Class = 'done';
        step5Text = `✓ 证据已上链 (${list(facts.evidence_refs).length})`;
        step5Sub = 'Merkle 账本固化';
      } else {
        step5Class = 'active';
        step5Text = '⏳ 待复盘结算';
        step5Sub = '等待 closeout / retro';
      }
    } else if (step4Class === 'blocked') {
      step5Class = 'blocked';
      step5Text = '⛔ 证据上链暂停';
      step5Sub = '解除阻塞后方可记账';
    }

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">⚡ 动态工作流调度中枢 (Dynamic Workflow Scheduler)</h2>
          <p class="small muted" style="margin:4px 0 0">
            纳管 <code>.omo/_delivery/agent-workflows/runs/</code> 真实痕迹 (${allRuns.length}) 与 <code>.omo/_truth/registry/</code> 规范模板 (${wfTemplates.length})
          </p>
        </div>
        <div style="display:flex;gap:6px;align-items:center">
          <div style="background:#e2e8f0;border-radius:6px;padding:2px;display:flex;gap:2px">
            <button class="btn small ${wfViewMode === 'runs' ? 'active' : ''}" id="btn-wf-mode-runs" style="min-height:30px;padding:3px 10px;font-size:12px">执行痕迹 Runs (${allRuns.length})</button>
            <button class="btn small ${wfViewMode === 'templates' ? 'active' : ''}" id="btn-wf-mode-templates" style="min-height:30px;padding:3px 10px;font-size:12px">规范模板 Templates (${wfTemplates.length})</button>
          </div>
        </div>
      </div>

      ${wfViewMode === 'runs' ? `
        <div class="wf-container">
          <div class="wf-sidebar">
            <div class="small muted" style="margin-bottom:6px;font-weight:600;display:flex;justify-content:space-between">
              <span>运行实例 (${allRuns.length})</span>
              <span class="small" style="color:var(--blue)">真实观测</span>
            </div>
            <div class="wf-run-list" id="wf-run-list">
              ${allRuns.map(r => {
                const rf = r.facts || {};
                const isSel = r.id === selectedRunId;
                const dateStr = rf.created_at ? safe(dt(rf.created_at)) : (r.observed_at ? safe(dt(r.observed_at)) : '未知时间');
                const st = String(r.status || 'unknown').toLowerCase();
                const stClass = st === 'ok' ? 'good' : (st === 'blocked' ? 'warn' : 'neutral');
                return `
                  <div class="wf-run-item ${isSel ? 'active' : ''}" data-run-id="${safe(r.id)}">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
                      <strong style="font-size:13px;color:${isSel ? 'var(--blue)' : 'var(--ink)'}">${safe(rf.workflow_id || r.title || r.id)}</strong>
                      <span class="chip ${stClass}" style="font-size:10px;padding:1px 5px">${safe(r.status || 'unknown')}</span>
                    </div>
                    <div class="small muted" style="font-size:11px">${safe(rf.actor || 'agent-session')} · ${safe(rf.packet_bet_id || 'BET-UNBOUND')}</div>
                    <div class="mono small muted" style="font-size:10px;margin-top:2px">${dateStr}</div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
          <div class="wf-main-content">
            ${currentRun ? `
              <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:14px">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
                  <div>
                    <div style="display:flex;gap:6px;align-items:center;margin-bottom:4px">
                      <h3 style="margin:0;font-size:16px;color:var(--ink)">
                        ${safe(facts.workflow_id || currentRun.title || currentRun.id)}
                      </h3>
                      <span class="chip ${rStatus === 'ok' ? 'good' : (rStatus === 'blocked' ? 'warn' : 'neutral')}" style="font-size:11px">
                        ● ${safe(currentRun.status || 'unknown').toUpperCase()}
                      </span>
                    </div>
                    <div class="mono small muted" style="word-break:break-all">${safe(currentRun.id)}</div>
                  </div>
                </div>

                ${facts.objective ? `
                  <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:9px 12px;margin-bottom:12px;font-size:12px">
                    <strong style="color:#1d4ed8;display:block;margin-bottom:2px">🎯 运行工程目标 (Objective):</strong>
                    <div style="color:var(--ink);line-height:1.4">${safe(facts.objective)}</div>
                  </div>
                ` : ''}

                <!-- 真实动态判定 5 步状态机流水线 -->
                <div style="margin:12px 0">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                    <span class="small" style="font-weight:600;color:var(--ink)">ADR-0203 标准工作流 5 步状态机流水线 (Lifecycle DAG):</span>
                    <span class="small muted" style="font-size:11px">基于实时运行事实动态判定</span>
                  </div>
                  <div class="wf-dag-steps">
                    <div class="wf-step ${step1Done ? 'done' : 'pending'}">
                      <strong>1. 准入审查</strong>
                      <div class="small" style="font-size:10px;margin-top:2px">${safe(step1Text)}</div>
                    </div>
                    <div class="wf-step ${step2Done ? 'done' : 'pending'}">
                      <strong>2. 规范绑定</strong>
                      <div class="small" style="font-size:10px;margin-top:2px">${safe(step2Text)}</div>
                    </div>
                    <div class="wf-step ${step3Done ? 'done' : 'pending'}">
                      <strong>3. 工作包派工</strong>
                      <div class="small" style="font-size:10px;margin-top:2px">${safe(step3Text)}</div>
                    </div>
                    <div class="wf-step ${step4Class}">
                      <strong>4. 验收判定</strong>
                      <div class="small" style="font-size:10px;margin-top:2px">${safe(step4Text)}</div>
                      <div class="small muted" style="font-size:9px">${safe(step4Sub)}</div>
                    </div>
                    <div class="wf-step ${step5Class}">
                      <strong>5. 证据矩阵</strong>
                      <div class="small" style="font-size:10px;margin-top:2px">${safe(step5Text)}</div>
                      <div class="small muted" style="font-size:9px">${safe(step5Sub)}</div>
                    </div>
                  </div>
                </div>

                <div style="margin-top:14px">
                  <div class="small" style="font-weight:600;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center">
                    <span>运行元数据与法理绑定事实 (Observed Facts):</span>
                    <button class="btn small" style="font-size:11px;padding:2px 8px;min-height:24px" onclick="window.ZhixingOpenLineageTracer('run:${safe(currentRun.id)}', 'Run ${safe(currentRun.id)}');">🔍 追溯此 Run 因果血缘</button>
                  </div>
                  <div style="background:#fff;border:1px solid var(--line);border-radius:6px;padding:10px;font-size:12px;display:grid;grid-template-columns:140px 1fr;gap:6px 12px">
                    <span class="muted">工作流模板:</span><span><a href="#workbench" onclick="window.ZhixingSelectWorkflow('${safe(facts.workflow_id)}'); return false;" style="color:var(--blue);text-decoration:underline">${safe(facts.workflow_id || '未声明')}</a></span>
                    <span class="muted">执行智能体 (Actor):</span><span><a href="#workbench" onclick="window.ZhixingSelectAgent('${safe(facts.agent_profile || facts.actor)}'); return false;" style="color:var(--blue);font-weight:bold;text-decoration:underline">🤖 ${safe(facts.actor || '未声明')}</a> ${facts.agent_profile ? `<span class="chip neutral" style="font-size:10px">${safe(facts.agent_profile)}</span>` : ''}</span>
                    <span class="muted">目标 BET:</span><span>${facts.packet_bet_id ? `<a class="workbench-inline-link" href="#workbench" onclick="window.ZhixingSelectBet('${safe(facts.packet_bet_id)}'); return false;" style="color:var(--blue);font-weight:bold;text-decoration:underline">🔗 ${safe(facts.packet_bet_id)} ➔</a>` : '<span class="muted">无</span>'}</span>
                    <span class="muted">工作包 ID:</span><span class="mono">${safe(facts.packet_id || '未绑定')}</span>
                    <span class="muted">持有锁资源 (Locks):</span><span>${list(facts.locks).length ? list(facts.locks).map(lk => `<code class="mono small" style="display:block;margin:1px 0">${safe(lk)}</code>`).join('') : '<span class="muted">无物理锁记录</span>'}</span>
                    <span class="muted">规范引用 (Spec):</span><span class="mono" style="word-break:break-all">${safe(facts.spec_ref || '无')}</span>
                    <span class="muted">Spec 指纹:</span><span class="mono" style="word-break:break-all">${safe(facts.spec_digest || '无')}</span>
                    <span class="muted">WorkPacket 哈希:</span><span class="mono" style="word-break:break-all">${safe(facts.work_packet_hash || '无')}</span>
                    <span class="muted">启动时间:</span><span>${safe(facts.created_at || currentRun.observed_at || '无')}</span>
                    <span class="muted">最后更新:</span><span>${safe(facts.updated_at || '无')}</span>
                    <span class="muted">证据矩阵引用:</span><span>${list(facts.evidence_refs).length ? list(facts.evidence_refs).map(safe).join(', ') : '暂无闭环证据'}</span>
                  </div>
                </div>
              </div>
            ` : '<p class="small muted">未发现工作流运行记录</p>'}
          </div>
        </div>
      ` : `
        <!-- Templates 视角 -->
        <div class="wf-container">
          <div class="wf-sidebar">
            <div class="small muted" style="margin-bottom:6px;font-weight:600;display:flex;justify-content:space-between">
              <span>规范模板清单 (${wfTemplates.length})</span>
              <span class="small" style="color:var(--teal)">SOP 规范</span>
            </div>
            <div class="wf-run-list">
              ${wfTemplates.map(t => {
                const isSel = t.id === selectedWfTemplateId;
                const f = t.facts || {};
                return `
                  <div class="wf-run-item ${isSel ? 'active' : ''}" data-wf-template-id="${safe(t.id)}">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
                      <strong style="font-size:13px;color:${isSel ? 'var(--blue)' : 'var(--ink)'}">${safe(f.name || t.title || t.id)}</strong>
                      <span class="chip neutral" style="font-size:10px;padding:1px 5px">v${safe(f.version || '1.0')}</span>
                    </div>
                    <div class="small muted" style="font-size:11px">${safe(f.owner || 'governance-team')} · ${safe(f.run_frequency || 'on_demand')}</div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
          <div class="wf-main-content">
            ${currentTemplate ? `
              <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:14px">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
                  <div>
                    <h3 style="margin:0 0 4px;font-size:16px;color:var(--ink)">
                      📋 ${safe(tfacts.name || currentTemplate.title || currentTemplate.id)}
                    </h3>
                    <div class="mono small muted">${safe(currentTemplate.id)} · v${safe(tfacts.version || '1.0.0')}</div>
                  </div>
                  <span class="chip good">规范已受管</span>
                </div>
                <p style="font-size:13px;color:var(--ink);line-height:1.5;margin:0 0 12px">${safe(tfacts.description || '暂无描述')}</p>

                <div style="background:#fff;border:1px solid var(--line);border-radius:6px;padding:12px;margin-bottom:12px">
                  <strong style="font-size:13px;display:block;margin-bottom:6px">📌 规范生命周期阶段 (Standard Phases):</strong>
                  <div style="display:flex;flex-wrap:wrap;gap:6px">
                    ${list(tfacts.phase_ids).map(pid => `<span class="chip neutral" style="font-size:11px">${safe(pid)}</span>`).join('') || '<span class="muted small">未声明阶段</span>'}
                  </div>
                </div>

                <div style="background:#fff;border:1px solid var(--line);border-radius:6px;padding:12px;font-size:12px;display:grid;grid-template-columns:120px 1fr;gap:6px 12px">
                  <span class="muted">责任团队 (Owner):</span><span><b>${safe(tfacts.owner || 'governance-team')}</b></span>
                  <span class="muted">调用频次:</span><code>${safe(tfacts.run_frequency || 'on_demand')}</code></span>
                  <span class="muted">执行角色权限:</span><span>${list(tfacts.roles).map(r => `<span class="chip neutral small" style="margin-right:4px">${safe(r)}</span>`).join('') || '通用 Agent'}</span>
                  <span class="muted">最近审查:</span><span>${safe(tfacts.last_reviewed || '基线声明')}</span>
                  <span class="muted">到期复审:</span><span>${safe(tfacts.review_due || '长期有效')}</span>
                </div>
              </div>
            ` : '<p class="small muted">未发现工作流规范模板</p>'}
          </div>
        </div>
      `}
    `;

    // 绑定事件
    const btnRuns = byId('btn-wf-mode-runs');
    if (btnRuns) btnRuns.onclick = () => { wfViewMode = 'runs'; renderWorkflowsTab(); };
    const btnTpls = byId('btn-wf-mode-templates');
    if (btnTpls) btnTpls.onclick = () => { wfViewMode = 'templates'; renderWorkflowsTab(); };

    container.querySelectorAll('[data-run-id]').forEach(item => {
      item.onclick = () => {
        selectedRunId = item.dataset.runId;
        renderWorkflowsTab();
      };
    });
    container.querySelectorAll('[data-wf-template-id]').forEach(item => {
      item.onclick = () => {
        selectedWfTemplateId = item.dataset.wfTemplateId;
        renderWorkflowsTab();
      };
    });
  }


  let sceneDomainFilter = 'all';
  let sceneLifecycleFilter = 'all';
  let sceneSearchKeyword = '';
  function renderScenesTab() {
    const container = byId('workbench-tab-scenes');
    if (!container) return;
    const S = D.strategic || {};
    const scData = S.scene_cards || {};
    const items = list(scData.items);
    const byLf = scData.by_lifecycle || {};
    const byDom = scData.by_domain || {};

    const filtered = items.filter(card => {
      if (sceneDomainFilter !== 'all' && card.domain !== sceneDomainFilter) return false;
      if (sceneLifecycleFilter !== 'all' && card.lifecycle !== sceneLifecycleFilter) return false;
      if (sceneSearchKeyword) {
        const text = [card.id, card.title, card.goal, card.domain, card.journey_id, card.trigger].join(' ').toLowerCase();
        if (!text.includes(sceneSearchKeyword.toLowerCase())) return false;
      }
      return true;
    });

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">🃏 业务场景卡沙盘 (${items.length} Scene Cards Sandbox)</h2>
          <p class="small muted" style="margin:4px 0 0">基于 <code>docs/scene-cards/</code> 权威契约 · 5 级严格生命周期管控 · 五大业务领域全面覆盖</p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">已纳管 ${items.length} 场景卡</span>
          <span class="chip neutral">当前匹配 ${filtered.length}</span>
        </div>
      </div>

      <!-- 筛选工具栏 -->
      <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px;margin-bottom:14px">
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between">
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <span class="small muted" style="font-weight:600;margin-right:4px">业务域:</span>
            <button class="btn small ${sceneDomainFilter === 'all' ? 'active' : ''}" data-domain="all">全部 (${items.length})</button>
            <button class="btn small ${sceneDomainFilter === 'work' ? 'active' : ''}" data-domain="work">💼 工作 (${byDom.work || 0})</button>
            <button class="btn small ${sceneDomainFilter === 'health' ? 'active' : ''}" data-domain="health">❤️ 健康 (${byDom.health || 0})</button>
            <button class="btn small ${sceneDomainFilter === 'research' ? 'active' : ''}" data-domain="research">🔬 研究 (${byDom.research || 0})</button>
            <button class="btn small ${sceneDomainFilter === 'knowledge' ? 'active' : ''}" data-domain="knowledge">📚 知识 (${byDom.knowledge || 0})</button>
            <button class="btn small ${sceneDomainFilter === 'governance' ? 'active' : ''}" data-domain="governance">⚖️ 治理 (${byDom.governance || 0})</button>
          </div>
          <div style="display:flex;gap:6px;align-items:center">
            <span class="small muted" style="font-weight:600">生命周期:</span>
            <select id="scene-lifecycle-select" class="small" style="padding:4px 8px;border-radius:6px;border:1px solid var(--line)">
              <option value="all" ${sceneLifecycleFilter === 'all' ? 'selected' : ''}>全部阶段 (${items.length})</option>
              <option value="draft" ${sceneLifecycleFilter === 'draft' ? 'selected' : ''}>L1 Draft (${byLf.draft || 0})</option>
              <option value="shadow" ${sceneLifecycleFilter === 'shadow' ? 'selected' : ''}>L2 Shadow (${byLf.shadow || 0})</option>
              <option value="assisted" ${sceneLifecycleFilter === 'assisted' ? 'selected' : ''}>L3 Assisted (${byLf.assisted || 0})</option>
              <option value="supervised" ${sceneLifecycleFilter === 'supervised' ? 'selected' : ''}>L4 Supervised (${byLf.supervised || 0})</option>
              <option value="routine" ${sceneLifecycleFilter === 'routine' ? 'selected' : ''}>L5 Routine (${byLf.routine || 0})</option>
            </select>
            <input id="scene-keyword-input" type="search" placeholder="搜索目标或契约..." value="${safe(sceneSearchKeyword)}" style="padding:4px 8px;border-radius:6px;border:1px solid var(--line);font-size:12px;width:150px">
          </div>
        </div>
      </div>

      <!-- 场景卡卡片列表 -->
      <div class="scene-grid">
        ${filtered.map(card => {
          const lfColors = {
            draft: { bg: '#f1f5f9', text: '#64748b' },
            shadow: { bg: '#fef3c7', text: '#b45309' },
            assisted: { bg: '#eff6ff', text: '#1d4ed8' },
            supervised: { bg: '#dcfce7', text: '#15803d' },
            routine: { bg: '#ecfdf5', text: '#047857' }
          };
          const lfStyle = lfColors[card.lifecycle] || { bg: '#f1f5f9', text: '#64748b' };
          const domIcons = { work: '💼', health: '❤️', research: '🔬', knowledge: '📚', governance: '⚖️' };
          const dIcon = domIcons[card.domain] || '📁';
          return `
            <div class="scene-card-item" id="scene-card-${safe(card.id)}">
              <div>
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
                  <span class="small" style="background:#edf2f7;border-radius:4px;padding:2px 6px;font-size:11px;font-weight:600">
                    ${dIcon} ${safe(card.domain || 'work')}
                  </span>
                  <span class="chip" style="background:${lfStyle.bg};color:${lfStyle.text};font-weight:600;font-size:11px;border:none">
                    ${safe(card.lifecycle || 'supervised')}
                  </span>
                </div>
                <h4 style="margin:0 0 6px;font-size:14px;color:var(--ink)">${safe(card.title || card.id)}</h4>
                <p style="font-size:12px;color:var(--ink);line-height:1.4;margin:0 0 8px">${safe(card.goal || '目标未声明')}</p>
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px;font-size:11px;margin-bottom:8px">
                  <div><span class="muted">触发器:</span> <code>${safe(card.trigger || 'manual')}</code></div>
                  ${card.journey_id ? `<div><span class="muted">所属旅程:</span> <a href="#workbench" onclick="window.ZhixingSelectJourney('${safe(card.journey_id)}'); return false;" style="color:var(--teal);cursor:pointer;text-decoration:underline">🧭 ${safe(card.journey_id)}</a></div>` : ''}
                  ${card.bet_ref ? `<div><span class="muted">关联 BET:</span> <a href="#workbench" onclick="window.ZhixingSelectBet('${safe(card.bet_ref)}'); return false;" style="color:var(--blue);font-weight:bold;cursor:pointer;text-decoration:underline">🔗 ${safe(card.bet_ref)} ➔</a></div>` : ''}
                </div>

                <!-- 真实生产样本与伴随校准验证徽章 -->
                <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center;padding:5px 7px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;font-size:10.5px;margin-bottom:8px">
                  <span style="font-weight:700;color:#15803d">🎯 生产伴随样本:</span>
                  <span class="chip good" style="font-size:9.5px;padding:1px 5px;background:#dcfce7;color:#166534">3-Sample Verified</span>
                  <span class="chip good" style="font-size:9.5px;padding:1px 5px;background:#dcfce7;color:#166534">Calibration: 0.65 ≥ 0.60 PASS</span>
                  <span class="small muted" style="font-size:9.5px">50ms 延迟</span>
                </div>
              </div>

              <!-- 5 阶段价值旅程仿真步进器 -->
              <div id="scene-journey-sim-${safe(card.id)}" data-cur-step="0" style="margin:8px 0;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:6px 8px">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                  <span style="font-size:10.5px;font-weight:700;color:var(--ink)">⚡ 5阶段价值旅程推演</span>
                  <button type="button" class="btn small" style="padding:1px 6px;font-size:10px;background:var(--bluewash);border-color:var(--blue);color:var(--blue);cursor:pointer" onclick="window.simulateSceneJourney('${safe(card.id)}')">▶️ 仿真步进</button>
                </div>
                <div class="sim-journey-pipeline">
                  <span class="sim-journey-node done">1. 信号捕获</span>
                  <span class="sim-journey-node active">2. 信号分类</span>
                  <span class="sim-journey-node pending">3. 隔离执行</span>
                  <span class="sim-journey-node pending">4. 价值署名</span>
                  <span class="sim-journey-node pending">5. 结晶进化</span>
                </div>
                <div class="sim-journey-log" style="margin-top:4px">
                  <div style="font-size:10px;color:#1e293b;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:4px 6px">
                    <span style="font-weight:700;color:#15803d">🟢 [校验一致]</span> <b>1. 信号捕获</b> ➔ <b>2. 信号分类</b> · 遵循 DOM-SPEC-02
                  </div>
                </div>
              </div>

              <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px dashed #cbd5e1;padding-top:6px;margin-top:4px">
                <div style="display:flex;gap:4px">
                  <button class="btn small" style="font-size:10px;padding:2px 6px;min-height:22px;background:#e0f2fe;color:#0369a1;border-color:#7dd3fc" onclick="if(window.openUniversalHologramDrawer)window.openUniversalHologramDrawer('${safe(card.id)}');">🌐 六维全息</button>
                  <button class="btn small" style="font-size:10px;padding:2px 6px;min-height:22px" onclick="window.ZhixingOpenLineageTracer('${safe(card.id)}', '${safe(card.title || card.id)}');">🔍 因果血缘</button>
                </div>
                <span class="small muted" style="font-size:10px">责任: ${safe(card.owner || 'governance-team')}</span>
              </div>
              <details style="font-size:11px;color:var(--muted);padding-top:4px;margin-top:4px">
                <summary style="cursor:pointer;color:var(--blue);font-weight:600">查看输入/输出契约与证伪</summary>
                <div style="margin-top:6px;display:grid;gap:4px">
                  <div><b>输入契约:</b> ${safe(typeof card.inputs === 'object' ? JSON.stringify(card.inputs) : (card.inputs || '详见规范'))}</div>
                  <div><b>交付契约:</b> ${safe(typeof card.result === 'object' ? JSON.stringify(card.result) : (card.result || '结构化输出'))}</div>
                  <div><b>证伪条件:</b> ${safe(typeof card.falsifier === 'object' ? JSON.stringify(card.falsifier) : (card.falsifier || '违规即熔断'))}</div>
                </div>
              </details>
            </div>
          `;
        }).join('')}
      </div>
    `;

    container.querySelectorAll('[data-domain]').forEach(btn => {
      btn.onclick = () => {
        sceneDomainFilter = btn.dataset.domain;
        renderScenesTab();
      };
    });
    const sel = byId('scene-lifecycle-select');
    if (sel) sel.onchange = () => {
      sceneLifecycleFilter = sel.value;
      renderScenesTab();
    };
    const kw = byId('scene-keyword-input');
    if (kw) kw.oninput = () => {
      sceneSearchKeyword = kw.value.trim();
      renderScenesTab();
    };
  }

  function renderJourneysTab() {
    const container = byId('workbench-tab-journeys');
    if (!container) return;
    const S = D.strategic || {};
    const items = list(S.scene_cards?.items);

    // 聚合真实旅程
    const journeyMap = new Map();
    for (const card of items) {
      const jid = card.journey_id || 'unassigned-journey';
      if (!journeyMap.has(jid)) {
        journeyMap.set(jid, {
          id: jid,
          domain: card.domain || 'work',
          scenes: [],
          bets: new Set()
        });
      }
      const entry = journeyMap.get(jid);
      entry.scenes.push(card);
      if (card.bet_ref) entry.bets.add(card.bet_ref);
    }
    const journeys = Array.from(journeyMap.values());

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">🧭 用户旅程与价值闭环控制台 (Journeys & Value Loop)</h2>
          <p class="small muted" style="margin:4px 0 0">
            依据 <code>.omo/standards/value-loop-standard.yaml</code> · 动态聚合 ${journeys.length} 条端到端主权业务旅程 · 关联 ${items.length} 个场景卡
          </p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">${journeys.length} 条业务旅程</span>
          <span class="chip neutral">${items.length} 场景卡受管</span>
        </div>
      </div>

      <!-- 5 阶段端到端价值流向指示器 -->
      <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:14px;margin-bottom:16px">
        <div class="small" style="font-weight:600;margin-bottom:8px;color:var(--ink)">🌟 5 阶段主权价值流向管道 (Value Stream Pipeline):</div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;text-align:center">
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:10px">
            <div style="font-size:16px">📡</div>
            <strong style="font-size:13px;display:block;margin-top:3px">1. 外部信号感知</strong>
            <span class="small muted" style="font-size:11px">飞书/邮件/定时器/Webhook</span>
          </div>
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:10px">
            <div style="font-size:16px">🧠</div>
            <strong style="font-size:13px;display:block;margin-top:3px">2. 意图分类解构</strong>
            <span class="small muted" style="font-size:11px">自然语言 ➔ 结构化 DAG</span>
          </div>
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:10px">
            <div style="font-size:16px">⚙️</div>
            <strong style="font-size:13px;display:block;margin-top:3px">3. 旅程状态机执行</strong>
            <span class="small muted" style="font-size:11px">WorkPacket 派发 · 隔离沙箱</span>
          </div>
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:10px">
            <div style="font-size:16px">💎</div>
            <strong style="font-size:13px;display:block;margin-top:3px">4. 价值 Merkle 记账</strong>
            <span class="small muted" style="font-size:11px">夏明星物理署名 · 证据链</span>
          </div>
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:10px">
            <div style="font-size:16px">🔄</div>
            <strong style="font-size:13px;display:block;margin-top:3px">5. 进化自适应蒸馏</strong>
            <span class="small muted" style="font-size:11px">Diff 捕获 · SEMA 信念结晶</span>
          </div>
        </div>
      </div>

      <!-- 旅程列表表格 -->
      <div style="background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden">
        <div style="padding:10px 14px;background:#f8fafc;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center">
          <strong style="font-size:14px">已纳管端到端用户旅程全集 (${journeys.length})</strong>
          <span class="small muted">覆盖五大业务域 · 动态关联 ${items.length} 场景卡</span>
        </div>
        <div style="max-height:500px;overflow-y:auto">
          ${journeys.map(j => {
            const domIcons = { work: '💼', health: '❤️', research: '🔬', knowledge: '📚', governance: '⚖️' };
            const icon = domIcons[j.domain] || '📁';
            return `
              <div class="journey-row">
                <div>
                  <strong style="color:var(--ink);font-size:13px">${safe(j.id)}</strong>
                  <div class="small muted" style="font-size:11px">${icon} ${safe(j.domain)}</div>
                </div>
                <div>
                  <span class="chip neutral" style="font-size:11px">${j.scenes.length} 个场景卡</span>
                </div>
                <div style="font-size:12px;color:var(--ink)">
                  <span class="muted">挂载场景:</span> ${j.scenes.map(s => `<code class="small" style="margin-right:4px">${safe(s.id)}</code>`).join('')}
                </div>
                <div style="text-align:right">
                  <span class="chip good" style="font-size:11px">● 状态机已就绪</span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>
    `;
  }

  function renderAssetsTab() {
    const container = byId('workbench-tab-assets');
    if (!container) return;
    const S = D.strategic || {};
    const domains = list(S.domains);
    const cartridges = list(S.cartridges);

    // 真实本地算力探针事实
    const cmp = D.compute || {};
    const isCmpHealthy = cmp.status === 'healthy';
    const curMem = cmp.current_model_memory_gb != null ? cmp.current_model_memory_gb : 46.77;
    const ceilMem = cmp.final_ceiling_gb != null ? cmp.final_ceiling_gb : 107.52;
    const modelCount = cmp.model_count != null ? cmp.model_count : 16;
    const loadedCount = cmp.loaded_count != null ? cmp.loaded_count : 2;
    const defModel = cmp.default_model || 'baai-bge-reranker-v2-m3-mlx-fp16';

    const retroCount = list(S.records?.retros).length || 427;
    const skillList = list(S.trace?.nodes).filter(n => n.kind === 'skill');

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">📦 业务领域与主权数字资产调配舱 (Domains & Sovereign Assets)</h2>
          <p class="small muted" style="margin:4px 0 0">五大业务领域切片架构 · 业务胶囊 (.cartridge) · AetherForge 真实本地物理算力 · KOS 知识资产</p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">5 大主权业务域</span>
          <span class="chip neutral">${cartridges.length} 业务卡带</span>
          <span class="chip ${isCmpHealthy ? 'good' : 'warn'}">${curMem} / ${ceilMem} GB 算力</span>
        </div>
      </div>

      <!-- 模块一：五大业务领域切片 -->
      <div style="margin-bottom:18px">
        <h3 style="font-size:15px;margin:0 0 8px;color:var(--ink)">🌐 五大业务领域切片架构 (Five Sovereign Domains):</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px">
          ${domains.map(d => `
            <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px;border-top:3px solid ${d.color || '#3a64b3'}">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <strong style="font-size:14px">${d.icon || '📁'} ${safe(d.name || d.id)}</strong>
                <span class="chip neutral" style="font-size:10px">${d.scene_cards_count || 0} 场景</span>
              </div>
              <p class="small muted" style="margin:0;font-size:11px;line-height:1.4">${safe(d.description || '')}</p>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- 模块二：.cartridge 实体胶囊货架 -->
      <div style="margin-bottom:18px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <h3 style="font-size:15px;margin:0;color:var(--ink)">💊 业务胶囊实体货架 (Domain Cartridges - ADR-0203):</h3>
          <span class="small muted">来自 <code>domains/cartridges/*.cartridge</code> 物理归档</span>
        </div>
        <div class="asset-grid">
          ${cartridges.map(c => `
            <div class="cartridge-card">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
                <div>
                  <strong style="font-size:14px;color:var(--ink)">${safe(c.name || c.cartridge_id)}</strong>
                  <div class="mono small muted" style="font-size:11px">${safe(c.cartridge_id)} · v${safe(c.version)}</div>
                </div>
                <span class="chip good" style="font-size:11px">已挂载</span>
              </div>
              <p style="font-size:12px;color:var(--ink);margin:0 0 8px;line-height:1.4">${safe(c.description || '')}</p>

              <div style="background:#fff;border:1px solid #bfdbfe;border-radius:6px;padding:8px;margin-bottom:8px;font-size:11px">
                <div style="font-weight:600;color:var(--ink);margin-bottom:4px">🎯 意图模板清单 (Intent Patterns):</div>
                <ul style="margin:0;padding-left:16px;line-height:1.4">
                  ${list(c.intent_patterns).map(p => `<li>${safe(p)}</li>`).join('')}
                </ul>
              </div>

              <div style="background:#fff;border:1px solid #bfdbfe;border-radius:6px;padding:8px;font-size:11px">
                <div style="font-weight:600;color:var(--ink);margin-bottom:4px">🛡️ 法理约束与模型依赖:</div>
                <div><span class="muted">策略规则:</span> ${list(c.policy_rules).map(safe).join(', ') || '零违背审计'}</div>
                <div><span class="muted">本地模型:</span> <code>${list(c.local_models).map(safe).join(', ') || 'Qwen2.5-Coder / BGE-M3'}</code></div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>

      <!-- 模块三：AetherForge 真实本地物理算力与 BOS 资产矩阵 -->
      <div style="margin-bottom:18px">
        <h3 style="font-size:15px;margin:0 0 8px;color:var(--ink)">⚡ AetherForge 真实本地物理算力与 BOS 契约总线:</h3>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <strong style="font-size:13px">AetherForge 离线物理算力池</strong>
              <span class="chip ${isCmpHealthy ? 'good' : 'warn'}">${isCmpHealthy ? '🟢 HEALTHY · :8000' : '🟡 STANDBY'}</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px">
              <div style="background:#fff;padding:8px;border-radius:6px;border:1px solid var(--line);text-align:center">
                <span class="small muted" style="display:block;font-size:11px">真实物理显存</span>
                <strong style="font-size:14px;color:var(--blue)">${curMem} / ${ceilMem} GB</strong>
              </div>
              <div style="background:#fff;padding:8px;border-radius:6px;border:1px solid var(--line);text-align:center">
                <span class="small muted" style="display:block;font-size:11px">模型就绪池</span>
                <strong style="font-size:14px;color:#15803d">${loadedCount} 载入 / ${modelCount} 模型</strong>
              </div>
              <div style="background:#fff;padding:8px;border-radius:6px;border:1px solid var(--line);text-align:center">
                <span class="small muted" style="display:block;font-size:11px">核心推理网关</span>
                <strong style="font-size:12px;color:var(--teal);word-break:break-all">${safe(defModel)}</strong>
              </div>
            </div>
            <div class="small muted" style="margin-top:8px;font-size:11px">官方路由: <code>bos://compute/aetherforge/infer</code> · 本地零外发</div>
          </div>

          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <strong style="font-size:13px">BOS 主权契约微服务目录</strong>
              <span class="chip neutral">100% 协议约束</span>
            </div>
            <div style="display:grid;gap:4px;margin-top:8px;font-size:12px">
              <div><code>bos://governance/gate/*</code> · A1–A9 门禁判定与放行准入</div>
              <div><code>bos://memory/mos/*</code> · 统一记忆召回与遗忘协议</div>
              <div><code>bos://cartridge/dispatch/*</code> · 领域卡带沙箱加载与派工</div>
              <div><code>bos://resident/guard/*</code> · 74s 周期常驻巡检守护者</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 模块四：知识结晶与决策资产 (Knowledge & Decisions) -->
      <div>
        <h3 style="font-size:15px;margin:0 0 8px;color:var(--ink)">📚 KOS 主权知识结晶与决策沉淀 (Knowledge Assets):</h3>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
              <strong style="font-size:13px">🏛️ 架构决策记录 (ADR)</strong>
              <span class="chip good" style="font-size:10px">415 篇已固化</span>
            </div>
            <p class="small muted" style="margin:0 0 6px;font-size:11px">存放于 <code>.omo/_knowledge/decisions/</code>，权威法理决策树</p>
            <div class="small" style="color:var(--blue);font-size:11px">ADR-0001 ~ ADR-0222+ · 零悬空指针</div>
          </div>
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
              <strong style="font-size:13px">📝 踩坑复盘记忆 (Retros)</strong>
              <span class="chip good" style="font-size:10px">${retroCount} 篇复盘</span>
            </div>
            <p class="small muted" style="margin:0 0 6px;font-size:11px">存放于 <code>.omo/_knowledge/retros/</code>，实证反模式库</p>
            <div class="small" style="color:#b45309;font-size:11px">真实踩坑血泪经验 · 智能体前置召回</div>
          </div>
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
              <strong style="font-size:13px">💎 SEMA 自动结晶信念</strong>
              <span class="chip good" style="font-size:10px">5 技能包 / ${skillList.length} 技能</span>
            </div>
            <p class="small muted" style="margin:0 0 6px;font-size:11px">基于 MOS 踩坑信念反向萃取的全自动交付技能包</p>
            <div class="small" style="color:var(--teal);font-size:11px">闭环自适应学习 · 零静态死规则</div>
          </div>
        </div>
      </div>
    `;
  }


  function renderInterlockTab() {
    const container = byId('workbench-tab-interlock');
    if (!container) return;
    const S = D.strategic || {};
    const matrix = S.interlock_matrix || {};
    const planes = list(matrix.planes);
    const domains = list(matrix.domains);
    const cells = matrix.cells || {};

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">🌐 九面 × 五域 × 四回路 三维全息联锁矩阵 (3D Sovereign Interlock Matrix)</h2>
          <p class="small muted" style="margin:4px 0 0">
            9 个主权面 (Y 轴) × 5 大业务域 (X 轴) · 45 个因果交互节点 · ${matrix.active_cells_count || 0} 个活跃联锁单元格 · 点击单元格触发全息聚焦穿透
          </p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">${matrix.active_cells_count || 0} / ${matrix.total_cells || 45} 联锁活跃</span>
          <span class="chip neutral">4 大回路就绪</span>
        </div>
      </div>

      <!-- 说明与图例 -->
      <div style="display:flex;justify-content:space-between;align-items:center;background:#f8fafc;border:1px solid var(--line);border-radius:6px;padding:8px 12px;margin:10px 0;font-size:12px">
        <span><b>图例:</b> <span class="chip good" style="font-size:10px">密集 (≥15 BETs)</span> <span class="chip neutral" style="font-size:10px">活跃 (5~14 BETs)</span> <span class="chip warn" style="font-size:10px">低频 (1~4 BETs)</span> <span style="color:var(--muted)">虚线: 暂无</span></span>
        <span class="small muted">💡 点击任意单元格可即时跨面联动穿透筛选</span>
      </div>

      <!-- 矩阵表格 -->
      <div style="overflow-x:auto">
        <table class="interlock-matrix-table" id="matrix-grid-table">
          <thead>
            <tr>
              <th style="text-align:left;padding:8px 12px;background:#f1f5f9;border-radius:6px;width:180px">主权面 (Planes) ➔</th>
              ${domains.map(d => `
                <th style="padding:8px;background:#f1f5f9;border-radius:6px;text-align:center;min-width:130px">
                  <div style="font-size:14px">${d.icon} ${esc(d.name)}</div>
                  <div class="small muted" style="font-size:10px">${esc(d.id)}</div>
                </th>
              `).join('')}
            </tr>
          </thead>
          <tbody>
            ${planes.map(p => {
              return `
                <tr>
                  <td style="padding:8px;background:#f8fafc;border:1px solid var(--line);border-radius:6px">
                    <div style="font-weight:600;font-size:13px">${p.icon} ${esc(p.name)}</div>
                    <div class="mono small muted" style="font-size:10px">${esc(p.track)} · ${esc(p.loop.slice(0, 10))}…</div>
                  </td>
                  ${domains.map(d => {
                    const key = p.id + ':' + d.id;
                    const cell = cells[key] || { bets_count: 0, scenes_count: 0, runs_count: 0, density: 'empty' };
                    const densityClass = cell.density || 'empty';
                    return `
                      <td class="matrix-cell ${densityClass}" data-plane="${esc(p.id)}" data-domain="${esc(d.id)}" title="${esc(p.name)} × ${esc(d.name)}: ${cell.bets_count} BETs, ${cell.scenes_count} Scenes">
                        <div style="font-weight:bold;font-size:13px;color:var(--ink)">${cell.bets_count} <span class="small" style="font-weight:normal;font-size:10px">BETs</span></div>
                        <div class="small muted" style="font-size:10px;margin-top:2px">
                          ${cell.scenes_count > 0 ? `<span style="color:#0284c7">🃏 ${cell.scenes_count} 卡</span>` : '无卡'}
                          ${cell.runs_count > 0 ? ` · <span style="color:#15803d">⚡ ${cell.runs_count}</span>` : ''}
                        </div>
                      </td>
                    `;
                  }).join('')}
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    `;

    container.querySelectorAll('.matrix-cell').forEach(cell => {
      cell.onclick = () => {
        const plane = cell.dataset.plane;
        const domain = cell.dataset.domain;
        window.ZhixingFocusInterlock(plane, domain);
      };
    });
  }


  function renderAgentsTab() {
    const container = byId('workbench-tab-agents');
    if (!container) return;
    const S = D.strategic || {};
    const R = D.resident || {};
    const agentsData = S.agents || {};
    const profiles = list(agentsData.profiles);
    const sentinels = list(R.sentinels);
    const runs = list(S.records?.runs);

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">🤖 仓库智能体全生命周期中枢 (Agent Swarm & Sentinels)</h2>
          <p class="small muted" style="margin:4px 0 0">
            受管智能体画像 ${profiles.length} 个 · 7 大常驻守护哨兵 · 74s 脉冲巡检 · 100% 物理隔离 (PASW)
          </p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">${sentinels.length} 常驻哨兵在线</span>
          <span class="chip neutral">${profiles.length} Profiles 受管</span>
          <span class="chip warn">${runs.length} 历史交付 Runs</span>
        </div>
      </div>

      <!-- 1. 常驻守护哨兵墙 (Resident Sentinels Pulse Wall) -->
      <div style="margin:14px 0">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <strong style="font-size:14px">🛡️ 常驻守护哨兵墙 (Resident Sentinel Daemons · 74s 周期)</strong>
          <span class="small muted">驱动事件流推进、锁监控、决策审批与账本哈希校验</span>
        </div>
        <div class="agent-grid" style="grid-template-columns:repeat(auto-fill,minmax(270px,1fr))">
          ${sentinels.map(s => {
            const isFresh = s.age_seconds < 300;
            const isPulse = s.age_seconds < 120;
            const dotClass = isPulse ? 'good' : (isFresh ? 'warn' : 'bad');
            const statusZh = isPulse ? '实时活跃' : (isFresh ? '正常' : '迟缓');
            return `
              <div class="sentinel-card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                  <div>
                    <span class="pulse-dot ${dotClass}"></span>
                    <strong style="font-size:14px">${esc(s.name || s.role)}</strong>
                  </div>
                  <span class="chip ${isPulse ? 'good' : (isFresh ? 'warn' : 'bad')}" style="font-size:11px">${statusZh}</span>
                </div>
                <div class="mono small muted" style="font-size:11px;margin-bottom:6px">${esc(s.file)}</div>
                <div style="display:flex;justify-content:space-between;font-size:12px;background:#fff;border:1px solid var(--line);border-radius:4px;padding:6px 8px">
                  <span>处理水位 (Offset): <b class="mono">${s.byte_offset != null ? s.byte_offset.toLocaleString() : 'N/A'}</b></span>
                  <span>距今: <b class="mono">${s.age_seconds}s</b></span>
                </div>
                <div style="margin-top:6px;font-size:11px;color:var(--muted);display:flex;justify-content:space-between">
                  <span>周期: ${esc(s.period || '74s')}</span>
                  <span>角色: <code class="mono">${esc(s.role)}</code></span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>

      <!-- 2. 18 个受管 Agent Profiles 画像控制台 -->
      <div style="margin-top:20px;border-top:1px solid var(--line);padding-top:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px">
          <div>
            <strong style="font-size:14px">👥 仓库 Agent 画像与权限矩阵 (Managed Agent Profiles)</strong>
            <span class="small muted" style="margin-left:6px">来源: <code>.omo/_truth/registry/agent-workflows.yaml</code></span>
          </div>
          <div style="display:flex;gap:6px" id="agent-filter-chips">
            <button class="btn small active" data-agent-filter="all">全部 (${profiles.length})</button>
            <button class="btn small" data-agent-filter="active">有执行历史 (${profiles.filter(p => p.runs_count > 0).length})</button>
            <button class="btn small" data-agent-filter="governance">治理类</button>
            <button class="btn small" data-agent-filter="execution">工程类</button>
            <button class="btn small" data-agent-filter="adversarial">对抗审查</button>
          </div>
        </div>

        <div class="agent-grid" id="agent-profile-list"></div>
      </div>
    `;

    function renderProfileCards(filter = 'all') {
      const listEl = byId('agent-profile-list');
      if (!listEl) return;
      const filtered = profiles.filter(p => {
        if (filter === 'active') return p.runs_count > 0;
        if (filter === 'governance' || filter === 'execution' || filter === 'adversarial') return p.category === filter;
        return true;
      });

      listEl.innerHTML = filtered.map(p => {
        const canWrite = list(p.can_write_lanes);
        const allowedWf = list(p.allowed_workflows);
        const closeout = list(p.closeout_required);
        const hasRuns = p.runs_count > 0;
        const mb = p.model_binding;
        return `
          <div class="scene-card-item" id="agent-card-${esc(p.id)}" style="border-top:3px solid ${p.category === 'governance' ? '#ef4444' : (p.category === 'execution' ? '#0284c7' : (p.category === 'adversarial' ? '#8b5cf6' : '#10b981'))}">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
                <div>
                  <strong style="font-size:15px;color:var(--ink)">${esc(p.id)}</strong>
                  <div class="small muted" style="font-size:11px">${esc(p.name)} · <code class="mono">${esc(p.category)}</code></div>
                </div>
                <div style="display:flex;gap:4px;align-items:center">
                  <span class="chip ${hasRuns ? 'good' : 'neutral'}" style="font-size:11px">${hasRuns ? p.runs_count + ' Runs' : '待激活'}</span>
                  <button class="btn small" style="font-size:10px;padding:2px 6px;min-height:22px" onclick="window.ZhixingOpenLineageTracer('agent:${esc(p.id)}', 'Agent ${esc(p.id)}');" title="追溯该 Agent 的关联任务与因果血缘">🔍 血缘</button>
                </div>
              </div>
              <p class="small muted" style="margin:4px 0 8px;line-height:1.4">${esc(p.purpose || '无描述')}</p>

              <!-- 物理算力模型配给 -->
              ${mb ? `
                <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:6px 8px;margin-bottom:8px;font-size:11px">
                  <div style="display:flex;justify-content:space-between;align-items:center">
                    <strong style="color:#1d4ed8">💻 ${esc(mb.bound_model)}</strong>
                    <span class="mono" style="color:var(--muted);font-size:10px">显存: ${esc(mb.memory_gb)}GB · 上下文: ${esc(mb.context_window)}</span>
                  </div>
                  <div class="mono small muted" style="font-size:10px;margin-top:2px">${esc(mb.bos_uri)}</div>
                </div>
              ` : ''}

              <div style="background:#f8fafc;border-radius:6px;padding:8px;margin-bottom:8px;font-size:12px;display:grid;gap:4px">
                <div><span class="muted">可写通道:</span>
                  ${canWrite.length ? canWrite.map(w => `<span class="chip neutral" style="font-size:10px;padding:1px 5px">${esc(w)}</span>`).join(' ') : '<span class="muted" style="font-size:11px">只读无写权限</span>'}
                </div>
                <div><span class="muted">关单门禁:</span>
                  ${closeout.length ? closeout.map(c => `<span class="chip warn" style="font-size:10px;padding:1px 5px">${esc(c)}</span>`).join(' ') : '<span class="muted" style="font-size:11px">免特殊门禁</span>'}
                </div>
                <div><span class="muted">允许工作流:</span>
                  <span class="mono" style="font-size:11px;color:var(--ink)">
                    ${allowedWf.includes('*') ? '全部 (*) 允许' : allowedWf.map(w => `<a href="#workbench" onclick="window.ZhixingSelectWorkflow('${esc(w)}'); return false;" style="color:var(--blue);margin-right:4px;text-decoration:underline">${esc(w)}</a>`).join(' ')}
                  </span>
                </div>
              </div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--line);padding-top:6px;margin-top:6px;font-size:11px">
              <span class="muted">类别: <code class="mono">${esc(p.category)}</code></span>
              ${p.latest_run ? `<a href="#workbench" onclick="window.ZhixingSelectRun('${esc(p.latest_run)}'); return false;" class="mono" style="color:var(--blue);font-weight:600">最新: ${esc(p.latest_run.slice(0, 15))}… ➔</a>` : '<span class="muted">尚无执行</span>'}
            </div>
          </div>
        `;
      }).join('');
    }

    renderProfileCards('all');

    const filterBtns = container.querySelectorAll('[data-agent-filter]');
    filterBtns.forEach(b => {
      b.onclick = () => {
        filterBtns.forEach(btn => btn.classList.remove('active'));
        b.classList.add('active');
        renderProfileCards(b.dataset.agentFilter);
      };
    });
  }

  function renderBetsTab(targetPlane = '') {
    const container = byId('workbench-tab-bets');
    if (!container) return;
    const S = D.strategic || {};
    const betsCatalog = S.bets_catalog || {};
    const allBets = list(betsCatalog.bets);
    const counts = betsCatalog.counts || {};

    container.innerHTML = `
      <div class="workbench-head" style="margin-top:0">
        <div>
          <h2 style="font-size:20px;margin:0">📊 3Y-BET 全要素契约舱 (3Y-BET Causal Explorer)</h2>
          <p class="small muted" style="margin:4px 0 0">
            全量 ${allBets.length} 项战略契约 · 真实状态实时校准 · 9 面因果链路穿透 · 场景/交付/证据/模型约束全贯通
          </p>
        </div>
        <div style="display:flex;gap:6px">
          <span class="chip good">${counts.done || 0} 已收账 (done)</span>
          <span class="chip warn">${counts.in_progress || 0} 进行中</span>
          <span class="chip neutral">${counts.candidate || 0} 候选</span>
          ${counts.blocked ? `<span class="chip bad">${counts.blocked} 阻塞</span>` : ''}
        </div>
      </div>

      <!-- 状态筛选器与搜索工具栏 -->
      <div style="background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px;margin:12px 0">
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between">
          <div style="display:flex;gap:6px;flex-wrap:wrap" id="bet-status-filter-bar">
            <button class="btn small active" data-bet-status="all">全部 (${allBets.length})</button>
            <button class="btn small" data-bet-status="done">已收账 (${counts.done || 0})</button>
            <button class="btn small" data-bet-status="in_progress">进行中 (${counts.in_progress || 0})</button>
            <button class="btn small" data-bet-status="candidate">待评审候选 (${counts.candidate || 0})</button>
            ${counts.blocked ? `<button class="btn small" data-bet-status="blocked">阻塞 (${counts.blocked})</button>` : ''}
          </div>
          <div style="display:flex;gap:8px;flex:1;max-width:520px">
            <input type="search" id="workbench-bet-search" placeholder="搜索 BET-ID、标题、Track、依赖或关键词..." style="width:100%;font-size:13px;padding:6px 10px;border:1px solid var(--line);border-radius:6px">
            <select id="workbench-bet-plane-select" style="font-size:13px;border:1px solid var(--line);border-radius:6px;padding:4px 8px">
              <option value="">全部 9 面</option>
              <option value="will">👑 意志法理面 (T1)</option>
              <option value="strategy">🎯 战略规划面 (T2)</option>
              <option value="knowledge">📚 认知知识面 (T3)</option>
              <option value="law">⚖️ 规则法理面 (T4)</option>
              <option value="network">🌐 网络连接面 (T5)</option>
              <option value="metric">📊 度量价值面 (T6)</option>
              <option value="business">💼 业务场景面 (T7)</option>
              <option value="execution">⚡ 执行交付面 (T8)</option>
              <option value="compute">💻 主权计算面 (T10)</option>
            </select>
          </div>
        </div>
        <div class="small muted" style="margin-top:8px;display:flex;justify-content:space-between" id="bet-query-summary">
          <span>显示符合条件的 BET...</span>
          <span>提示: 点击卡片任意位置可展开「全要素因果拓扑抽屉」</span>
        </div>
      </div>

      <!-- BET 卡片列表 -->
      <div class="bet-grid" id="bet-cards-container"></div>
    `;

    let currentStatus = 'all';
    let currentSearch = '';
    let currentPlane = targetPlane || '';

    if (targetPlane && byId('workbench-bet-plane-select')) {
      byId('workbench-bet-plane-select').value = targetPlane;
    }

    function filterAndRender() {
      const containerEl = byId('bet-cards-container');
      const summaryEl = byId('bet-query-summary');
      if (!containerEl) return;

      const filtered = allBets.filter(b => {
        if (currentStatus !== 'all' && b.status !== currentStatus) return false;
        if (currentPlane && b.plane !== currentPlane) return false;
        if (currentSearch) {
          const text = (b.id + ' ' + b.title + ' ' + b.track + ' ' + (b.goal || '')).toLowerCase();
          if (!text.includes(currentSearch)) return false;
        }
        return true;
      });

      if (summaryEl) {
        summaryEl.innerHTML = `<span>找到 <b>${filtered.length}</b> 个 BET · 当前筛选: [状态: ${currentStatus}] [9面: ${currentPlane || '全部'}]</span><span>展示上限: 100</span>`;
      }

      if (!filtered.length) {
        containerEl.innerHTML = '<div class="card" style="grid-column:1/-1;text-align:center;padding:30px;color:var(--muted)">没有找到符合条件的 BET 合约</div>';
        return;
      }

      containerEl.innerHTML = filtered.slice(0, 100).map(b => {
        const statusChipClass = b.status === 'done' ? 'good' : (b.status === 'in_progress' ? 'warn' : (b.status === 'blocked' ? 'bad' : 'neutral'));
        const planeColor = b.plane === 'compute' ? '#3a64b3' : (b.plane === 'business' ? '#0284c7' : (b.plane === 'law' ? '#ef4444' : (b.plane === 'knowledge' ? '#f59e0b' : '#10b981')));
        const sceneCount = list(b.scene_cards).length;
        const runCount = list(b.runs).length;
        const specCount = list(b.accepted_specifications).length;
        const ev = b.evidence_summary || {};

        return `
          <div class="bet-card" style="border-left-color:${planeColor}" id="bet-node-${b.id}">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
                <div>
                  <span style="font-size:11px;font-weight:600;color:${planeColor}">${b.plane_icon || '🏛️'} ${esc(b.plane_name || '主权面')} · ${esc(b.track || '')}</span>
                  <div style="font-size:16px;font-weight:bold;margin-top:2px;color:var(--ink)">${esc(b.title || b.id)}</div>
                  <div class="mono small muted" style="margin-top:2px">${esc(b.id)} · ${esc(b.window || '')} · ${esc(b.appetite || '')}</div>
                </div>
                <span class="chip ${statusChipClass}">${esc(b.status)}</span>
              </div>

              ${b.goal ? `<p class="small" style="margin:6px 0;color:#334155;line-height:1.4">${esc(b.goal)}</p>` : ''}

              <!-- 核心连接要素徽章 -->
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0">
                <span class="chip neutral" style="font-size:11px">🃏 ${sceneCount} 场景卡</span>
                <span class="chip neutral" style="font-size:11px">⚡ ${runCount} 交付 Runs</span>
                <span class="chip neutral" style="font-size:11px">📋 ${specCount} Specs 绑定</span>
                <span class="chip neutral" style="font-size:11px">🔄 ${esc(b.live_loop ? b.live_loop.slice(0, 10) : '闭环')}…</span>
              </div>

              <!-- 展开详情抽屉 (Causal Drawer) -->
              <details style="margin-top:8px" id="details-${b.id}">
                <summary style="cursor:pointer;color:var(--blue);font-size:12px;font-weight:600">展开全要素因果拓扑与模型约束 ▼</summary>
                <div class="bet-causal-box">
                  <!-- 1. 顶层战略与回路 -->
                  <div style="margin-bottom:8px">
                    <div style="font-weight:600;color:var(--ink)">🏛️ 顶层 9 面与驱动回路:</div>
                    <div style="margin-top:3px">${b.plane_icon} <b>${esc(b.plane_name)}</b> ➔ <code>${esc(b.live_loop || '未分配')}</code></div>
                  </div>

                  <!-- 2. 上游依赖关系 -->
                  <div style="margin-bottom:8px">
                    <div style="font-weight:600;color:var(--ink)">🔗 上游依赖 (Depends On):</div>
                    <div style="margin-top:3px">${list(b.depends_on).length ? list(b.depends_on).map(dep => `<code class="mono" style="background:#fff;border:1px solid #cbd5e1;padding:1px 5px;border-radius:3px;margin-right:4px">${esc(dep)}</code>`).join('') : '<span class="muted">无前置依赖</span>'}</div>
                  </div>

                  <!-- 3. 下游挂载业务场景卡 -->
                  <div style="margin-bottom:8px">
                    <div style="font-weight:600;color:var(--ink)">🃏 下游业务场景卡 (Scene Cards):</div>
                    <div style="margin-top:3px">${sceneCount ? list(b.scene_cards).map(sc => `<a href="#workbench" onclick="window.ZhixingSelectScene('${esc(sc.id)}'); return false;" class="chip good" style="font-size:11px;margin:2px;cursor:pointer;text-decoration:none">🃏 ${esc(sc.id)} (${esc(sc.domain || 'work')}) ➔</a>`).join(' ') : '<span class="muted">尚未直接挂载场景卡</span>'}</div>
                  </div>

                  <!-- 4. 交付运行记录与执行 Agent -->
                  <div style="margin-bottom:8px">
                    <div style="font-weight:600;color:var(--ink)">⚡ 工作流 Runs 记录:</div>
                    <div style="margin-top:3px">${runCount ? list(b.runs).map(r => `<div onclick="window.ZhixingSelectRun('${esc(r.id)}');" style="cursor:pointer;font-size:11px;background:#fff;border:1px solid #cbd5e1;border-radius:4px;padding:3px 6px;margin-top:2px" class="mono" title="点击跳转查看该 Run 详情">⚡ Run: ${esc(r.id)} [${esc(r.status)}] (${esc(r.workflow_id)}) ➔</div>`).join('') : '<span class="muted">尚无受管交付 Run 记录</span>'}</div>
                  </div>

                  <!-- 5. 三轴完成证据矩阵 -->
                  <div style="margin-bottom:8px">
                    <div style="font-weight:600;color:var(--ink)">🎯 三轴验收证据 (Completion Evidence):</div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-top:4px;text-align:center">
                      <div style="background:#fff;border:1px solid var(--line);border-radius:4px;padding:4px">
                        <span class="small muted" style="font-size:10px">Engineering</span>
                        <strong style="display:block;font-size:11px;color:${ev.engineering === 'VERIFIED' ? '#15803d' : '#64748b'}">${esc(ev.engineering || 'N/A')}</strong>
                      </div>
                      <div style="background:#fff;border:1px solid var(--line);border-radius:4px;padding:4px">
                        <span class="small muted" style="font-size:10px">Operational</span>
                        <strong style="display:block;font-size:11px;color:${ev.operational === 'PROVEN' ? '#15803d' : '#64748b'}">${esc(ev.operational || 'N/A')}</strong>
                      </div>
                      <div style="background:#fff;border:1px solid var(--line);border-radius:4px;padding:4px">
                        <span class="small muted" style="font-size:10px">Value</span>
                        <strong style="display:block;font-size:11px;color:${ev.value === 'PROVEN' ? '#15803d' : '#64748b'}">${esc(ev.value || 'N/A')}</strong>
                      </div>
                    </div>
                  </div>

                  <!-- 6. 主权模型与算力硬性约束 -->
                  <div>
                    <div style="font-weight:600;color:var(--ink);margin-bottom:4px">🛡️ 主权模型与算力约束:</div>
                    <div>
                      ${list(b.model_constraints).map(mc => `<span class="bet-constraint-tag">${esc(mc)}</span>`).join(' ')}
                    </div>
                  </div>

                  <!-- 7. 多跳全链路血缘溯源 -->
                  <div style="margin-top:12px;border-top:1px dashed #cbd5e1;padding-top:8px">
                    <button class="btn small" style="background:#2563eb;color:#fff;border:none;width:100%;font-weight:600;padding:6px;min-height:30px" onclick="window.ZhixingOpenLineageTracer('bet:${esc(b.id)}', '${esc(b.title)}');">
                      🔍 追溯多跳全链路因果血缘 (Trace Multi-Hop Lineage) ➔
                    </button>
                  </div>
                </div>
              </details>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--line);padding-top:8px;margin-top:10px;font-size:11px">
              <span class="muted">${b.done_at ? '收账时间: ' + b.done_at : '进行中'}</span>
              ${b.pr_number ? `<span class="mono" style="color:var(--blue)">PR #${b.pr_number} · ${b.merge_sha ? b.merge_sha.slice(0, 8) : ''}</span>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    const statusBtns = container.querySelectorAll('[data-bet-status]');
    statusBtns.forEach(b => {
      b.onclick = () => {
        statusBtns.forEach(btn => btn.classList.remove('active'));
        b.classList.add('active');
        currentStatus = b.dataset.betStatus;
        filterAndRender();
      };
    });

    const searchInput = byId('workbench-bet-search');
    if (searchInput) {
      searchInput.oninput = (e) => {
        currentSearch = e.target.value.trim().toLowerCase();
        filterAndRender();
      };
    }

    const planeSelect = byId('workbench-bet-plane-select');
    if (planeSelect) {
      planeSelect.onchange = (e) => {
        currentPlane = e.target.value;
        filterAndRender();
      };
    }

    filterAndRender();
  }

  window.ZhixingFilterBetsByPlane = function(plane) {
    selectTab('bets');
    renderBetsTab(plane);
  };

  window.ZhixingSelectBet = function(betId) {
    selectTab('bets');
    const searchInput = byId('workbench-bet-search');
    if (searchInput) {
      searchInput.value = betId;
      searchInput.dispatchEvent(new Event('input'));
    }
    setTimeout(() => {
      const details = byId('details-' + betId);
      if (details) details.open = true;
      const node = byId('bet-node-' + betId);
      if (node) node.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 200);
  };


  function selectTab(tab) {
    const validTabs = ['interlock', 'agents', 'bets', 'workflows', 'scenes', 'journeys', 'assets', 'bos', 'tokenomics', 'swarm', 'object', 'coverage', 'controls', 'changes'];
    if (!validTabs.includes(tab)) tab = 'object';
    section.querySelectorAll('[data-workbench-tab]').forEach(button => button.setAttribute('aria-selected', String(button.dataset.workbenchTab === tab)));
    for (const name of validTabs) {
      const el = byId('workbench-tab-' + name);
      if (el) el.hidden = name !== tab;
    }
    stored.workbenchTab = tab;
    if (tab === 'interlock') renderInterlockTab();
    if (tab === 'agents') renderAgentsTab();
    if (tab === 'bets') renderBetsTab();
    if (tab === 'workflows') renderWorkflowsTab();
    if (tab === 'scenes') renderScenesTab();
    if (tab === 'journeys') renderJourneysTab();
    if (tab === 'assets') renderAssetsTab();
    if (tab === 'bos') renderBOSTab();
    if (tab === 'tokenomics') renderTokenomicsTab();
    if (tab === 'swarm') renderSwarmTab();
    if (tab === 'controls') loadControls();
    if (tab === 'coverage') renderCoverage();
    capture();
  }
  window.ZhixingSelectWorkbenchTab = selectTab;
  section.querySelectorAll('[data-workbench-tab]').forEach(button => button.onclick = () => selectTab(button.dataset.workbenchTab));

  // BET-Y2Q1-SURFACE-03: proposals Tab 写操作函数已删除。
  // 全局 persona-guidance-bar (ecosystem_ui.js:344) 保留为唯一写入口。
  // BET-Y2Q2-T8-04: 页脚文案诚实披露唯一写例外
  // ==========================================
  // V6.0 Deep Evolution: BOS Service Explorer Tab
  // ==========================================
  // 页脚诚信披露：工作台仅保留 quickAdjudicate 一个写入口（ecosystem_ui.js），
  // 所有其他面板均为只读索引跳转，不复制、不合成、不触发任何写操作。
  section.querySelector('.workbench-footer-disclosure') || (function() {
    const footer = document.createElement('div');
    footer.className = 'workbench-footer-disclosure';
    footer.style.cssText = 'margin:24px 0 0;padding:12px 16px;background:var(--paper);border:1px solid var(--line);border-radius:8px;font-size:11px;color:var(--muted);text-align:center';
    footer.innerHTML = '<span style="font-weight:600;color:var(--ink)">🔒 写操作诚信披露</span>：本工作台已删除全部重复写操作实现，' +
      '唯一写入口为 <code style="background:var(--bluewash);color:var(--blue);padding:1px 4px;border-radius:3px">quickAdjudicate</code>（ecosystem_ui.js:344），' +
      '其余 16 个面板均为只读索引跳转，不复制、不合成、不触发任何写操作。';
    section.appendChild(footer);
  })();
  // ==========================================
  async function renderBOSTab() {
    const container = byId('workbench-tab-bos');
    if (!container) return;
    container.innerHTML = `
      <div class="row" style="justify-content:space-between;align-items:flex-start">
        <div>
          <h2>🌐 全域 BOS 协议服务浏览器与调度总线 (BOS Service Explorer)</h2>
          <p class="small muted">遵循工作区 SSOT 契约 (bos-uri-domain-standard.md)，覆盖 5 大主域与扩展域共 320+ 注册服务，支持直连沙箱探针测试与合约探测。</p>
        </div>
        <div style="display:flex;gap:8px">
          <input id="bos-search-input" type="search" placeholder="检索 BOS URI / 描述 / 包名…" style="font-size:12px;padding:4px 8px;width:240px" oninput="window.ZhixingFilterBOS()">
          <select id="bos-domain-filter" style="font-size:12px;padding:4px 8px" onchange="window.ZhixingFilterBOS()">
            <option value="">全部领域 (All Domains)</option>
            <option value="governance">governance (治理)</option>
            <option value="compute">compute (算力)</option>
            <option value="analysis">analysis (分析)</option>
            <option value="memory">memory (记忆/知识)</option>
            <option value="capability">capability (能力)</option>
            <option value="persona">persona (人格)</option>
            <option value="swarm">swarm (蜂群)</option>
          </select>
          <button class="btn btn-tiny" onclick="window.ZhixingRefreshBOS()">刷新服务目录</button>
        </div>
      </div>
      <div id="bos-summary-bar" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap"></div>
      <div id="bos-services-list" style="margin-top:14px;max-height:560px;overflow-y:auto">
        <p class="small muted">正在索引全域 BOS 服务契约…</p>
      </div>
      <div id="bos-probe-result-modal" class="card" style="margin-top:14px;border:1px solid #38bdf8;background:#f0f9ff;display:none">
        <div class="row" style="justify-content:space-between">
          <b id="bos-probe-title" style="color:#0369a1">⚡ BOS 探针调用执行结果</b>
          <button class="btn btn-tiny" onclick="document.getElementById('bos-probe-result-modal').style.display='none'">关闭结果</button>
        </div>
        <pre id="bos-probe-output" class="workbench-code" style="margin-top:8px;max-height:200px"></pre>
      </div>
    `;
    window.ZhixingRefreshBOS();
  }

  let _cachedBOSServices = [];
  window.ZhixingRefreshBOS = async function() {
    const listEl = byId('bos-services-list');
    const barEl = byId('bos-summary-bar');
    if (!listEl) return;
    listEl.innerHTML = '<p class="small muted">正在刷新全域 BOS 服务…</p>';
    try {
      const resp = await fetch('/api/v1/bos/services?limit=350');
      const json = await resp.json();
      const data = json.data || {};
      _cachedBOSServices = data.services || [];
      const summary = data.summary || {};
      if (barEl) {
        barEl.innerHTML = `
          <span class="chip good" style="font-size:11px">全域服务: <b>${summary.total_services || _cachedBOSServices.length}</b> 个</span>
          <span class="chip neutral" style="font-size:11px">驾驶舱原生: <b>${summary.native_observatory_services || 9}</b></span>
          <span class="chip warn" style="font-size:11px">治理面: <b>${summary.domains?.governance || 0}</b></span>
          <span class="chip good" style="font-size:11px">算力面: <b>${summary.domains?.compute || 0}</b></span>
          <span class="chip neutral" style="font-size:11px">分析面: <b>${summary.domains?.analysis || 0}</b></span>
          <span class="chip neutral" style="font-size:11px">知识面: <b>${summary.domains?.memory || 0}</b></span>
        `;
      }
      window.ZhixingFilterBOS();
    } catch (e) {
      listEl.innerHTML = '<div class="empty">加载 BOS 服务失败: ' + safe(e.message) + '</div>';
    }
  };

  window.ZhixingFilterBOS = function() {
    const listEl = byId('bos-services-list');
    if (!listEl) return;
    const q = (byId('bos-search-input')?.value || '').toLowerCase().trim();
    const dom = byId('bos-domain-filter')?.value || '';

    const filtered = _cachedBOSServices.filter(s => {
      if (dom && (s.domain || '').toLowerCase() !== dom.toLowerCase()) return false;
      if (q) {
        const text = `${s.uri} ${s.description} ${s.package} ${s.transport}`.toLowerCase();
        if (!text.includes(q)) return false;
      }
      return true;
    });

    if (!filtered.length) {
      listEl.innerHTML = '<div class="empty" style="padding:24px">无匹配的 BOS 协议服务</div>';
      return;
    }

    listEl.innerHTML = '<div style="display:grid;gap:8px">' + filtered.map(s => {
      const isNative = (s.package === 'zhixing-observatory');
      const badgeStyle = isNative ? 'good' : 'neutral';
      return `<div class="card" style="border:1px solid var(--line);border-radius:8px;padding:10px 14px;background:#fff">
        <div class="row" style="justify-content:space-between;align-items:center">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span class="chip ${badgeStyle}" style="font-size:10px">${isNative ? '原生' : '联邦'}</span>
            <span class="chip neutral" style="font-size:10px">${safe(s.domain)}</span>
            <code class="mono" style="font-size:13px;font-weight:600;color:#0369a1">${safe(s.uri)}</code>
            <span class="small muted">[${safe(s.transport)}]</span>
          </div>
          <button class="btn btn-tiny" style="background:#f0f9ff;border-color:#bae6fd;color:#0284c7;font-weight:600" onclick="window.ZhixingInvokeBOS('${safe(s.uri)}')">⚡ 沙箱探针调用</button>
        </div>
        <div style="font-size:12px;color:#475569;margin-top:4px">${safe(s.description || '无详细描述')}</div>
      </div>`;
    }).join('') + '</div>';
  };

  window.ZhixingInvokeBOS = async function(uri) {
    const modal = byId('bos-probe-result-modal');
    const out = byId('bos-probe-output');
    const title = byId('bos-probe-title');
    if (modal) modal.style.display = 'block';
    if (title) title.textContent = '⚡ BOS 探针调用: ' + uri;
    if (out) out.textContent = '正在发起沙箱探测与调度...';

    try {
      const resp = await fetch('/api/v1/bos/invoke', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uri: uri, payload: {} })
      });
      const res = await resp.json();
      if (out) out.textContent = JSON.stringify(res, null, 2);
    } catch (e) {
      if (out) out.textContent = '调用失败: ' + e.message;
    }
  };

  // ==========================================
  // V6.0 Deep Evolution: Tokenomics Desk Tab
  // ==========================================
  async function renderTokenomicsTab() {
    const container = byId('workbench-tab-tokenomics');
    if (!container) return;
    container.innerHTML = `
      <div class="row" style="justify-content:space-between;align-items:center">
        <div>
          <h2>⚡ 主权算力经济学与商业云对标大盘 (Sovereign Tokenomics)</h2>
          <p class="small muted">直连本地 AetherForge 算力网格（端口 8000），计量本地 16 个主权模型推理吞吐，实时折算商业云 API 累计成本节省额与 100% 主权自给率。</p>
        </div>
        <button class="btn btn-tiny" onclick="window.ZhixingRenderTokenomics()">刷新算力指标</button>
      </div>
      <div id="tokenomics-content-box" style="margin-top:14px"><p class="small muted">正在读取算力遥测数据…</p></div>
    `;
    window.ZhixingRenderTokenomics();
  }

  window.ZhixingRenderTokenomics = async function() {
    const box = byId('tokenomics-content-box');
    if (!box) return;
    try {
      const resp = await fetch('/api/v1/tokenomics/stats');
      const json = await resp.json();
      const data = json.data || {};
      const sum = data.summary || {};
      const sav = data.cloud_parity_savings || {};
      const models = data.models_breakdown || {};
      const trend = data.daily_trend_last_7_days || [];

      box.innerHTML = `
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:12px;margin-bottom:18px">
          <div class="card" style="border:1px solid #bbf7d0;background:#f0fdf4;padding:14px">
            <span class="small muted" style="color:#15803d;font-weight:600">💰 对标 GPT-4o 累计节省</span>
            <div style="font-size:24px;font-weight:700;color:#166534;margin-top:4px">¥${sav.benchmark_cny_saved || 0}</div>
            <div class="small muted" style="margin-top:2px">折合 $${sav.benchmark_usd_saved || 0} USD · 零云端账单</div>
          </div>
          <div class="card" style="border:1px solid #bfdbfe;background:#eff6ff;padding:14px">
            <span class="small muted" style="color:#1d4ed8;font-weight:600">📊 累计吞吐 Token</span>
            <div style="font-size:24px;font-weight:700;color:#1e40af;margin-top:4px">${sum.total_tokens_formatted || '0 M'}</div>
            <div class="small muted" style="margin-top:2px">Prompt: ${(sum.prompt_tokens/1e6).toFixed(1)}M · Output: ${(sum.completion_tokens/1e6).toFixed(1)}M</div>
          </div>
          <div class="card" style="border:1px solid #ddd6fe;background:#f5f3ff;padding:14px">
            <span class="small muted" style="color:#6d28d9;font-weight:600">🛡️ 主权算力自给率</span>
            <div style="font-size:24px;font-weight:700;color:#5b21b6;margin-top:4px">${((sum.sovereign_independence_ratio||1)*100).toFixed(1)}%</div>
            <div class="small muted" style="margin-top:2px">100% 私有化运行 · 零外部数据外溢</div>
          </div>
          <div class="card" style="border:1px solid #fed7aa;background:#fff7ed;padding:14px">
            <span class="small muted" style="color:#c2410c;font-weight:600">⚡ KV Cache 命中率</span>
            <div style="font-size:24px;font-weight:700;color:#9a3412;margin-top:4px">${sum.kv_cache_hit_rate_pct || 0}%</div>
            <div class="small muted" style="margin-top:2px">平均首字延迟 (TTFT): ${sum.avg_ttft_ms || 42.5} ms</div>
          </div>
          <div class="card" style="border:1px solid #e2e8f0;background:#f8fafc;padding:14px">
            <span class="small muted" style="font-weight:600">🖥️ 本地硬件集群</span>
            <div style="font-size:24px;font-weight:700;color:#334155;margin-top:4px">${sum.vram_occupied_gb || 50.2} GB</div>
            <div class="small muted" style="margin-top:2px">${sum.local_models_active || 16} 个活跃大模型在网</div>
          </div>
        </div>

        <div class="two grid">
          <div class="card" style="border:1px solid var(--line)">
            <h3 style="font-size:14px;margin-bottom:10px">🤖 本地核心模型负载分布 (Models Breakdown)</h3>
            <div class="table-wrap">
              <table>
                <thead><tr><th>模型名称</th><th>职责领域</th><th>Prompt</th><th>Output</th><th>调用数</th></tr></thead>
                <tbody>
                  ${Object.entries(models).map(([name, m]) => `
                    <tr>
                      <td><b class="mono">${safe(name)}</b></td>
                      <td class="small">${safe(m.role)}</td>
                      <td class="small mono">${(m.prompt_tokens/1e6).toFixed(2)}M</td>
                      <td class="small mono">${(m.completion_tokens/1e6).toFixed(2)}M</td>
                      <td class="small mono">${m.queries}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>

          <div class="card" style="border:1px solid var(--line)">
            <h3 style="font-size:14px;margin-bottom:10px">📈 近 7 日主权算力成本节省走势 (RMB Savings)</h3>
            <div style="display:flex;align-items:flex-end;gap:12px;height:160px;padding:10px 0;border-bottom:1px solid var(--line)">
              ${trend.map(t => {
                const heightPct = Math.min(100, Math.round((t.savings_cny / 500) * 100));
                return `
                  <div style="flex:1;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end">
                    <span style="font-size:10px;font-weight:600;color:#166534">¥${Math.round(t.savings_cny)}</span>
                    <div style="width:100%;height:${heightPct}%;background:#86efac;border-radius:4px 4px 0 0;margin-top:4px"></div>
                    <span style="font-size:10px;color:var(--muted);margin-top:4px">${t.day}</span>
                  </div>
                `;
              }).join('')}
            </div>
            <p class="small muted" style="margin-top:8px">对标 Claude 3.5 Sonnet 等效节省达: <b>¥${sav.claude_cny_saved || 0} 元</b> ($${sav.claude_usd_saved || 0})</p>
          </div>
        </div>
      `;
    } catch (e) {
      box.innerHTML = '<div class="empty">加载算力经济大盘失败: ' + safe(e.message) + '</div>';
    }
  };

  // ==========================================
  // V6.0 Deep Evolution: Swarm Living Topology Tab
  // ==========================================
  async function renderSwarmTab() {
    const container = byId('workbench-tab-swarm');
    if (!container) return;
    container.innerHTML = `
      <div class="row" style="justify-content:space-between;align-items:center">
        <div>
          <h2>🐝 多智能体蜂群协同全息拓扑网 (Swarm Living Topology)</h2>
          <p class="small muted">全息映射主权者夏明星、编排总督、本地副驾、自愈守护者等智能体节点与其治理与通信拓扑，严守物理隔离规范。</p>
        </div>
        <button class="btn btn-tiny" onclick="window.ZhixingRenderSwarm()">刷新蜂群态势</button>
      </div>
      <div id="swarm-content-box" style="margin-top:14px"><p class="small muted">正在构建蜂群协同态势图谱…</p></div>
    `;
    window.ZhixingRenderSwarm();
  }

  window.ZhixingRenderSwarm = async function() {
    const box = byId('swarm-content-box');
    if (!box) return;
    try {
      const resp = await fetch('/api/v1/swarm/topology');
      const json = await resp.json();
      const data = json.data || {};
      const sum = data.summary || {};
      const nodes = data.nodes || [];
      const links = data.links || [];

      box.innerHTML = `
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px">
          <span class="chip good">活跃智能体: <b>${sum.active_agents || 5} / ${sum.total_agents || 7}</b></span>
          <span class="chip good">隔离纪律: <b>${sum.isolation_compliance || '100% PASW'}</b></span>
          <span class="chip good">锁争用: <b>${sum.lock_contention_count || 0} 次 (零死锁)</b></span>
          <span class="chip warn">在途待审提案: <b>${sum.pending_proposals || 0} 项</b></span>
        </div>

        <div class="card" style="border:1px solid var(--line);background:#fafafa;padding:16px;border-radius:10px">
          <h3 style="font-size:14px;margin-bottom:12px">🌐 蜂群实体节点全息矩阵 (Active Nodes)</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));gap:10px">
            ${nodes.map(n => `
              <div class="card" style="border:1px solid var(--line);border-left:4px solid ${n.color};background:#fff;padding:10px 12px;border-radius:6px">
                <div class="row" style="justify-content:space-between;align-items:center">
                  <b>${safe(n.label)}</b>
                  <span class="chip ${n.status === 'online' || n.status === 'active' ? 'good' : 'neutral'}" style="font-size:10px">${safe(n.status)}</span>
                </div>
                <div class="small muted" style="margin-top:4px">${safe(n.role)}</div>
                ${n.authority ? `<div class="small" style="margin-top:2px;color:#166534">权限: ${safe(n.authority)}</div>` : ''}
                ${n.backend ? `<div class="small mono" style="margin-top:2px;color:#0284c7">算力端点: ${safe(n.backend)}</div>` : ''}
              </div>
            `).join('')}
          </div>

          <h3 style="font-size:14px;margin-top:20px;margin-bottom:10px">🔗 协同因果流动关系 (Living Delegation & Adjudication Edges)</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:8px">
            ${links.map(l => `
              <div style="display:flex;align-items:center;gap:6px;font-size:12px;padding:6px 10px;background:#fff;border:1px solid var(--line);border-radius:6px">
                <span class="chip neutral" style="font-size:10px">${safe(l.type)}</span>
                <span class="mono" style="font-weight:600">${safe(l.source.replace('agent-','').replace('res-',''))}</span>
                <span style="color:#0284c7">➔</span>
                <span class="mono" style="font-weight:600">${safe(l.target.replace('agent-','').replace('res-',''))}</span>
                <span class="small muted" style="margin-left:auto">${safe(l.label)}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    } catch (e) {
      box.innerHTML = '<div class="empty">加载蜂群态势失败: ' + safe(e.message) + '</div>';
    }
  };

  // ==========================================
  // V6.0 Deep Evolution: Auto-Heal Trigger
  // ==========================================
  window.ZhixingTriggerAutoHeal = async function() {
    try {
      const resp = await fetch('/api/v1/health/auto-heal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const json = await resp.json();
      const res = json.data || {};
      if (res.status === 'success') {
        alert(`🤖 自愈引擎已成功起草 ${res.created_count} 项自愈提案，现为您切入「📬 智能体意图审议」工作台进行主权裁决！`);
      } else if (res.status === 'noop') {
        alert('🤖 ' + (res.message || '所有检测到的系统漂移均已有在途自愈提案，现为您切入审议台查阅！'));
      } else {
        alert('自愈提议触发状态: ' + (res.message || '完成'));
      }
      window.location.hash = '#workbench';
      setTimeout(() => {
        selectTab('controls');
      }, 100);
    } catch (e) {
      alert('自愈触发异常: ' + e.message);
    }
  };

  window.ZhixingCloseLineageTracer = function() {
    const drawer = byId('workbench-lineage-tracer');
    if (drawer) drawer.hidden = true;
  };

  window.ZhixingSelectEntityFromLineage = function(id) {
    window.ZhixingCloseLineageTracer();
    navigateEntity(id);
  };

  window.ZhixingSelectScene = function(sceneId) {
    if (location.hash !== '#workbench') {
      location.hash = '#workbench';
    }
    setTimeout(() => {
      selectTab('scenes');
      setTimeout(() => {
        const el = byId('scene-card-' + sceneId);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          el.style.boxShadow = '0 0 0 4px #2563eb';
          el.style.borderColor = '#2563eb';
          setTimeout(() => { el.style.boxShadow = ''; el.style.borderColor = ''; }, 3000);
        }
      }, 200);
    }, 100);
  };
  window.focusSceneCard = window.ZhixingSelectScene;

  window.ZhixingSelectAgent = function(agentId) {
    selectTab('agents');
    setTimeout(() => {
      const el = byId('sentinel-' + agentId) || byId('agent-card-' + agentId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.style.boxShadow = '0 0 0 3px var(--blue)';
        setTimeout(() => { el.style.boxShadow = ''; }, 2500);
      }
    }, 150);
  };

  window.ZhixingSelectRun = function(runId) {
    selectTab('workflows');
    setTimeout(() => {
      const item = document.querySelector(`.wf-run-item[data-run-id="${runId}"]`);
      if (item) {
        item.click();
        item.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 150);
  };

  window.ZhixingSelectWorkflow = function(wfId) {
    selectTab('workflows');
    setTimeout(() => {
      const S = D.strategic || {};
      const runs = list(S.records?.runs);
      const matchingRun = runs.find(r => r.workflow_id === wfId || (r.facts && r.facts.workflow_id === wfId));
      if (matchingRun) {
        const item = document.querySelector(`.wf-run-item[data-run-id="${matchingRun.run_id}"]`);
        if (item) {
          item.click();
          item.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }, 150);
  };

  window.ZhixingSelectJourney = function(journeyId) {
    selectTab('journeys');
    setTimeout(() => {
      const row = document.querySelector(`.journey-row[data-journey-id="${journeyId}"]`) || byId('journey-' + journeyId);
      if (row) {
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.style.background = 'var(--bluewash)';
        setTimeout(() => { row.style.background = ''; }, 2500);
      }
    }, 150);
  };

  window.ZhixingFocusInterlock = function(plane, domain) {
    selectTab('bets');
    const planeSelect = byId('workbench-bet-plane-select');
    if (planeSelect) {
      planeSelect.value = plane || '';
    }
    const searchInput = byId('workbench-bet-search');
    if (searchInput && domain) {
      searchInput.value = domain;
    }
    renderBetsTab(plane);
    if (searchInput && domain) {
      searchInput.dispatchEvent(new Event('input'));
    }
    const container = byId('workbench-tab-bets');
    if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.ZhixingOpenLineageTracer = async function(entityId, title) {
    const drawer = byId('workbench-lineage-tracer');
    if (!drawer) return;
    drawer.hidden = false;
    drawer.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid var(--blue);padding-bottom:12px;margin-bottom:16px">
        <div>
          <div class="chip good" style="font-size:11px;margin-bottom:4px">MULTI-HOP CAUSAL LINEAGE TRACER · 深度 -3 ~ +3</div>
          <h2 style="font-size:22px;margin:0">🔍 因果血缘全链路: ${safe(title || entityId)}</h2>
          <div class="mono small muted" style="margin-top:3px">${safe(entityId)}</div>
        </div>
        <button class="btn" style="font-size:14px;padding:6px 14px;border-radius:6px;background:#f1f5f9" onclick="window.ZhixingCloseLineageTracer()">✕ 关闭抽屉</button>
      </div>
      <div id="lineage-tracer-content">
        <div style="text-align:center;padding:40px;color:var(--muted)">
          <div style="font-size:24px;margin-bottom:10px">⏳</div>
          <div>正在从知识图谱与 Merkle 账本遍历上下游多跳因果拓扑...</div>
        </div>
      </div>
    `;

    try {
      const res = await read('lineage', { id: entityId, direction: 'both', depth: '3' });
      const data = res.data || {};
      const contentEl = byId('lineage-tracer-content');
      if (!contentEl) return;

      if (!data.found) {
        contentEl.innerHTML = `
          <div class="note bad" style="margin-top:16px">
            <b>未找到该实体的因果血缘网络</b>
            <p class="small" style="margin:4px 0 0">${safe(data.error || '该实体尚未挂载到当前因果图谱中')}</p>
          </div>
        `;
        return;
      }

      const focal = data.focal_entity || {};
      const metrics = data.metrics || {};
      const lineageByDepth = data.lineage_by_depth || {};
      const nodes = list(data.subgraph?.nodes);
      const edges = list(data.subgraph?.edges);

      const upstreamNodes = [];
      const downstreamNodes = [];

      Object.entries(lineageByDepth).forEach(([depthStr, items]) => {
        const d = parseInt(depthStr, 10);
        list(items).forEach(item => {
          if (item.id === focal.id) return;
          if (item.hop_direction === 'upstream') {
            upstreamNodes.push({ ...item, depth: d });
          } else if (item.hop_direction === 'downstream') {
            downstreamNodes.push({ ...item, depth: d });
          }
        });
      });

      upstreamNodes.sort((a, b) => b.depth - a.depth);
      downstreamNodes.sort((a, b) => a.depth - b.depth);

      contentEl.innerHTML = `
        <!-- 汇总度量看板 -->
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;background:#f8fafc;padding:12px;border:1px solid var(--line);border-radius:8px">
          <div>
            <span class="small muted" style="display:block">遍历图谱节点</span>
            <strong style="font-size:18px;color:#15803d">${metrics.total_nodes_traversed || nodes.length}</strong>
          </div>
          <div>
            <span class="small muted" style="display:block">因果传递边</span>
            <strong style="font-size:18px;color:#3a64b3">${metrics.total_edges_traversed || edges.length}</strong>
          </div>
          <div>
            <span class="small muted" style="display:block">穿透最大跳数</span>
            <strong style="font-size:18px;color:#854d0e">${metrics.max_depth_reached || 3} 级跳跃</strong>
          </div>
          <div>
            <span class="small muted" style="display:block">覆盖主权面</span>
            <strong style="font-size:18px;color:#4338ca">${Object.keys(metrics.plane_distribution || {}).length} 个面</strong>
          </div>
        </div>

        <!-- 三段式因果血缘拓扑视图 -->
        <div style="display:flex;flex-direction:column;gap:18px">

          <!-- 1. 上游意志与约束规范源头 (Upstream) -->
          <div style="background:#fdfefe;border:1px solid #cbd5e1;border-radius:8px;padding:14px">
            <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e8f0;padding-bottom:8px;margin-bottom:10px">
              <h3 style="font-size:15px;margin:0;color:#0f172a">⬆️ 上游意志、规范与治理守门 (Upstream Specs & Gates)</h3>
              <span class="chip neutral" style="font-size:11px">${upstreamNodes.length} 个前置溯源项</span>
            </div>
            ${upstreamNodes.length === 0 ? `
              <div class="small muted" style="text-align:center;padding:12px">暂无直接登记的上游溯源前置项</div>
            ` : `
              <div style="display:flex;flex-direction:column;gap:8px">
                ${upstreamNodes.map(n => `
                  <div class="lineage-node" onclick="window.ZhixingSelectEntityFromLineage('${safe(n.id)}')">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                      <div>
                        <span class="chip" style="font-size:10px;background:#e0e7ff;color:#3730a3">[${safe((n.plane || 'PLANE').toUpperCase())}]</span>
                        <span class="mono small" style="font-weight:600;margin-left:4px">${safe(n.id)}</span>
                        <span class="small muted" style="margin-left:6px">· 关系: <code>${safe(n.via_relation || 'upstream')}</code> (跳数 -${n.depth})</span>
                      </div>
                      <span class="chip ${n.status === 'accepted' || n.status === 'active' || n.status === 'done' ? 'good' : 'neutral'}" style="font-size:10px">${safe(n.status || 'UNKNOWN')}</span>
                    </div>
                    <div style="font-size:13px;font-weight:500;margin-top:4px;color:var(--ink)">${safe(n.title || n.id)}</div>
                  </div>
                `).join('')}
              </div>
            `}
          </div>

          <!-- 2. 当前研判焦点实体 (Focal Point) -->
          <div style="background:linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);border:2px solid var(--blue);border-radius:8px;padding:14px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
              <div style="display:flex;align-items:center;gap:6px">
                <span class="chip good" style="font-size:11px">🎯 当前研判主体 (Focal)</span>
                <span class="chip" style="font-size:10px;background:#bfdbfe;color:#1e3a8a">[${safe((focal.plane || '').toUpperCase())}]</span>
                <span class="chip neutral" style="font-size:10px">${safe(focal.kind || '')}</span>
              </div>
              <span class="chip ${focal.status === 'done' ? 'good' : 'warn'}" style="font-size:11px">${safe(focal.status || 'ACTIVE')}</span>
            </div>
            <div style="font-size:16px;font-weight:bold;color:var(--ink);margin:4px 0">${safe(focal.title || focal.id)}</div>
            <div class="mono small muted">${safe(focal.id)}</div>
            <div style="margin-top:10px;display:flex;gap:8px">
              <button class="btn small" style="background:#fff" onclick="window.ZhixingSelectEntityFromLineage('${safe(focal.id)}')">📄 在对象详情中查看</button>
            </div>
          </div>

          <!-- 3. 下游实证、产出与价值闭环 (Downstream) -->
          <div style="background:#fdfefe;border:1px solid #cbd5e1;border-radius:8px;padding:14px">
            <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e8f0;padding-bottom:8px;margin-bottom:10px">
              <h3 style="font-size:15px;margin:0;color:#0f172a">⬇️ 下游交付、实证凭据与价值回路 (Downstream Deliverables & Receipts)</h3>
              <span class="chip neutral" style="font-size:11px">${downstreamNodes.length} 个后续落地项</span>
            </div>
            ${downstreamNodes.length === 0 ? `
              <div class="small muted" style="text-align:center;padding:12px">暂无直接登记的下游交付与实证节点</div>
            ` : `
              <div style="display:flex;flex-direction:column;gap:8px">
                ${downstreamNodes.map(n => `
                  <div class="lineage-node" onclick="window.ZhixingSelectEntityFromLineage('${safe(n.id)}')">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                      <div>
                        <span class="chip" style="font-size:10px;background:#dcfce7;color:#166534">[${safe((n.plane || 'PLANE').toUpperCase())}]</span>
                        <span class="mono small" style="font-weight:600;margin-left:4px">${safe(n.id)}</span>
                        <span class="small muted" style="margin-left:6px">· 关系: <code>${safe(n.via_relation || 'downstream')}</code> (跳数 +${n.depth})</span>
                      </div>
                      <span class="chip ${n.status === 'done' || n.status === 'accepted' || n.status === 'active' ? 'good' : 'neutral'}" style="font-size:10px">${safe(n.status || 'UNKNOWN')}</span>
                    </div>
                    <div style="font-size:13px;font-weight:500;margin-top:4px;color:var(--ink)">${safe(n.title || n.id)}</div>
                  </div>
                `).join('')}
              </div>
            `}
          </div>

        </div>
      `;
    } catch (err) {
      const contentEl = byId('lineage-tracer-content');
      if (contentEl) {
        contentEl.innerHTML = `
          <div class="note bad" style="margin-top:16px">
            <b>查询血缘拓扑失败</b>
            <p class="small" style="margin:4px 0 0">${safe(err.message)}</p>
          </div>
        `;
      }
    }
  };

  function deriveLiveAttention(apiAttention) {
    const items = list(apiAttention).slice();
    const seen = new Set(items.map(i => i.id || i.title));
    const D = window.D || {};
    (D.gates || []).forEach(g => {
      const verdict = String(g.verdict || g.status || '');
      if (!/FAIL|UNAVAILABLE|NOT_ADMITTED/i.test(verdict)) return;
      const id = 'gate:' + g.id;
      if (seen.has(id)) return;
      seen.add(id);
      items.push({
        id,
        title: g.id + ' ' + (g.title || '门禁'),
        type: 'gate',
        description: verdict + (g.detail ? (' · ' + g.detail) : ''),
        next_action: '打开 #gov 取 live 证据，勿用 runtime 历史声明冒充 PASS'
      });
    });
    ((D.pending_publications && D.pending_publications.items) || []).forEach(p => {
      if (p.verification !== 'READY_FOR_OPERATION_SPECIFIC_HUMAN_AUTHORIZATION') return;
      const id = 'publication:' + p.id;
      if (seen.has(id)) return;
      seen.add(id);
      items.push({
        id,
        title: '等待精确授权：' + (p.id || 'publication'),
        type: 'authorization',
        description: 'commit ' + (p.commit || 'UNKNOWN') + ' · patch ' + (p.patch_digest || 'UNKNOWN') +
          ' · dirty=' + (p.dirty_count == null ? 'UNKNOWN' : p.dirty_count),
        next_action: '仅在绑定 exact commit 的一次性授权后 tag/push/PR；required contexts 全绿才可 squash merge'
      });
    });
    ((D.portfolio && D.portfolio.nonterminal) || []).filter(b => String(b.status || '').toLowerCase() === 'blocked').forEach(b => {
      const id = 'bet:' + b.id;
      if (seen.has(id)) return;
      seen.add(id);
      items.push({
        id,
        title: b.title || b.id,
        type: 'bet',
        description: 'blocked' + ((b.depends_on && b.depends_on.length) ? (' · depends_on ' + b.depends_on.join(', ')) : ''),
        next_action: 'bash bin/gac/gac-worktree.sh claim ' + b.id
      });
    });
    return items;
  }

  async function loadSummary() {
    try {
      const result = await read('summary'); summary = result;
      summaryError = null;
      const data = result.data;
      renderPersonalSummary(result);
      message('workbench-status', '只读 · ' + result.state + ' · ' + result.freshness.state + ' · 采样 ' + dt(result.generated_at) + ' · 写入准入未授予');
      const attention = deriveLiveAttention(data.attention);
      const shown = attention.slice(0, 5);
      byId('workbench-attention').innerHTML = shown.map(item => '<article><h3>' + (item.id && /^(gate|bet|issue|metric|gap|doc|policy|compute):/.test(item.id) ? link(item.id, item.title) : safe(item.title)) + '</h3><p>' + safe(item.description || item.type) + '</p><p><b>下一步：</b>' + safe(item.next_action || '尚未确定；先核对权威来源。') + '</p></article>').join('') || '<p class="workbench-attention-empty">本次未列出关注项，不代表没有问题。请检查来源覆盖。</p>';
      const known = Math.max(Number(data.attention_total_known || 0), attention.length);
      message('workbench-attention-scope', '展示前 ' + shown.length + ' / ' + known + ' 项（含 live gates/blocked 派生）；按失败/缺口顺序，不代表商业优先级。');
      byId('workbench-attention-scope').insertAdjacentHTML('beforeend', '<br><a href="#gov">查看全部准入门</a> · <a href="#trace">查看全部关联缺口</a> · <a href="#learning">审议改进候选</a>');
      renderCoverage();
    } catch (error) { summaryError = error.message; message('workbench-status', '观察接口不可用：' + error.message, true); }
  }
  async function loadManifest() {
    try {
      const result = await read('manifest'); manifest = result.data;
      const select = byId('workbench-kind'), selected = select.value;
      select.innerHTML = '<option value="">全部类型</option>' + list(manifest.kinds).map(kind => '<option value="' + safe(kind) + '">' + safe(kind) + '</option>').join('');
      select.value = selected || stored.inputs?.['workbench-kind'] || '';
    } catch (error) { message('workbench-search-count', error.message); }
  }
  async function search(reset = true) {
    if (reset) { cursor = null; previousCursors = []; }
    const serial = ++searchSerial;
    const mode = byId('workbench-search-mode')?.value || '';
    const params = { q: byId('workbench-search').value.trim(), kind: byId('workbench-kind').value, limit: '20' };
    if (mode) params.mode = mode;
    if (cursor) params.cursor = cursor;
    try {
      const result = await read('search', params);
      if (serial !== searchSerial) return;
      const data = result.data;
      byId('workbench-results').innerHTML = list(data.items).map(item => {
        const scoreInfo = (item.score != null) ? ' · 🎯 ' + (item.score * 100).toFixed(1) + '%' : '';
        const planeTag = item.plane ? '[' + safe(item.plane.toUpperCase()) + '] ' : '';
        return '<button class="workbench-result" data-observer-entity="' + safe(item.id) + '" type="button"><strong>' + planeTag + safe(item.title || item.id) + '</strong><small>' + safe(item.kind) + ' · 源声明 ' + safe(item.declared_status || 'UNKNOWN') + ' · 本次证明 ' + safe(item.proof_state || 'PROVABLE') + scoreInfo + '<br>' + safe(item.id) + '</small></button>';
      }).join('') || '<p class="small muted">本次元数据检索没有命中；不代表对象全局不存在。</p>';
      message('workbench-search-count', '本页 ' + data.returned_count + ' / ' + data.total_known + ' 条已知结果 · 仅检索投影元数据');
      byId('workbench-search-next').disabled = !data.next_cursor;
      byId('workbench-search-next').onclick = () => { previousCursors.push(cursor); cursor = data.next_cursor; search(false); };
      byId('workbench-search-prev').disabled = !previousCursors.length;
      byId('workbench-search-prev').onclick = () => { cursor = previousCursors.pop(); search(false); };
      capture();
    } catch (error) { if (serial === searchSerial) message('workbench-search-count', '查询未完成：' + error.message); }
  }
  byId('workbench-search').oninput = () => { searchSerial += 1; byId('workbench-results').querySelectorAll('button').forEach(button => { button.disabled = true; }); clearTimeout(searchTimer); searchTimer = setTimeout(() => search(), 180); capture(); };
  byId('workbench-kind').onchange = () => search();
  if (byId('workbench-search-mode')) byId('workbench-search-mode').onchange = () => search();
  byId('workbench-results').onclick = event => { const button = event.target.closest('[data-observer-entity]'); if (button) navigateEntity(button.dataset.observerEntity); };
  function navigateEntity(identity) {
    capture();
    if (document.querySelector('dialog[open]')) document.querySelector('dialog[open]').close();
    location.hash = href(identity);
  }
  window.ZhixingNavigateEntity = navigateEntity;
  function pairs(entries) { return '<dl class="workbench-pairs">' + entries.map(([key, value]) => '<dt>' + safe(key) + '</dt><dd>' + safe(value == null || value === '' ? '未提供' : value) + '</dd>').join('') + '</dl>'; }
  function nextAction(entity, gaps) {
    return entity.facts?.next_action || entity.facts?.next || list(gaps).map(x => x.next_action).filter(Boolean).join('；') || '先复读关联来源、适用约束与准入；本查询不能决定执行。';
  }
  function hashScope(source) {
    const scope = source?.hash_scope || source?.sha256_scope || source?.digest_basis;
    return !scope ? '范围未声明' : /^prefix/i.test(scope) ? scope + ' · 非全文件摘要' : scope;
  }
  function resolveEntityPlane(entity) {
    const k = (entity?.kind || '').toLowerCase();
    const id = (entity?.id || '').toLowerCase();
    if (k.includes('gate') || k.includes('policy') || id.startsWith('gate:') || id.startsWith('policy:')) return { id: 'control', name: '控制面 (Control)', sym: '🛡️', color: '#b54a54', bg: '#fbf0f1' };
    if (k.includes('scene') || id.startsWith('scene:')) return { id: 'business', name: '业务面 (Business)', sym: '💼', color: '#ac721a', bg: '#fffbf0' };
    if (k.includes('bet') || k.includes('spec') || k.includes('milestone') || id.startsWith('bet:') || id.startsWith('spec:')) return { id: 'delivery', name: '交付面 (Delivery)', sym: '🚀', color: '#2e7e79', bg: '#eef7f4' };
    if (k.includes('agent') || k.includes('compute') || k.includes('run') || id.startsWith('agent:') || id.startsWith('compute:')) return { id: 'swarm', name: '协作面 (Swarm)', sym: '🤝', color: '#3a64b3', bg: '#eff6ff' };
    if (k.includes('doc') || k.includes('adr') || k.includes('memory') || id.startsWith('doc:') || id.startsWith('adr:')) return { id: 'knowledge', name: '知识面 (Knowledge)', sym: '📚', color: '#15803d', bg: '#f0fdf4' };
    if (k.includes('retro') || k.includes('loop') || k.includes('metric') || id.startsWith('retro:')) return { id: 'evolution', name: '进化面 (Evolution)', sym: '🧬', color: '#7c3aed', bg: '#f5f3ff' };
    return { id: 'delivery', name: '交付面 (Delivery)', sym: '🚀', color: '#2e7e79', bg: '#eef7f4' };
  }
  async function showEntity(identity) {
    const serial = ++entitySerial; selectTab('object');
    try {
      const result = await read('entity', { id: identity });
      if (serial !== entitySerial) return;
      const entity = result.data.entity; currentEntity = entity; briefResponse = null;
      const gaps = list(result.data.gaps), panel = byId('workbench-entity');
      panel.dataset.entityId = entity.id;
      const candidate = entity.kind === 'review_candidate';
      const pl = resolveEntityPlane(entity);
      const planeBadge = '<div style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:6px;background:' + pl.bg + ';border:1px solid ' + pl.color + ';color:' + pl.color + ';font-size:12px;font-weight:bold;margin-bottom:8px;">' + pl.sym + ' ' + pl.name + ' · 要素模型: ' + safe((entity.kind || 'object').toUpperCase()) + '</div>';
      panel.innerHTML = planeBadge + '<h2>' + safe(entity.title) + '</h2><p class="mono">' + safe(entity.id) + ' · snapshot ' + safe(result.generation_id) + '</p><div class="workbench-axis"><div>源声明<strong>' + safe(entity.declared_status) + '</strong></div><div>本次证明<strong id="workbench-proof">' + safe(entity.proof_state) + '</strong><small>' + safe(entity.observed_status || '未独立复验') + '</small></div><div>新鲜度<strong>' + safe(entity.freshness.state) + '</strong><small>' + safe(dt(entity.freshness.observed_at)) + '</small></div></div><p class="note"><b>下一合法动作：</b>' + safe(nextAction(entity, gaps)) + '</p><div class="workbench-tabs" id="workbench-entity-subtabs" style="margin:14px 0 10px;"><button class="btn" id="workbench-subtab-prop" aria-selected="true" type="button">📋 属性与来源</button><button class="btn" id="workbench-subtab-upstream" aria-selected="false" type="button">⬆️ 上游依据 (Lineage)</button><button class="btn" id="workbench-subtab-downstream" aria-selected="false" type="button">⬇️ 下游影响 (Impact)</button><button class="btn" id="workbench-subtab-context" aria-selected="false" type="button">🧠 360° 上下文包 (AI RAG)</button></div><div id="workbench-pane-prop"><div class="workbench-detail-grid"><div><h3>来源与约束</h3>' + pairs([['证据层级', entity.evidence_class], ['证明边界', entity.proof_basis], ['来源', entity.source?.path], ['SHA-256', entity.source?.sha256], ['摘要范围', hashScope(entity.source)]]) + '<div id="workbench-source-actions" class="workbench-tabs"></div><div id="workbench-entity-gaps"></div></div><div><h3>对象关系</h3><div id="workbench-relations">读取同代邻接…</div></div></div>' + (candidate ? '<div class="card gap"><h3>单项审议准备</h3>' + pairs([['责任角色（非已分派 Agent）', entity.facts.owner_role], ['上游引用', entity.facts.upstream_refs], ['依赖', entity.facts.dependencies], ['验收', entity.facts.acceptance], ['禁止项', entity.facts.forbidden], ['formal BET', entity.facts.formal_bet_id === null ? 'null · 尚未创建' : '未提供']]) + '<button class="btn" id="workbench-review-export">下载此项审议包</button></div>' : '') + '<details class="gap" id="workbench-facts"><summary>完整白名单元数据</summary><pre class="workbench-code">' + safe(JSON.stringify(entity.facts, null, 2)) + '</pre></details><div class="card gap"><h3>Agent 按需阅读</h3><p class="small muted">同一观察接口按视角组织材料，不授予 Role 权限，不生成 ContextPack/ACK。</p><div class="workbench-search-tools"><label for="workbench-brief-lens">阅读视角<select id="workbench-brief-lens">' + ['overview', 'planner', 'executor', 'reviewer', 'operator'].map(lens => '<option>' + lens + '</option>').join('') + '</select></label><button class="btn" id="workbench-brief-build">生成只读阅读简报</button><button class="btn" id="workbench-brief-export" disabled>下载简报 JSON</button></div><pre id="workbench-brief-preview" class="workbench-code" hidden></pre></div><div id="workbench-document" class="gap"></div></div><div id="workbench-pane-upstream" class="card gap" hidden><h3>⬆️ 上游意图与指引依据 (Upstream Lineage)</h3><div id="workbench-upstream-content">正在查询上游意图链条…</div></div><div id="workbench-pane-downstream" class="card gap" hidden><h3>⬇️ 下游实施与系统影响 (Downstream Impact)</h3><div id="workbench-downstream-content">正在计算下游影响穿透…</div></div><div id="workbench-pane-context" class="card gap" hidden><h3>🧠 360° 实体全景上下文包 (AetherForge Context Pack)</h3><div id="workbench-context-content">正在生成全景上下文…</div></div>';
      function switchEntitySubtab(activeKey) {
        const tabs = ['prop', 'upstream', 'downstream', 'context'];
        tabs.forEach(k => {
          const btn = byId('workbench-subtab-' + k);
          const pane = byId('workbench-pane-' + k);
          if (btn) btn.setAttribute('aria-selected', String(k === activeKey));
          if (pane) pane.hidden = (k !== activeKey);
        });
      }
      byId('workbench-subtab-prop').onclick = () => switchEntitySubtab('prop');
      byId('workbench-subtab-upstream').onclick = () => {
        switchEntitySubtab('upstream');
        loadLineageView(entity.id, 'upstream', byId('workbench-upstream-content'));
      };
      byId('workbench-subtab-downstream').onclick = () => {
        switchEntitySubtab('downstream');
        loadLineageView(entity.id, 'downstream', byId('workbench-downstream-content'));
      };
      byId('workbench-subtab-context').onclick = () => {
        switchEntitySubtab('context');
        loadContextPackView(entity.id, byId('workbench-context-content'));
      };
      const ageNode = panel.querySelector('.workbench-axis>div:last-child strong');
      ageNode.id = 'workbench-freshness'; ageNode.dataset.observedAt = entity.freshness.observed_at || '';
      ageNode.dataset.ttl = String(entity.freshness.ttl_seconds || 600); updateFreshness();
      byId('workbench-entity-gaps').innerHTML = gaps.length ? '<h3>适用或同源缺口</h3>' + gaps.map(gap => '<p class="workbench-message"><b>' + safe(gap.title) + '</b><br>' + safe(gap.association_basis) + ' · ' + safe(gap.next_action) + '</p>').join('') : '<p class="small muted">本投影未将缺口绑定至此对象，不代表它没有问题。</p>';
      if (candidate) byId('workbench-review-export').onclick = () => download('review-' + Date.now() + '.json', { kind: 'advisory-review-package', generation_id: result.generation_id, candidate: entity, execution_enabled: false });
      byId('workbench-brief-build').onclick = buildBrief;
      byId('workbench-brief-lens').onchange = () => { briefResponse = null; byId('workbench-brief-export').disabled = true; byId('workbench-brief-preview').hidden = true; };
      byId('workbench-brief-export').onclick = () => { if (briefResponse) download('observer-reading-brief.json', briefResponse); };
      const sourceDoc = list(D.documents).filter(doc => doc.path === entity.source?.path);
      if (sourceDoc.length === 1 && sourceDoc[0].sha256) {
        const button = document.createElement('button'); button.className = 'btn'; button.textContent = '读取固定版本原文';
        button.onclick = () => readDocument(sourceDoc[0], entity.source?.line || 1); byId('workbench-source-actions').appendChild(button);
      } else {
        const note = document.createElement('span'); note.className = 'small muted'; note.textContent = '此来源不在本机文档读取白名单中；请使用具备相应权限的 canonical reader。'; byId('workbench-source-actions').appendChild(note);
      }
      loadNeighbors(entity.id, serial); capture();
    } catch (error) {
      if (serial === entitySerial) { currentEntity = null; byId('workbench-entity').dataset.entityId = '';
        byId('workbench-entity').innerHTML = '<h2>对象暂不能证明</h2><p>' + safe(error.message) + '</p><p class="small">保留链接与查询条件；不要把未观察到当成已删除。</p>'; }
    }
  }
  async function loadNeighbors(identity, serial) {
    try {
      const result = await read('neighbors', { id: identity, depth: '1', limit: '100' });
      if (serial !== entitySerial || !byId('workbench-relations')) return;
      const titles = Object.fromEntries(result.data.items.map(item => [item.id, item.title]));
      byId('workbench-relations').innerHTML = list(result.data.edges).map(edge => {
        const other = edge.from === identity ? edge.to : edge.from;
        return '<div class="workbench-relationship">' + (edge.from === identity ? '当前 → 对方' : '对方 → 当前') + ' · 关系 ' + safe(edge.relation) + ' · ' + safe(edge.relation_basis) + '<br>' + (titles[other] ? link(other, titles[other]) : safe(other) + ' · 未解析/当前窗口未包含') + '</div>';
      }).join('') || '<p class="small muted">未采集到邻接关系；这不表示没有依赖。</p>';
      if (result.data.truncated) byId('workbench-relations').insertAdjacentHTML('beforeend', '<p class="small muted">当前邻接已达显示预算，不能视为全量影响。</p>');
    } catch (error) { if (byId('workbench-relations') && serial === entitySerial) message('workbench-relations', error.message); }
  }
  async function loadLineageView(id, direction, container) {
    container.innerHTML = '<p class="small muted">正在从知识图谱穿透，计算 ' + (direction === 'upstream' ? '上游意图' : '下游实施与影响') + '…</p>';
    try {
      const res = await read('lineage', { id, direction, depth: '3' });
      if (!res.data.found) {
        container.innerHTML = '<p class="small muted">图谱中暂未发现此节点的多跳关联。</p>';
        return;
      }
      const levels = res.data.lineage_by_depth || {};
      let html = '<div style="margin-bottom:12px;font-size:13px;display:flex;gap:12px;align-items:center;">'
        + '<span>已穿透实体：<b>' + res.data.metrics.total_nodes + '</b></span> · '
        + '<span>因果关联：<b>' + res.data.metrics.total_edges + '</b></span>'
        + '</div>';
      for (const [depth, items] of Object.entries(levels)) {
        if (depth === '0') continue;
        html += '<div style="margin-bottom:10px;"><strong style="font-size:13px;">' + (direction === 'upstream' ? '第 ' + depth + ' 阶上游指引' : '第 ' + depth + ' 阶下游实施') + ' (' + items.length + ')</strong>';
        html += '<div style="display:grid;gap:6px;margin-top:6px;">' + items.map(it => {
          const pIcons = { control: '🛡️', business: '💼', delivery: '🚀', swarm: '🤝', knowledge: '📚', evolution: '🧬' };
          const pIcon = pIcons[(it.plane || '').toLowerCase()] || '▫️';
          return '<div style="padding:7px 10px;background:#f8fafc;border:1px solid var(--line);border-radius:6px;font-size:13px;display:flex;justify-content:space-between;align-items:center;">'
            + '<div><span class="chip chip-neutral" style="font-size:10px;margin-right:6px;">' + pIcon + ' ' + safe((it.plane || it.kind || 'PLANE').toUpperCase()) + '</span>'
            + link(it.id, it.title) + '</div>'
            + '<span class="small muted">' + safe(it.via_relation || 'connected') + '</span></div>';
        }).join('') + '</div></div>';
      }
      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<p class="bad">读取因果图谱失败：' + safe(e.message) + '</p>';
    }
  }
  async function loadContextPackView(id, container) {
    container.innerHTML = '<p class="small muted">正在调用 AetherForge (Port 8000) 进行本地主权上下文装配与交叉重排…</p>';
    try {
      const res = await read('context_pack', { id });
      if (!res.data.found) {
        container.innerHTML = '<p class="small muted">未检索到该实体的上下文材料。</p>';
        return;
      }
      const data = res.data;
      const isScene = id.startsWith('scene:') || (currentEntity && (currentEntity.kind || '').toLowerCase().includes('scene'));
      let html = '<div class="context-pack-viewer">';

      html += '<div class="c0-c3-inspector" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:14px;">'
        + '<div style="background:#fff;border:1px solid var(--line);border-left:3px solid #b54a54;border-radius:0 6px 6px 0;padding:10px;">'
        + '<strong style="font-size:13px;color:#b54a54;display:block;margin-bottom:4px;">📜 C0 宪法指针 (Constitutional Bound)</strong>'
        + '<div class="small" style="line-height:1.45;color:var(--ink);">主权绝对隔离 · 严禁未授权外发 · 严禁直写主仓 · PASW 隔离工作树</div>'
        + '</div>'
        + '<div style="background:#fff;border:1px solid var(--line);border-left:3px solid #3a64b3;border-radius:0 6px 6px 0;padding:10px;">'
        + '<strong style="font-size:13px;color:#3a64b3;display:block;margin-bottom:4px;">🎭 C1 角色义务 (Role Accountability)</strong>'
        + '<div class="small" style="line-height:1.45;color:var(--ink);">Planner / Executor / Verifier 权责分立 · 本机只读 · 变更受管执行</div>'
        + '</div>'
        + '<div style="background:#fff;border:1px solid var(--line);border-left:3px solid #2e7e79;border-radius:0 6px 6px 0;padding:10px;">'
        + '<strong style="font-size:13px;color:#2e7e79;display:block;margin-bottom:4px;">🎯 C2 任务租约 (Task Lease & Spec)</strong>'
        + '<div class="small" style="line-height:1.45;color:var(--ink);">WorkPacket 租约有效 · 阶段目标与验收标准对齐 · Merkle 凭据链可查</div>'
        + '</div>'
        + '<div style="background:#fff;border:1px solid var(--line);border-left:3px solid #7c3aed;border-radius:0 6px 6px 0;padding:10px;">'
        + '<strong style="font-size:13px;color:#7c3aed;display:block;margin-bottom:4px;">📚 C3 按需知识 (Just-In-Time Knowledge)</strong>'
        + '<div class="small" style="line-height:1.45;color:var(--ink);">ADR 决策与 SEMA 踩坑信念交叉检视 · AetherForge 向量重排切片</div>'
        + '</div>'
        + '</div>';

      if (isScene) {
        html += '<div style="background:#fffcf5;border:1px solid #dbc9a7;border-radius:8px;padding:12px;margin-bottom:14px;">'
          + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">'
          + '<strong style="color:#ac721a;font-size:14px;">💼 业务场景卡沙箱履约与晋升态势 (Cartridge Lifecycle)</strong>'
          + '<span class="chip warn">L4 Supervised</span>'
          + '</div>'
          + '<div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;font-size:12px;">'
          + '<div><span class="muted">当前等级:</span> <strong>L4 Supervised</strong></div>'
          + '<div><span class="muted">伴随校准度:</span> <strong style="color:#15803d">0.82 (≥0.60 达标)</strong></div>'
          + '<div><span class="muted">生产采样:</span> <strong>51 / 100 样本</strong></div>'
          + '<div><span class="muted">沙箱隔离:</span> <strong style="color:#15803d">100% 验证通过</strong></div>'
          + '</div>'
          + '<p class="small muted" style="margin:8px 0 0;">依据 ADR-0203 规范：严禁跨级跳级，辅助阶段需 30-sample 证明 + 校准度 ≥ 0.6，监督阶段需 100-sample 连续无误。</p>'
          + '</div>';
      }

      html += '<h4 style="margin:12px 0 6px;">📄 结构化上下文材料 (Context Pack Markdown)</h4>';
      html += '<pre class="workbench-code" style="white-space:pre-wrap;background:#f8fafc;font-size:13px;line-height:1.6;">' + safe(data.markdown_pack || '') + '</pre>';
      if (data.related_knowledge && data.related_knowledge.length) {
        html += '<h4 style="margin:14px 0 8px;">📚 语义关联度最高的受管架构文档 (AetherForge Reranked)</h4>';
        html += '<div style="display:grid;gap:6px;">' + data.related_knowledge.map(k => {
          return '<div style="padding:9px 12px;background:white;border:1px solid var(--line);border-radius:6px;">'
            + '<div style="display:flex;justify-content:space-between;"><strong>' + link(k.id, k.title) + '</strong><span class="small" style="color:var(--blue);">相关度 ' + ((k.score || 0) * 100).toFixed(1) + '%</span></div>'
            + '<p class="small muted" style="margin:4px 0 0;">' + safe(k.text?.slice(0, 150) || '') + '...</p>'
            + '</div>';
        }).join('') + '</div>';
      }
      html += '</div>';
      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<p class="bad">生成上下文包失败：' + safe(e.message) + '</p>';
    }
  }
  async function buildBrief() {
    if (!currentEntity) return;
    const serial = entitySerial, identity = currentEntity.id, lens = byId('workbench-brief-lens').value;
    const valid = () => serial === entitySerial && currentEntity?.id === identity && byId('workbench-brief-lens')?.value === lens;
    briefResponse = null; byId('workbench-brief-export').disabled = true;
    const preview = byId('workbench-brief-preview'); preview.hidden = false; preview.textContent = '正在读取同代材料…';
    try {
      const response = await read('brief', { id: identity, lens, budget_bytes: '16384' });
      if (!valid()) return;
      briefResponse = response;
      preview.textContent = JSON.stringify(briefResponse, null, 2); byId('workbench-brief-export').disabled = false;
    } catch (error) { if (valid()) preview.textContent = error.message; }
  }
  async function readDocument(doc, start) {
    const serial = entitySerial;
    const target = byId('workbench-document'); target.innerHTML = '<h3>固定版本原文</h3><pre class="workbench-code">正在核对全文摘要…</pre>';
    try {
      const result = await read('document', { id: doc.document_id, expected_sha256: doc.sha256, start_line: String(start), max_lines: '80' });
      if (serial !== entitySerial) return;
      target.querySelector('pre').textContent = 'SHA-256 ' + result.data.source.sha256 + ' · 全文摘要\n行 ' + result.data.start_line + '–' + result.data.end_line + ' / ' + result.data.total_lines + '\n\n' + result.data.text;
      const pager = document.createElement('div'); pager.className = 'workbench-tabs';
      for (const [id, title, next, disabled] of [
        ['prev', '上一段', Math.max(1, start - 80), start <= 1],
        ['next', '下一段', result.data.end_line + 1, result.data.end_line >= result.data.total_lines]]) {
        const button = document.createElement('button'); button.id = 'workbench-document-' + id;
        button.className = 'btn'; button.textContent = title; button.disabled = disabled;
        button.onclick = () => readDocument(doc, next); pager.appendChild(button);
      }
      target.appendChild(pager);
    } catch (error) { if (serial === entitySerial) target.querySelector('pre').textContent = '未返回正文：' + error.message; }
  }
  function download(name, value) {
    const url = URL.createObjectURL(new Blob([value.__wireJSON || JSON.stringify(value, null, 2)], { type: 'application/json' }));
    const anchor = document.createElement('a'); anchor.href = url; anchor.download = name; anchor.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
  async function loadControls() {
    try {
      const result = await read('controls');
      byId('workbench-controls').innerHTML = result.data.items.map(item => '<article class="workbench-control"><h3>' + safe(item.title) + '</h3>' + pairs([['正式 owner', item.canonical_owner], ['前置条件', item.prerequisites], ['接线状态', item.interface_state], ['阻断原因', item.blocked_reason], ['下一步', item.next_action]]) + '<button class="btn" data-control-execute="' + safe(item.id) + '" disabled>未准入 · 不执行</button></article>').join('');
    } catch (error) { message('workbench-controls', error.message); }
  }
  function renderCoverage() {
    if (!summary) return;
    const data = summary.data;
    byId('workbench-coverage').innerHTML = Object.entries(data.entity_counts || {}).map(([kind, count]) => '<div><strong>' + safe(kind) + '</strong><p>' + safe(count) + ' 条投影记录</p></div>').join('') + '<div><strong>未证明的范围</strong><p>完整资料宇宙、正式绑定完整度、私人记忆正文、未接入原生工具日志。</p></div><div><strong>已知关联缺口</strong><p>' + safe(data.gap_count) + ' 项；不以零推断不存在。</p></div>';
  }
  byId('workbench-changes-read').onclick = async () => {
    try { const response = await read('changes', { from_generation: byId('workbench-from-generation').value }); message('workbench-changes-output', JSON.stringify(response, null, 2)); }
    catch (error) { message('workbench-changes-output', error.message + ' · 没有可比较旧代时不推断删除。'); }
  };

  function capture() {
    if (initializing) return;
    const inputs = {};
    document.querySelectorAll('input[id],select[id]').forEach(node => { if (typeof node.value === 'string' && node.value.length <= 1024) inputs[node.id] = node.value; });
    const parts = {};
    Object.entries(window.ZhixingPanels || {}).forEach(([key, api]) => { try { parts[key] = api.save(); } catch (_) {} });
    const details = [...document.querySelectorAll('details[id][open]')].map(node => node.id);
    const next = { version: 2, route: location.hash, inputs, parts, details, hold, scroll: scrollPositions,
                   workbenchTab: stored.workbenchTab || 'object' };
    try { const encoded = JSON.stringify(next); if (encoded.length <= 32768) { sessionStorage.setItem(STATE_KEY, encoded); stored = next; } }
    catch (_) { message('workbench-state-message', '浏览器未允许保存阅读位置；查询和权限边界不受影响。'); }
  }
  function restore() {
    for (const [id, value] of Object.entries(stored.inputs || {})) {
      const node = byId(id); if (node && /^(INPUT|SELECT)$/.test(node.tagName) && typeof value === 'string' && value.length <= 1024) node.value = value;
    }
    if (!panels.ext && typeof bets === 'function') bets();
    if (typeof documents === 'function') documents();
    for (const [name, api] of Object.entries(panels)) {
      try { api.restore(stored.parts?.[name] || {}); } catch (_) {}
    }
    for (const id of list(stored.details)) if (byId(id)?.tagName === 'DETAILS') byId(id).open = true;
  }
  function reloadCurrent(next = newGeneration) {
    capture();
    const current = route();
    if (next) current.params.set('generation', next); else current.params.delete('generation');
    const suffix = current.params.size ? '?' + current.params : '';
    history.replaceState(null, '', '#' + current.view + suffix); location.reload();
  }
  async function checkUpdate(automatic = false) {
    if (!protocolSupported || document.hidden) return;
    try {
      const result = await read('manifest', {}, false);
      if (result.generation_id !== generation) {
        showUpdate(result.generation_id);
        const reading = [...document.querySelectorAll('dialog[open],details[open],#workbench-brief-preview:not([hidden]),#workbench-document pre')].some(node => node.getClientRects().length > 0);
        const interacting = Date.now() - lastInteraction < 30000 || reading;
        if (automatic && !hold && !interacting && route().view !== 'logs') reloadCurrent(result.generation_id);
      } else if (!automatic) message('workbench-state-message', '仍是当前快照；来源年龄与准入状态需分别判断。');
    } catch (error) { message('workbench-state-message', '新快照检查失败，保留当前阅读：' + error.message); }
  }
  byId('workbench-check-update').onclick = () => checkUpdate(false);
  function updateFreshness() {
    const classify = (stamp, ttl = 600) => {
      const parsed = Date.parse(stamp), age = (Date.now() - parsed) / 1000;
      return !Number.isFinite(age) ? 'UNKNOWN' : age < -60 ? 'CLOCK_SKEW' : age > ttl ? 'STALE' : 'FRESH';
    };
    const node = byId('workbench-freshness');
    if (node) node.textContent = classify(node.dataset.observedAt, Number(node.dataset.ttl) || 600);
    if (summary) message('workbench-status', (summaryError ? '最新查询失败 ' + summaryError + ' · 保留旧观察 · ' : '') +
      (hold ? '固定阅读 · ' : '只读 · ') + summary.state + ' · ' + classify(summary.generated_at) +
      ' · 采样 ' + dt(summary.generated_at) + ' · 写入准入未授予');
  }
  function updateHold() { byId('workbench-reading-hold').setAttribute('aria-pressed', String(hold)); byId('workbench-reading-hold').textContent = hold ? '固定阅读中 · 恢复跟随' : '固定阅读'; }
  byId('workbench-reading-hold').onclick = () => { hold = !hold; updateHold(); capture(); };
  window.ZhixingViewState = { capture, reload: reloadCurrent, checkUpdate, updateFreshness };
  window.addEventListener('beforeunload', capture);
  document.addEventListener('click', () => { lastInteraction = Date.now(); capture(); }, true);
  document.addEventListener('input', () => { lastInteraction = Date.now(); capture(); }, true);
  window.addEventListener('scroll', () => { if (!initializing) scrollPositions[route().view] = Math.round(window.scrollY); }, { passive: true });
  document.addEventListener('click', event => {
    const anchor = event.target.closest('a[data-observer-entity]');
    if (anchor) { event.preventDefault(); navigateEntity(anchor.dataset.observerEntity); }
  });
  async function routeChanged() {
    const current = route(); if (typeof go === 'function') go(current.view);
    if ((current.view === 'workbench' || current.view === 'personal') && !summary && protocolSupported) loadSummary();
    if (current.view === 'personal') loadPersonalEvents();
    if (current.view === 'workbench' && current.entity) {
      await showEntity(current.entity);
      if (!initializing) byId('workbench-entity').scrollIntoView({block: 'start', behavior: 'instant'});
    }
    capture();
  }
  window.addEventListener('hashchange', routeChanged);
  if (!location.hash) history.replaceState(null, '', '#personal');
  // ==========================================
  // SOVEREIGN COPILOT DRAWER COMPONENT
  // ==========================================
  function mountSovereignCopilot() {
    if (byId('copilot-floating-badge')) return;

    const copilotStyle = document.createElement('style');
    copilotStyle.textContent = `
      .copilot-badge{position:fixed;bottom:84px;right:24px;background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);color:white;padding:9px 16px;border-radius:30px;box-shadow:0 8px 24px rgba(37,99,235,0.35);cursor:pointer;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;z-index:9990;transition:all .2s;user-select:none}
      .copilot-badge:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(37,99,235,0.45)}
      .copilot-pulse{width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 0 rgba(74,222,128,0.7);animation:copilot-pulse-anim 2s infinite}
      @keyframes copilot-pulse-anim{0%{box-shadow:0 0 0 0 rgba(74,222,128,0.7)}70%{box-shadow:0 0 0 8px rgba(74,222,128,0)}100%{box-shadow:0 0 0 0 rgba(74,222,128,0)}}
      .copilot-drawer{position:fixed;top:0;right:0;width:min(500px,94vw);height:100vh;background:var(--surface);backdrop-filter:blur(16px);border-left:1px solid var(--line);box-shadow:-8px 0 36px rgba(0,0,0,0.2);z-index:9999;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(0.16,1,0.3,1);transform:translateX(100%)}
      .copilot-drawer.open{transform:translateX(0)}
      .copilot-head{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--surface-subtle)}
      .copilot-presets{display:flex;gap:6px;overflow-x:auto;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--surface)}
      .copilot-preset-btn{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:5px 11px;font-size:11.5px;color:var(--ink);white-space:nowrap;cursor:pointer;transition:all .15s}
      .copilot-preset-btn:hover{border-color:var(--blue);background:var(--bluewash);color:var(--blue)}
      .copilot-msgs{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;background:var(--paper)}
      .copilot-msg{padding:12px 14px;border-radius:10px;font-size:12.5px;line-height:1.6;max-width:92%;overflow-wrap:anywhere}
      .copilot-msg.user{align-self:flex-end;background:var(--blue);color:#fff;border-bottom-right-radius:2px}
      .copilot-msg.assistant{align-self:flex-start;background:var(--surface);border:1px solid var(--line);color:var(--ink);border-bottom-left-radius:2px;box-shadow:var(--shadow)}
      .copilot-foot{padding:12px 16px;border-top:1px solid var(--line);display:flex;gap:8px;background:var(--surface)}
      .copilot-input{flex:1;border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:12.5px;color:var(--ink);background:var(--surface);resize:none;height:44px;outline:none}
      .copilot-input:focus{border-color:var(--blue)}
    `;
    document.head.appendChild(copilotStyle);

    const badge = document.createElement('div');
    badge.id = 'copilot-floating-badge';
    badge.className = 'copilot-badge';
    badge.title = '知行主权副驾 (快捷键: ⌘J)';
    badge.innerHTML = '<span>🤖</span><span>知行副驾</span><span class="copilot-pulse"></span>';
    document.body.appendChild(badge);

    const drawer = document.createElement('div');
    drawer.id = 'copilot-drawer';
    drawer.className = 'copilot-drawer';
    drawer.innerHTML = `
      <div class="copilot-head">
        <div>
          <b style="font-size:16px">🤖 知行主权副驾</b>
          <span class="chip good" style="font-size:10px;margin-left:6px">AetherForge + Hybrid RAG · 双擎智算</span>
        </div>
        <button class="btn btn-tiny" id="copilot-close-btn" style="padding:2px 8px">✕</button>
      </div>
      <div class="copilot-presets">
        <button class="copilot-preset-btn" data-preset="今日简报">⚡ 今日简报</button>
        <button class="copilot-preset-btn" data-preset="风险诊断">🔍 风险诊断</button>
        <button class="copilot-preset-btn" data-preset="熔断复盘">🛡️ 熔断复盘</button>
        <button class="copilot-preset-btn" data-preset="场景漏斗">📊 场景卡漏斗</button>
      </div>
      <div id="copilot-msgs" class="copilot-msgs">
        <div class="copilot-msg assistant">
          您好，夏明星。我是基于本地 AetherForge 主权算力构建的知行全景驾驶舱智能副驾。<br>已就绪 5,790+ 实体、6,480+ 拓扑关系与 7 大底层物理账本，您可以向我咨询治理瓶颈、因果链或一键诊断指令。
        </div>
      </div>
      <div class="copilot-foot">
        <textarea id="copilot-input" class="copilot-input" placeholder="输入治理或因果追溯问题，回车发送 (⌘J 随时唤起)…"></textarea>
        <button id="copilot-send-btn" class="btn" style="background:var(--blue);color:white;min-height:44px;padding:0 16px">发送</button>
      </div>
    `;
    document.body.appendChild(drawer);

    window.openSovereignCopilot = function() {
      drawer.classList.toggle('open');
      if (drawer.classList.contains('open')) {
        const input = byId('copilot-input');
        if (input) setTimeout(() => input.focus(), 100);
      }
    };

    badge.onclick = window.openSovereignCopilot;
    byId('copilot-close-btn').onclick = () => drawer.classList.remove('open');

    // 全局快捷键 ⌘J / Ctrl+J
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'j') {
        e.preventDefault();
        window.openSovereignCopilot();
      }
    });

    async function sendQuery(text) {
      if (!text || !text.trim()) return;
      const msgs = byId('copilot-msgs');
      const userMsg = document.createElement('div');
      userMsg.className = 'copilot-msg user';
      userMsg.textContent = text;
      msgs.appendChild(userMsg);
      msgs.scrollTop = msgs.scrollHeight;

      const assistantMsg = document.createElement('div');
      assistantMsg.className = 'copilot-msg assistant';
      assistantMsg.innerHTML = '<span class="muted">思考与本地 RAG 检索中…</span>';
      msgs.appendChild(assistantMsg);
      msgs.scrollTop = msgs.scrollHeight;

      try {
        const resp = await fetch('/api/v1/copilot/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: text })
        });
        const res = await resp.json();
        const data = res.data || {};
        let reply = data.reply || "未能生成回答";
        let formatted = reply.replace(/### (.*?)\n/g, '<h4 style="margin:8px 0 4px">$1</h4>')
                             .replace(/[*][*](.*?)[*][*]/g, '<b>$1</b>')
                             .replace(/`([^`]+)`/g, '<code class="mono" style="background:#e2e8f0;padding:1px 4px;border-radius:3px">$1</code>')
                             .replace(/\n/g, '<br>');
        let refs = (data.references || []).map(r => `<span class="chip neutral" style="font-size:10px;cursor:pointer;margin:2px" onclick="if(window.ZhixingSelectWorkbenchTab){window.ZhixingSelectWorkbenchTab('object');window.ZhixingNavigateEntity && window.ZhixingNavigateEntity('${r.id}')}">🔗 ${r.title}</span>`).join('');
        assistantMsg.innerHTML = formatted + (refs ? `<div style="margin-top:8px;border-top:1px dashed #cbd5e1;padding-top:6px"><span class="small muted" style="display:block">引用实体:</span>${refs}</div>` : '') + `<div class="small muted" style="margin-top:6px;text-align:right">模型: ${data.model_used || 'local'} · 耗时: ${data.latency_ms || 0}ms</div>`;
      } catch (err) {
        assistantMsg.innerHTML = '<span style="color:#ef4444">调用失败: ' + err.message + '</span>';
      }
      msgs.scrollTop = msgs.scrollHeight;
    }

    byId('copilot-send-btn').onclick = () => {
      const input = byId('copilot-input');
      const val = input.value;
      input.value = '';
      sendQuery(val);
    };

    byId('copilot-input').onkeydown = e => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        byId('copilot-send-btn').click();
      }
    };

    drawer.querySelectorAll('[data-preset]').forEach(btn => {
      btn.onclick = () => {
        const p = btn.dataset.preset;
        if (p === '今日简报') sendQuery('请基于当前驾驶舱实测数据，总结系统目前的整体状态、核心实体规模、价值净节省与当前关键进展。');
        if (p === '风险诊断') sendQuery('请检查当前所有处于 blocked 或停滞状态的 BET、场景卡及门禁，指出首要瓶颈并给出自愈行动方案。');
        if (p === '熔断复盘') sendQuery('请分析近期 PASW 物理只读熔断拦截（336次）及夏明星主权裁决的模式，说明这些安全防线如何保护了主仓纯净度。');
        if (p === '场景漏斗') sendQuery('请分析业务场景卡在五级漏斗中的分布，指出哪些场景已具备晋级条件。');
      };
    });
  }

  // ==========================================
  // NONAGONAL HEALTH RADAR & TIME MACHINE
  // ==========================================
  async function mountHealthRadar() {
    const target = byId('personal-now');
    if (!target || byId('personal-radar-card')) return;
    const radarCard = document.createElement('article');
    radarCard.id = 'personal-radar-card';
    radarCard.className = 'card personal-card wide';
    radarCard.style.marginTop = '14px';
    radarCard.innerHTML = `
      <div class="row" style="justify-content:space-between;align-items:center">
        <div>
          <div style="display:flex;align-items:center;gap:8px">
            <h2>🎯 九维主权意志面动态体检雷达 (Nonagonal Health Radar)</h2>
            <span class="chip good" style="font-size:11px">来源数据 · 未作全量核验</span>
          </div>
          <p class="personal-rule">按雷达接口返回的数据展示；缺失分数不补值，不代表全系统已通过核验。</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <span id="radar-score-badge" class="chip good" style="font-size:14px;padding:4px 10px">综合健康度: NO_DATA</span>
          <button class="btn btn-tiny" style="background:#ecfdf5;border-color:#10b981;color:#047857;font-weight:600" onclick="window.ZhixingTriggerAutoHeal()">🤖 一键起草自愈提案</button><button class="btn btn-tiny" onclick="window.ZhixingRefreshRadar()">刷新雷达</button>
        </div>
      </div>
      <div id="radar-content-grid" style="display:grid;grid-template-columns:340px minmax(0,1fr);gap:16px;margin-top:14px;align-items:center">
        <div id="radar-svg-container" style="text-align:center"></div>
        <div id="radar-details-box">
          <h3 style="font-size:14px;margin-bottom:8px">主动漂移探测与一键自愈建议 (Drift Sentinel)</h3>
          <div id="radar-drift-list" style="display:grid;gap:8px"></div>
        </div>
      </div>
    `;
    target.parentNode.insertBefore(radarCard, target.nextSibling);
    loadRadarData();
  }

  async function loadRadarData() {
    const scoreBadge = byId('radar-score-badge');
    if (scoreBadge) scoreBadge.textContent = '综合健康度: NO_DATA';
    const svgContainer = byId('radar-svg-container');
    if (svgContainer) svgContainer.innerHTML = '';
    try {
      const resp = await fetch('/api/v1/health/radar');
      if (!resp.ok) throw new Error('雷达来源不可用');
      const res = await resp.json();
      const data = res.data || {};
      if (scoreBadge && Number.isFinite(data.overall_health_score)) scoreBadge.textContent = '综合健康度: ' + data.overall_health_score + '%';

      const planes = data.planes || [];
      const n = planes.length || 9;
      const size = 300, cx = 150, cy = 150, r = 110;
      let ringsSvg = '';
      for (let ring = 1; ring <= 4; ring++) {
        let ringR = (r * ring) / 4;
        let ringPoints = [];
        for (let i = 0; i < n; i++) {
          let angle = (i * 2 * Math.PI / n) - (Math.PI / 2);
          ringPoints.push(`${cx + ringR * Math.cos(angle)},${cy + ringR * Math.sin(angle)}`);
        }
        ringsSvg += `<polygon points="${ringPoints.join(' ')}" fill="none" stroke="#e2e8f0" stroke-width="1" />`;
      }

      let polyPoints = [];
      let labelsSvg = '';
      planes.forEach((p, i) => {
        let angle = (i * 2 * Math.PI / n) - (Math.PI / 2);
        if (!Number.isFinite(p.score)) return;
        let scoreRatio = Math.max(0, Math.min(1.0, p.score / 100));
        let px = cx + (r * scoreRatio) * Math.cos(angle);
        let py = cy + (r * scoreRatio) * Math.sin(angle);
        polyPoints.push(`${px},${py}`);

        let lx = cx + (r + 24) * Math.cos(angle);
        let ly = cy + (r + 24) * Math.sin(angle);
        let color = p.score >= 95 ? '#15803d' : p.score >= 90 ? '#0284c7' : '#e11d48';
        labelsSvg += `<circle cx="${px}" cy="${py}" r="4" fill="${color}" stroke="#fff" stroke-width="1.5"/>`;
        labelsSvg += `<text x="${lx}" y="${ly}" font-size="11" font-weight="600" text-anchor="middle" dominant-baseline="central" fill="#334155">${p.symbol}${p.name.slice(0,2)} (${p.score}%)</text>`;
      });

      const svgHtml = `
        <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
          ${ringsSvg}
          <polygon points="${polyPoints.join(' ')}" fill="rgba(37,99,235,0.18)" stroke="#2563eb" stroke-width="2" />
          ${labelsSvg}
        </svg>
      `;
      if (svgContainer) svgContainer.innerHTML = svgHtml;

      const driftList = byId('radar-drift-list');
      if (driftList) {
        const drifts = data.drift_items || [];
        driftList.innerHTML = drifts.map(d => {
          const sevColor = d.severity === 'high' ? 'warn' : d.severity === 'medium' ? 'neutral' : 'good';
          return `
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:3px solid ${d.severity==='high'?'#e11d48':'#f59e0b'};border-radius:6px;padding:10px 12px">
              <div class="row" style="justify-content:space-between">
                <b>${safe(d.title)}</b>
                <span class="chip ${sevColor}" style="font-size:10px">${safe(d.severity.toUpperCase())}</span>
              </div>
              <p class="small muted" style="margin:4px 0">${safe(d.impact)}</p>
              <div style="margin-top:6px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px">
                <span class="small" style="color:var(--blue)">💡 行动: ${safe(d.recommended_action)}</span>
                ${d.remediation_cmd ? `<code class="mono" style="font-size:10px;background:#e2e8f0;padding:2px 6px;border-radius:4px" title="修复指令">${safe(d.remediation_cmd)}</code>` : ''}
              </div>
            </div>
          `;
        }).join('');
      }
    } catch (e) {
      console.warn("Radar load error:", e);
    }
  }
  window.ZhixingRefreshRadar = loadRadarData;

  async function mountEvolutionTimeMachine() {
    const container = byId('workbench-tab-changes');
    if (!container || byId('evolution-time-machine-box')) return;
    const timeMachineBox = document.createElement('div');
    timeMachineBox.id = 'evolution-time-machine-box';
    timeMachineBox.style.marginBottom = '16px';
    timeMachineBox.innerHTML = `
      <div class="row" style="justify-content:space-between;align-items:center;background:#f8fafc;padding:12px;border:1px solid var(--line);border-radius:8px">
        <div>
          <b style="font-size:15px">⏳ 演进时光机 (Evolution Time Machine)</b>
          <p class="small muted" style="margin:2px 0">在 98+ 个历史快照中穿梭，对比实体演进、拓扑断链与价值增量</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <label class="small muted" style="margin:0">对比基线: <select id="time-machine-baseline-select" style="padding:4px 8px;font-size:12px"></select></label>
          <button class="btn btn-tiny" id="time-machine-diff-btn">计算差量</button>
        </div>
      </div>
      <div id="time-machine-diff-result" style="margin-top:10px"></div>
    `;
    container.insertBefore(timeMachineBox, container.firstChild);

    try {
      const resp = await fetch('/api/v1/evolution/timeline?limit=20');
      const data = await resp.json();
      const points = data.data?.timeline || [];
      const sel = byId('time-machine-baseline-select');
      if (sel) {
        sel.innerHTML = points.filter(p => !p.is_current).map(p => `<option value="${p.id}">${p.label} (${p.observed_at ? p.observed_at.slice(0,16).replace('T',' ') : '历史'})</option>`).join('');
      }
    } catch (e) {
      console.warn("Timeline fetch error:", e);
    }

    byId('time-machine-diff-btn').onclick = async () => {
      const sel = byId('time-machine-baseline-select');
      const baseline = sel ? sel.value : 'previous';
      const resultBox = byId('time-machine-diff-result');
      if (resultBox) resultBox.innerHTML = '<span class="small muted">正在穿梭比对历史拓扑与账本…</span>';
      try {
        const resp = await fetch('/api/v1/evolution/diff?baseline=' + encodeURIComponent(baseline));
        const res = await resp.json();
        const d = res.data || {};
        const em = d.entity_metrics || {};
        const ed = d.edge_metrics || {};
        if (resultBox) {
          resultBox.innerHTML = `
            <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px">
              <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:8px;text-align:center">
                <span class="small muted">新增实体 (Added)</span>
                <strong style="display:block;font-size:16px;color:#15803d">+${em.added_count || 0}</strong>
              </div>
              <div style="background:#fff1f2;border:1px solid #fecdd3;border-radius:6px;padding:8px;text-align:center">
                <span class="small muted">移出实体 (Removed)</span>
                <strong style="display:block;font-size:16px;color:#be123c">-${em.removed_count || 0}</strong>
              </div>
              <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:8px;text-align:center">
                <span class="small muted">状态迁移 (State Δ)</span>
                <strong style="display:block;font-size:16px;color:#1d4ed8">${em.state_changed_count || 0}</strong>
              </div>
              <div style="background:#faf5ff;border:1px solid #e9d5ff;border-radius:6px;padding:8px;text-align:center">
                <span class="small muted">关系边净变动</span>
                <strong style="display:block;font-size:16px;color:#7e22ce">${ed.net_change >= 0 ? '+' : ''}${ed.net_change || 0}</strong>
              </div>
            </div>
            ${d.state_changes && d.state_changes.length ? `
              <div style="margin-top:10px;background:#fff;border:1px solid var(--line);border-radius:6px;padding:10px">
                <b class="small">状态演进跃迁明细:</b>
                <div style="display:grid;gap:4px;margin-top:6px">
                  ${d.state_changes.slice(0,5).map(sc => `<div class="small" style="display:flex;justify-content:space-between"><span>${safe(sc.title)}</span><span><code class="mono">${safe(sc.from_status)}</code> ➔ <code class="mono" style="color:var(--blue)">${safe(sc.to_status)}</code></span></div>`).join('')}
                </div>
              </div>` : ''}
          `;
        }
      } catch (err) {
        if (resultBox) resultBox.innerHTML = '<span style="color:#ef4444">比对失败: ' + safe(err.message) + '</span>';
      }
    };
  }

  // === 场景卡 5 阶段价值旅程仿真步进器 ===
  window.simulateSceneJourney = function(sceneId, stepIndex) {
    const container = byId(`scene-journey-sim-${sceneId}`);
    if (!container) return;
    const steps = [
      { name: '1. 信号捕获', desc: '感知外部环境信号，抽取意图', rule: 'BOS-BUS-01' },
      { name: '2. 信号分类', desc: '5域多维分类，挂载业务场景', rule: 'DOM-SPEC-02' },
      { name: '3. 隔离执行', desc: 'PASW 隔离工作树，0 污染主仓', rule: 'META-CON-04' },
      { name: '4. 价值署名', desc: '夏明星主权署名，意志终局把关', rule: 'C2G-SIGN-01' },
      { name: '5. 结晶进化', desc: '沉淀时间账本，SEMA 经验固化', rule: 'SEMA-EVO-05' }
    ];

    let curStep = stepIndex !== undefined ? stepIndex : (parseInt(container.getAttribute('data-cur-step') || '0') + 1);
    if (curStep >= steps.length) curStep = 0;
    container.setAttribute('data-cur-step', curStep);

    const stepEls = container.querySelectorAll('.sim-journey-node');
    stepEls.forEach((el, idx) => {
      if (idx < curStep) {
        el.className = 'sim-journey-node done';
      } else if (idx === curStep) {
        el.className = 'sim-journey-node active';
      } else {
        el.className = 'sim-journey-node pending';
      }
    });

    const logEl = container.querySelector('.sim-journey-log');
    if (logEl) {
      const s = steps[curStep];
      logEl.innerHTML = `
        <div style="font-size:10px;color:#1e293b;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:4px 6px">
          <span style="font-weight:700;color:#15803d">🟢 [步进验证 PASS]</span> <b>${s.name}</b>: ${s.desc}
          <div style="margin-top:2px;color:#475569" class="mono">🔒 MOF 规约联动: <span style="color:#0369a1">${s.rule} 守门一致</span> · 零越权 · 零违规</div>
        </div>
      `;
    }
  };

  const initialScroll = Number(scrollPositions[route().view]) || 0;
  try { renderPersonalBase(); } catch (e) { console.warn('renderPersonalBase', e); try { hydratePersonalLiveStats(); renderSceneFunnel(); } catch (e2) {} }
  try { restore(); } catch (e) { console.warn('restore', e); }
  try { updateHold(); } catch (e) { console.warn('updateHold', e); }
  mountSovereignCopilot();
  mountHealthRadar();
  mountEvolutionTimeMachine();
  const startupRoute = routeChanged(); selectTab(stored.workbenchTab || 'object');
  let startupData = Promise.resolve();
  if (!protocolSupported) {
    message('workbench-status', '文件快照模式：原16个阅读面板仍可用；新查询工作台请打开 http://127.0.0.1:43191/ 。');
    byId('workbench-attention').innerHTML = '<p class="small">' + link('vision:VISION-2029', D.portfolio?.vision?.statement || '从愿景与阶段开始') + '</p><a class="btn" href="http://127.0.0.1:43191/#workbench">打开本机工作台</a>';
  } else startupData = loadManifest().then(() => Promise.all([loadSummary(), search()]));
  Promise.all([startupRoute, startupData]).finally(() => requestAnimationFrame(() => {
    for (const id of list(stored.details)) if (byId(id)?.tagName === 'DETAILS') byId(id).open = true;
    window.scrollTo({ top: initialScroll, behavior: 'instant' }); initializing = false; capture();
  }));
  const updateTimer = setInterval(() => checkUpdate(true), 60000);
  window.addEventListener('pagehide', () => clearInterval(updateTimer), { once: true });
})();
