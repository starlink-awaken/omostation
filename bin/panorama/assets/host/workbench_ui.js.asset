    .wf-container{display:grid;grid-template-columns:320px minmax(0,1fr);gap:14px}.wf-run-list{max-height:550px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;padding-right:4px}.wf-run-item{padding:10px;border:1px solid var(--line);border-radius:6px;background:#fff;cursor:pointer;text-align:left;transition:all .15s}.wf-run-item:hover,.wf-run-item.active{border-color:var(--blue);background:var(--bluewash)}.wf-dag-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:14px 0}.wf-step{background:#f8fafc;border:1px solid #cbd5e1;border-radius:6px;padding:8px;text-align:center;font-size:12px;position:relative}.wf-step.done{background:#f0fdf4;border-color:#86efac;color:#15803d}.wf-step.active{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8;font-weight:600}.wf-step.blocked{background:#fef2f2;border-color:#fca5a5;color:#b91c1c;font-weight:600}.wf-step.pending{background:#f8fafc;border-color:#e2e8f0;color:#94a3b8}.scene-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px;margin-top:12px}.scene-card-item{border:1px solid var(--line);border-radius:8px;padding:12px;background:#fff;display:flex;flex-direction:column;justify-content:space-between;transition:box-shadow .2s}.scene-card-item:hover{box-shadow:0 3px 10px rgba(0,0,0,.06)}.journey-row{padding:10px 12px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:180px 100px 1fr 120px;gap:12px;align-items:center;font-size:13px}.asset-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:12px}.cartridge-card{border:1px solid #bfdbfe;background:linear-gradient(135deg,#f0f7ff 0%,#fdfefe 100%);border-radius:8px;padding:14px}.sim-journey-pipeline{display:flex;align-items:center;justify-content:space-between;gap:4px;margin:8px 0}.sim-journey-node{flex:1;text-align:center;padding:4px 2px;border-radius:4px;font-size:10px;border:1px solid #cbd5e1;background:#f8fafc;color:#64748b;transition:all .2s}.sim-journey-node.done{background:#dcfce7;border-color:#86efac;color:#15803d;font-weight:600}.sim-journey-node.active{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8;font-weight:700;box-shadow:0 0 0 2px rgba(59,130,246,0.2)}.sim-journey-node.pending{background:#f8fafc;border-color:#e2e8f0;color:#94a3b8}
    .agent-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin-top:12px}.sentinel-card{background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;padding:12px;position:relative;transition:all .15s}.sentinel-card:hover{box-shadow:0 3px 10px rgba(0,0,0,.06)}.pulse-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:6px}.pulse-dot.good{background:#10b981;box-shadow:0 0 0 3px rgba(16,185,129,.2)}.pulse-dot.warn{background:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.2)}.pulse-dot.bad{background:#ef4444;box-shadow:0 0 0 3px rgba(239,68,68,.2)}.bet-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px;margin-top:12px}.bet-card{background:#fff;border:1px solid var(--line);border-radius:9px;padding:13px;border-left:4px solid var(--blue);transition:all .2s;display:flex;flex-direction:column;justify-content:space-between}.bet-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.07);border-color:#3a64b3}.bet-causal-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;padding:10px 12px;margin-top:10px;font-size:12px}.bet-constraint-tag{display:inline-block;padding:2px 7px;border-radius:4px;font-size:11px;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;margin:2px}
