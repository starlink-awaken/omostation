    @media(max-width:720px){aside{padding:8px 12px;position:relative;width:100%;height:auto}.brand{padding:0 4px 4px;display:block}.brand strong{font-size:21px;letter-spacing:2px}.brand small,.aside-foot{display:none}aside nav{display:flex!important;gap:8px;overflow:auto;padding-bottom:4px}.workbench-nav-group{display:flex;flex:0 0 auto;border-top:0;border-left:1px solid #cbd9e5;margin:0;padding-left:5px}.workbench-nav-title{writing-mode:vertical-rl;padding:3px;font-size:10px}.workbench-nav-group a{min-width:72px;width:auto;padding:8px;font-size:13px;min-height:44px}.workbench-nav-group .nav-symbol{display:none}main{margin:0;padding:10px 12px 30px}.topline{gap:7px;align-items:flex-start;flex-direction:column;margin-bottom:8px}.top-actions .chip{display:none}.top-actions .btn{font-size:12px;padding:5px 8px;min-height:34px}.workbench-head{align-items:flex-start;margin:8px 0}.workbench-head h1{font-size:24px}.workbench-head .btn{font-size:12px;padding:6px 8px}.workbench-mode{font-size:12px;line-height:1.5}.workbench-grid{gap:12px}.workbench-section .card{padding:14px}.workbench-axis{grid-template-columns:1fr}.workbench-controls,.workbench-coverage{grid-template-columns:1fr}.workbench-pairs{grid-template-columns:1fr;gap:2px}.workbench-pairs dd{margin-bottom:8px}.workbench-status-line{font-size:12px;line-height:1.5;padding:7px 9px}.workbench-search-tools label{min-width:110px}.workbench-tabs .btn{font-size:13px;min-height:44px}.workbench-result{min-height:44px}.workbench-head .btn{min-height:44px}.workbench-attention article{padding:9px 11px}.workbench-attention h3{font-size:14px}.workbench-code{font-size:12px}.personal-hero{padding:19px 16px}.personal-hero:after{display:none}.personal-hero h1{font-size:28px}.personal-route{grid-template-columns:1fr;gap:8px;border-top:0}.personal-route div{padding:8px 0 8px 18px;border-left:1px solid #a7bbc9}.personal-route div:before{top:13px;left:-5px}.personal-section .card{padding:14px}.personal-event{grid-template-columns:1fr;gap:2p