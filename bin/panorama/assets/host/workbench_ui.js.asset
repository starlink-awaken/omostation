/* Human working surface over the same bounded observer queries used by agents. */
(function () {
  'use strict';
  const byId = id => document.getElementById(id);
  const esc = (typeof window.esc === 'function') ? window.esc : (x => String(x ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])));
  const safe = value => esc(value == null ? '' : typeof value === 'object' ? JSON.stringify(value) : value);
  const list = value => Array.isArray(value) ? value : [];
  const chip = (typeof window.chip === 'function') ? window.chip : ((s,t='') => '<span class="chip '+t+'">'+esc(s)+'</span>');
  const dt = (typeof window.dt === 'function') ? window.dt : (x => x ? new Date(x).toLocaleString('zh-CN',{timeZone:'Asia/Shanghai',hour12:false}) : '未观测');
  const STATE_KEY = 'zhixing-view/v2';
  const protocolSupported = location.protocol === 'http:';
  // Main template binds window.D; this IIFE cannot see script-local const D.
  function pickDashData() {
    const candidates = [];
    if (typeof window.zxData === 'function') {
      try { candidates.push(window.zxData()); } catch (e) {}
    }
    candidates.push(window.__zxLiveData, window.D);
    try {
      const el = document.getElementById('snapshot');
      if (el && el.textContent) candidates.push(JSON.parse(el.textContent));
    } catch (e) {}
    for (const c of candidates) {
      if (c && typeof c === 'object' && (c.portfolio || c.gates || c.strategic)) return c;
    }
    return candidates.find(c => c && typeof c === 'object') || {};
  }
  const D = pickDashData();
  const generation = D.generation_id;
  const panels = window.ZhixingPanels || {};
  let stored = {};
