  let searchTimer, newGeneration = null, lastInteraction = Date.now();
  let summary = null, manifest = null, briefResponse = null, initializing = true, summaryError = null;
  const scrollPositions = stored.scroll && typeof stored.scroll === 'object' ? stored.scroll : {};

