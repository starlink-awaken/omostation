"""Environment evidence collector — reads execution environment data."""

from __future__ import annotations

import json
import os
import subprocess
from datetime import datetime, timezone
from pathlib import Path

from collectors.base import DataCollector
from collectors.registry import register

APP = Path(__file__).resolve().parent.parent
WORKSPACE = Path("/Users/xiamingxing/Workspace")

# launchd jobs run without a user PATH; the verifier path must be absolute.
_SCRIPT_ENV_ROOTS = ("OMOSTATION_STATE_ROOT", "PANORAMA_ROOT", "WORKSPACE")
_SUBPROCESS_PATH = "/Users/xiamingxing/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"


def _meta_doctor_script() -> str:
    for env in _SCRIPT_ENV_ROOTS:
        root = os.environ.get(env)
        if root:
            candidate = Path(root) / "bin/gac/meta-doctor.py"
            if candidate.is_file():
                return str(candidate)
    return str(WORKSPACE / "bin/gac/meta-doctor.py")


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


@register("environment_evidence", timeout=30)
class EnvironmentEvidenceCollector(DataCollector):

    name = "environment_evidence"

    def collect(self) -> dict:
        cache_path = APP / "execution-environment-sources.json"
        cached = None
        if cache_path.exists():
            try:
                cached = json.loads(cache_path.read_text(encoding="utf-8"))
            except Exception:
                pass

        try:
            env = {**os.environ, "PATH": _SUBPROCESS_PATH + ":" + os.environ.get("PATH", "")}
            proc = subprocess.run(
                ["python3", "-B", _meta_doctor_script(), "--refs-only"],
                capture_output=True, text=True, timeout=25, env=env,
            )
            ok = proc.returncode == 0
            try:
                live = json.loads(proc.stdout) if ok else {}
            except Exception:
                live = {}
        except Exception:
            ok = False
            live = {}

        return {
            "status": "OK" if ok else "FAIL",
            "live": live if isinstance(live, dict) else {},
            "cached": cached if isinstance(cached, dict) else {},
            "workspace_exists": WORKSPACE.exists(),
            "observed_at": _now(),
        }

    def validate(self, data: dict) -> bool:
        return data.get("status") in ("OK", "FAIL")
