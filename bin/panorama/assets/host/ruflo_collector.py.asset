"""Ruflo collector — reads Ruflo RF0 verification data."""

from __future__ import annotations

import subprocess
from datetime import datetime, timezone

from collectors._script_paths import resolve_script
from collectors.base import DataCollector
from collectors.registry import register


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


@register("ruflo", timeout=30)
class RufloCollector(DataCollector):

    name = "ruflo"

    def collect(self) -> dict:
        script = resolve_script(
            "bin/gac/ruflo-rf0-verify.py",
            "/Users/xiamingxing/Workspace/bin/gac/ruflo-rf0-verify.py",
        )
        try:
            proc = subprocess.run(
                ["python3", "-B", script, "--json"],
                capture_output=True, text=True, timeout=25,
            )
            ok = proc.returncode == 0
            output = proc.stdout.strip() if ok else proc.stderr.strip()
        except Exception as exc:
            return {"status": "UNAVAILABLE", "error": str(exc), "observed_at": _now()}

        return {
            "status": "OK" if ok else "FAIL",
            "verifier": script,
            "output": output[:1000],
            "observed_at": _now(),
        }

    def validate(self, data: dict) -> bool:
        return data.get("status") in ("OK", "FAIL", "UNAVAILABLE")
