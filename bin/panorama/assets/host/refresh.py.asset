#!/usr/bin/env python3
"""Read-only source collection and atomic publication for the local Zhixing view.
This collector has no task dispatch, database recovery, Git write, or approval API.
Invocation by the Codex heartbeat is the only scheduling mechanism.
"""
from __future__ import annotations
import argparse, concurrent.futures, copy, fcntl, hashlib, json, math, os, re
import sqlite3, subprocess, sys, tempfile, threading, time
import socket
from urllib.request import build_opener, ProxyHandler
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

