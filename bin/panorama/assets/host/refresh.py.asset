APP = Path("/Users/xiamingxing/.local/share/zhixing-dashboard")
PAGE = LIBRARY / "40-验收与运营/Agent体系全景总览-2026-09-08.html"
CURRENT = APP / "current.json"
SEED = LIBRARY / ".library/observations/2026-09-08-agent-os-dashboard-snapshot.json"
PYTHON = "/opt/homebrew/bin/python3"
GH = "/opt/homebrew/bin/gh"
MULTICA = "/Users/xiamingxing/.local/bin/multica"
ORCA = "/usr/local/bin/orca"
RUFLO_PACKAGE = Path("/opt/homebrew/lib/node_modules/ruflo/package.json")
REFERENCE_CELL_ALLOWED_ROOT = Path("/Users/xiamingxing/agents/codex-agent-os-reference-cell/attempts")
ENVIRONMENT_EVIDENCE_ALLOWED_ROOT = Path("/Users/xiamingxing/agents/codex-agent-os-recovery/attempts")
