<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.omostation.zhixing-host-drift.plist — 织星宿主漂移 + 提交钉扎 每小时巡检

  用途: 织星宿主漂移 + 未推送提交钉扎巡检 (2026-09-19):
    原记为「crontab 写入在系统层已坏, 故改用 launchd」, 该依据 **2026-09-28 实测推翻**
    (惰性注释探针写入后 crontab 行数真实变化; 仅「原样回写 rc=0」不能证明写入发生,
    因回读内容本就一致)。改用 launchd 的理由是架构性的 —— registry.yaml 为调度 SSOT
    (ADR-A / ADR-0119 / ADR-0121), crontab 平面是遗留面不应新增条目。
    本机 dashboard 周期任务本就承载于 launchd
    (`com.omostation.zhixing-dashboard-refresh`), 沿用该机制。
    注: 本注释块不得含连续两个半角连字符 (XML 规范禁止, 该序列与本注释的
    起止定界符同形), 否则 plistlib 解析失败而 plutil/launchd 放过
    → 被 meta-doctor 静默跳过出 M2 引用校验 (T16-01 C2)。

  执行 (每小时 :23):
    1. workspace-wip-guard.py protect  — 把未合入 origin/main 的分支尖端钉到
       refs/wip/ (提交被并发会话切走后仍可恢复; 2026-09-18 实证 e4787d290)
    2. zhixing-host-sync.py check      — 织星宿主文件 (template.html/refresh.py)
       与仓库副本的漂移检测 (2026-09-17 实证: 面板被覆盖后"所有备份均无该代码")

  安装:
    cp bin/ops/launchd/com.omostation.zhixing-host-drift.plist \
       ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) \
       ~/Library/LaunchAgents/com.omostation.zhixing-host-drift.plist
  卸载:
    launchctl bootout gui/$(id -u)/com.omostation.zhixing-host-drift
  手动触发验证:
    launchctl kickstart -p gui/$(id -u)/com.omostation.zhixing-host-drift
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omostation.zhixing-host-drift</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/xiamingxing/Workspace &amp;&amp; python3 bin/gac/workspace-wip-guard.py protect &amp;&amp; python3 bin/gac/zhixing-host-sync.py check</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/xiamingxing/Workspace</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>23</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/zhixing-host-drift.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/zhixing-host-drift.log</string>
</dict>
</plist>
