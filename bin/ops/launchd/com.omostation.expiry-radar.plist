<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.omostation.expiry-radar.plist — SLA 越界前瞻日报

  用途 (2026-09-21): 把"过期"从**事故**变成**计划内工作**。
    当天实证两颗时间炸弹同时引爆: X2-C05 (≤14d) 的 omo-governance-surfaces.yaml
    与 doc-governance (≤90d) 的 26 个文档 —— 昨天 CI 全绿, 今天纯因日期滚动
    而**所有 PR** 变红。根因是判定器纯二元 (`age > review_days`), 无前瞻、
    无 grace 档; 而文档按批次复审, 于是必然按批次**集体**越界。

  执行 (每日 08:50, strict 档 → 有 imminent 即 exit 1, 在 job 状态可见):
    python3 bin/gac/check-expiry-radar.py (horizon=7, strict)

  为什么用 launchd 而非 crontab:
    原以为 crontab 写入在本机系统层已坏, 但 **2026-09-28 实测推翻** (探针写入后
    行数真实变化, 仅「原样回写 rc=0」不足为证)。当前改用 launchd 的理由是架构性的 ——
    registry.yaml 为调度 SSOT (ADR-A / ADR-0119 / ADR-0121), crontab 平面是遗留面。
    注: 本注释块不得含连续两个半角连字符 (XML 规范禁止, 该序列与本注释的
    起止定界符同形), 否则 plistlib 解析失败而 plutil/launchd 解析器更宽容会放过
    → 该 plist 被 meta-doctor 静默跳过出 M2 引用校验 (T16-01 shadow 的 C2 即按
    plistlib 检出本文件)。

  安装:
    cp bin/ops/launchd/com.omostation.expiry-radar.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) \
       ~/Library/LaunchAgents/com.omostation.expiry-radar.plist
  卸载:
    launchctl bootout gui/$(id -u)/com.omostation.expiry-radar
  手动触发:
    launchctl kickstart -p gui/$(id -u)/com.omostation.expiry-radar

  NOTE: exit 1 **不代表故障** —— 它代表"有文档即将/已经过期", 这正是本 job
  的目的 (让风险可见)。与 zhixing-host-drift 的 check 同语义。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omostation.expiry-radar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/xiamingxing/Workspace &amp;&amp; python3 bin/gac/check-expiry-radar.py --horizon 7 --strict</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/xiamingxing/Workspace</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/expiry-radar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/expiry-radar.log</string>
</dict>
</plist>
