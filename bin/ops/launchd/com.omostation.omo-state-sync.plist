<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.omostation.omo-state-sync.plist — 每小时同步运行时投影 (health/system/brief/governance-data)

  背景 (2026-10-19, meta-doctor M1 心跳巡检发现):
    `.omo/state/runtime/health.yaml` 停在 2026-10-14 14:11, 相对 72h SLA 已过
    120.5h → meta-doctor `stale_beats=1`, 连带织星驾驶舱 A2 (Resident 与宿主健康真值)
    与 A5 (引用与 launchd 完整性) 双双 FAIL。

  根因 (逐层验证, 非声明缺失):
    1. 声明面是**活的** —— `.omo/_truth/registry/runtime-projections.yaml` 把 health
       列为 active 投影, generator 记为 "omo state sync"。
    2. 缺的**只是排程** —— `omo state sync` 在 crontab 与 launchd 中**均无任何注册**。
       即 DECL_EXEC_GAP 的「声明 ✓ / 进程存活 ✓ / 落盘 ✗」第三形态,
       与 com.omostation.omo-health-refresh 注释记录的 system_health.yaml 同款。
    3. 手动跑一次 `omo state sync` 即把 health.yaml 归零 (stale_beats 1→0),
       证明写入器与声明都正常, 缺的确实只是调度。

  正确修法: 让生成器**持续跑**, 而非删声明或改 SLA。

  为何走 launchd 而非 crontab —— 架构性理由, 非能力性:
    registry.yaml 为调度 SSOT (ADR-A / ADR-0119 / ADR-0121), crontab 平面是遗留面,
    不应新增条目。见 .omo/cron/registry.yaml zhixing-host-drift 条目。

  环境说明: no_proxy 设为 loopback/github, 避免走 ClashX 127.0.0.1:7890 代理超时。

  安装 / 卸载 / 手动触发:
    cp bin/ops/launchd/com.omostation.omo-state-sync.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.omostation.omo-state-sync.plist
    launchctl bootout gui/$(id -u)/com.omostation.omo-state-sync
    launchctl kickstart -p gui/$(id -u)/com.omostation.omo-state-sync
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omostation.omo-state-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/Users/xiamingxing/Workspace/projects/omo/.venv/bin/omo state sync</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/xiamingxing/Workspace</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>no_proxy</key>
        <string>github.com,api.github.com,localhost,127.0.0.1</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>27</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/omo-state-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiamingxing/Workspace/runtime/cron/omo-state-sync.log</string>
</dict>
</plist>
