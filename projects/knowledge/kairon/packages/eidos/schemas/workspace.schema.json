{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.dev/schemas/workspace.schema.json",
  "title": "Workspace",
  "type": "object",
  "required": [
    "id", "type", "version", "title", "status", "owner",
    "created_at", "updated_at", "visibility", "workspace_kind",
    "member_ids", "policy_ref", "audit_trace"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^ws_"},
    "type": {"const": "Workspace"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "archived", "paused"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "visibility": {"type": "string", "enum": ["private", "team", "org"]},
    "workspace_kind": {"type": "string", "enum": ["team", "project", "domain"]},
    "member_ids": {"type": "array", "items": {"type": "string", "pattern": "^mbr_"}},
    "policy_ref": {"type": "string", "minLength": 1},
    "audit_trace": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
