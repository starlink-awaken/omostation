{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/router-decision.schema.draft.json",
  "title": "DBOS RouterDecision",
  "description": "Draft schema for machine-readable Agent Router backend selection and fallback evidence. Artifact draft for WP-2026-046; not yet canonical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "work_packet",
    "agent_id",
    "selected_backend",
    "fallback_chain",
    "selection_reason",
    "readiness_status",
    "mcp_profile_id",
    "permission_scope",
    "risk_level",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "router-decision.draft-2026-05-16"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8,14}.*$"
    },
    "work_packet": {
      "type": "string",
      "pattern": "^WP-[0-9]{4}-[0-9]{3}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "selected_backend": {
      "type": "string",
      "enum": [
        "acp",
        "mcp",
        "managed_cli",
        "local_model",
        "manual_bridge",
        "raw_cli_fallback"
      ]
    },
    "fallback_chain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "acp",
          "mcp",
          "managed_cli",
          "local_model",
          "manual_bridge",
          "raw_cli_fallback"
        ]
      }
    },
    "selection_reason": {
      "type": "string",
      "minLength": 12
    },
    "readiness_status": {
      "type": "string",
      "enum": [
        "ready",
        "ready_after_fix",
        "failed_readiness",
        "unavailable",
        "timed_out",
        "blocked",
        "rejected",
        "unknown"
      ]
    },
    "mcp_profile_id": {
      "description": "Null when no MCP tool profile is attached. Use a stable profile id when the route includes curated MCP tools.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "permission_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "backend_candidates": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend",
          "agent_id",
          "readiness_status",
          "decision"
        ],
        "properties": {
          "backend": {
            "type": "string",
            "enum": [
              "acp",
              "mcp",
              "managed_cli",
              "local_model",
              "manual_bridge",
              "raw_cli_fallback"
            ]
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "readiness_status": {
            "type": "string",
            "enum": [
              "ready",
              "ready_after_fix",
              "failed_readiness",
              "unavailable",
              "timed_out",
              "blocked",
              "rejected",
              "unknown"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "selected",
              "fallback",
              "rejected",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_paths": {
            "$ref": "#/$defs/evidence_paths"
          }
        }
      }
    },
    "evidence_paths": {
      "$ref": "#/$defs/evidence_paths"
    },
    "failure_conditions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "status",
          "fallback_to"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "failed_readiness",
              "timed_out",
              "blocked",
              "rejected"
            ]
          },
          "fallback_to": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "acp",
              "mcp",
              "managed_cli",
              "local_model",
              "manual_bridge",
              "raw_cli_fallback",
              null
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "evidence_paths": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
