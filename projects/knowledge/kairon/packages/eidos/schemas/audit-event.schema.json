{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "event_id",
    "occurred_at",
    "type",
    "actor",
    "action",
    "target",
    "risk_level",
    "summary",
    "work_packet",
    "policy_scope",
    "artifacts",
    "evidence",
    "correlation_id",
    "schema_version"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^audit-[0-9]{8}-[0-9]{3,}$|^evt-[0-9]{8}-[0-9]{3,}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": [
        "audit_event",
        "tool_called",
        "state_mutated",
        "external_write_requested",
        "external_write_completed",
        "approval_requested",
        "approval_recorded",
        "policy_evaluated",
        "permission_checked",
        "object_written",
        "object_updated",
        "event_correction"
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "actor_role": { "type": "string" },
    "action": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "summary": { "type": "string", "minLength": 1 },
    "work_packet": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string" },
    "policy_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "approval_receipt": { "type": ["string", "null"] },
    "before_state": { "type": ["object", "null"] },
    "after_state": { "type": ["object", "null"] },
    "artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1, "default": [] },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1, "default": [] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "parent_event_id": { "type": ["string", "null"] },
    "corrects_event_id": { "type": ["string", "null"] },
    "correction_reason": { "type": ["string", "null"] },
    "authorization": {
      "type": "object",
      "required": ["mode", "approved_by", "approval_required"],
      "properties": {
        "mode": { "type": "string", "enum": ["conductor", "policy", "human", "sandbox", "log_only"] },
        "approved_by": { "type": ["string", "null"] },
        "approval_required": { "type": "boolean" },
        "approval_receipt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "risk_level": { "enum": ["high", "critical"] } } },
      "then": {
        "required": ["approval_receipt", "authorization"],
        "properties": {
          "approval_receipt": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "event_correction" } } },
      "then": { "required": ["corrects_event_id", "correction_reason"] }
    }
  ],
  "additionalProperties": false
}
