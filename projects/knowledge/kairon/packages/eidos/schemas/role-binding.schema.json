{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.dev/schemas/role-binding.schema.json",
  "title": "RoleBinding",
  "type": "object",
  "required": [
    "id", "type", "version", "title", "status", "owner",
    "created_at", "updated_at", "workspace_id", "member_id",
    "role", "policy_ref", "audit_trace"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^rb_"},
    "type": {"const": "RoleBinding"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "revoked"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "workspace_id": {"type": "string", "pattern": "^ws_"},
    "member_id": {"type": "string", "pattern": "^mbr_"},
    "role": {"type": "string", "enum": ["owner", "operator", "reviewer", "observer"]},
    "policy_ref": {"type": "string", "minLength": 1},
    "audit_trace": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
