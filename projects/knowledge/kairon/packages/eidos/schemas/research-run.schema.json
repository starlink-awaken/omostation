{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/research-run.schema.json",
  "title": "ResearchRun",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "question", "scope", "source_policy", "source_refs", "evidence_refs", "output_format", "owner_role"],
  "properties": {
    "id": { "type": "string", "pattern": "^rsr_" },
    "type": { "const": "ResearchRun" },
    "status": { "enum": ["planned", "running", "synthesized", "reviewed", "completed", "failed"] },
    "question": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "source_policy": { "type": "array", "items": { "type": "string" } },
    "output_format": { "type": "string" },
    "owner_role": { "type": "string" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_item_ids": { "type": "array", "items": { "type": "string", "pattern": "^src_" } },
    "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^claim_" } },
    "evaluation_refs": { "type": "array", "items": { "type": "string" } },
    "report_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
