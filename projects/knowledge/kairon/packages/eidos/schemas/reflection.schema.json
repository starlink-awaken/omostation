{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/reflection.schema.json",
  "title": "Reflection",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "trigger_ref", "lesson", "impact_scope", "recommended_action", "action_items"],
  "properties": {
    "id": { "type": "string", "pattern": "^rfl_" },
    "type": { "const": "Reflection" },
    "status": { "enum": ["draft", "reviewed", "promoted", "archived"] },
    "trigger_ref": { "type": "string" },
    "lesson": { "type": "string", "minLength": 1 },
    "impact_scope": { "type": "string" },
    "recommended_action": { "type": "string" },
    "promotion_target": { "type": "string" },
    "promoted_by": { "type": "string" },
    "promoted_at": { "type": ["string", "null"], "format": "date-time" },
    "action_items": { "type": "array", "items": { "type": "string" } },
    "memory_refs": { "type": "array", "items": { "type": "string", "pattern": "^mem_" } },
    "failure_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
