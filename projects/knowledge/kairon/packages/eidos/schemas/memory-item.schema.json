{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/memory-item.schema.json",
  "title": "MemoryItem",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "content", "summary", "source_refs", "evidence_refs", "confidence", "memory_kind"],
  "properties": {
    "id": { "type": "string", "pattern": "^mem_" },
    "type": { "const": "MemoryItem" },
    "status": { "enum": ["candidate", "reviewed", "durable", "rejected", "deprecated", "archived"] },
    "content": { "type": "string", "minLength": 1 },
    "memory_kind": { "type": "string", "enum": ["fact", "decision", "pattern", "preference", "skill", "reflection", "project_context"] },
    "claim_refs": { "type": "array", "items": { "type": "string", "pattern": "^claim_" } },
    "review_refs": { "type": "array", "items": { "type": "string", "pattern": "^rev_" } },
    "promoted_from": { "type": "array", "items": { "type": "string" } },
    "promoted_from_refs": { "type": "array", "items": { "type": "string" } },
    "supersedes_refs": { "type": "array", "items": { "type": "string" } },
    "retire_reason": { "type": "string" }
  },
  "additionalProperties": true
}
