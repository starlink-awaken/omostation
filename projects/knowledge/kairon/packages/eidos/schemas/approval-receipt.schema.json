{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/approval-receipt.schema.json",
  "title": "ApprovalReceipt",
  "type": "object",
  "required": [
    "approval_id",
    "work_packet",
    "requested_by",
    "decision",
    "decider",
    "decided_at",
    "risk_level",
    "action",
    "impact",
    "rollback_plan",
    "audit_event"
  ],
  "properties": {
    "approval_id": { "type": "string" },
    "work_packet": { "type": "string" },
    "requested_by": { "type": "string" },
    "decision": { "type": "string", "enum": ["approved", "rejected", "expired", "revoked"] },
    "decider": { "type": "string" },
    "decided_at": { "type": "string", "format": "date-time" },
    "risk_level": { "type": "string", "enum": ["high", "critical"] },
    "action": { "type": "string" },
    "impact": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "rollback_plan": { "type": "string" },
    "audit_event": { "type": "string" }
  },
  "additionalProperties": true
}
