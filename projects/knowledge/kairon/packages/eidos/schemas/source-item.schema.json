{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/source-item.schema.json",
  "title": "SourceItem",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "source_uri", "source_kind", "ingest_method", "provenance", "confidence", "evidence_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^src_" },
    "type": { "const": "SourceItem" },
    "status": { "enum": ["captured", "triaged", "linked", "rejected", "archived"] },
    "uri": { "type": "string" },
    "source_uri": { "type": "string" },
    "source_kind": { "type": "string", "enum": ["file", "url", "note", "email", "chat", "repo", "manual", "other"] },
    "ingest_method": { "type": "string" },
    "content_hash": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["captured_at", "captured_by"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "captured_by": { "type": "string" },
        "original_title": { "type": "string" },
        "original_author": { "type": "string" }
      },
      "additionalProperties": true
    },
    "normalized_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
