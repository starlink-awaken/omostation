{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/approval-request.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "title",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "provenance",
    "visibility",
    "permission",
    "permission_scope",
    "write_authority",
    "audit_trace",
    "task_run_id",
    "work_packet",
    "requested_by",
    "risk_level",
    "action",
    "impact",
    "rollback_plan",
    "policy_ref"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^apr_" },
    "type": { "const": "ApprovalRequest" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "enum": ["requested", "approved", "rejected", "expired", "revoked"] },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": ["captured_from", "captured_at", "captured_by", "source_system", "import_method"],
      "properties": {
        "captured_from": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "captured_by": { "type": "string" },
        "source_system": { "type": "string" },
        "import_method": { "type": "string" }
      },
      "additionalProperties": true
    },
    "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
    "permission": {
      "type": "object",
      "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "external_write_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "permission_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "write_authority": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "task_run_id": { "type": "string", "pattern": "^task_" },
    "work_packet": { "type": "string", "pattern": "^WP-2026-" },
    "requested_by": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "string", "enum": ["high", "critical"] },
    "action": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "rollback_plan": { "type": "string", "minLength": 1 },
    "policy_ref": { "type": "string", "minLength": 1 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "approval_receipt_id": { "type": ["string", "null"], "pattern": "^aprv_" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "decision_note": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
