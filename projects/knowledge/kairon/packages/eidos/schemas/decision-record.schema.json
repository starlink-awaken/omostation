{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.dev/schemas/decision-record.schema.json",
  "title": "DecisionRecord",
  "type": "object",
  "required": [
    "id", "type", "version", "title", "status", "owner",
    "created_at", "updated_at", "workspace_id", "decision",
    "rationale", "evidence_refs", "policy_ref", "audit_trace"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^dr_"},
    "type": {"const": "DecisionRecord"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "status": {"type": "string", "enum": ["accepted", "rejected", "superseded"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "workspace_id": {"type": "string", "pattern": "^ws_"},
    "decision": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "policy_ref": {"type": "string", "minLength": 1},
    "audit_trace": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
