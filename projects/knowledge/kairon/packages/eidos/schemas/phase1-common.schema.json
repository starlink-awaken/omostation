{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/phase1-common.schema.json",
  "title": "Phase1Common",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "title",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "provenance",
    "visibility",
    "permission",
    "permission_scope",
    "write_authority",
    "audit_trace"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string" },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": ["captured_from", "captured_at", "captured_by", "source_system", "import_method"],
      "properties": {
        "captured_from": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "captured_by": { "type": "string" },
        "source_system": { "type": "string" },
        "import_method": { "type": "string" },
        "lineage_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "source_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "policy_scope": { "type": "array", "items": { "type": "string" }, "default": [] },
    "permission_scope": { "type": "array", "items": { "type": "string" } },
    "write_authority": { "type": "array", "items": { "type": "string" } },
    "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
    "retention_policy": { "type": "string" },
    "permission": {
      "type": "object",
      "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "external_write_allowed": { "type": "boolean" },
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "share": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "commonFields": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "title",
        "status",
        "owner",
        "created_at",
        "updated_at",
        "provenance",
        "visibility",
        "permission",
        "permission_scope",
        "write_authority",
        "audit_trace"
      ],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "provenance": {
          "type": "object",
          "required": ["captured_from", "captured_at", "captured_by", "source_system", "import_method"],
          "properties": {
            "captured_from": { "type": "string" },
            "captured_at": { "type": "string", "format": "date-time" },
            "captured_by": { "type": "string" },
            "source_system": { "type": "string" },
            "import_method": { "type": "string" },
            "lineage_refs": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "source_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "policy_scope": { "type": "array", "items": { "type": "string" }, "default": [] },
        "permission_scope": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "retention_policy": { "type": "string" },
        "permission": {
          "type": "object",
          "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
          "properties": {
            "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
            "read_roles": { "type": "array", "items": { "type": "string" } },
            "write_roles": { "type": "array", "items": { "type": "string" } },
            "write_authority": { "type": "array", "items": { "type": "string" } },
            "approval_required": { "type": "boolean" },
            "external_write_allowed": { "type": "boolean" },
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } },
            "share": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
