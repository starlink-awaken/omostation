{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/step-run.schema.json",
  "title": "StepRun",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "title",
    "status",
    "owner",
    "created_at",
    "updated_at",
    "visibility",
    "permission",
    "permission_scope",
    "write_authority",
    "audit_trace",
    "workflow_run_id",
    "step_id",
    "sequence",
    "depends_on_step_ids",
    "tool_call_refs",
    "input_refs",
    "output_refs",
    "acceptance_criteria",
    "risk_level"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^step_" },
    "type": { "const": "StepRun" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string", "enum": ["queued", "running", "checkpointed", "review", "completed", "blocked", "failed", "skipped", "rejected"] },
    "owner": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
    "permission": {
      "type": "object",
      "required": ["visibility", "read_roles", "write_roles", "write_authority", "approval_required", "external_write_allowed"],
      "properties": {
        "visibility": { "type": "string", "enum": ["private", "team", "org", "public"] },
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } },
        "write_authority": { "type": "array", "items": { "type": "string" } },
        "approval_required": { "type": "boolean" },
        "external_write_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "permission_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "write_authority": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "audit_trace": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "workflow_run_id": { "type": "string", "pattern": "^wfr_" },
    "step_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "depends_on_step_ids": { "type": "array", "items": { "type": "string", "pattern": "^step_" } },
    "task_run_id": { "type": ["string", "null"], "pattern": "^task_" },
    "approval_request_id": { "type": ["string", "null"], "pattern": "^apr_" },
    "approval_receipt_id": { "type": ["string", "null"], "pattern": "^aprv_" },
    "tool_call_refs": { "type": "array", "items": { "type": "string", "pattern": "^tcall_" } },
    "checkpoint_ref": { "type": ["string", "null"] },
    "input_refs": { "type": "array", "items": { "type": "string" } },
    "output_refs": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "blocked_reason": { "type": ["string", "null"] },
    "failure_ref": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
