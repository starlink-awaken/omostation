{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/claim.schema.json",
  "title": "Claim",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "statement", "claim_type", "asserted_by", "asserted_at", "confidence", "evidence_refs", "source_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^claim_" },
    "type": { "const": "Claim" },
    "status": { "enum": ["draft", "supported", "contested", "accepted", "rejected", "deprecated"] },
    "statement": { "type": "string", "minLength": 1 },
    "claim_kind": { "type": "string", "enum": ["fact", "interpretation", "decision", "hypothesis", "pattern"] },
    "claim_type": { "type": "string", "enum": ["fact", "interpretation", "decision", "hypothesis", "pattern"] },
    "asserted_by": { "type": "string" },
    "asserted_at": { "type": "string", "format": "date-time" },
    "stance_status": { "type": "string", "enum": ["supporting", "contested", "mixed", "unknown"] },
    "counter_evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^evd_" } },
    "research_run_id": { "type": "string", "pattern": "^rsr_" },
    "research_run_ref": { "type": "string", "pattern": "^rsr_" }
  },
  "additionalProperties": true
}
