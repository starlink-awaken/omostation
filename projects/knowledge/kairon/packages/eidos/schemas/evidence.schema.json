{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalbrainos.local/schemas/evidence.schema.json",
  "title": "Evidence",
  "allOf": [{ "$ref": "phase1-common.schema.json#/$defs/commonFields" }],
  "required": ["id", "type", "source_refs", "source_ref", "evidence_kind", "locator", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^evd_" },
    "type": { "const": "Evidence" },
    "status": { "enum": ["captured", "verified", "disputed", "superseded", "rejected"] },
    "evidence_kind": { "type": "string", "enum": ["quote", "file", "dataset", "observation", "run_artifact", "external_reference"] },
    "locator": { "type": "string" },
    "excerpt": { "type": "string" },
    "quote_or_excerpt_ref": { "type": "string" },
    "content_hash": { "type": "string" },
    "stance": { "type": "string", "enum": ["supports", "contradicts", "context", "unknown"] },
    "source_ref": { "type": "string" },
    "source_item_id": { "type": "string", "pattern": "^src_" },
    "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^claim_" } }
  },
  "additionalProperties": true
}
