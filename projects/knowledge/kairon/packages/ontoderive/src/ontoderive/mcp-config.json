{
  "mcpServers": {
    "ontoderive": {
      "command": "python3",
      "args": ["-m", "ontoderive.mcp_server"],
      "description": "OntoDerive 推导引擎 — 事实驱动方案推导",
      "env": {"PYTHONPATH": "src"}
    },
    "ontoderive-toolforge": {
      "command": "python3",
      "args": ["-m", "ontoderive.toolforge.mcp_server"],
      "description": "ToolForge 思维工具匹配 (方法论/策略/模式/原则/理论/技能)",
      "env": {"PYTHONPATH": "src"}
    }
  }
}
