FROM python:3.13-slim

WORKDIR /app

RUN pip install uv

COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev 2>/dev/null || true

RUN uv pip install --system pytest pytest-timeout pytest-asyncio pytest-cov

COPY packages/ ./packages/
COPY tests/ ./tests/

RUN useradd -m kairon && chown -R kairon:kairon /app
USER kairon

CMD ["python3", "-m", "pytest", "packages/*/tests/", "-v", "--timeout=60", "-q"]
