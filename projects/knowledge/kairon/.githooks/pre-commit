#!/bin/bash
# Pre-commit CI gate: run ruff check + ruff format check + debt prevention on staged Python files.
# Supports: kairon (submodule), agora, cockpit, ecos, omo, metaos, runtime
set -euo pipefail

if [ "${SKIP_GATE:-}" = "true" ]; then
    echo "🔓 SKIP_GATE=true — 跳过 pre-commit 检查"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")
DEBT_WARNINGS=0

echo "🔍 Running pre-commit check: ruff + debt prevention ..."

# ── Debt Prevention Checks ──────────────────────────────────────────────────────

check_atomic_write() {
    local project_dir=$1
    local project_name=$2
    if [ ! -d "$project_dir" ]; then
        return
    fi
    cd "$project_dir"
    STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' 2>/dev/null | grep -v "__pycache__" | grep -v ".venv" || true)
    if [ -n "$STAGED_PY" ]; then
        # Check for non-atomic write patterns
        NON_ATOMIC=$(echo "$STAGED_PY" | xargs grep -l "write_text\|open.*['\"]w['\"]" 2>/dev/null | grep -v "test" | grep -v "conftest" || true)
        if [ -n "$NON_ATOMIC" ]; then
            for f in $NON_ATOMIC; do
                # Skip if already using atomic_write
                if grep -q "atomic_write" "$f" 2>/dev/null; then
                    continue
                fi
                # Skip one-time scaffolding (cli.py template generation)
                if grep -q "scaffold\|template\|create.*plugin" "$f" 2>/dev/null; then
                    continue
                fi
                echo "   ⚠️  [$project_name] Potential non-atomic write: $f"
                echo "      Consider using atomic_write_json/atomic_write_text from kairon_utils"
                DEBT_WARNINGS=$((DEBT_WARNINGS + 1))
            done
        fi
    fi
    cd "$REPO_ROOT"
}

check_test_coverage() {
    local project_dir=$1
    local project_name=$2
    if [ ! -d "$project_dir/packages" ]; then
        return
    fi
    cd "$project_dir"
    # Check if new packages are added without tests
    NEW_DIRS=$(git diff --cached --name-only --diff-filter=A -- 'packages/*/pyproject.toml' 2>/dev/null || true)
    if [ -n "$NEW_DIRS" ]; then
        for toml in $NEW_DIRS; do
            pkg_dir=$(dirname "$toml")
            if [ ! -d "$pkg_dir/tests" ]; then
                echo "   ⚠️  [$project_name] New package without tests: $pkg_dir"
                echo "      Add at least basic test coverage"
                DEBT_WARNINGS=$((DEBT_WARNINGS + 1))
            fi
        done
    fi
    cd "$REPO_ROOT"
}

# ── Ruff Check ──────────────────────────────────────────────────────────────────

check_project() {
    local project_dir=$1
    local project_name=$2
    if [ ! -d "$project_dir" ]; then
        return
    fi
    cd "$project_dir"
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' 2>/dev/null | grep -v "packages/_archived/" || true)
    if [ -n "$STAGED_FILES" ]; then
        echo "   [$project_name] Checking: $(echo "$STAGED_FILES" | tr '\n' ' ')"
        if command -v ruff &>/dev/null; then
            ruff check $STAGED_FILES 2>&1 || { echo "❌ ruff check failed for $project_name"; exit 1; }
            ruff format --check $STAGED_FILES 2>&1 || { echo "❌ ruff format check failed for $project_name"; exit 1; }
        fi
    fi
    cd "$REPO_ROOT"
}

# ── Main ────────────────────────────────────────────────────────────────────────

case "$REPO_NAME" in
    kairon)
        check_project "$REPO_ROOT" "kairon"
        check_atomic_write "$REPO_ROOT" "kairon"
        check_test_coverage "$REPO_ROOT" "kairon"
        ;;
    agora)
        check_project "$REPO_ROOT" "agora"
        check_atomic_write "$REPO_ROOT" "agora"
        ;;
    cockpit)
        check_project "$REPO_ROOT" "cockpit"
        ;;
    ecos)
        check_project "$REPO_ROOT" "ecos"
        ;;
    omo)
        check_project "$REPO_ROOT" "omo"
        ;;
    metaos)
        check_project "$REPO_ROOT" "metaos"
        check_atomic_write "$REPO_ROOT" "metaos"
        ;;
    runtime)
        check_project "$REPO_ROOT" "runtime"
        ;;
    Workspace|omostation)
        for proj in projects/agora projects/cockpit projects/ecos projects/omo projects/metaos projects/runtime; do
            if [ -d "$proj" ]; then
                check_project "$REPO_ROOT/$proj" "$(basename $proj)"
                check_atomic_write "$REPO_ROOT/$proj" "$(basename $proj)"
            fi
        done
        if [ -d "projects/kairon" ]; then
            check_project "$REPO_ROOT/projects/kairon" "kairon"
            check_atomic_write "$REPO_ROOT/projects/kairon" "kairon"
            check_test_coverage "$REPO_ROOT/projects/kairon" "kairon"
        fi
        ;;
    *)
        echo "✅ Unknown project ($REPO_NAME); skipping checks"
        ;;
esac

# ── Debt Warning Summary ────────────────────────────────────────────────────────

if [ "$DEBT_WARNINGS" -gt 0 ]; then
    echo ""
    echo "⚠️  Debt prevention warnings: $DEBT_WARNINGS"
    echo "   These are advisory — commit will proceed."
    echo "   Fix before merging to avoid technical debt accumulation."
fi

echo "✅ Pre-commit check complete"
