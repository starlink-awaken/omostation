#!/bin/bash
# Pre-push gate: lint + diff-aware test smoke
# Supports: kairon
set -eo pipefail

if [ "${SKIP_GATE:-}" = "true" ]; then
    echo "🔓 SKIP_GATE=true — 跳过 pre-push 检查"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")
cd "$REPO_ROOT"

echo "🔍 Pre-push: $REPO_NAME (lint + smoke test)"

# ── ruff lint ────────────────────────────────────────────
if command -v ruff &>/dev/null; then
    ruff check packages/ src/ 2>/dev/null || { echo "❌ ruff check failed"; exit 1; }
    ruff format --check packages/ src/ 2>/dev/null || { echo "❌ format check failed"; exit 1; }
fi

# ── diff-aware smoke test ───────────────────────────────
# Only test packages changed since HEAD (fast)
CHANGED=$(git diff --name-only HEAD 2>/dev/null | grep "^packages/" || true | cut -d/ -f2 | sort -u | tr '\n' ' ')
if [ -n "$CHANGED" ]; then
    echo "  Changed packages: $CHANGED"
    # Quick smoke: try import for each changed package
    for pkg in $CHANGED; do
        if [ -f "packages/$pkg/tests" ] || [ -d "packages/$pkg/tests" ]; then
            echo "  Testing $pkg..."
            uv run pytest "packages/$pkg/tests" -q --tb=no -x 2>/dev/null || echo "  ⚠️  $pkg tests failed (non-blocking in dev)"
        fi
    done
fi

echo "✅ Pre-push check passed"
