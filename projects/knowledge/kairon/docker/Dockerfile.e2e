# kairon E2E Test Dockerfile
# Build: docker build -f docker/Dockerfile.e2e -t kairon-e2e .
#
# For local dev, docker-compose.e2e.yml mounts live code as volumes.
# For CI, bake code into the image (uncomment COPY steps in CI workflow).

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy the full workspace before syncing so uv can resolve package members.
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY tests/ ./tests/
RUN uv venv
RUN uv pip install -e packages/core-models -e packages/ontoderive pytest pytest-timeout pytest-asyncio pytest-cov

# Create non-root user
RUN useradd -m kairon && chown -R kairon:kairon /app
USER kairon

# Default command keeps the runner container idle; test commands are passed via docker compose run.
CMD ["sleep", "infinity"]
