#!/bin/bash
# Pre-commit hook
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")

echo "🔍 Pre-commit: $REPO_NAME"

# 检查是否有待提交的文件
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
if [ "$STAGED_FILES" -eq 0 ]; then
  echo "⚠️ 无待提交文件"
  exit 0
fi

# typecheck gate: 仅 .ts 改动时跑 tsc (本地防 red commit 入库; CI verify 兜底外的早拦层)
# 全项目 typecheck 0 是本会话战果, 此 gate 防回归. --no-verify 可绕过 (紧急情况).
TS_CHANGED=$(git diff --cached --name-only | grep -E '\.ts$' || true)
if [ -n "$TS_CHANGED" ]; then
  echo "🔍 typecheck (.ts changes detected)..."
  if ! bun run typecheck > /tmp/gbrain-precommit-tc.log 2>&1; then
    echo "❌ typecheck failed — fix errors above or use --no-verify to bypass:"
    tail -25 /tmp/gbrain-precommit-tc.log >&2
    exit 1
  fi
fi

echo "✅ Pre-commit check complete"
