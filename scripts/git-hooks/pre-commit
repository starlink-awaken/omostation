#!/usr/bin/env bash
# ─── ecos pre-commit 门禁 ──────────────────────────────
# ruff check + ruff format --check + debt prevention + MOF 校验
# 跳过: SKIP_GATE=true git commit -m "..."
# ──────────────────────────────────────────────────────

set -euo pipefail

if [ "${SKIP_GATE:-}" = "true" ]; then
    echo "🔓 SKIP_GATE=true — 跳过 pre-commit 检查"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")
DEBT_WARNINGS=0

# 工具路径选择: venv 优先, 退回 uv
VENV_PY="$REPO_ROOT/.venv/bin/python3"
if [ -x "$VENV_PY" ]; then
    PYTHON_BIN="$VENV_PY"
    PYTHON_LABEL="venv"
elif command -v uv &>/dev/null; then
    PYTHON_BIN="uv run --no-project --with pyyaml python3"
    PYTHON_LABEL="uv"
else
    PYTHON_BIN=""
    PYTHON_LABEL="none"
fi

echo "🔍 Pre-commit: $REPO_NAME (python: $PYTHON_LABEL)"

# ── ruff check (staged .py only) ──────────────────────
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' 2>/dev/null | grep -v "__pycache__" | grep -v ".venv" || true)
if [ -n "$STAGED_PY" ] && command -v ruff &>/dev/null; then
    if ! ruff check $STAGED_PY 2>&1; then
        echo "❌ ruff check 失败"
        exit 1
    fi
fi

# ── ruff format check (staged .py only) ───────────────
if [ -n "$STAGED_PY" ] && command -v ruff &>/dev/null; then
    if ! ruff format --check $STAGED_PY 2>&1; then
        echo "❌ ruff format 不符合规范 — 运行: ruff format"
        exit 1
    fi
fi

# ── Debt prevention: non-atomic write check ──────────
if [ -n "$STAGED_PY" ]; then
    for f in $STAGED_PY; do
        FULL_PATH="$REPO_ROOT/$f"
        if [ ! -f "$FULL_PATH" ] || echo "$f" | grep -q "test\|conftest"; then
            continue
        fi
        if grep -qE "write_text|open\([^)]*['\"]w['\"]" "$FULL_PATH" 2>/dev/null; then
            if ! grep -q "atomic_write" "$FULL_PATH" 2>/dev/null; then
                echo "⚠️  潜在非原子写入: $f"
                DEBT_WARNINGS=$((DEBT_WARNINGS + 1))
            fi
        fi
    done
fi

[ "$DEBT_WARNINGS" -gt 0 ] && echo "⚠️  债务预防警告: $DEBT_WARNINGS 项"

# ── MOF 工具 helper ───────────────────────────────────
_run_mof_tool() {
    local tool="$1"
    shift
    [ -z "$PYTHON_BIN" ] && { echo "⚠️  Python 不可用, 跳过 $tool"; return 0; }
    if [[ "$PYTHON_BIN" == "uv"* ]]; then
        (cd "$REPO_ROOT" && uv run --no-project --with pyyaml python3 "src/ecos/ssot/tools/$tool" "$@") || return $?
    else
        (cd "$REPO_ROOT" && "$PYTHON_BIN" "src/ecos/ssot/tools/$tool" "$@") || return $?
    fi
}

# ── MOF Schema 校验 (CR-MOF-VALIDATE-01) ──────────────
STAGED_M1=$(git diff --cached --name-only --diff-filter=ACM -- 'src/ecos/ssot/mof/m1/**/*.yaml' 2>/dev/null)
if [ -n "$STAGED_M1" ]; then
    echo "🔍 MOF schema 校验 (staged M1)..."
    _run_mof_tool mof-schema-validate.py --staged --strict || {
        echo "❌ mof-schema-validate 失败"
        exit 1
    }
fi

# ── MOF Bridge-Sync + Derive ─────────────────────────
STAGED_LIFECYCLE=$(git diff --cached --name-only --diff-filter=ACM -- 'src/ecos/ssot/mof/m1/lifecycle/**/*.yaml' 2>/dev/null)
if [ -n "$STAGED_LIFECYCLE" ]; then
    echo "🔗 MOF bridge-sync 校验 (model-driven ↔ M1)..."
    _run_mof_tool mof-bridge-sync.py --strict || {
        echo "❌ mof-bridge-sync 失败 (model-driven ↔ M1 失同步)"
        exit 1
    }
    echo "📊 mof-derive 桥接验证..."
    _run_mof_tool mof-derive.py --strict || {
        echo "❌ mof-derive 失败"
        exit 1
    }
fi

# ── MOF State-Bridge ──────────────────────────────────
STAGED_OMOTASK=$(git diff --cached --name-only --diff-filter=ACM -- 'src/ecos/ssot/mof/m1/omo_layer/OMOTASK-*.yaml' 2>/dev/null)
if [ -n "$STAGED_OMOTASK" ]; then
    echo "🔄 MOF state-bridge 校验 (.omo/tasks/ ↔ M1 OMOTask)..."
    _run_mof_tool mof-state-bridge.py --strict || {
        echo "❌ mof-state-bridge 失败 (m1_only > 0 即失同步)"
        exit 1
    }
fi

echo "✅ Pre-commit check complete"