# 未纳入 CI 的 shell 测试 —— 每行 `路径  # 原因`
#
# 由 tests/run-shell-suites.sh 读取:
#   · 名单不腐烂: runner 会校验每个路径**确实存在** (改名/删除不同步即报错);
#   · 新加的测试**默认被纳入**, 只有显式列在这里才排除 ⇒ 不会再出现无人执行的死测试;
#   · 修好/加速后请把该行删掉, 它会自动回到 CI。
#
# 排序无关。原因请写「为什么现在不能纳入」+ 「怎样才可纳入」。

tests/integration/run-all.sh                  # 聚合器: 自己会跑其它套件, 再被聚合会重复执行/递归
tests/test_submodule_autobump.sh              # 慢 (>40s, 2026-09-29 实测): 瘦身或拆分后可纳入
tests/integration/e2e-smoke.sh                # 真需运行环境 (2026-09-29 定位): 第 1 段要已起的 agora SSE :7431 / cron-service :7450, 第 2/3 段要各子项目 uv 环境与依赖; 拆分出「CLI 入口」子集后部分可纳入
tests/integration/test-sandbox-timemachine.sh # 工具熔断预算失效 (2026-09-29 定位): SANDBOX_TIMEOUT_S=5 < 本仓 git worktree add 实测 8.0s (post-checkout 钩子跑 guard-submodules); 熔断提高/可 env 覆盖后即可纳入
