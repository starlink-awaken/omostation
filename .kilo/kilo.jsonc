{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "git status *": "allow",
      "git submodule *": "allow",
      "git worktree *": "allow",
      "bash *": "allow",
      "git branch *": "allow",
      "grep *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "git -C *": "allow",
      "git log *": "allow",
      "git merge-base *": "allow",
      "find *": "allow",
      "read *": "allow",
      "dirname *": "allow",
      "head *": "allow",
      "git rev-parse *": "allow",
      "rm *": "allow",
      "uv *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "bin/mof-drift *": "allow",
      "python3 *": "allow",
      "/Users/xiamingxing/Workspace/bin/mof/mof-drift *": "allow",
      "which *": "allow",
      "agora *": "allow",
      "git diff *": "allow",
      "git ls-tree *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "xargs *": "allow",
      "make gac-local-gate *": "allow",
      "gh pr create *": "allow",
      "gh pr merge *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "git config --global *": "allow",
      "ps *": "allow",
      "sleep *": "allow",
      "gh pr diff *": "allow",
      "git ls-remote *": "allow",
      "git push *": "allow",
      "git show *": "allow",
      "git cherry-pick *": "allow",
      "git switch *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "ruff *": "allow",
      "rsync *": "allow",
      "git fetch *": "allow",
      "git checkout *": "allow",
      "git reset *": "allow",
      "make agent-workflow-bootstrap *": "allow",
      "make agent-workflow-status *": "allow",
      "make agent-workflow-closeout *": "allow",
      "make agent-workflow-compliance *": "allow",
      "make agent-workflow-doctor *": "allow",
      "make ci-local *": "allow",
      "make ssot-guardian *": "allow",
      "make doc-ssot-lint *": "allow",
      "make gac-validate *": "allow",
      "make gac-drift *": "allow",
      "make state-sync *": "allow",
      "make sync-submodules *": "allow",
      "make install-hooks *": "allow",
      "bash bin/gac/gac-worktree.sh *": "allow",
      "bash bin/ssot/submodule-pointer-transaction.sh *": "allow",
      "python3 bin/adr/next-adr-id.py *": "allow",
      "python3 bin/gac/swarm-discipline-cli.py *": "allow",
      "python3 bin/gac/m1-closeout-report.py *": "allow",
      "python3 bin/gac/gac-local-gate.py *": "allow",
      "python3 bin/ssot/check-branch-redundant.py *": "allow",
      "python3 bin/mof/mof-bootstrap.py *": "allow",
      "python3 bin/mof/m4-health-score.py *": "allow",
      "python3 bin/mof/gen-project-registry.py *": "allow",
      "python3 bin/gac/gac-export-agents.py *": "allow",
      "python3 bin/agent-workflow.py *": "allow"
    }
  },
  "mcp": {
    "agora-mcp": {
      "type": "local",
      "command": ["uv", "run", "--project", "projects/agora", "agora-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "omo-mcp": {
      "type": "local",
      "command": ["uv", "run", "--project", "projects/omo", "omo-mcp"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
